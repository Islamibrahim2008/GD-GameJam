            "textR": 0
          },
          "comment": "Light cone size\n"
        },
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const light = runtimeScene.getObjects(\"light\")[0];",
            "if (light && light.__light3D && !light.__edgeMapApplied) {",
            "    const s = light.__light3D;",
            "",
            "    const size  = 256;",
            "    const inner = 0.60;  // لحد هنا الضوء كامل (0 إلى 1 من نص القطر)",
            "    const outer = 1.00;  // عند هنا الضوء بيبقى صفر",
            "    const curve = 2.0;   // 1 = خطي، أكبر = الحافة بتقفل أسرع وأنعم",
            "",
            "    const canvas = document.createElement(\"canvas\");",
            "    canvas.width = canvas.height = size;",
            "    const ctx = canvas.getContext(\"2d\");",
            "    const img = ctx.createImageData(size, size);",
            "",
            "    for (let y = 0; y < size; y++) {",
            "        for (let x = 0; x < size; x++) {",
            "            const dx = (x + 0.5) / size * 2 - 1;",
            "            const dy = (y + 0.5) / size * 2 - 1;",
            "            const d = Math.sqrt(dx * dx + dy * dy);",
            "",
            "            let t = (d - inner) / (outer - inner);",
            "            t = Math.min(1, Math.max(0, t));",
            "            t = t * t * (3 - 2 * t);               // smoothstep",
            "            const v = Math.round(255 * Math.pow(1 - t, curve));",
            "",
            "            const i = (y * size + x) * 4;",
            "            img.data[i] = img.data[i + 1] = img.data[i + 2] = v;",
            "            img.data[i + 3] = 255;",
            "        }",
            "    }",
            "    ctx.putImageData(img, 0, 0);",
            "",
            "    const tex = new THREE.CanvasTexture(canvas);",
            "    tex.colorSpace = THREE.SRGBColorSpace;",
            "    s.map = tex;",
            "    s.penumbra = 0;               // الحافة هتتحكم فيها الخريطة",
            "",
            "    light.__edgeMapApplied = true; // تتنفذ مرة واحدة بس",
            "}"
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
      ]
    }
  ]
}
