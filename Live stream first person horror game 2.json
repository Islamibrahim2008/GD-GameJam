  "tests": [
    {
      "description": "Scene loads and portals exist without errors",
      "lastRunAt": 1793542897216,
      "lastRunDurationMs": 11182,
      "lastRunFramesExecuted": 121,
      "lastRunStatus": "passed",
      "name": "portal-view-smoke",
      "type": "gameplay",
      "source": [
        "await harness.goToScene('Game Scene');",
        "await harness.stepFrames(120);",
        "const blue = harness.getObjects('PortalBlue');",
        "const orange = harness.getObjects('PortalOrange');",
        "harness.assert(blue.length > 0, 'PortalBlue exists');",
        "harness.assert(orange.length > 0, 'PortalOrange exists');",
        "const logs = harness.getEventLog ? [] : [];",
        "await harness.takeScreenshot('portal-scene');"
      ]
    },
    {
      "description": "Place both portals and verify cross-view renders without errors",
      "lastRunAt": 1792868385214,
      "lastRunDurationMs": 12165,
      "lastRunFramesExecuted": 187,
      "lastRunStatus": "failed",
      "name": "portal-cross-view",
      "type": "gameplay",
      "source": [
        "await harness.goToScene('Game Scene');",
        "await harness.stepFrames(60);",
        "// Place Blue with left click (raycast from camera center)",
        "harness.setMouseButtonPressed(true, 'left');",
        "await harness.stepFrames(3);",
        "harness.setMouseButtonPressed(false, 'left');",
        "await harness.stepFrames(30);",
        "// Place Orange with right click",
        "harness.setMouseButtonPressed(true, 'right');",
        "await harness.stepFrames(3);",
        "harness.setMouseButtonPressed(false, 'right');",
        "await harness.stepFrames(90);",
        "const blue = harness.getObjects('PortalBlue')[0];",
        "const orange = harness.getObjects('PortalOrange')[0];",
        "const bActive = blue ? blue.variables.find(v => v.variableName === 'Active')?.value : undefined;",
        "const oActive = orange ? orange.variables.find(v => v.variableName === 'Active')?.value : undefined;",
        "harness.assert(bActive === 1, 'Blue portal became active after left click (Active=' + bActive + ')');",
        "harness.assert(oActive === 1, 'Orange portal became active after right click (Active=' + oActive + ')');",
        "await harness.takeScreenshot('both-portals');"
      ]
    },
    {
      "description": "Verify wall GrabWeight via API",
      "lastRunAt": 1793542905874,
      "lastRunDurationMs": 4957,
      "lastRunFramesExecuted": 63,
      "lastRunStatus": "stopped",
      "name": "grabpack-init-check",
      "type": "gameplay",
      "source": [
        "await harness.goToScene('Game Scene');",
        "await harness.stepFrames(120);",
        "const walls = harness.getObjects('wall');",
        "harness.assert(walls.length>=1, 'wall exists');",
        "const wid = walls[0].id;",
        "const gv = harness.getObjectVariable(wid, 'GrabWeight');",
        "harness.assert(gv!==undefined, 'GrabWeight var exists via API, got '+JSON.stringify(gv));",
        "if (gv) harness.assert(Number(gv.value)===1, 'GrabWeight=1 got '+JSON.stringify(gv));",
        "const gs = harness.getSceneVariable('GrabState');",
        "harness.assert(gs && Number(gs.value)===0, 'GrabState 0');",
        "await harness.takeScreenshot('grabpack-init');"
      ]
    },
    {
      "description": "Verify heavy horror physics: walking, sprinting and jumping work with the tuned character controller.",
      "lastRunAt": 1792952761457,
      "lastRunDurationMs": 4912,
      "lastRunFramesExecuted": 178,
      "lastRunStatus": "stopped",
      "name": "horror-physics-check",
      "type": "gameplay",
      "source": [
        "await harness.goToScene('Game Scene');",
        "await harness.stepFrames(30);",
        "const p0 = harness.getObjects('Player')[0];",
        "harness.assert(!!p0, 'Player exists');",
        "// Walk forward",
        "harness.setKeyPressed('w', true);",
        "const moved = await harness.stepUntil(() => { const p = harness.getObjects('Player')[0]; return p && Math.abs(p.x - p0.x) + Math.abs(p.y - p0.y) > 120; }, { maxFrames: 240 });",
        "harness.setKeyPressed('w', false);",
        "await harness.stepFrames(20);",
        "harness.assert(moved, 'Player walks forward with new physics');",
        "// Sprint should be faster per second",
        "const p1 = harness.getObjects('Player')[0];",
        "harness.setKeyPressed('w', true);",
        "harness.setKeyPressed('LShift', true);",
        "await harness.stepFrames(60);",
        "harness.setKeyPressed('LShift', false);",
        "harness.setKeyPressed('w', false);",
        "await harness.stepFrames(20);",
        "const p2 = harness.getObjects('Player')[0];",
        "const sprintDist = Math.abs(p2.x - p1.x) + Math.abs(p2.y - p1.y);",
        "harness.assert(sprintDist > 100, 'Sprint moves player noticeably (dist=' + sprintDist.toFixed(0) + ')');",
        "// Jump: leaves floor and lands (measure from a standing start)",
        "await harness.stepFrames(30);",
        "const before = harness.getObjects('Player')[0];",
        "harness.setKeyPressed('Space', true);",
        "await harness.stepFrames(3);",
        "harness.setKeyPressed('Space', false);",
        "let maxZ = before.z;",
        "for (let i = 0; i < 120; i++) { await harness.stepFrames(1); const p = harness.getObjects('Player')[0]; if (p && p.z > maxZ) maxZ = p.z; }",
        "harness.assert(maxZ > before.z + 10, 'Player jumps (maxZ=' + maxZ.toFixed(0) + ', before=' + before.z.toFixed(0) + ')');",
        "harness.takeScreenshot('horror-physics');"
      ]
    },
    {
      "description": "Sprint banking: camera rolls slightly when strafing while sprinting, and returns to level when stopping.",
      "lastRunAt": 1792952006726,
      "lastRunDurationMs": 2105,
      "lastRunFramesExecuted": 1,
      "lastRunStatus": "stopped",
      "name": "camera-roll-sprint",
      "type": "gameplay",
      "source": [
        "await harness.goToScene('Game Scene');",
        "await harness.stepFrames(40);",
        "// grab pointer lock so mouse look works",
        "harness.setMouseButtonPressed(true);",
        "await harness.stepFrames(3);",
        "harness.setMouseButtonPressed(false);",
        "await harness.stepFrames(3);",
        "",
        "const base = harness.getCameraState('') || harness.getCameraState();",
        "const rollIdle = base ? base.rotationY : 0;",
        "harness.assert(Math.abs(rollIdle) < 0.35, `idle roll is ~0 (got ${rollIdle})`);",
        "",
        "// sprint forward + strafe right",
        "harness.setKeyPressed('LShift', true);",
        "harness.setKeyPressed('w', true);",
        "harness.setKeyPressed('d', true);",
        "await harness.stepFrames(70);",
        "const sprintCam = harness.getCameraState('');",
        "const rollSprint = sprintCam ? sprintCam.rotationY : 0;",
        "await harness.takeScreenshot('sprint-roll');",
        "harness.assert(Math.abs(rollSprint) > 0.8, `camera rolls while sprint-strafing (got ${rollSprint})`);",
        "harness.assert(Math.abs(rollSprint) < 6, `roll stays subtle, under 6 degrees (got ${rollSprint})`);",
        "",
        "// stop strafing, keep sprinting -> roll must come back",
        "harness.setKeyPressed('d', false);",
        "await harness.stepFrames(70);",
        "const straightCam = harness.getCameraState('');",
        "const rollStraight = straightCam ? straightCam.rotationY : 0;",
        "harness.assert(Math.abs(rollStraight) < 0.6, `roll returns toward level when going straight (got ${rollStraight})`);",
        "",
        "// stop sprinting -> fully level",
        "harness.setKeyPressed('LShift', false);",
        "harness.setKeyPressed('w', false);",
        "await harness.stepFrames(120);",
        "const idleCam = harness.getCameraState('');",
        "const rollEnd = idleCam ? idleCam.rotationY : 0;",
        "harness.assert(Math.abs(rollEnd) < 0.25, `roll is level after stopping (got ${rollEnd})`);",
