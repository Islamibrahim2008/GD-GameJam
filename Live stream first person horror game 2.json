        "harness.setSceneVariable('MonsterState', 'Patrol');",
        "harness.setSceneVariable('PlayerVisible', 0);",
        "harness.setSceneVariable('Suspicion', 0);",
        "harness.setSceneVariable('AmbushPhase', 0);",
        "harness.setSceneVariable('LLM_State', 'Ambush');",
