        "  harness.assert(mul >= 0.7 && mul <= 1.4, 'speed multiplier clamped: ' + mul);",
        "  harness.assert(nv('LLM_Valid') === 1, 'directive valid');",
        "  console.log('LLM strategy=' + sv('LLM_Strategy') + ' | state=' + sv('LLM_State') + ' | ambushIdx=' + nv('LLM_AmbushIdx') + ' | mul=' + mul + ' | reason=' + sv('LLM_Reason'));",
