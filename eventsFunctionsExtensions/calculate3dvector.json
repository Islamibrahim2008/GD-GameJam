    {
      "description": "Returns the X component of a 3D vector built from a distance, a horizontal angle (Z) and a vertical angle (X).",
      "fullName": "↗️Vector X from distance and angles",
      "functionType": "Expression",
      "group": "Spherical vectors",
      "name": "Vec3_X",
      "sentence": "↗️Vector X (Distance: _PARAM1_, Z angle: _PARAM2_, X angle: _PARAM3_)",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const N = (v) => { v = Number(v); return Number.isFinite(v) ? v : 0; };",
            "const C = (v) => { v = Math.round(v * 1e10) / 1e10; return v === 0 ? 0 : v; };",
            "const A = (n) => N(eventsFunctionContext.getArgument(n));",
            "",
            "const D=A('Distance'), z=gdjs.toRad(A('AngleZ')), x=gdjs.toRad(A('AngleX'));",
            "eventsFunctionContext.returnValue = C(D * Math.sin(x) * Math.cos(z));"
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
      ],
      "expressionType": {
        "type": "expression"
      },
      "parameters": [
        {
          "description": "Distance (length of the vector)",
          "name": "Distance",
          "type": "expression"
        },
        {
          "description": "Horizontal angle in degrees (Z rotation)",
          "longDescription": "0 = towards +X, 90 = towards +Y. For a camera pointing forward use CameraRotationZ - 90, or use the Camera forward expressions.",
          "name": "AngleZ",
          "type": "expression"
        },
        {
          "description": "Vertical angle in degrees (X rotation, camera convention)",
          "longDescription": "Same convention as the 3D camera RotationX: 0 = straight down (-Z), 90 = horizontal, 180 = straight up (+Z).",
          "name": "AngleX",
          "type": "expression"
        }
      ],
      "objectGroups": []
    },
