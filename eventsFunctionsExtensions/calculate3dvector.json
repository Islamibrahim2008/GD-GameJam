      "functionType": "Expression",
      "group": "Position",
      "name": "DistanceToPoint",
      "sentence": "↔️Distance from 3D object to point (_PARAM1_, _PARAM2_, X: _PARAM3_, Y: _PARAM4_, Z: _PARAM5_)",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const N = (v) => { v = Number(v); return Number.isFinite(v) ? v : 0; };",
            "const C = (v) => { v = Math.round(v * 1e10) / 1e10; return v === 0 ? 0 : v; };",
            "const A = (n) => N(eventsFunctionContext.getArgument(n));",
            "",
            "const ObjectPoint = eventsFunctionContext.getArgument(\"ObjectPoint\");",
            "if (objects.length == 0) {",
            "    eventsFunctionContext.returnValue = 0;",
            "    return;",
            "}",
            "const O = objects[0];",
            "if (!O.get3DRendererObject || !O.get3DRendererObject()) {",
            "    eventsFunctionContext.returnValue = 0;",
            "    return;",
            "}",
            "let px, py, pz;",
            "if (ObjectPoint === \"Center point\") {",
            "    px = O.getCenterXInScene(); py = O.getCenterYInScene(); pz = O.getCenterZInScene();",
            "} else {",
            "    px = O.getX(); py = O.getY(); pz = O.getZ();",
            "}",
            "eventsFunctionContext.returnValue = Math.hypot(px - A('X'), py - A('Y'), pz - A('Z'));"
          ],
          "parameterObjects": "Object",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
