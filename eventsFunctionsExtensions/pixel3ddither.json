  "eventsFunctions": [
    {
      "description": "Installs the post-process on the 3D renderer with default settings. Safe to call more than once.",
      "fullName": "Install pixel 3D effect",
      "functionType": "Action",
      "group": "Pixel 3D",
      "name": "InstallEffect",
      "sentence": "Install the pixel 3D + dither effect",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const threeRenderer = runtimeScene.getGame().getRenderer().getThreeRenderer();",
            "if (!threeRenderer) return;",
            "",
            "// لو متركّب على نفس الـ renderer: بس فعّله. لو renderer مختلف: فكّ القديم وركّب من جديد",
            "if (gdjs.__pixel3D) {",
            "  if (gdjs.__pixel3D.threeRenderer === threeRenderer) {",
            "    gdjs.__pixel3D.enabled = true;",
            "    return;",
            "  }",
            "  try { gdjs.__pixel3D.dispose(); } catch (e) {}",
            "  gdjs.__pixel3D = null;",
            "}",
            "",
            "const DEFAULTS = {",
            "  targetHeight: 360, levels: 7, ditherStrength: 0.9, saturation: 1.1, contrast: 1.08,",
            "  manualGamma: false, supersample: 2, fixTextures: true,",
            "  highlightKnee: 0.85, shadowSaturation: 1.0, shadowLift: 1.0,",
            "  outline: 1.0, outlineThreshold: 0.08, outlineThickness: 1.0,",
            "  vignette: 0.55, chromatic: 0.035,",
            "};",
            "",
            "const state = Object.assign({",
            "  enabled: true,",
            "  threeRenderer: threeRenderer,",
            "  defaults: DEFAULTS,",
            "  originalRender: threeRenderer.render.bind(threeRenderer),",
            "}, DEFAULTS);",
            "",
            "const rt = new THREE.WebGLRenderTarget(1, 1, {",
            "  minFilter: THREE.NearestFilter,",
            "  magFilter: THREE.NearestFilter,",
            "  depthBuffer: true,",
            "  type: THREE.HalfFloatType,",
            "});",
            "rt.depthTexture = new THREE.DepthTexture(1, 1);",
            "rt.depthTexture.minFilter = THREE.NearestFilter;",
            "rt.depthTexture.magFilter = THREE.NearestFilter;",
            "",
            "const material = new THREE.ShaderMaterial({",
            "  defines: { SS: state.supersample },",
            "  uniforms: {",
            "    tDiffuse: { value: rt.texture },",
            "    tDepth: { value: rt.depthTexture },",
            "    uRes: { value: new THREE.Vector2(1, 1) },",
            "    levels: { value: state.levels },",
            "    ditherStrength: { value: state.ditherStrength },",
            "    saturation: { value: state.saturation },",
            "    contrast: { value: state.contrast },",
            "    gammaOn: { value: 0.0 },",
            "    highlightKnee: { value: state.highlightKnee },",
            "    shadowSaturation: { value: state.shadowSaturation },",
            "    shadowLift: { value: state.shadowLift },",
            "    camNear: { value: 0.1 },",
            "    camFar: { value: 1000.0 },",
            "    isOrtho: { value: 0.0 },",
            "    outline: { value: state.outline },",
            "    outlineThreshold: { value: state.outlineThreshold },",
            "    outlineThickness: { value: state.outlineThickness },",
            "    vignette: { value: state.vignette },",
            "    chromatic: { value: state.chromatic },",
            "  },",
            "  vertexShader: `",
            "    varying vec2 vUv;",
            "    void main() {",
            "      vUv = uv;",
            "      gl_Position = vec4(position.xy, 0.0, 1.0);",
            "    }",
            "  `,",
            "  fragmentShader: `",
            "    uniform sampler2D tDiffuse;",
            "    uniform sampler2D tDepth;",
            "    uniform vec2 uRes;",
            "    uniform float levels;",
            "    uniform float ditherStrength;",
            "    uniform float saturation;",
            "    uniform float contrast;",
            "    uniform float gammaOn;",
            "    uniform float highlightKnee;",
            "    uniform float shadowSaturation;",
            "    uniform float shadowLift;",
            "    uniform float camNear;",
            "    uniform float camFar;",
            "    uniform float isOrtho;",
            "    uniform float outline;",
            "    uniform float outlineThreshold;",
            "    uniform float outlineThickness;",
            "    uniform float vignette;",
            "    uniform float chromatic;",
            "    varying vec2 vUv;",
            "",
            "    float bayer2(vec2 a) { a = floor(a); return fract(a.x / 2.0 + a.y * a.y * 0.75); }",
            "    float bayer4(vec2 a) { return bayer2(0.5 * a) * 0.25 + bayer2(a); }",
            "",
            "    vec3 toSRGB(vec3 c) {",
            "      c = max(c, vec3(0.0));",
            "      return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));",
            "    }",
            "",
            "    vec4 boxTex(vec2 uvc) {",
            "      vec4 s = vec4(0.0);",
            "      for (int j = 0; j < SS; j++) {",
            "        for (int i = 0; i < SS; i++) {",
            "          vec2 o = (vec2(float(i), float(j)) + 0.5) / float(SS) - 0.5;",
            "          s += texture2D(tDiffuse, uvc + o / uRes);",
            "        }",
            "      }",
            "      return s / float(SS * SS);",
            "    }",
            "",
            "    vec3 softHighlights(vec3 c) {",
            "      if (highlightKnee >= 0.999) return c;",
            "      float m = max(max(c.r, c.g), c.b);",
            "      if (m <= highlightKnee) return c;",
            "      float range = 1.0 - highlightKnee;",
            "      float mapped = highlightKnee + range * (1.0 - exp(-(m - highlightKnee) / range));",
            "      return c * (mapped / m);",
            "    }",
            "",
            "    float linearZ(float d) {",
            "      if (isOrtho > 0.5) return camNear + d * (camFar - camNear);",
            "      float z = d * 2.0 - 1.0;",
            "      return (2.0 * camNear * camFar) / (camFar + camNear - z * (camFar - camNear));",
            "    }",
            "",
            "    float invDepth(vec2 uv) {",
            "      return 1.0 / max(linearZ(texture2D(tDepth, uv).r), 0.0001);",
            "    }",
            "",
            "    float edgeAt(vec2 uv, vec2 o) {",
            "      float c  = invDepth(uv);",
            "      float lf = invDepth(uv + vec2(-o.x, 0.0));",
            "      float rg = invDepth(uv + vec2( o.x, 0.0));",
            "      float up = invDepth(uv + vec2(0.0,  o.y));",
            "      float dn = invDepth(uv + vec2(0.0, -o.y));",
            "      float lap = (lf + rg + up + dn) - 4.0 * c;",
            "      return step(outlineThreshold, -lap / max(c, 0.0001));",
            "    }",
            "",
            "    void main() {",
            "      vec2 pix = floor(vUv * uRes);",
            "      vec2 uvc = (pix + 0.5) / uRes;",
            "      vec2 dir = uvc - 0.5;",
            "",
            "      vec2 off = dir * dot(dir, dir) * chromatic;",
            "      vec4 base = boxTex(uvc);",
            "      vec3 col;",
            "      col.r = boxTex(clamp(uvc + off, 0.0, 1.0)).r;",
            "      col.g = base.g;",
            "      col.b = boxTex(clamp(uvc - off, 0.0, 1.0)).b;",
            "      col = max(col, vec3(0.0));",
            "",
            "      if (gammaOn > 0.5) col = toSRGB(col);",
            "",
            "      if (shadowLift != 1.0) col = pow(col, vec3(shadowLift));",
            "",
            "      float l = dot(col, vec3(0.299, 0.587, 0.114));",
            "      float satMul = saturation * mix(shadowSaturation, 1.0, smoothstep(0.0, 0.4, l));",
            "      col = mix(vec3(l), col, satMul);",
            "      col = (col - 0.5) * contrast + 0.5;",
            "      col = max(col, vec3(0.0));",
            "",
            "      col = softHighlights(col);",
            "      col = clamp(col, 0.0, 1.0);",
            "",
            "      float vd = length(dir) * 1.4142;",
            "      col *= 1.0 - smoothstep(0.35, 1.05, vd) * vignette;",
            "",
            "      float d = (bayer4(pix) - 0.46875) * ditherStrength;",
            "      float steps = levels - 1.0;",
            "      col = clamp(floor(col * steps + 0.5 + d) / steps, 0.0, 1.0);",
            "",
            "      if (outline > 0.0) {",
            "        vec2 o = outlineThickness / uRes;",
            "        float e = 0.0;",
            "        for (int j = 0; j < SS; j++) {",
            "          for (int i = 0; i < SS; i++) {",
            "            vec2 t = (vec2(float(i), float(j)) + 0.5) / float(SS) - 0.5;",
            "            e += edgeAt(uvc + t / uRes, o);",
            "          }",
            "        }",
            "        float edge = step(0.5, e / float(SS * SS));",
            "        col = mix(col, vec3(0.0), edge * outline);",
            "      }",
            "",
            "      gl_FragColor = vec4(col, base.a);",
            "    }",
            "  `,",
            "  depthTest: false,",
            "  depthWrite: false,",
            "  transparent: true,",
            "});",
            "",
            "const quadScene = new THREE.Scene();",
            "quadScene.add(new THREE.Mesh(new THREE.PlaneGeometry(2, 2), material));",
            "const quadCam = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);",
            "const size = new THREE.Vector2();",
            "",
            "const maxAniso = threeRenderer.capabilities.getMaxAnisotropy();",
            "const TEX_KEYS = ['map', 'emissiveMap', 'normalMap', 'roughnessMap', 'metalnessMap', 'aoMap'];",
            "let frameCount = 0;",
            "function fixTextures(root) {",
            "  root.traverse((obj) => {",
            "    if (!obj.material) return;",
            "    const mats = Array.isArray(obj.material) ? obj.material : [obj.material];",
            "    for (const m of mats) {",
            "      for (const key of TEX_KEYS) {",
            "        const t = m[key];",
            "        if (!t || !t.userData || t.userData.__pixel3DFixed) continue;",
            "        t.userData.__pixel3DFixed = true;",
            "        t.generateMipmaps = true;",
            "        t.minFilter = THREE.LinearMipmapLinearFilter;",
            "        t.anisotropy = maxAniso;",
            "        t.needsUpdate = true;",
            "      }",
            "    }",
            "  });",
            "}",
            "",
            "threeRenderer.render = function (scene, camera) {",
            "  if (!state.enabled) return state.originalRender(scene, camera);",
            "  try { if (threeRenderer.getRenderTarget() !== null) return state.originalRender(scene, camera); } catch (e) {}",
            "  if (state.rendering) return state.originalRender(scene, camera);",
            "  state.rendering = true;",
            "  try {",
            "",
            "  if (state.fixTextures && scene && (frameCount++ % 30) === 0) {",
            "    try { fixTextures(scene); } catch (e) {}",
            "  }",
            "",
            "  // الـ supersample ممكن يتغير وقت التشغيل: لازم نعيد تجميع الـ shader",
            "  const SS = Math.max(1, Math.min(4, Math.round(state.supersample)));",
            "  if (material.defines.SS !== SS) {",
            "    material.defines.SS = SS;",
            "    material.needsUpdate = true;",
            "  }",
            "",
            "  threeRenderer.getDrawingBufferSize(size);",
            "  const pixelSize = Math.max(1, Math.round(size.y / state.targetHeight));",
            "  const w = Math.max(1, Math.floor(size.x / pixelSize));",
            "  const h = Math.max(1, Math.floor(size.y / pixelSize));",
            "  if (rt.width !== w * SS || rt.height !== h * SS) rt.setSize(w * SS, h * SS);",
            "",
            "  const u = material.uniforms;",
            "  u.uRes.value.set(w, h);",
            "  u.levels.value = state.levels;",
            "  u.ditherStrength.value = state.ditherStrength;",
            "  u.saturation.value = state.saturation;",
            "  u.contrast.value = state.contrast;",
            "  u.gammaOn.value = state.manualGamma ? 1.0 : 0.0;",
            "  u.highlightKnee.value = state.highlightKnee;",
            "  u.shadowSaturation.value = state.shadowSaturation;",
            "  u.shadowLift.value = state.shadowLift;",
            "  u.outline.value = state.outline;",
            "  u.outlineThreshold.value = state.outlineThreshold;",
            "  u.outlineThickness.value = state.outlineThickness;",
            "  u.vignette.value = state.vignette;",
            "  u.chromatic.value = state.chromatic;",
            "  if (camera) {",
            "    u.camNear.value = camera.near;",
            "    u.camFar.value = camera.far;",
            "    u.isOrtho.value = camera.isOrthographicCamera ? 1.0 : 0.0;",
            "  }",
            "",
            "  const prevTarget = threeRenderer.getRenderTarget();",
            "  const prevAutoClear = threeRenderer.autoClear;",
            "",
            "  // 1) المشهد (بالإضاءة والظلال) في الـ target",
            "  threeRenderer.setRenderTarget(rt);",
            "  threeRenderer.autoClear = true;",
            "  state.originalRender(scene, camera);",
            "",
            "  // 2) النتيجة على الشاشة",
            "  threeRenderer.setRenderTarget(prevTarget);",
            "  threeRenderer.autoClear = false;",
            "  state.originalRender(quadScene, quadCam);",
            "",
            "  threeRenderer.autoClear = prevAutoClear;",
            "  } finally { state.rendering = false; }",
            "};",
            "",
            "state.dispose = function () {",
            "  threeRenderer.render = state.originalRender;",
            "  rt.dispose();",
            "  rt.depthTexture.dispose();",
            "  material.dispose();",
            "};",
            "",
            "gdjs.__pixel3D = state;",
            ""
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
      ],
      "parameters": [],
      "objectGroups": []
    },
    {
      "description": "Restores the original renderer and frees GPU resources.",
      "fullName": "Remove pixel 3D effect",
      "functionType": "Action",
      "group": "Pixel 3D",
      "name": "RemoveEffect",
      "sentence": "Remove the pixel 3D + dither effect",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const s = gdjs.__pixel3D;",
            "if (!s) return;",
            "try { s.dispose(); } catch (e) {}",
            "gdjs.__pixel3D = null;",
            ""
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
      ],
      "parameters": [],
      "objectGroups": []
    },
    {
      "description": "Turn the effect on or off without uninstalling it.",
      "fullName": "Enable/disable pixel 3D effect",
      "functionType": "Action",
      "group": "Pixel 3D",
      "name": "SetEnabled",
      "sentence": "Enable the pixel 3D effect: _PARAM1_",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const s = gdjs.__pixel3D;",
            "if (!s) return;",
            "const v = eventsFunctionContext.getArgument(\"Enabled\");",
            "s.enabled = (v === true || v === \"yes\" || v === \"true\" || v === 1);",
            ""
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
      ],
      "parameters": [
        {
          "description": "Enabled",
          "name": "Enabled",
          "type": "yesorno"
        }
      ],
      "objectGroups": []
    },
    {
      "description": "Change one numeric setting (pixel size, levels, dither, lighting, outline, screen...).",
      "fullName": "Change a numeric setting",
      "functionType": "Action",
      "group": "Pixel 3D",
      "name": "SetNumber",
      "sentence": "Set pixel 3D setting _PARAM1_ to _PARAM2_",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const s = gdjs.__pixel3D;",
            "if (!s) return;",
            "const name = eventsFunctionContext.getArgument(\"Setting\");",
            "let v = Number(eventsFunctionContext.getArgument(\"Value\"));",
            "if (!isFinite(v)) return;",
            "if (name === \"supersample\") v = Math.max(1, Math.min(4, Math.round(v)));",
            "else if (name === \"targetHeight\") v = Math.max(1, Math.round(v));",
            "else if (name === \"levels\") v = Math.max(2, Math.round(v));",
            "if (typeof s.defaults[name] === \"number\") s[name] = v;",
            ""
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
      ],
      "parameters": [
        {
          "description": "Setting",
          "name": "Setting",
          "supplementaryInformation": "[\"targetHeight\", \"levels\", \"ditherStrength\", \"saturation\", \"contrast\", \"supersample\", \"highlightKnee\", \"shadowSaturation\", \"shadowLift\", \"outline\", \"outlineThreshold\", \"outlineThickness\", \"vignette\", \"chromatic\"]",
          "type": "stringWithSelector"
        },
        {
          "description": "Value",
          "name": "Value",
          "type": "expression"
        }
      ],
      "objectGroups": []
    },
    {
      "description": "Change a boolean option (fixTextures, manualGamma).",
      "fullName": "Change an on/off setting",
      "functionType": "Action",
      "group": "Pixel 3D",
      "name": "SetToggle",
      "sentence": "Set pixel 3D option _PARAM1_ to _PARAM2_",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const s = gdjs.__pixel3D;",
            "if (!s) return;",
            "const name = eventsFunctionContext.getArgument(\"Option\");",
            "const v = eventsFunctionContext.getArgument(\"Value\");",
            "if (typeof s.defaults[name] === \"boolean\") {",
            "  s[name] = (v === true || v === \"yes\" || v === \"true\" || v === 1);",
            "}",
            ""
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
      ],
      "parameters": [
        {
          "description": "Option",
          "name": "Option",
          "supplementaryInformation": "[\"fixTextures\", \"manualGamma\"]",
          "type": "stringWithSelector"
        },
        {
          "description": "Value",
          "name": "Value",
          "type": "yesorno"
        }
      ],
      "objectGroups": []
    },
    {
      "description": "Restores all settings to their default values.",
      "fullName": "Reset pixel 3D settings",
      "functionType": "Action",
      "group": "Pixel 3D",
      "name": "ResetDefaults",
      "sentence": "Reset pixel 3D settings to defaults",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const s = gdjs.__pixel3D;",
            "if (!s) return;",
            "Object.assign(s, s.defaults);",
            ""
          ],
          "parameterObjects": "",
