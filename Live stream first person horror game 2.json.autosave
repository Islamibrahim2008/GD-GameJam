olor","sentence":"Set custom palette color _PARAM2_ of layer _PARAM1_ to _PARAM3_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const PIXEL = gdjs.__pixel3D;","if (PIXEL) PIXEL.setPaletteColor(runtimeScene, eventsFunctionContext.getArgument('Layer'), eventsFunctionContext.getArgument('Index'), eventsFunctionContext.getArgument('Color'));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[{"description":"3D layer","name":"Layer","type":"layer"},{"description":"Palette index (0-31)","name":"Index","type":"expression"},{"description":"Color","name":"Color","type":"color"}],"objectGroups":[]},{"description":"Restores the default Pixel Art settings on a layer.","fullName":"Reset Pixel 3D defaults","functionType":"Action","group":"Pixel 3D","name":"ResetDefaults","sentence":"Reset Pixel 3D defaults on layer _PARAM1_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const PIXEL = gdjs.__pixel3D;","if (PIXEL) PIXEL.resetDefaults(runtimeScene, eventsFunctionContext.getArgument('Layer'));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[{"description":"3D layer","name":"Layer","type":"layer"}],"objectGroups":[]},{"description":"Restores the default Pixel Art settings on all active layers.","fullName":"Reset all Pixel 3D defaults","functionType":"Action","group":"Pixel 3D","name":"ResetAllDefaults","sentence":"Reset Pixel 3D defaults on all layers","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const PIXEL = gdjs.__pixel3D;","if (PIXEL) PIXEL.resetAllDefaults(runtimeScene);"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[],"objectGroups":[]},{"description":"Convenience action for the integer pixel size. 0 uses the automatic size from the pixel height. 1 disables pixelation.","fullName":"Set the Pixel 3D pixel size","functionType":"Action","group":"Pixel 3D","name":"SetPixelSize","sentence":"Set Pixel 3D pixel size of layer _PARAM1_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const PIXEL = gdjs.__pixel3D;","if (PIXEL) PIXEL.setNumber(runtimeScene, eventsFunctionContext.getArgument('Layer'), 'Pixel Scale', eventsFunctionContext.getArgument('Scale'));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[{"description":"3D layer","name":"Layer","type":"layer"},{"description":"Integer pixel scale (0 = auto)","name":"Scale","type":"expression"}],"objectGroups":[]},{"description":"Convenience action for the internal pixel grid height (360 = about 640x360 at 16:9).","fullName":"Set the Pixel 3D target height","functionType":"Action","group":"Pixel 3D","name":"SetTargetHeight","sentence":"Set Pixel 3D target height of layer _PARAM1_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const PIXEL = gdjs.__pixel3D;","if (PIXEL) PIXEL.setNumber(runtimeScene, eventsFunctionContext.getArgument('Layer'), 'Pixel Height', eventsFunctionContext.getArgument('Height'));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[{"description":"3D layer","name":"Layer","type":"layer"},{"description":"Target pixel-grid height","name":"Height","type":"expression"}],"objectGroups":[]},{"description":"True if Pixel 3D is active on the given layer.","fullName":"Pixel 3D is enabled on a layer","functionType":"Condition","group":"Pixel 3D","name":"IsEnabledOnLayer","sentence":"Pixel 3D is enabled on layer _PARAM1_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const PIXEL = gdjs.__pixel3D;","eventsFunctionContext.returnValue = !!(PIXEL && PIXEL.isEnabled(runtimeScene, eventsFunctionContext.getArgument('Layer')));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[{"description":"3D layer","name":"Layer","type":"layer"}],"objectGroups":[]},{"description":"True if Pixel 3D is active on at least one layer of the scene.","fullName":"Pixel 3D is active","functionType":"Condition","group":"Pixel 3D","name":"IsActive","sentence":"Pixel 3D is active","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const PIXEL = gdjs.__pixel3D;","eventsFunctionContext.returnValue = !!(PIXEL && PIXEL.isActive(runtimeScene));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[],"objectGroups":[]},{"description":"True if the project uses Three.js and a WebGL renderer.","fullName":"Pixel 3D is supported","functionType":"Condition","group":"Pixel 3D","name":"IsSupported","sentence":"Pixel 3D is supported","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const PIXEL = gdjs.__pixel3D;","eventsFunctionContext.returnValue = !!(PIXEL && PIXEL.isSupported());"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[],"objectGroups":[]},{"description":"Width of the internal pixel grid of a layer (0 if the effect is not active).","fullName":"Pixel grid width","functionType":"Expression","group":"Pixel 3D","name":"PixelWidth","sentence":"Pixel grid width of layer _PARAM1_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const PIXEL = gdjs.__pixel3D;","eventsFunctionContext.returnValue = PIXEL ? PIXEL.getStats(runtimeScene, eventsFunctionContext.getArgument('Layer')).width : 0;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"expressionType":{"type":"expression"},"parameters":[{"description":"3D layer","name":"Layer","type":"layer"}],"objectGroups":[]},{"description":"Height of the internal pixel grid of a layer (0 if the effect is not active).","fullName":"Pixel grid height","functionType":"Expression","group":"Pixel 3D","name":"PixelHeight","sentence":"Pixel grid height of layer _PARAM1_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const PIXEL = gdjs.__pixel3D;","eventsFunctionContext.returnValue = PIXEL ? PIXEL.getStats(runtimeScene, eventsFunctionContext.getArgument('Layer')).height : 0;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"expressionType":{"type":"expression"},"parameters":[{"description":"3D layer","name":"Layer","type":"layer"}],"objectGroups":[]},{"description":"Integer pixel scale of a layer (1 = native, 2 = half resolution, ...).","fullName":"Pixel scale","functionType":"Expression","group":"Pixel 3D","name":"PixelScale","sentence":"Pixel scale of layer _PARAM1_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const PIXEL = gdjs.__pixel3D;","eventsFunctionContext.returnValue = PIXEL ? PIXEL.getStats(runtimeScene, eventsFunctionContext.getArgument('Layer')).scale : 1;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"expressionType":{"type":"expression"},"parameters":[{"description":"3D layer","name":"Layer","type":"layer"}],"objectGroups":[]},{"description":"Current style preset name of a layer.","fullName":"Pixel 3D preset name","functionType":"Expression","group":"Pixel 3D","name":"PresetName","sentence":"Pixel 3D preset name of layer _PARAM1_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const PIXEL = gdjs.__pixel3D;","const s = PIXEL ? PIXEL.getSettings(runtimeScene, eventsFunctionContext.getArgument('Layer')) : null;","eventsFunctionContext.returnValue = s ? s.preset : '';"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"expressionType":{"type":"expression"},"parameters":[{"description":"3D layer","name":"Layer","type":"layer"}],"objectGroups":[]},{"description":"Current palette name of a layer.","fullName":"Pixel 3D palette name","functionType":"Expression","group":"Pixel 3D","name":"PaletteName","sentence":"Pixel 3D palette name of layer _PARAM1_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const PIXEL = gdjs.__pixel3D;","const s = PIXEL ? PIXEL.getSettings(runtimeScene, eventsFunctionContext.getArgument('Layer')) : null;","eventsFunctionContext.returnValue = s ? s.palette : '';"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"expressionType":{"type":"expression"},"parameters":[{"description":"3D layer","name":"Layer","type":"layer"}],"objectGroups":[]},{"description":"Reads a numeric setting of a layer, for HUDs and debug text.","fullName":"Pixel 3D setting value","functionType":"Expression","group":"Pixel 3D","name":"SettingValue","sentence":"Pixel 3D setting _PARAM2_ of layer _PARAM1_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const PIXEL = gdjs.__pixel3D;","const s = PIXEL ? PIXEL.getSettings(runtimeScene, eventsFunctionContext.getArgument('Layer')) : null;","const key = String(eventsFunctionContext.getArgument('Setting') || '').trim().toLowerCase();","const map = { 'pixel height':'targetHeight', 'pixel scale':'pixelScale', 'color levels':'colorLevels', 'dither strength':'dither', 'saturation':'saturation', 'contrast':'contrast', 'outline':'outline', 'outline threshold':'outlineThreshold', 'outline thickness':'outlineThickness', 'outline distance':'outlineDistance', 'crease threshold':'creaseThreshold', 'cel shading':'cel', 'cel bands':'celBands', 'cel softness':'celSoftness', 'rim':'rim', 'vignette':'vignette', 'chromatic':'chromatic', 'palette size':'paletteSize' };","eventsFunctionContext.returnValue = s && map[key] !== undefined ? s[map[key]] : 0;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"expressionType":{"type":"expression"},"parameters":[{"description":"3D layer","name":"Layer","type":"layer"},{"defaultValue":"Pixel Height","description":"Numeric setting","name":"Setting","supplementaryInformation":"[\"Pixel Height\",\"Pixel Scale\",\"Color Levels\",\"Dither Strength\",\"Saturation\",\"Contrast\",\"Outline\",\"Outline Threshold\",\"Outline Thickness\",\"Outline Distance\",\"Crease Threshold\",\"Cel Shading\",\"Cel Bands\",\"Cel Softness\",\"Rim\",\"Vignette\",\"Chromatic\",\"Palette Size\"]","type":"stringWithSelector"}],"objectGroups":[]},{"description":"Internal: installs the Pixel 3D runtime and restores the saved layers. Called automatically when a scene is loaded.","fullName":"Initialize Pixel 3D (lifecycle)","functionType":"Action","name":"onSceneLoaded","sentence":"Initialize Pixel 3D","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["(function () {","  'use strict';","  const module = { exports: {} };","  const exports = module.exports;","  /**\r"," * Pixel 3D + Dither — engine-integrated GDevelop 5 / Three.js r185 extension.\r"," *\r"," * Design rules (why this version is different from 4.2):\r"," *  - No `threeRenderer.render` monkey-patch. Every effect is an\r"," *    EffectComposer pass owned by the 3D layer, like FSR1 and the engine's own\r"," *    effects.\r"," *  - The pass is inserted *after* the layer OutputPass, so tone mapping,\r"," *    exposure and sRGB conversion from light3d / the engine are kept. Palette,\r"," *    cel shading, dithering, outlines, vignette and chromatic aberration are\r"," *    done in display space, on a low-resolution grid.\r"," *  - The composer is resized to the pixel grid (integer scale), so LOD3D reads\r"," *    the real internal height and the GPU only shades one fragment per pixel.\r"," *  - Depth comes from the engine's SceneDepthRenderPass; outlines use both the\r"," *    inverse-depth Laplacian (silhouettes) and depth-derived normals (creases).\r"," *  - FSR1 is disabled on a layer when Pixel 3D is enabled there, and the\r"," *    extension exports `isActiveOnLayer` so a patched FSR1 can skip it.\r"," *  - WebGPU is guarded; the effect only installs on WebGLRenderer.\r"," *\r"," * The file is embedded into Pixel3DDither.json by build-pixel3d.js.\r"," * License: MIT.\r"," */\r","(function (root, factory) {\r","  if (typeof module === 'object' && module.exports) {\r","    module.exports = factory();\r","  } else {\r","    root.Pixel3DRuntime = factory();\r","  }\r","})(typeof globalThis !== 'undefined' ? globalThis : this, function () {\r","  'use strict';\r","\r","  const VERSION = '5.0.0';\r","\r","  const DEFAULTS = {\r","    preset: 'Pixel Art',\r","    targetHeight: 360,\r","    pixelScale: 0,\r","    palette: 'None',\r","    paletteSize: 0,\r","    paletteColors: null,\r","    colorLevels: 24,\r","    dither: 0.75,\r","    ditherEnabled: true,\r","    saturation: 1.05,\r","    contrast: 1.0,\r","    outline: 1.1,\r","    outlineThreshold: 0.08,\r","    creaseThreshold: 0.35,\r","    outlineThickness: 1,\r","    outlineDistance: 0.15,\r","    coloredOutline: true,\r","    cel: 0,\r","    celBands: 4,\r","    celSoftness: 0.1,\r","    rim: 0,\r","    vignette: 0.12,\r","    chromatic: 0,\r","  };\r","\r","  const PRESETS = {\r","    'Pixel Art': {\r","      targetHeight: 360,\r","      pixelScale: 0,\r","      palette: 'None',\r","      colorLevels: 24,\r","      dither: 0.75,\r","      ditherEnabled: true,\r","      saturation: 1.05,\r","      contrast: 1.0,\r","      outline: 1.1,\r","      outlineThreshold: 0.08,\r","      creaseThreshold: 0.35,\r","      outlineThickness: 1,\r","      outlineDistance: 0.15,\r","      coloredOutline: true,\r","      cel: 0,\r","      celBands: 4,\r","      celSoftness: 0.1,\r","      rim: 0,\r","      vignette: 0.12,\r","      chromatic: 0,\r","    },\r","    Cartoon: {\r","      targetHeight: 1080,\r","      pixelScale: 1,\r","      palette: 'None',\r","      colorLevels: 32,\r","      dither: 0,\r","      ditherEnabled: false,\r","      saturation: 1.12,\r","      contrast: 1.05,\r","      outline: 1.35,\r","      outlineThreshold: 0.1,\r","      creaseThreshold: 0.3,\r","      outlineThickness: 1.2,\r","      outlineDistance: 0.25,\r","      coloredOutline: true,\r","      cel: 0.9,\r","      celBands: 4,\r","      celSoftness: 0.08,\r","      rim: 0.25,\r","      vignette: 0.18,\r","      chromatic: 0,\r","    },\r","    'Game Boy': {\r","      targetHeight: 288,\r","      pixelScale: 0,\r","      palette: 'Game Boy',\r","      colorLevels: 4,\r","      dither: 0.8,\r","      ditherEnabled: true,\r","      saturation: 0.9,\r","      contrast: 1.05,\r","      outline: 1.2,\r","      outlineThreshold: 0.08,\r","      creaseThreshold: 0.4,\r","      outlineThickness: 1,\r","      outlineDistance: 0.1,\r","      coloredOutline: false,\r","      cel: 0,\r","      celBands: 4,\r","      celSoftness: 0.1,\r","      rim: 0,\r","      vignette: 0.15,\r","      chromatic: 0,\r","    },\r","    CGA: {\r","      targetHeight: 240,\r","      pixelScale: 0,\r","      palette: 'CGA',\r","      colorLevels: 16,\r","      dither: 0.7,\r","      ditherEnabled: true,\r","      saturation: 1.1,\r","      contrast: 1.05,\r","      outline: 1,\r","      outlineThreshold: 0.08,\r","      creaseThreshold: 0.4,\r","      outlineThickness: 1,\r","      outlineDistance: 0.1,\r","      coloredOutline: false,\r","      cel: 0,\r","      celBands: 4,\r","      celSoftness: 0.1,\r","      rim: 0,\r","      vignette: 0.12,\r","      chromatic: 0,\r","    },\r","    'Hi-Res Pixel': {\r","      targetHeight: 540,\r","      pixelScale: 0,\r","      palette: 'None',\r","      colorLevels: 32,\r","      dither: 0.35,\r","      ditherEnabled: true,\r","      saturation: 1.02,\r","      contrast: 1.0,\r","      outline: 0.9,\r","      outlineThreshold: 0.08,\r","      creaseThreshold: 0.38,\r","      outlineThickness: 1,\r","      outlineDistance: 0.15,\r","      coloredOutline: true,\r","      cel: 0,\r","      celBands: 4,\r","      celSoftness: 0.1,\r","      rim: 0,\r","      vignette: 0.08,\r","      chromatic: 0,\r","    },\r","  };\r","\r","  const PALETTES = {\r","    None: null,\r","    'PICO-8': [\r","      0x000000, 0x1d2b53, 0x7e2553, 0x008751, 0xab5236, 0x5f574f, 0xc2c3c7, 0xfff1e8,\r","      0xff004d, 0xffa300, 0xffec27, 0x00e436, 0x29adff, 0x83769c, 0xff77a8, 0xffccaa,\r","    ],\r","    'Game Boy': [0x0f380f, 0x306230, 0x8bac0f, 0x9bbc0f],\r","    'Sweetie 16': [\r","      0x1a1c2c, 0x5d275d, 0xb13e53, 0xef7d57, 0xffcd75, 0xa7f070, 0x38b764, 0x257179,\r","      0x29366f, 0x3b5dc9, 0x41a6f6, 0x73eff7, 0xf4f4f4, 0x94b0c2, 0x566c86, 0x333c57,\r","    ],\r","    CGA: [\r","      0x000000, 0x0000aa, 0x00aa00, 0x00aaaa, 0xaa0000, 0xaa00aa, 0xaa5500, 0xaaaaaa,\r","      0x555555, 0x5555ff, 0x55ff55, 0x55ffff, 0xff5555, 0xff55ff, 0xffff55, 0xffffff,\r","    ],\r","    NES: [\r","      0x000000, 0x1d2b53, 0x7e2553, 0x008751, 0xab5236, 0x5f574f, 0xc2c3c7, 0xfff1e8,\r","      0xff004d, 0xffa300, 0xffec27, 0x00e436, 0x29adff, 0x83769c, 0xff77a8, 0xffccaa,\r","    ],\r","    Custom: [],\r","  };\r","\r","  const NUMERIC_SETTINGS = {\r","    'pixel height': 'targetHeight',\r","    'pixel scale': 'pixelScale',\r","    'color levels': 'colorLevels',\r","    'dither strength': 'dither',\r","    saturation: 'saturation',\r","    contrast: 'contrast',\r","    outline: 'outline',\r","    'outline threshold': 'outlineThreshold',\r","    'outline thickness': 'outlineThickness',\r","    'outline distance': 'outlineDistance',\r","    'crease threshold': 'creaseThreshold',\r","    'cel shading': 'cel',\r","    'cel bands': 'celBands',\r","    'cel softness': 'celSoftness',\r","    rim: 'rim',\r","    vignette: 'vignette',\r","    chromatic: 'chromatic',\r","    'palette size': 'paletteSize',\r","  };\r","\r","  const TOGGLE_SETTINGS = {\r","    dither: 'ditherEnabled',\r","    outline: 'outlineEnabled',\r","    'cel shading': 'celEnabled',\r","    'palette mapping': 'paletteEnabled',\r","    'colored outline': 'coloredOutline',\r","    'rim light': 'rimEnabled',\r","  };\r","\r","  function installPixel3D(gdjs, THREE, runtimeScene) {\r","    const log = (...args) => console.log('[Pixel3D]', ...args);\r","    const warn = (...args) => console.warn('[Pixel3D]', ...args);\r","    const num = (value, fallback) => {\r","      const n = typeof value === 'number' ? value : parseFloat(value);\r","      return Number.isFinite(n) ? n : fallback;\r","    };\r","    const clamp = (value, min, max) => (value < min ? min : value > max ? max : value);\r","    const bool = (value) => {\r","      if (typeof value === 'boolean') return value;\r","      const text = String(value === undefined || value === null ? '' : value).toLowerCase();\r","      return text === 'true' || text === 'yes' || text === '1' || text === 'on';\r","    };\r","    const normalize = (value) =>\r","      String(value === undefined || value === null ? '' : value).replace(/[\"']/g, '').trim().toLowerCase();\r","\r","    if (!THREE) {\r","      const stub = {\r","        version: VERSION,\r","        noThree: true,\r","        enable() { return false; },\r","        enableAll() { return 0; },\r","        disable() {},\r","        disableAll() {},\r","        setEnabled() {},\r","        setPreset() {},\r","        setNumber() {},\r","        setToggle() {},\r","        setPalette() {},\r","        setPaletteColor() {},\r","        resetDefaults() {},\r","        update() {},\r","        onSceneUnloading() {},\r","        isActiveOnLayer() { return false; },\r","        isEnabled() { return false; },\r","        isSupported() { return false; },\r","        getStats() { return { width: 0, height: 0, scale: 1 }; },\r","        getSettings() { return null; },\r","      };\r","      if (gdjs) gdjs.__pixel3D = stub;\r","      return stub;\r","    }\r","\r","    const tmpSize = new THREE.Vector2();\r","    const tmpSize2 = new THREE.Vector2();\r","    const scenes = new Set();\r","    const config = {\r","      persist: true,\r","      layers: new Map(),\r","    };\r","\r","    const isWebGPU = (renderer) =>\r","      !renderer ||\r","      !!renderer.isWebGPURenderer ||\r","      typeof THREE.WebGLRenderTarget !== 'function' ||\r","      typeof renderer.getDrawingBufferSize !== 'function';\r","\r","    // ------------------------------------------------------------ palettes\r","    const parseColor = (value) => {\r","      if (typeof value === 'number') {\r","        return [(value >> 16) & 255, (value >> 8) & 255, value & 255];\r","      }\r","      const text = String(value === undefined || value === null ? '' : value).trim();\r","      const hex = text.replace(/^#/, '');\r","      if (/^[0-9a-f]{6}$/i.test(hex)) {\r","        return [\r","          parseInt(hex.slice(0, 2), 16),\r","          parseInt(hex.slice(2, 4), 16),\r","          parseInt(hex.slice(4, 6), 16),\r","        ];\r","      }\r","      const parts = text.split(/[;,]/).map((part) => num(part, 0));\r","      return [clamp(parts[0] || 0, 0, 255), clamp(parts[1] || 0, 0, 255), clamp(parts[2] || 0, 0, 255)];\r","    };\r","    const srgbToLinear = (c) => (c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4));\r","    const linearToOklab = (r, g, b) => {\r","      const l = 0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b;\r","      const m = 0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b;\r","      const s = 0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b;\r","      const l3 = Math.cbrt(l);\r","      const m3 = Math.cbrt(m);\r","      const s3 = Math.cbrt(s);\r","      return [\r","        0.2104542553 * l3 + 0.793617785 * m3 - 0.0040720468 * s3,\r","        1.9779984951 * l3 - 2.428592205 * m3 + 0.4505937099 * s3,\r","        0.0259040371 * l3 + 0.7827717662 * m3 - 0.808675766 * s3,\r","      ];\r","    };\r","    const paletteLab = (colors) => {\r","      const result = [];\r","      for (let i = 0; i < 32; i++) {\r","        const color = colors[i] || 0;\r","        const r = srgbToLinear(((color >> 16) & 255) / 255);\r","        const g = srgbToLinear(((color >> 8) & 255) / 255);\r","        const b = srgbToLinear((color & 255) / 255);\r","        const lab = linearToOklab(r, g, b);\r","        result.push(new THREE.Vector3(lab[0], lab[1], lab[2]));\r","      }\r","      return result;\r","    };\r","    const makePaletteTexture = (colors) => {\r","      const data = new Uint8Array(32 * 4);\r","      for (let i = 0; i < 32; i++) {\r","        const color = colors[i] || 0;\r","        data[i * 4] = (color >> 16) & 255;\r","        data[i * 4 + 1] = (color >> 8) & 255;\r","        data[i * 4 + 2] = color & 255;\r","        data[i * 4 + 3] = 255;\r","      }\r","      const texture = new THREE.DataTexture(data, 32, 1, THREE.RGBAFormat);\r","      texture.minFilter = THREE.NearestFilter;\r","      texture.magFilter = THREE.NearestFilter;\r","      texture.wrapS = THREE.ClampToEdgeWrapping;\r","      texture.wrapT = THREE.ClampToEdgeWrapping;\r","      texture.generateMipmaps = false;\r","      texture.colorSpace = THREE.NoColorSpace;\r","      texture.needsUpdate = true;\r","      return texture;\r","    };\r","\r","    // ------------------------------------------------------------ settings\r","    const freshSettings = (base) => {\r","      const settings = Object.assign({}, DEFAULTS, base || {});\r","      settings.paletteEnabled = settings.palette !== 'None';\r","      settings.outlineEnabled = settings.outline > 0;\r","      settings.celEnabled = settings.cel > 0;\r","      settings.rimEnabled = settings.rim > 0;\r","      settings.paletteColors = settings.paletteColors ? settings.paletteColors.slice() : null;\r","      settings.active = !!settings.active;\r","      return settings;\r","    };\r","    const applyPresetTo = (settings, presetName) => {\r","      const key = Object.keys(PRESETS).find((name) => name.toLowerCase() === normalize(presetName));\r","      if (!key) {\r","        warn('Unknown preset \"' + presetName + '\".');\r","        return false;\r","      }\r","      Object.assign(settings, PRESETS[key]);\r","      settings.preset = key;\r","      settings.paletteEnabled = settings.palette !== 'None';\r","      settings.outlineEnabled = settings.outline > 0;\r","      settings.celEnabled = settings.cel > 0;\r","      settings.rimEnabled = settings.rim > 0;\r","      if (settings.palette !== 'Custom' && PALETTES[settings.palette]) {\r","        settings.paletteColors = PALETTES[settings.palette].slice();\r","      }\r","      return true;\r","    };\r","    const getSavedSettings = (layerName) => {\r","      if (!config.layers.has(layerName)) config.layers.set(layerName, freshSettings());\r","      return config.layers.get(layerName);\r","    };\r","    const applySettings = (state) => {\r","      const settings = state.settings;\r","      state.paletteTextureDirty = true;\r","      state.sizeDirty = true;\r","    };\r","\r","    // ------------------------------------------------------------ shaders\r","    const HEAVY_FRAGMENT = `\r","precision highp float;\r","\r","uniform sampler2D tDiffuse;\r","uniform sampler2D tDepth;\r","uniform sampler2D uPalette;\r","uniform vec2 uSrcSize;\r","uniform vec2 uOutSize;\r","uniform float uLevels;\r","uniform float uDither;\r","uniform float uSaturation;\r","uniform float uContrast;\r","uniform float uOutline;\r","uniform float uOutlineThreshold;\r","uniform float uCrease;\r","uniform float uOutlineThickness;\r","uniform float uOutlineDistance;\r","uniform float uColoredOutline;\r","uniform float uCel;\r","uniform float uCelBands;\r","uniform float uCelSoftness;\r","uniform float uRim;\r","uniform vec3 uRimColor;\r","uniform float uVignette;\r","uniform float uChromatic;\r","uniform float uNear;\r","uniform float uFar;\r","uniform float uIsOrtho;\r","uniform float uAspect;\r","uniform float uTanHalfFov;\r","uniform vec2 uOrthoSize;\r","uniform float uHasDepth;\r","uniform int uPaletteCount;\r","uniform vec3 uPaletteLab[32];\r","\r","varying vec2 vUv;\r","\r","float bayer2(vec2 a) { a = floor(a); return fract(a.x / 2.0 + a.y * a.y * 0.75); }\r","float bayer4(vec2 a) { return bayer2(0.5 * a) * 0.25 + bayer2(a); }\r","\r","vec3 srgbToLinear(vec3 c) {\r","  c = max(c, vec3(0.0));\r","  return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));\r","}\r","vec3 linearToSrgb(vec3 c) {\r","  c = max(c, vec3(0.0));\r","  return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));\r","}\r","vec3 linearToOklab(vec3 c) {\r","  float l = 0.4122214708 * c.r + 0.5363325363 * c.g + 0.0514459929 * c.b;\r","  float m = 0.2119034982 * c.r + 0.6806995451 * c.g + 0.1073969566 * c.b;\r","  float s = 0.0883024619 * c.r + 0.2817188376 * c.g + 0.6299787005 * c.b;\r","  l = pow(max(l, 0.0), 1.0 / 3.0);\r","  m = pow(max(m, 0.0), 1.0 / 3.0);\r","  s = pow(max(s, 0.0), 1.0 / 3.0);\r","  return vec3(\r","    0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,\r","    1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,\r","    0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s\r","  );\r","}\r","vec3 oklabToLinear(vec3 lab) {\r","  float l = lab.x + 0.3963377774 * lab.y + 0.2158037573 * lab.z;\r","  float m = lab.x - 0.1055613458 * lab.y - 0.0638541728 * lab.z;\r","  float s = lab.x - 0.0894841775 * lab.y - 1.2914855480 * lab.z;\r","  l = l * l * l; m = m * m * m; s = s * s * s;\r","  return vec3(\r","    4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,\r","   -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,\r","   -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s\r","  );\r","}\r","\r","float linearZ(float d) {\r","  if (uIsOrtho > 0.5) return uNear + d * (uFar - uNear);\r","  float z = d * 2.0 - 1.0;\r","  return (2.0 * uNear * uFar) / (uFar + uNear - z * (uFar - uNear));\r","}\r","vec3 viewPosition(vec2 uv) {\r","  float d = linearZ(texture2D(tDepth, clamp(uv, vec2(0.0), vec2(1.0))).r);\r","  float z = -d;\r","  if (uIsOrtho > 0.5) {\r","    return vec3((uv * 2.0 - 1.0) * uOrthoSize, z);\r","  }\r","  float y = (uv.y * 2.0 - 1.0) * d * uTanHalfFov;\r","  float x = (uv.x * 2.0 - 1.0) * d * uTanHalfFov * uAspect;\r","  return vec3(x, y, z);\r","}\r","vec3 normalAt(vec2 uv, vec2 o) {\r","  vec3 pL = viewPosition(uv - vec2(o.x, 0.0));\r","  vec3 pR = viewPosition(uv + vec2(o.x, 0.0));\r","  vec3 pD = viewPosition(uv - vec2(0.0, o.y));\r","  vec3 pU = viewPosition(uv + vec2(0.0, o.y));\r","  vec3 n = cross(pR - pL, pU - pD);\r","  float len = length(n);\r","  if (len < 0.000001) return vec3(0.0, 0.0, 1.0);\r","  n /= len;\r","  return n.z < 0.0 ? -n : n;\r","}\r","float invDepth(vec2 uv) {\r","  return 1.0 / max(linearZ(texture2D(tDepth, clamp(uv, vec2(0.0), vec2(1.0))).r), 0.0001);\r","}\r","float depthSilhouette(vec2 uv, vec2 o) {\r","  float c = invDepth(uv);\r","  float lf = invDepth(uv + vec2(-o.x, 0.0));\r","  float rg = invDepth(uv + vec2(o.x, 0.0));\r","  float up = invDepth(uv + vec2(0.0, o.y));\r","  float dn = invDepth(uv + vec2(0.0, -o.y));\r","  float lap = (lf + rg + up + dn) - 4.0 * c;\r","  return step(uOutlineThreshold, -lap / max(c, 0.0001));\r","}\r","float creaseEdge(vec2 uv, vec2 o) {\r","  vec3 n = normalAt(uv, o);\r","  float d = max(\r","    max(1.0 - dot(n, normalAt(uv + vec2(o.x, 0.0), o)), 1.0 - dot(n, normalAt(uv - vec2(o.x, 0.0), o))),\r","    max(1.0 - dot(n, normalAt(uv + vec2(0.0, o.y), o)), 1.0 - dot(n, normalAt(uv - vec2(0.0, o.y), o)))\r","  );\r","  return smoothstep(uCrease, uCrease + 0.2, d);\r","}\r","\r","void main() {\r","  vec2 pix = floor(gl_FragCoord.xy);\r","  vec2 uvc = (pix + 0.5) / uSrcSize;\r","  vec2 dir = uvc - 0.5;\r","  vec2 off = dir * dot(dir, dir) * uChromatic;\r","\r","  vec4 base = texture2D(tDiffuse, uvc);\r","  if (uChromatic > 0.0) {\r","    base.r = texture2D(tDiffuse, clamp(uvc + off, 0.0, 1.0)).r;\r","    base.b = texture2D(tDiffuse, clamp(uvc - off, 0.0, 1.0)).b;\r","  }\r","  float alpha = clamp(base.a, 0.0, 1.0);\r","  vec3 premulLinear = srgbToLinear(base.rgb);\r","  vec3 lin = alpha > 0.00001 ? premulLinear / alpha : vec3(0.0);\r","\r","  if (uHasDepth > 0.5 && uRim > 0.0) {\r","    vec3 n = normalAt(uvc, vec2(1.0) / uSrcSize);\r","    float rim = pow(1.0 - clamp(dot(n, normalize(-viewPosition(uvc))), 0.0, 1.0), 2.0);\r","    lin += uRimColor * rim * uRim;\r","  }\r","\r","  vec3 lab = linearToOklab(max(lin, vec3(0.0)));\r","  lab.yz *= uSaturation;\r","  lab.x = (lab.x - 0.5) * uContrast + 0.5;\r","  lab.x = clamp(lab.x, 0.0, 1.0);\r","\r","  if (uCel > 0.0) {\r","    float band = floor(lab.x * uCelBands + 0.5) / uCelBands;\r","    lab.x = mix(lab.x, mix(band, lab.x, uCelSoftness), uCel);\r","  }\r","\r","  float bayer = bayer4(pix);\r","  float dither = (bayer - 0.5) * uDither;\r","  vec3 straight;\r","\r","  if (uPaletteCount > 0) {\r","    int nearest = 0;\r","    int second = 0;\r","    float best = 1e20;\r","    float next = 1e20;\r","    for (int i = 0; i < 32; i++) {\r","      if (i >= uPaletteCount) break;\r","      vec3 delta = lab - uPaletteLab[i];\r","      float distance = dot(delta, delta);\r","      if (distance < best) {\r","        next = best;\r","        second = nearest;\r","        best = distance;\r","        nearest = i;\r","      } else if (distance < next) {\r","        next = distance;\r","        second = i;\r","      }\r","    }\r","    vec3 c0 = uPaletteLab[nearest];\r","    vec3 c1 = uPaletteLab[second];\r","    vec3 axis = c1 - c0;\r","    float denom = dot(axis, axis);\r","    float t = denom > 0.000001 ? clamp(dot(lab - c0, axis) / denom, 0.0, 1.0) : 0.0;\r","    float threshold = mix(0.5, bayer, uDither);\r","    int chosen = t > threshold ? second : nearest;\r","    vec3 paletteSrgb = texture2D(uPalette, vec2((float(chosen) + 0.5) / 32.0, 0.5)).rgb;\r","    straight = paletteSrgb;\r","  } else {\r","    float steps = max(uLevels - 1.0, 1.0);\r","    lab.x = clamp(floor(lab.x * steps + 0.5 + dither) / steps, 0.0, 1.0);\r","    float chroma = length(lab.yz);\r","    float hue = atan(lab.y, lab.z);\r","    chroma = clamp(floor(chroma * steps + 0.5 + dither) / steps, 0.0, 0.8);\r","    lab.yz = vec2(sin(hue), cos(hue)) * chroma;\r","    straight = linearToSrgb(oklabToLinear(lab));\r","  }\r","\r","  straight = clamp(straight, 0.0, 1.0);\r","  float vd = length(dir) * 1.41421356;\r","  straight *= 1.0 - smoothstep(0.35, 1.05, vd) * uVignette;\r","\r","  if (uHasDepth > 0.5 && uOutline > 0.0) {\r","    vec2 o = (uOutlineThickness / uSrcSize) * (1.0 + uOutlineDistance * clamp(linearZ(texture2D(tDepth, uvc).r) / max(uFar, 0.001), 0.0, 1.0));\r","    float edge = depthSilhouette(uvc, o);\r","    edge = max(edge, creaseEdge(uvc, o));\r","    vec3 dark = mix(vec3(0.0), straight * 0.22, uColoredOutline);\r","    straight = mix(straight, dark, clamp(edge * uOutline, 0.0, 1.0));\r","  }\r","\r","  gl_FragColor = vec4(straight * alpha, alpha);\r","}\r","`;\r","\r","    const OUTPUT_FRAGMENT = `\r","precision highp float;\r","uniform sampler2D tSrc;\r","uniform vec2 uSrcSize;\r","uniform vec2 uOutSize;\r","uniform float uUpscale;\r","varying vec2 vUv;\r","void main() {\r","  vec2 uv = vUv;\r","  if (uUpscale > 0.5) {\r","    vec2 pix = floor(gl_FragCoord.xy * uSrcSize / uOutSize);\r","    uv = (pix + 0.5) / uSrcSize;\r","  }\r","  gl_FragColor = texture2D(tSrc, uv);\r","}\r","`;\r","\r","    const VERTEX = `\r","varying vec2 vUv;\r","void main() {\r","  vUv = uv;\r","  gl_Position = vec4(position.xy, 0.0, 1.0);\r","}\r","`;\r","\r","    // ------------------------------------------------------------ pass\r","    class PixelPass {\r","      constructor(state) {\r","        this.state = state;\r","        this.isPass = true;\r","        this.enabled = true;\r","        this.needsSwap = true;\r","        this.clear = false;\r","        this.renderToScreen = false;\r","        this.__pixel3DPass = true;\r","\r","        this.scene = new THREE.Scene();\r","        this.camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);\r","        this.geometry = new THREE.PlaneGeometry(2, 2);\r","        this.mesh = new THREE.Mesh(this.geometry, null);\r","        this.mesh.frustumCulled = false;\r","        this.scene.add(this.mesh);\r","\r","        this.heavyMaterial = new THREE.ShaderMaterial({\r","          vertexShader: VERTEX,\r","          fragmentShader: HEAVY_FRAGMENT,\r","          depthTest: false,\r","          depthWrite: false,\r","          blending: THREE.NoBlending,\r","          uniforms: {\r","            tDiffuse: { value: null },\r","            tDepth: { value: null },\r","            uPalette: { value: null },\r","            uSrcSize: { value: new THREE.Vector2(1, 1) },\r","            uOutSize: { value: new THREE.Vector2(1, 1) },\r","            uLevels: { value: 24 },\r","            uDither: { value: 0.75 },\r","            uSaturation: { value: 1.05 },\r","            uContrast: { value: 1 },\r","            uOutline: { value: 1.1 },\r","            uOutlineThreshold: { value: 0.08 },\r","            uCrease: { value: 0.35 },\r","            uOutlineThickness: { value: 1 },\r","            uOutlineDistance: { value: 0.15 },\r","            uColoredOutline: { value: 1 },\r","            uCel: { value: 0 },\r","            uCelBands: { value: 4 },\r","            uCelSoftness: { value: 0.1 },\r","            uRim: { value: 0 },\r","            uRimColor: { value: new THREE.Vector3(1, 1, 1) },\r","            uVignette: { value: 0.12 },\r","            uChromatic: { value: 0 },\r","            uNear: { value: 0.1 },\r","            uFar: { value: 1000 },\r","            uIsOrtho: { value: 0 },\r","            uAspect: { value: 1 },\r","            uTanHalfFov: { value: 0.4 },\r","            uOrthoSize: { value: new THREE.Vector2(1, 1) },\r","            uHasDepth: { value: 0 },\r","            uPaletteCount: { value: 0 },\r","            uPaletteLab: { value: paletteLab([]) },\r","          },\r","        });\r","\r","        this.outputMaterial = new THREE.ShaderMaterial({\r","          vertexShader: VERTEX,\r","          fragmentShader: OUTPUT_FRAGMENT,\r","          depthTest: false,\r","          depthWrite: false,\r","          blending: THREE.NoBlending,\r","          uniforms: {\r","            tSrc: { value: null },\r","            uSrcSize: { value: new THREE.Vector2(1, 1) },\r","            uOutSize: { value: new THREE.Vector2(1, 1) },\r","            uUpscale: { value: 1 },\r","          },\r","        });\r","\r","        this.pixelRT = null;\r","        this.pixelRTWidth = 0;\r","        this.pixelRTHeight = 0;\r","        this.whiteDepth = new THREE.DataTexture(\r","          new Uint8Array([255, 255, 255, 255]),\r","          1,\r","          1,\r","          THREE.RGBAFormat\r","        );\r","        this.whiteDepth.needsUpdate = true;\r","        this.stats = { width: 0, height: 0, scale: 1 };\r","      }\r","\r","      setSize() {\r","        /* The source size follows the composer's read buffer every frame. */\r","      }\r","\r","      ensureRT(width, height) {\r","        if (this.pixelRT && this.pixelRTWidth === width && this.pixelRTHeight === height) return;\r","        if (this.pixelRT) this.pixelRT.dispose();\r","        this.pixelRT = new THREE.WebGLRenderTarget(width, height, {\r","          type: THREE.UnsignedByteType,\r","          format: THREE.RGBAFormat,\r","          minFilter: THREE.NearestFilter,\r","          magFilter: THREE.NearestFilter,\r","          depthBuffer: false,\r","          stencilBuffer: false,\r","          generateMipmaps: false,\r","        });\r","        this.pixelRT.texture.colorSpace = THREE.NoColorSpace;\r","        this.pixelRT.texture.generateMipmaps = false;\r","        this.pixelRTWidth = width;\r","        this.pixelRTHeight = height;\r","      }\r","\r","      updatePalette() {\r","        const state = this.state;\r","        const settings = state.settings;\r","        const colors = settings.paletteEnabled\r","          ? settings.paletteColors || (PALETTES[settings.palette] || [])\r","          : [];\r","        const count = Math.min(32, settings.paletteSize > 0 ? Math.min(settings.paletteSize, colors.length) : colors.length);\r","        if (state.paletteTextureDirty) {\r","          if (state.paletteTexture) state.paletteTexture.dispose();\r","          state.paletteTexture = makePaletteTexture(colors);\r","          state.paletteLab = paletteLab(colors);\r","          state.paletteTextureDirty = false;\r","        }\r","        const uniforms = this.heavyMaterial.uniforms;\r","        uniforms.uPalette.value = state.paletteTexture;\r","        uniforms.uPaletteCount.value = count;\r","        uniforms.uPaletteLab.value = state.paletteLab;\r","      }\r","\r","      render(renderer, writeBuffer, readBuffer) {\r","        const state = this.state;\r","        const settings = state.settings;\r","        if (!readBuffer || !readBuffer.texture) return;\r","        const srcW = Math.max(1, Math.round(readBuffer.width));\r","        const srcH = Math.max(1, Math.round(readBuffer.height));\r","        this.ensureRT(srcW, srcH);\r","\r","        const camera = state.lr.getThreeCamera ? state.lr.getThreeCamera() : null;\r","        const uniforms = this.heavyMaterial.uniforms;\r","        uniforms.tDiffuse.value = readBuffer.texture;\r","        uniforms.uSrcSize.value.set(srcW, srcH);\r","        this.updatePalette();\r","\r","        let depthTexture = null;\r","        try {\r","          if (state.lr.getSceneDepthTexture) depthTexture = state.lr.getSceneDepthTexture();\r","        } catch (error) {\r","          depthTexture = null;\r","        }\r","        const hasDepth = !!depthTexture && depthTexture.isTexture;\r","        uniforms.tDepth.value = hasDepth ? depthTexture : this.whiteDepth;\r","        uniforms.uHasDepth.value = hasDepth ? 1 : 0;\r","\r","        if (camera) {\r","          uniforms.uNear.value = camera.near;\r","          uniforms.uFar.value = camera.far;\r","          uniforms.uIsOrtho.value = camera.isOrthographicCamera ? 1 : 0;\r","          uniforms.uAspect.value = camera.isPerspectiveCamera\r","            ? camera.aspect\r","            : (camera.right - camera.left) / Math.max(camera.top - camera.bottom, 1e-5);\r","          if (camera.isPerspectiveCamera) {\r","            uniforms.uTanHalfFov.value = Math.tan(THREE.MathUtils.degToRad(camera.fov) * 0.5);\r","          } else {\r","            uniforms.uOrthoSize.value.set(\r","              (camera.right - camera.left) * 0.5,\r","              (camera.top - camera.bottom) * 0.5\r","            );\r","          }\r","        }\r","\r","        uniforms.uLevels.value = Math.max(2, settings.colorLevels);\r","        uniforms.uDither.value = settings.ditherEnabled ? clamp(settings.dither, 0, 1) : 0;\r","        uniforms.uSaturation.value = settings.saturation;\r","        uniforms.uContrast.value = settings.contrast;\r","        uniforms.uOutline.value = settings.outlineEnabled ? settings.outline : 0;\r","        uniforms.uOutlineThreshold.value = settings.outlineThreshold;\r","        uniforms.uCrease.value = settings.creaseThreshold;\r","        uniforms.uOutlineThickness.value = settings.outlineThickness;\r","        uniforms.uOutlineDistance.value = settings.outlineDistance;\r","        uniforms.uColoredOutline.value = settings.coloredOutline ? 1 : 0;\r","        uniforms.uCel.value = settings.celEnabled ? settings.cel : 0;\r","        uniforms.uCelBands.value = Math.max(2, Math.round(settings.celBands));\r","        uniforms.uCelSoftness.value = clamp(settings.celSoftness, 0, 1);\r","        uniforms.uRim.value = settings.rimEnabled ? settings.rim : 0;\r","        uniforms.uVignette.value = clamp(settings.vignette, 0, 1);\r","        uniforms.uChromatic.value = Math.max(0, settings.chromatic);\r","\r","        const previousTarget = renderer.getRenderTarget();\r","        const previousAutoClear = renderer.autoClear;\r","        renderer.autoClear = false;\r","\r","        this.mesh.material = this.heavyMaterial;\r","        renderer.setRenderTarget(this.pixelRT);\r","        renderer.render(this.scene, this.camera);\r","\r","        const out = renderer.getDrawingBufferSize(tmpSize);\r","        const toScreen = !!this.renderToScreen;\r","        const outMat = this.outputMaterial;\r","        outMat.uniforms.tSrc.value = this.pixelRT.texture;\r","        outMat.uniforms.uSrcSize.value.set(srcW, srcH);\r","        outMat.uniforms.uUpscale.value = toScreen ? 1 : 0;\r","        if (toScreen) {\r","          outMat.uniforms.uOutSize.value.set(\r","            Math.max(1, Math.round(out.x)),\r","            Math.max(1, Math.round(out.y))\r","          );\r","          outMat.blending = THREE.CustomBlending;\r","          outMat.blendEquation = THREE.AddEquation;\r","          outMat.blendSrc = THREE.OneFactor;\r","          outMat.blendDst = THREE.OneMinusSrcAlphaFactor;\r","          outMat.transparent = true;\r","          renderer.setRenderTarget(null);\r","        } else {\r","          outMat.uniforms.uOutSize.value.set(srcW, srcH);\r","          outMat.blending = THREE.NoBlending;\r","          outMat.transparent = false;\r","          renderer.setRenderTarget(writeBuffer);\r","          if (renderer.clear) renderer.clear(true, false, false);\r","        }\r","        this.mesh.material = outMat;\r","        renderer.render(this.scene, this.camera);\r","\r","        renderer.autoClear = previousAutoClear;\r","        renderer.setRenderTarget(previousTarget);\r","\r","        this.stats.width = srcW;\r","        this.stats.height = srcH;\r","        this.stats.scale = Math.max(\r","          1,\r","          Math.round(Math.max(1, out.y) / Math.max(1, srcH))\r","        );\r","      }\r","\r","      dispose() {\r","        if (this.pixelRT) this.pixelRT.dispose();\r","        this.pixelRT = null;\r","        this.heavyMaterial.dispose();\r","        this.outputMaterial.dispose();\r","        this.geometry.dispose();\r","        this.whiteDepth.dispose();\r","      }\r","    }\r","\r","    // ------------------------------------------------------------ composer/order\r","    const findOutputPass = (composer) => {\r","      if (!composer || !composer.passes) return null;\r","      for (let i = composer.passes.length - 1; i >= 0; i--) {\r","        if (composer.passes[i] && composer.passes[i].isOutputPass) return composer.passes[i];\r","      }\r","      return null;\r","    };\r","    const computeScale = (settings, outputHeight) => {\r","      if (settings.pixelScale > 0) return clamp(Math.round(settings.pixelScale), 1, 32);\r","      return clamp(Math.max(1, Math.round(outputHeight / Math.max(1, settings.targetHeight))), 1, 32);\r","    };\r","    const patchComposer = (state) => {\r","      const composer = state.composer;\r","      if (!composer || composer.__pixel3DPatched) return;\r","      const baseSetSize = composer.setSize;\r","      composer.__pixel3DBaseSetSize = baseSetSize;\r","      composer.__pixel3DState = state;\r","      composer.__pixel3DPatched = true;\r","      composer.setSize = function (width, height) {\r","        const st = this.__pixel3DState;\r","        if (!st || !st.enabled) return baseSetSize.call(this, width, height);\r","        const out = this.renderer.getDrawingBufferSize(tmpSize);\r","        const scale = computeScale(st.settings, out.y);\r","        const ew = Math.max(1, Math.floor(out.x / scale));\r","        const eh = Math.max(1, Math.floor(out.y / scale));\r","        const pr = this._pixelRatio > 0 ? this._pixelRatio : 1;\r","        this._width = ew / pr;\r","        this._height = eh / pr;\r","        baseSetSize.call(this, this._width, this._height);\r","        this._width = width;\r","        this._height = height;\r","      };\r","    };\r","    const unpatchComposer = (state) => {\r","      const composer = state.composer;\r","      if (!composer || !composer.__pixel3DPatched) return;\r","      if (composer.__pixel3DBaseSetSize) composer.setSize = composer.__pixel3DBaseSetSize;\r","      delete composer.__pixel3DBaseSetSize;\r","      delete composer.__pixel3DState;\r","      delete composer.__pixel3DPatched;\r","    };\r","    const applyComposerSize = (state) => {\r","      const composer = state.composer;\r","      if (!composer) return;\r","      const size = composer.renderer.getSize(tmpSize2);\r","      composer.setSize(size.x, size.y);\r","      state.sizeDirty = false;\r","    };\r","    const reorderPass = (state) => {\r","      const composer = state.composer;\r","      const pass = state.pass;\r","      if (!composer || !pass || !composer.passes) return;\r","      const passes = composer.passes;\r","      const current = passes.indexOf(pass);\r","      if (current === -1) return;\r","      let outputIndex = -1;\r","      for (let i = passes.length - 1; i >= 0; i--) {\r","        if (passes[i] && passes[i].isOutputPass) {\r","          outputIndex = i;\r","          break;\r","        }\r","      }\r","      if (outputIndex === -1) {\r","        // No OutputPass (should not happen on a 3D layer): keep the pass last\r","        // if it is already last, otherwise append it.\r","        if (current !== passes.length - 1) {\r","          passes.splice(current, 1);\r","          passes.push(pass);\r","        }\r","        return;\r","      }\r","      if (current === outputIndex + 1) return;\r","      passes.splice(current, 1);\r","      let insert = -1;\r","      for (let i = passes.length - 1; i >= 0; i--) {\r","        if (passes[i] && passes[i].isOutputPass) {\r","          insert = i;\r","          break;\r","        }\r","      }\r","      passes.splice(insert + 1, 0, pass);\r","    };\r","    const patchOrder = (state) => {\r","      const lr = state.lr;\r","      if (!lr || !lr.updatePostProcessingPassesOrder) return;\r","      if (!lr.__pixel3DBaseOrder) {\r","        lr.__pixel3DBaseOrder = lr.updatePostProcessingPassesOrder;\r","        lr.__pixel3DState = state;\r","        lr.updatePostProcessingPassesOrder = function () {\r","          this.__pixel3DBaseOrder.call(this);\r","          const st = this.__pixel3DState;\r","          if (st && st.pass) reorderPass(st);\r","        };\r","      } else {\r","        lr.__pixel3DState = state;\r","      }\r","    };\r","    const unpatchOrder = (state) => {\r","      const lr = state.lr;\r","      if (!lr || !lr.__pixel3DBaseOrder) return;\r","      lr.updatePostProcessingPassesOrder = lr.__pixel3DBaseOrder;\r","      delete lr.__pixel3DBaseOrder;\r","      delete lr.__pixel3DState;\r","    };\r","    const prepareOutputPass = (state) => {\r","      const op = findOutputPass(state.composer);\r","      if (!op || !op.material) return;\r","      if (state.outputPass !== op) {\r","        state.outputPass = op;\r","        state.outputSaved = {\r","          blending: op.material.blending,\r","          blendSrc: op.material.blendSrc,\r","          blendDst: op.material.blendDst,\r","          blendEquation: op.material.blendEquation,\r","          blendSrcAlpha: op.material.blendSrcAlpha,\r","          blendDstAlpha: op.material.blendDstAlpha,\r","          blendEquationAlpha: op.material.blendEquationAlpha,\r","          transparent: op.material.transparent,\r","          depthTest: op.material.depthTest,\r","          depthWrite: op.material.depthWrite,\r","        };\r","      }\r","      op.material.blending = THREE.NoBlending;\r","      op.material.transparent = false;\r","    };\r","    const restoreOutputPass = (state) => {\r","      const op = state.outputPass;\r","      const saved = state.outputSaved;\r","      state.outputPass = null;\r","      state.outputSaved = null;\r","      if (!op || !op.material || !saved) return;\r","      op.material.blending = saved.blending;\r","      op.material.blendSrc = saved.blendSrc;\r","      op.material.blendDst = saved.blendDst;\r","      op.material.blendEquation = saved.blendEquation;\r","      op.material.blendSrcAlpha = saved.blendSrcAlpha;\r","      op.material.blendDstAlpha = saved.blendDstAlpha;\r","      op.material.blendEquationAlpha = saved.blendEquationAlpha;\r","      op.material.transparent = saved.transparent;\r","      op.material.depthTest = saved.depthTest;\r","      op.material.depthWrite = saved.depthWrite;\r","    };\r","\r","    // ------------------------------------------------------------ FSR cooperation\r","    const fsrStateOnLayer = (scene, layerName) => {\r","      const fsr = gdjs.__fsr1;\r","      if (!fsr || !fsr.getState) return null;\r","      try {\r","        return fsr.getState(scene, layerName) || null;\r","      } catch (error) {\r","        return null;\r","      }\r","    };\r","    const disableFSROnLayer = (scene, layerName) => {\r","      const fsr = gdjs.__fsr1;\r","      if (!fsr || !fsr.disable) return;\r","      try {\r","        if (fsrStateOnLayer(scene, layerName)) fsr.disable(scene, layerName);\r","      } catch (error) {}\r","    };\r","\r","    // ------------------------------------------------------------ layer access\r","    const getLayerAndComposer = (scene, layerName) => {\r","      let layer = null;\r","      try {\r","        layer = scene.getLayer(layerName || '');\r","      } catch (error) {\r","        return null;\r","      }\r","      if (!layer || !layer.getRenderer) return null;\r","      let lr = null;\r","      try {\r","        lr = layer.getRenderer();\r","      } catch (error) {\r","        return null;\r","      }\r","      if (!lr || !lr.getThreeEffectComposer) return null;\r","      let composer = null;\r","      try {\r","        composer = lr.getThreeEffectComposer();\r","      } catch (error) {\r","        return null;\r","      }\r","      if (!composer || !composer.passes) return null;\r","      return { layer, lr, composer };\r","    };\r","    const layerNameOf = (layer, fallback) => {\r","      try {\r","        return layer && layer.getName ? layer.getName() : fallback || '';\r","      } catch (error) {\r","        return fallback || '';\r","      }\r","    };\r","\r","    // ------------------------------------------------------------ state\r","    const getSceneState = (scene, create) => {\r","      if (!scene) return null;\r","      let state = scene.__pixel3dRuntime;\r","      if (!state && create) {\r","        state = { scene, layers: new Map(), frame: 0 };\r","        scene.__pixel3dRuntime = state;\r","      }\r","      return state || null;\r","    };\r","    const createState = (scene, layerName, layer, lr, composer, settings) => ({\r","      scene,\r","      layerName,\r","      layer,\r","      lr,\r","      composer,\r","      settings,\r","      enabled: false,\r","      pass: null,\r","      paletteTexture: null,\r","      paletteLab: null,\r","      paletteTextureDirty: true,\r","      sizeDirty: true,\r","      outputPass: null,\r","      outputSaved: null,\r","      depthRequested: false,\r","      lastFSRCheck: 0,\r","    });\r","    const disposeState = (state, restoreSize) => {\r","      if (!state) return;\r","      state.enabled = false;\r","      if (state.lr && state.pass && state.lr.removePostProcessingPass) {\r","        try {\r","          state.lr.removePostProcessingPass(state.pass);\r","        } catch (error) {}\r","      }\r","      if (state.composer && state.pass) {\r","        try {\r","          const index = state.composer.passes.indexOf(state.pass);\r","          if (index !== -1) state.composer.passes.splice(index, 1);\r","        } catch (error) {}\r","      }\r","      if (state.depthRequested && state.lr && state.lr.setSceneDepthTextureNeeded) {\r","        try {\r","          state.lr.setSceneDepthTextureNeeded(false);\r","        } catch (error) {}\r","      }\r","      state.depthRequested = false;\r","      restoreOutputPass(state);\r","      unpatchOrder(state);\r","      unpatchComposer(state);\r","      if (state.pass) {\r","        try {\r","          state.pass.dispose();\r","        } catch (error) {}\r","        state.pass = null;\r","      }\r","      if (state.paletteTexture) {\r","        state.paletteTexture.dispose();\r","        state.paletteTexture = null;\r","      }\r","      state.paletteLab = null;\r","      if (restoreSize && state.composer) {\r","        try {\r","          const size = state.composer.renderer.getSize(tmpSize2);\r","          state.composer.setSize(size.x, size.y);\r","        } catch (error) {}\r","      }\r","    };\r","\r","    const installPass = (state) => {\r","      if (state.enabled) return true;\r","      const lr = state.lr;\r","      const composer = state.composer;\r","      if (!lr || !composer || !lr.addPostProcessingPass) return false;\r","      patchOrder(state);\r","      patchComposer(state);\r","      state.pass = new PixelPass(state);\r","      state.enabled = true;\r","      lr.addPostProcessingPass(state.pass, 'Pixel3D');\r","      prepareOutputPass(state);\r","      reorderPass(state);\r","      if (lr.setSceneDepthTextureNeeded) {\r","        try {\r","          lr.setSceneDepthTextureNeeded(true);\r","          state.depthRequested = true;\r","        } catch (error) {}\r","      }\r","      applyComposerSize(state);\r","      reorderPass(state);\r","      prepareOutputPass(state);\r","      state.settings.active = true;\r","      return true;\r","    };\r","\r","    const applyStateSize = (state) => {\r","      if (!state.enabled) return;\r","      applyComposerSize(state);\r","      reorderPass(state);\r","      prepareOutputPass(state);\r","    };\r","\r","    // ------------------------------------------------------------ public API\r","    const getStateFor = (scene, layerName) => {\r","      const sceneState = getSceneState(scene, false);\r","      if (!sceneState) return null;\r","      return sceneState.layers.get(layerName || '') || null;\r","    };\r","    const getOrCreateSettings = (layerName) => getSavedSettings(layerName || '');\r","    const saveSettings = (layerName, settings) => {\r","      if (config.persist) config.layers.set(layerName || '', settings);\r","    };\r","\r","    const enable = (scene, layerName, preset) => {\r","      try {\r","        layerName = layerName || '';\r","        const sceneState = getSceneState(scene, true);\r","        const existing = sceneState.layers.get(layerName);\r","        if (existing && existing.enabled) {\r","          if (preset) {\r","            applyPresetTo(existing.settings, preset);\r","            applySettings(existing);\r","            applyStateSize(existing);\r","          }\r","          return true;\r","        }\r","        const found = getLayerAndComposer(scene, layerName);\r","        if (!found) {\r","          warn(\r","            'Layer \"' +\r","              layerName +\r","              '\" has no 3D effect composer. Put the effect on a 3D layer of a project that uses Three.js.'\r","          );\r","          return false;\r","        }\r","        if (isWebGPU(found.composer.renderer)) {\r","          warn('Pixel 3D needs a WebGLRenderer; WebGPU is not supported by this build.');\r","          return false;\r","        }\r","        disableFSROnLayer(scene, layerName);\r","        const settings = existing ? existing.settings : getSavedSettings(layerName);\r","        if (preset) applyPresetTo(settings, preset);\r","        settings.preset = preset ? settings.preset : settings.preset || 'Custom';\r","        const state = existing || createState(scene, layerName, found.layer, found.lr, found.composer, settings);\r","        state.layer = found.layer;\r","        state.lr = found.lr;\r","        state.composer = found.composer;\r","        state.settings = settings;\r","        state.paletteTextureDirty = true;\r","        settings.active = true;\r","        sceneState.layers.set(layerName, state);\r","        saveSettings(layerName, settings);\r","        if (!installPass(state)) return false;\r","        log('Enabled on layer \"' + layerName + '\" (' + settings.preset + ').');\r","        return true;\r","      } catch (error) {\r","        warn('Unable to enable:', error);\r","        return false;\r","      }\r","    };\r","\r","    const disable = (scene, layerName) => {\r","      layerName = layerName || '';\r","      const sceneState = getSceneState(scene, false);\r","      if (!sceneState) return;\r","      const state = sceneState.layers.get(layerName);\r","      if (!state) return;\r","      disposeState(state, true);\r","      state.settings.active = false;\r","      saveSettings(layerName, state.settings);\r","      sceneState.layers.delete(layerName);\r","    };\r","\r","    const enableAll = (scene, preset) => {\r","      let count = 0;\r","      const layers = scene._orderedLayers || [];\r","      for (let i = 0; i < layers.length; i++) {\r","        const layer = layers[i];\r","        if (!layer || !layer.getRenderer) continue;\r","        let lr = null;\r","        try {\r","          lr = layer.getRenderer();\r","        } catch (error) {\r","          continue;\r","        }\r","        if (!lr || !lr.getThreeEffectComposer) continue;\r","        let composer = null;\r","        try {\r","          composer = lr.getThreeEffectComposer();\r","        } catch (error) {\r","          continue;\r","        }\r","        if (!composer) continue;\r","        const name = layerNameOf(layer, '');\r","        if (enable(scene, name, preset)) count++;\r","      }\r","      return count;\r","    };\r","\r","    const disableAll = (scene) => {\r","      const sceneState = getSceneState(scene, false);\r","      if (!sceneState) return;\r","      const states = Array.from(sceneState.layers.values());\r","      for (let i = 0; i < states.length; i++) {\r","        states[i].settings.active = false;\r","        saveSettings(states[i].layerName, states[i].settings);\r","        disposeState(states[i], true);\r","      }\r","      sceneState.layers.clear();\r","    };\r","\r","    const setNumber = (scene, layerName, setting, value) => {\r","      layerName = layerName || '';\r","      const key = NUMERIC_SETTINGS[normalize(setting)];\r","      if (!key) {\r","        warn('Unknown numeric setting \"' + setting + '\".');\r","        return false;\r","      }\r","      const settings = (getStateFor(scene, layerName) || { settings: getOrCreateSettings(layerName) }).settings;\r","      const n = num(value, settings[key]);\r","      switch (key) {\r","        case 'targetHeight': settings.targetHeight = clamp(n, 64, 4320); break;\r","        case 'pixelScale': settings.pixelScale = clamp(Math.round(n), 0, 32); break;\r","        case 'colorLevels': settings.colorLevels = clamp(Math.round(n), 2, 64); break;\r","        case 'dither': settings.dither = clamp(n, 0, 1); break;\r","        case 'saturation': settings.saturation = clamp(n, 0, 3); break;\r","        case 'contrast': settings.contrast = clamp(n, 0.2, 3); break;\r","        case 'outline': settings.outline = clamp(n, 0, 4); break;\r","        case 'outlineThreshold': settings.outlineThreshold = clamp(n, 0.001, 1); break;\r","        case 'creaseThreshold': settings.creaseThreshold = clamp(n, 0.01, 1.5); break;\r","        case 'outlineThickness': settings.outlineThickness = clamp(n, 0, 4); break;\r","        case 'outlineDistance': settings.outlineDistance = clamp(n, 0, 2); break;\r","        case 'cel': settings.cel = clamp(n, 0, 1); break;\r","        case 'celBands': settings.celBands = clamp(Math.round(n), 2, 16); break;\r","        case 'celSoftness': settings.celSoftness = clamp(n, 0, 1); break;\r","        case 'rim': settings.rim = clamp(n, 0, 2); break;\r","        case 'vignette': settings.vignette = clamp(n, 0, 1); break;\r","        case 'chromatic': settings.chromatic = clamp(n, 0, 0.2); break;\r","        case 'paletteSize': settings.paletteSize = clamp(Math.round(n), 0, 32); break;\r","        default: break;\r","      }\r","      settings.preset = 'Custom';\r","      saveSettings(layerName, settings);\r","      const state = getStateFor(scene, layerName);\r","      if (state) {\r","        state.sizeDirty = true;\r","        applySettings(state);\r","        applyStateSize(state);\r","      }\r","      return true;\r","    };\r","\r","    const setToggle = (scene, layerName, option, value) => {\r","      layerName = layerName || '';\r","      const key = TOGGLE_SETTINGS[normalize(option)];\r","      if (!key) {\r","        warn('Unknown option \"' + option + '\".');\r","        return false;\r","      }\r","      const settings = (getStateFor(scene, layerName) || { settings: getOrCreateSettings(layerName) }).settings;\r","      const on = bool(value);\r","      if (key === 'outlineEnabled') settings.outlineEnabled = on;\r","      else if (key === 'celEnabled') settings.celEnabled = on;\r","      else if (key === 'rimEnabled') settings.rimEnabled = on;\r","      else if (key === 'paletteEnabled') {\r","        settings.paletteEnabled = on;\r","        if (!on) settings.palette = 'None';\r","        else if (settings.palette === 'None') settings.palette = 'PICO-8';\r","      } else settings[key] = on;\r","      settings.preset = 'Custom';\r","      saveSettings(layerName, settings);\r","      const state = getStateFor(scene, layerName);\r","      if (state) applySettings(state);\r","      return true;\r","    };\r","\r","    const setPalette = (scene, layerName, paletteName) => {\r","      layerName = layerName || '';\r","      const key = Object.keys(PALETTES).find((name) => name.toLowerCase() === normalize(paletteName));\r","      if (!key) {\r","        warn('Unknown palette \"' + paletteName + '\".');\r","        return false;\r","      }\r","      const settings = (getStateFor(scene, layerName) || { settings: getOrCreateSettings(layerName) }).settings;\r","      settings.palette = key;\r","      settings.paletteEnabled = key !== 'None';\r","      settings.paletteColors = key === 'Custom' ? settings.paletteColors || [] : (PALETTES[key] || []).slice();\r","      settings.paletteSize = 0;\r","      settings.preset = 'Custom';\r","      saveSettings(layerName, settings);\r","      const state = getStateFor(scene, layerName);\r","      if (state) applySettings(state);\r","      return true;\r","    };\r","\r","    const setPaletteColor = (scene, layerName, index, color) => {\r","      layerName = layerName || '';\r","      const settings = (getStateFor(scene, layerName) || { settings: getOrCreateSettings(layerName) }).settings;\r","      const i = clamp(Math.round(num(index, 0)), 0, 31);\r","      if (!settings.paletteColors) settings.paletteColors = [];\r","      const rgb = parseColor(color);\r","      settings.paletteColors[i] = (rgb[0] << 16) | (rgb[1] << 8) | rgb[2];\r","      settings.palette = 'Custom';\r","      settings.paletteEnabled = true;\r","      settings.preset = 'Custom';\r","      saveSettings(layerName, settings);\r","      const state = getStateFor(scene, layerName);\r","      if (state) applySettings(state);\r","      return true;\r","    };\r","\r","    const resetDefaults = (scene, layerName) => {\r","      layerName = layerName || '';\r","      const settings = freshSettings();\r","      applyPresetTo(settings, 'Pixel Art');\r","      const state = getStateFor(scene, layerName);\r","      settings.active = !!(state && state.enabled);\r","      config.layers.set(layerName, settings);\r","      if (state) {\r","        state.settings = settings;\r","        state.paletteTextureDirty = true;\r","        applySettings(state);\r","        applyStateSize(state);\r","      }\r","    };\r","\r","    const setPreset = (scene, layerName, preset) => {\r","      layerName = layerName || '';\r","      const existing = getStateFor(scene, layerName);\r","      const settings = existing ? existing.settings : getSavedSettings(layerName);\r","      const applied = applyPresetTo(settings, preset);\r","      if (!applied) return false;\r","      saveSettings(layerName, settings);\r","      if (existing) {\r","        applySettings(existing);\r","        applyStateSize(existing);\r","      }\r","      return true;\r","    };\r","\r","    const isActiveOnLayer = (layerName, scene) => {\r","      const targets = scene ? [scene] : Array.from(scenes);\r","      for (let i = 0; i < targets.length; i++) {\r","        const state = getSceneState(targets[i], false);\r","        const layerState = state && state.layers.get(layerName || '');\r","        if (layerState && layerState.enabled) return true;\r","      }\r","      return false;\r","    };\r","\r","    const update = (scene) => {\r","      const sceneState = getSceneState(scene, false);\r","      if (!sceneState) return;\r","      sceneState.frame++;\r","      sceneState.layers.forEach((state) => {\r","        if (!state.enabled) return;\r","        if (state.sizeDirty) applyStateSize(state);\r","        // A patched FSR1 skips Pixel layers. If an unpatched FSR1 is enabled\r","        // later, disable it here so it cannot resize the composer behind us.\r","        if (sceneState.frame - state.lastFSRCheck > 0) {\r","          state.lastFSRCheck = sceneState.frame;\r","          disableFSROnLayer(scene, state.layerName);\r","        }\r","        // Keep the pass directly after the OutputPass if GDevelop reorders or\r","        // recreates the pass chain.\r","        const passes = state.composer.passes;\r","        const index = passes.indexOf(state.pass);\r","        let outputIndex = -1;\r","        for (let i = passes.length - 1; i >= 0; i--) if (passes[i].isOutputPass) { outputIndex = i; break; }\r","        if (index !== -1 && outputIndex !== -1 && index !== outputIndex + 1) reorderPass(state);\r","      });\r","    };\r","\r","    const getStats = (scene, layerName) => {\r","      const state = getStateFor(scene, layerName);\r","      if (!state || !state.pass) return { width: 0, height: 0, scale: 1, enabled: false };\r","      return Object.assign({ enabled: state.enabled }, state.pass.stats);\r","    };\r","\r","    const api = {\r","      version: VERSION,\r","      config,\r","      DEFAULTS,\r","      PRESETS,\r","      PALETTES,\r","      enable,\r","      enableAll,\r","      disable,\r","      disableAll,\r","      setEnabled(scene, layerName, value) {\r","        if (bool(value)) enable(scene, layerName);\r","        else disable(scene, layerName);\r","      },\r","      setPreset,\r","      setNumber,\r","      setToggle,\r","      setPalette,\r","      setPaletteColor,\r","      resetDefaults,\r","      resetAllDefaults(scene) {\r","        const sceneState = getSceneState(scene, false);\r","        if (!sceneState) return;\r","        sceneState.layers.forEach((state) => resetDefaults(scene, state.layerName));\r","      },\r","      update,\r","      isActiveOnLayer,\r","      isEnabled(scene, layerName) {\r","        const state = getStateFor(scene, layerName);\r","        return !!(state && state.enabled);\r","      },\r","      isActive(scene) {\r","        const sceneState = getSceneState(scene, false);\r","        if (!sceneState) return false;\r","        for (const state of sceneState.layers.values()) if (state.enabled) return true;\r","        return false;\r","      },\r","      isSupported() {\r","        return true;\r","      },\r","      getStats,\r","      getSettings(scene, layerName) {\r","        const state = getStateFor(scene, layerName);\r","        return state ? state.settings : config.layers.get(layerName || '') || null;\r","      },\r","      onSceneUnloading(scene) {\r","        const sceneState = getSceneState(scene, false);\r","        if (!sceneState) return;\r","        const states = Array.from(sceneState.layers.values());\r","        for (let i = 0; i < states.length; i++) disposeState(states[i], true);\r","        sceneState.layers.clear();\r","        delete scene.__pixel3dRuntime;\r","        scenes.delete(scene);\r","      },\r","      bindScene(scene) {\r","        return bindScene(scene);\r","      },\r","      cleanupScene(scene) {\r","        if (scene && scene.__pixel3dRuntime) api.onSceneUnloading(scene);\r","      },\r","    };\r","\r","    const bindScene = (scene) => {\r","      if (!scene) return;\r","      const sceneState = getSceneState(scene, true);\r","      scenes.add(scene);\r","      if (!config.persist) return;\r","      config.layers.forEach((settings, layerName) => {\r","        if (sceneState.layers.has(layerName) || !settings.active) return;\r","        const found = getLayerAndComposer(scene, layerName);\r","        if (!found) return;\r","        const state = createState(scene, layerName, found.layer, found.lr, found.composer, settings);\r","        sceneState.layers.set(layerName, state);\r","        installPass(state);\r","      });\r","      return sceneState;\r","    };\r","\r","    if (gdjs.__pixel3D && gdjs.__pixel3D.version !== VERSION) {\r","      try {\r","        if (gdjs.__pixel3D.cleanupScene) gdjs.__pixel3D.cleanupScene(runtimeScene);\r","      } catch (error) {}\r","    }\r","    if (gdjs.__pixel3D && gdjs.__pixel3D.version === VERSION) {\r","      gdjs.__pixel3D.bindScene(runtimeScene);\r","      return gdjs.__pixel3D;\r","    }\r","    gdjs.__pixel3D = api;\r","    bindScene(runtimeScene);\r","    log('Pixel 3D runtime ready (v' + VERSION + ').');\r","    return api;\r","  }\r","\r","  return installPixel3D;\r","});\r","","  const installPixel3D = module.exports;","  if (typeof gdjs !== 'undefined') {","    installPixel3D(","      gdjs,","      typeof THREE !== 'undefined' ? THREE : null,","      runtimeScene","    );","  }","})();"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[],"objectGroups":[]},{"description":"Internal: keeps pass order, checks FSR1 cooperation and applies pending size changes. Called automatically after the scene events.","fullName":"Pixel 3D per-frame update (lifecycle)","functionType":"Action","name":"onScenePostEvents","sentence":"Pixel 3D per-frame update","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":"if (gdjs.__pixel3D) { gdjs.__pixel3D.update(runtimeScene); }","parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[],"objectGroups":[]},{"description":"Internal: removes every Pixel 3D pass and restores the layer renderers when a scene is unloaded. Called automatically.","fullName":"Pixel 3D cleanup (lifecycle)","functionType":"Action","name":"onSceneUnloading","sentence":"Pixel 3D cleanup","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":"if (gdjs.__pixel3D) { gdjs.__pixel3D.onSceneUnloading(runtimeScene); }","parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[],"objectGroups":[]}],"eventsFunctionsFolderStructure":{"folderName":"__ROOT","children":[{"folderName":"Pixel 3D","children":[{"functionName":"EnablePixel3D"},{"functionName":"EnablePixel3DAllLayers"},{"functionName":"DisablePixel3D"},{"functionName":"DisablePixel3DAllLayers"},{"functionName":"SetEnabled"},{"functionName":"SetPreset"},{"functionName":"SetNumber"},{"functionName":"SetToggle"},{"functionName":"SetPalette"},{"functionName":"SetPaletteColor"},{"functionName":"ResetDefaults"},{"functionName":"ResetAllDefaults"},{"functionName":"SetPixelSize"},{"functionName":"SetTargetHeight"},{"functionName":"IsEnabledOnLayer"},{"functionName":"IsActive"},{"functionName":"IsSupported"},{"functionName":"PixelWidth"},{"functionName":"PixelHeight"},{"functionName":"PixelScale"},{"functionName":"PresetName"},{"functionName":"PaletteName"},{"functionName":"SettingValue"}]},{"functionName":"onSceneLoaded"},{"functionName":"onScenePostEvents"},{"functionName":"onSceneUnloading"}]},"eventsBasedBehaviors":[],"eventsBasedObjects":[]},{"author":"","category":"General","dimension":"3D","extensionNamespace":"","fullName":"3D terrain","gdevelopVersion":">=5.5.222","helpPath":"","iconUrl":"data:image/svg+xml;base64,","name":"Terrain3D","previewIconUrl":"https://asset-resources.gdevelop.io/public-resources/Icons/10e0a26c0d500830dfe23b94138beb0ef61607ba62bca05a5aa5c849777f1b06_terrain.svg","shortDescription":"A ground with hills and valleys that can be sculpted and painted in the editor, with collisions.","version":"0.2.0","description":["A 3D terrain object for open worlds, adventure or racing games: hills, mountains, islands or valleys, with painted layers of grass, dirt, rock or sand.","","- **Sculpt and paint in the scene editor**: select a terrain to show the tools (raise, lower, smooth, flatten and paint 4 layers).","- **Start from a relief** (hills, mountains, island) or **from a heightmap image**.","- **Steep slopes automatically show rock** (or any layer).","- **Natural borders between layers**: stones and tufts of a texture cover the gaps of the other where layers meet (height blending), and the repetition of textures is made less visible (texture variation).","- **Physics**: add the **3D physics** behavior to the terrain. Characters and objects collide with the ground exactly. The terrain is always static.","- **Pathfinding**: add the **floor/obstacle for pathfinding (navmesh based)** behavior to the terrain, so that characters with the navmesh pathfinding behavior walk on its hills and around its cliffs (in recent GDevelop versions).","- **Shape it with the Edits property**: a list of raise, flatten, smooth and paint strokes written in JSON, shown in the scene editor. It's readable and can be changed by hand or by an AI agent, like the relief, the heightmap and the other properties. Actions only change the terrain during the game.","- **Change it during the game** with actions (raise, lower, flatten, smooth, paint, along a line for paths and rivers) and read the ground height, slope or layer with expressions.","- **Grass**: add a **terrain grass** object over the terrain. Thousands of blades sway in the wind, grow where a layer (like grass) is painted and where the ground is not too steep, and are pushed aside by characters. Sculpt or paint the terrain and the grass follows.","- **Forests, rocks and bushes**: add a **scattered models** object over the terrain. It places hundreds or thousands of copies of a 3D model (trees, rocks, bushes, flowers...) on the ground and draws them all at once, which is much faster than an object for each. Copies grow where a layer is painted, away from steep slopes, and follow the ground when it's sculpted. Add or erase them with the brushes of the scene editor or with the Edits property, give trees trunk collisions, and cut them down with actions. Ready-made forests, rocks and bushes are in the asset store.","- **Tunnels and caves**: make holes in the ground (and fill them again) with the brushes, the Edits property or actions, and put a 3D model of the tunnel or the cave (with a mesh collision shape) under the ground. Nothing is drawn in holes, and characters, cars and rays go through them.","- **Made for large worlds**: the terrain is split in chunks that are hidden when off-screen and simplified when far away, and collisions are updated only where the ground changes."],"origin":{"identifier":"Terrain3D","name":"gdevelop-extension-store"},"tags":["3d","terrain","ground","heightmap","landscape","open world","grass","foliage","forest","trees","tunnel","cave"],"authorIds":[],"dependencies":[],"globalVariables":[],"sceneVariables":[],"eventsFunctions":[{"description":"Define helper classes JavaScript code.","fullName":"Define helper classes","functionType":"Action","name":"DefineHelperClasses","private":true,"sentence":"Define helper classes JavaScript code","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["if (gdjs.__terrain3DExtension) {","    return;","}","","// Tested by the gameplay tests of the \"3D island terrain\" example (GDevelop-examples repository).","","const groundsByScene = new WeakMap();","/**"," * The grounds of a scene (the terrains), followed by the terrain grass."," *"," * A ground has: `getVersion()` (changing when the ground changes),"," * `containsPoint(x, y)`, `getHeightAt(x, y)` (Z position of the ground),"," * `getSlopeAt(x, y)` (in degrees), `getLayerWeightAt(x, y, layer)` (how"," * much a painted layer, from 1 to 4, is there, from 0 to 1) and optionally"," * `getTintAt(x, y)` (the painted tint, as red, green and blue from 0 to 255)."," * @param {gdjs.RuntimeScene} runtimeScene"," * @returns {Set<object>}"," */","const getGrounds = (runtimeScene) => {","    let grounds = groundsByScene.get(runtimeScene);","    if (!grounds) {","        grounds = new Set();","        groundsByScene.set(runtimeScene, grounds);","    }","    return grounds;","};","","/**"," * @param {number} seed"," * @returns {() => number} Random numbers between 0 (included) and 1 (excluded), the same for the same seed."," */","const createRandom = (seed) => {","    let state = seed >>> 0 || 1;","    return () => {","        state ^= state << 13;","        state ^= state >>> 17;","        state ^= state << 5;","        return (state >>> 0) / 4294967296;","    };","};","","/**"," * Find the highest ground at a position: grounds can overlap (like an island over a sea floor)."," * @param {Iterable<object>} grounds"," * @param {{ground: object | null, z: number}} result Set to the ground (null if there is none) and its Z position."," */","const findHighestGround = (grounds, x, y, result) => {","    result.ground = null;","    for (const ground of grounds) {","        if (!ground.containsPoint(x, y)) continue;","        const z = ground.getHeightAt(x, y);","        if (!result.ground || z > result.z) {","            result.ground = ground;","            result.z = z;","        }","    }","    return result;","};","","// The grounds or the objects placed on them can change every frame (while","// sculpting or moving them in the editor): things are placed again at most this often.","const PLACEMENT_DELAY = 0.3;","","/**"," * Tells when things placed on the grounds of a scene (grass blades, scattered"," * models) must be placed again: after the grounds or the given properties"," * changed, at most every `PLACEMENT_DELAY` seconds."," */","class GroundPlacement {","    /** @param {gdjs.RuntimeScene} runtimeScene */","    constructor(runtimeScene) {","        this.grounds = getGrounds(runtimeScene);","        this.placedFrom = '';","        this.timeSincePlacement = 0;","    }","","    /**","     * @param {number} elapsedSeconds","     * @param {string} propertiesKey Changes when the things must be placed again.","     */","    shouldPlaceAgain(elapsedSeconds, propertiesKey) {","        this.timeSincePlacement += elapsedSeconds;","        if (this.placedFrom && this.timeSincePlacement < PLACEMENT_DELAY) return false;","        let placementKey = propertiesKey;","        for (const ground of this.grounds) placementKey += '|' + ground.getVersion();","        if (placementKey === this.placedFrom) return false;","        this.placedFrom = placementKey;","        this.timeSincePlacement = 0;","        return true;","    }","","    placeAgain() {","        this.placedFrom = '';","    }","}","","/**"," * Replace parts of the shader code of a Three.js material, with an error if"," * a part is missing (for example after an update of Three.js)."," * @param {string} shaderCode"," * @param {Array<[string, string]>} replacements The searched code and its replacement."," * @param {string} materialName"," */","const patchShaderCode = (shaderCode, replacements, materialName) => {","    for (const [searchedCode, newCode] of replacements) {","        if (!shaderCode.includes(searchedCode)) {","            console.error(`${materialName}: \"${searchedCode}\" was not found in the shader, which won't look as expected.`);","        }","        shaderCode = shaderCode.replace(searchedCode, newCode);","    }","    return shaderCode;","};","","// Size of the object inner area. Instances are scaled from it, so these only","// define the default size of a new terrain.","const AREA_SIZE = 4096;","const AREA_DEPTH = 600;","","// Terrains have at most 8 x 8 chunks (so at most 64 draw calls), of at least","// 32 x 32 cells.","const MIN_CHUNK_CELLS = 32;","const MAX_CHUNKS_PER_SIDE = 8;","/** @param {number} resolution */","const getChunkCells = (resolution) => Math.max(MIN_CHUNK_CELLS, resolution / MAX_CHUNKS_PER_SIDE);","// Grid steps of each level of detail, and the distance (in chunk sizes)","// from which each one is used.","const LOD_STEPS = [1, 2, 4];","const LOD_DISTANCES = [0, 3, 6];","","const LAYER_COUNT = 4;","const RESOLUTIONS = [64, 128, 256, 512, 1024];","const DEFAULT_RESOLUTION = 256;","// Each undo step is a copy of the data: fewer are kept for big terrains.","const UNDO_STEPS_SAMPLES = 20 * 257 * 257;","","const clamp01 = (value) => (value < 0 ? 0 : value > 1 ? 1 : value);","const clampInteger = (value, min, max) =>","    value < min ? min : value > max ? max : Math.floor(value);","","/**"," * A rectangle of grid samples, inclusive. Empty when `minI > maxI`."," */","class SampleRectangle {","    constructor() {","        this.clear();","    }","","    clear() {","        this.minI = Number.MAX_SAFE_INTEGER;","        this.minJ = Number.MAX_SAFE_INTEGER;","        this.maxI = -1;","        this.maxJ = -1;","    }","","    isEmpty() {","        return this.minI > this.maxI;","    }","","    /** @param {SampleRectangle} other */","    add(other) {","        if (other.isEmpty()) return;","        this.minI = Math.min(this.minI, other.minI);","        this.minJ = Math.min(this.minJ, other.minJ);","        this.maxI = Math.max(this.maxI, other.maxI);","        this.maxJ = Math.max(this.maxJ, other.maxJ);","    }","","    set(minI, minJ, maxI, maxJ) {","        this.minI = minI;","        this.minJ = minJ;","        this.maxI = maxI;","        this.maxJ = maxJ;","        return this;","    }","}","","/**"," * The heights (between 0 and 1) and the painted layers weights of a square"," * grid of `size * size` samples."," */","class TerrainData {","    /** @param {number} resolution The number of cells on each side. */","    constructor(resolution) {","        this.resolution = resolution;","        this.size = resolution + 1;","        this.heights = new Float32Array(this.size * this.size);","        /** 4 weights (0-255) per sample, one for each layer. */","        this.splat = new Uint8Array(this.size * this.size * LAYER_COUNT);","        this.fillLayer(0);","        /**","         * 4 bytes per sample: a tint multiplying the layers (red, green and","         * blue, white for none) and the wetness (0 for dry).","         */","        this.colors = new Uint8Array(this.size * this.size * 4);","        this.clearColors();","    }","","    clearColors() {","        this.colors.fill(255);","        for (let index = 3; index < this.colors.length; index += 4) {","            this.colors[index] = 0;","        }","    }","","    /** @param {number} layer */","    fillLayer(layer) {","        this.splat.fill(0);","        for (let index = layer; index < this.splat.length; index += LAYER_COUNT) {","            this.splat[index] = 255;","        }","    }","","    getHeight(i, j) {","        const last = this.resolution;","        const clampedI = i < 0 ? 0 : i > last ? last : i;","        const clampedJ = j < 0 ? 0 : j > last ? last : j;","        return this.heights[clampedJ * this.size + clampedI];","    }","","    /**","     * @param {number} gridX","     * @param {number} gridY","     * @returns {number} The height interpolated on the triangles that are drawn.","     */","    sampleHeight(gridX, gridY) {","        const x = Math.min(Math.max(gridX, 0), this.resolution);","        const y = Math.min(Math.max(gridY, 0), this.resolution);","        const i = Math.min(Math.floor(x), this.resolution - 1);","        const j = Math.min(Math.floor(y), this.resolution - 1);","        const fx = x - i;","        const fy = y - j;","        const topRight = this.getHeight(i + 1, j);","        const bottomLeft = this.getHeight(i, j + 1);","        if (fx + fy <= 1) {","            const topLeft = this.getHeight(i, j);","            return topLeft + fx * (topRight - topLeft) + fy * (bottomLeft - topLeft);","        }","        const bottomRight = this.getHeight(i + 1, j + 1);","        return (","            bottomRight +","            (1 - fx) * (bottomLeft - bottomRight) +","            (1 - fy) * (topRight - bottomRight)","        );","    }","","    /** @returns {number} The weight (0-1) of a layer, interpolated between samples. */","    sampleLayerWeight(gridX, gridY, layer) {","        const x = Math.min(Math.max(gridX, 0), this.resolution);","        const y = Math.min(Math.max(gridY, 0), this.resolution);","        const i = Math.min(Math.floor(x), this.resolution - 1);","        const j = Math.min(Math.floor(y), this.resolution - 1);","        const fx = x - i;","        const fy = y - j;","        const weight = (i, j) => this.splat[(j * this.size + i) * LAYER_COUNT + layer];","        const top = weight(i, j) + fx * (weight(i + 1, j) - weight(i, j));","        const bottom = weight(i, j + 1) + fx * (weight(i + 1, j + 1) - weight(i, j + 1));","        return (top + fy * (bottom - top)) / 255;","    }","","    /**","     * @param {number} channel 0, 1 and 2 for the tint, 3 for the wetness.","     * @returns {number} The channel (0-1), interpolated between samples.","     */","    sampleColor(gridX, gridY, channel) {","        const x = Math.min(Math.max(gridX, 0), this.resolution);","        const y = Math.min(Math.max(gridY, 0), this.resolution);","        const i = Math.min(Math.floor(x), this.resolution - 1);","        const j = Math.min(Math.floor(y), this.resolution - 1);","        const fx = x - i;","        const fy = y - j;","        const value = (i, j) => this.colors[(j * this.size + i) * 4 + channel];","        const top = value(i, j) + fx * (value(i + 1, j) - value(i, j));","        const bottom = value(i, j + 1) + fx * (value(i + 1, j + 1) - value(i, j + 1));","        return (top + fy * (bottom - top)) / 255;","    }","","    /**","     * @param {number} index The index of a sample.","     * @returns {boolean} true if no layer is painted on the sample: it's a hole.","     */","    isHole(index) {","        const offset = index * LAYER_COUNT;","        return (this.splat[offset] | this.splat[offset + 1] | this.splat[offset + 2] | this.splat[offset + 3]) === 0;","    }","","    /**","     * @returns {number} The sum of the layer weights (0-1), interpolated between samples: there is a","     * hole where it's under 0.5, like what is drawn.","     */","    sampleSolidity(gridX, gridY) {","        let solidity = 0;","        for (let layer = 0; layer < LAYER_COUNT; layer++) solidity += this.sampleLayerWeight(gridX, gridY, layer);","        return solidity;","    }","","    /** @returns {number} The index (from 0) of the layer painted the most. */","    getDominantLayer(gridX, gridY) {","        const i = clampInteger(Math.round(gridX), 0, this.resolution);","        const j = clampInteger(Math.round(gridY), 0, this.resolution);","        const offset = (j * this.size + i) * LAYER_COUNT;","        let dominantLayer = 0;","        for (let layer = 1; layer < LAYER_COUNT; layer++) {","            if (this.splat[offset + layer] > this.splat[offset + dominantLayer]) {","                dominantLayer = layer;","            }","        }","        return dominantLayer;","    }","","    /** @param {TerrainData} other */","    copyFrom(other) {","        this.heights.set(other.heights);","        this.splat.set(other.splat);","        this.colors.set(other.colors);","    }","","    /**","     * @param {number} resolution","     * @returns {TerrainData} A copy of this data with another resolution.","     */","    resampled(resolution) {","        const data = new TerrainData(resolution);","        const ratio = this.resolution / resolution;","        for (let j = 0; j < data.size; j++) {","            for (let i = 0; i < data.size; i++) {","                const index = j * data.size + i;","                data.heights[index] = this.sampleHeight(i * ratio, j * ratio);","                const sourceOffset =","                    (Math.round(j * ratio) * this.size + Math.round(i * ratio)) * LAYER_COUNT;","                for (let layer = 0; layer < LAYER_COUNT; layer++) {","                    data.splat[index * LAYER_COUNT + layer] = this.splat[sourceOffset + layer];","                }","                for (let channel = 0; channel < 4; channel++) {","                    data.colors[index * 4 + channel] = this.colors[sourceOffset + channel];","                }","            }","        }","        return data;","    }","}","","/**"," * Brushes change the samples around a segment, with an effect going smoothly"," * from full on the segment to none at `radius`. A point is a segment of"," * length 0. Positions are in scene units relative to the terrain origin."," */","const brushes = {","    /**","     * @param {TerrainData} data","     * @param {{cellWidth: number, cellHeight: number, ax: number, ay: number, bx: number, by: number, radius: number}} stroke","     * @param {(sampleIndex: number, weight: number, t: number) => void} apply Called with the weight of","     * the brush and the position (from 0 to 1) of the nearest point of the segment.","     * @param {SampleRectangle} changedSamples","     */","    forEachSample(data, stroke, apply, changedSamples) {","        const { cellWidth, cellHeight, ax, ay, bx, by, radius } = stroke;","        const last = data.resolution;","        const minI = clampInteger(Math.floor((Math.min(ax, bx) - radius) / cellWidth), 0, last);","        const maxI = clampInteger(Math.ceil((Math.max(ax, bx) + radius) / cellWidth), 0, last);","        const minJ = clampInteger(Math.floor((Math.min(ay, by) - radius) / cellHeight), 0, last);","        const maxJ = clampInteger(Math.ceil((Math.max(ay, by) + radius) / cellHeight), 0, last);","        changedSamples.set(minI, minJ, maxI, maxJ);","        if (radius <= 0) return;","","        const abX = bx - ax;","        const abY = by - ay;","        const abLengthSquared = abX * abX + abY * abY;","        const radiusSquared = radius * radius;","        for (let j = minJ; j <= maxJ; j++) {","            const y = j * cellHeight;","            for (let i = minI; i <= maxI; i++) {","                const x = i * cellWidth;","                const t =","                    abLengthSquared > 0","                        ? clamp01(((x - ax) * abX + (y - ay) * abY) / abLengthSquared)","                        : 0;","                const dx = x - (ax + t * abX);","                const dy = y - (ay + t * abY);","                const distanceSquared = dx * dx + dy * dy;","                if (distanceSquared >= radiusSquared) continue;","                const falloff = 1 - distanceSquared / radiusSquared;","                apply(j * data.size + i, falloff * falloff, t);","            }","        }","    },","","    raise(data, stroke, amount, changedSamples) {","        const { heights } = data;","        brushes.forEachSample(","            data,","            stroke,","            (index, weight) => {","                heights[index] = clamp01(heights[index] + amount * weight);","            },","            changedSamples","        );","    },","","    /**","     * @param {number} targetHeight","     * @param {number} [endTargetHeight] The target at the end of the segment, for a slope (like a road","     * going up). The same target as at its start by default.","     */","    flatten(data, stroke, targetHeight, strength, changedSamples, endTargetHeight = targetHeight) {","        const { heights } = data;","        const startTarget = clamp01(targetHeight);","        const endTarget = clamp01(endTargetHeight);","        brushes.forEachSample(","            data,","            stroke,","            (index, weight, t) => {","                const target = startTarget + (endTarget - startTarget) * t;","                heights[index] += (target - heights[index]) * clamp01(weight * strength);","            },","            changedSamples","        );","    },","","    smooth(data, stroke, strength, changedSamples) {","        const { heights, size } = data;","        const changes = [];","        brushes.forEachSample(","            data,","            stroke,","            (index, weight) => {","                const i = index % size;","                const j = (index - i) / size;","                let sum = 0;","                for (let dj = -1; dj <= 1; dj++) {","                    for (let di = -1; di <= 1; di++) {","                        sum += data.getHeight(i + di, j + dj);","                    }","                }","                changes.push(index, heights[index] + (sum / 9 - heights[index]) * clamp01(weight * strength));","            },","            changedSamples","        );","        // Written after all averages are computed, so that the result","        // doesn't depend on the order in which samples are visited.","        for (let index = 0; index < changes.length; index += 2) {","            heights[changes[index]] = changes[index + 1];","        }","    },","","    paint(data, stroke, layer, strength, changedSamples) {","        const { splat } = data;","        brushes.forEachSample(","            data,","            stroke,","            (index, weight) => {","                const amount = clamp01(weight * strength);","                const offset = index * LAYER_COUNT;","                for (let otherLayer = 0; otherLayer < LAYER_COUNT; otherLayer++) {","                    const target = otherLayer === layer ? 255 : 0;","                    const value = splat[offset + otherLayer];","                    // Rounded towards the target, so that light strokes still paint.","                    const change = (target - value) * amount;","                    splat[offset + otherLayer] = value + (change > 0 ? Math.ceil(change) : Math.floor(change));","                }","            },","            changedSamples","        );","    },","","    /** Remove all the layers, making a hole (`fill` or painting a layer fills it again). */","    hole(data, stroke, changedSamples) {","        const { splat } = data;","        brushes.forEachSample(","            data,","            stroke,","            (index) => {","                splat.fill(0, index * LAYER_COUNT, (index + 1) * LAYER_COUNT);","            },","            changedSamples","        );","    },","","    /**","     * Fill the holes in the radius with the layers of the ground around them:","     * each pass fills the holes next to the ground with the average of their","     * neighbors, from the edges of the holes inward.","     */","    fill(data, stroke, changedSamples) {","        const { splat, size, resolution } = data;","        /** @type {number[]} */","        let holes = [];","        brushes.forEachSample(","            data,","            stroke,","            (index) => {","                if (data.isHole(index)) holes.push(index);","            },","            changedSamples","        );","        const filledWeights = new Float32Array(holes.length * LAYER_COUNT);","        while (holes.length > 0) {","            /** @type {number[]} */","            const remainingHoles = [];","            /** @type {number[]} */","            const filledHoles = [];","            for (const index of holes) {","                const i = index % size;","                const j = (index - i) / size;","                const weights = filledWeights.subarray(filledHoles.length * LAYER_COUNT, (filledHoles.length + 1) * LAYER_COUNT);","                weights.fill(0);","                for (let neighborJ = Math.max(j - 1, 0); neighborJ <= Math.min(j + 1, resolution); neighborJ++) {","                    for (let neighborI = Math.max(i - 1, 0); neighborI <= Math.min(i + 1, resolution); neighborI++) {","                        const neighbor = neighborJ * size + neighborI;","                        if (data.isHole(neighbor)) continue;","                        for (let layer = 0; layer < LAYER_COUNT; layer++) weights[layer] += splat[neighbor * LAYER_COUNT + layer];","                    }","                }","                if (weights[0] + weights[1] + weights[2] + weights[3] > 0) filledHoles.push(index);","                else remainingHoles.push(index);","            }","            if (filledHoles.length === 0) {","                // No ground around (a hole bigger than the brush): the first layer is used.","                for (const index of remainingHoles) splat[index * LAYER_COUNT] = 255;","                break;","            }","            // Filled after the pass, so that the holes are filled from the edges inward.","            filledHoles.forEach((index, filledIndex) => {","                const weights = filledWeights.subarray(filledIndex * LAYER_COUNT, (filledIndex + 1) * LAYER_COUNT);","                const total = weights[0] + weights[1] + weights[2] + weights[3];","                for (let layer = 0; layer < LAYER_COUNT; layer++) {","                    splat[index * LAYER_COUNT + layer] = Math.round((weights[layer] / total) * 255);","                }","            });","            holes = remainingHoles;","        }","    },","","    /** @param {number[]} color The red, green and blue (0-255) of the tint: white removes it. */","    tint(data, stroke, color, strength, changedSamples) {","        brushes.paintColors(data, stroke, 0, color, strength, changedSamples);","    },","","    /** @param {number} wetness From 0 (dry) to 1. */","    wet(data, stroke, wetness, strength, changedSamples) {","        brushes.paintColors(data, stroke, 3, [Math.round(clamp01(wetness) * 255)], strength, changedSamples);","    },","","    /**","     * Bring channels of the colors (see `TerrainData.colors`) towards targets.","     * @param {number} firstChannel","     * @param {number[]} targets From 0 to 255, for the channels from the first one.","     */","    paintColors(data, stroke, firstChannel, targets, strength, changedSamples) {","        const { colors } = data;","        brushes.forEachSample(","            data,","            stroke,","            (index, weight) => {","                const amount = clamp01(weight * strength);","                for (let channel = 0; channel < targets.length; channel++) {","                    const offset = index * 4 + firstChannel + channel;","                    // Rounded towards the target, so that light strokes still paint.","                    const change = (targets[channel] - colors[offset]) * amount;","                    colors[offset] += change > 0 ? Math.ceil(change) : Math.floor(change);","                }","            },","            changedSamples","        );","    },","};","","const relief = (() => {","    const hash = (x, y, seed) => {","        let h = Math.imul(x, 374761393) + Math.imul(y, 668265263) + Math.imul(seed, 982451653);","        h = Math.imul(h ^ (h >>> 13), 1274126177);","        return ((h ^ (h >>> 16)) >>> 0) / 4294967296;","    };","    const valueNoise = (x, y, seed) => {","        const x0 = Math.floor(x);","        const y0 = Math.floor(y);","        const fx = x - x0;","        const fy = y - y0;","        const sx = fx * fx * (3 - 2 * fx);","        const sy = fy * fy * (3 - 2 * fy);","        const top = hash(x0, y0, seed) + sx * (hash(x0 + 1, y0, seed) - hash(x0, y0, seed));","        const bottom =","            hash(x0, y0 + 1, seed) + sx * (hash(x0 + 1, y0 + 1, seed) - hash(x0, y0 + 1, seed));","        return top + sy * (bottom - top);","    };","    /** Fractal noise between 0 and 1. */","    const fractalNoise = (x, y, seed) => {","        let value = 0;","        let amplitude = 0.5;","        let frequency = 1;","        for (let octave = 0; octave < 5; octave++) {","            value += amplitude * valueNoise(x * frequency, y * frequency, seed + octave);","            amplitude *= 0.5;","            frequency *= 2;","        }","        return value / 0.96875;","    };","    const smoothstep = (edge0, edge1, x) => {","        const t = clamp01((x - edge0) / (edge1 - edge0));","        return t * t * (3 - 2 * t);","    };","    const reliefHeights = {","        Flat: () => 0,","        Hills: (u, v, seed) => 0.05 + 0.5 * Math.pow(fractalNoise(u * 3, v * 3, seed), 2),","        Mountains: (u, v, seed) => {","            const ridge = 1 - Math.abs(2 * fractalNoise(u * 2.5, v * 2.5, seed) - 1);","            return 0.9 * Math.pow(ridge, 2.5);","        },","        Island: (u, v, seed) => {","            const distanceToCenter = 2 * Math.hypot(u - 0.5, v - 0.5);","            const coast = 0.2 * (fractalNoise(u * 4, v * 4, seed + 7) - 0.5);","            const land = smoothstep(0.95, 0.55, distanceToCenter + coast);","            return land * (0.12 + 0.6 * Math.pow(fractalNoise(u * 3, v * 3, seed), 1.5));","        },","    };","    const beachLayer = 3;","","    return {","        /**","         * @param {TerrainData} data","         * @param {string} reliefName Flat, Hills, Mountains or Island.","         * @param {number} seed","         */","        generate(data, reliefName, seed) {","            const getHeight = reliefHeights[reliefName] || reliefHeights.Flat;","            const integerSeed = Math.floor(seed) | 0;","            data.fillLayer(0);","            for (let j = 0; j < data.size; j++) {","                for (let i = 0; i < data.size; i++) {","                    const index = j * data.size + i;","                    const height = clamp01(","                        getHeight(i / data.resolution, j / data.resolution, integerSeed)","                    );","                    data.heights[index] = height;","                    if (reliefName === 'Island') {","                        const sand = Math.round(255 * smoothstep(0.16, 0.1, height));","                        const offset = index * LAYER_COUNT;","                        data.splat[offset] = 255 - sand;","                        data.splat[offset + beachLayer] = sand;","                    }","                }","            }","        },","    };","})();","","/**"," * Edits written in the Edits property: a JSON list of brush strokes, like"," * `[{\"tool\": \"raise\", \"x\": 0.5, \"y\": 0.5, \"radius\": 0.2, \"height\": 0.3}]`,"," * applied on the relief or the heightmap. Positions and radius are fractions"," * of the terrain size, heights and Z positions fractions of its depth: they"," * are the same for all instances, whatever their size. They are made to be"," * read and written by people and by AI agents."," */","const edits = {","    /**","     * @param {TerrainData} data","     * @param {string} text","     */","    apply(data, text) {","        if (!text.trim()) return;","        let editList;","        try {","            editList = JSON.parse(text);","        } catch (error) {","            console.warn('The edits of a terrain are not valid JSON: ' + error.message);","            return;","        }","        if (!Array.isArray(editList)) {","            console.warn('The edits of a terrain must be a JSON list (like [{\"tool\": \"raise\", ...}]).');","            return;","        }","        const numberOr = (value, defaultValue) => (typeof value === 'number' && isFinite(value) ? value : defaultValue);","        const changedSamples = new SampleRectangle();","        for (const edit of editList) {","            if (!edit || typeof edit !== 'object') continue;","            const x = numberOr(edit.x, 0.5);","            const y = numberOr(edit.y, 0.5);","            const stroke = {","                cellWidth: 1 / data.resolution,","                cellHeight: 1 / data.resolution,","                ax: x,","                ay: y,","                bx: numberOr(edit.toX, x),","                by: numberOr(edit.toY, y),","                radius: numberOr(edit.radius, 0.1),","            };","            const strength = clamp01(numberOr(edit.strength, 1));","            if (edit.tool === 'raise') {","                brushes.raise(data, stroke, numberOr(edit.height, 0.1), changedSamples);","            } else if (edit.tool === 'flatten') {","                const z = numberOr(edit.z, 0);","                brushes.flatten(data, stroke, z, strength, changedSamples, numberOr(edit.toZ, z));","            } else if (edit.tool === 'smooth') {","                // Smoothing the same fraction of the terrain at any resolution.","                const passes = Math.max(Math.round(((1 + 9 * strength) * data.resolution) / 256), 1);","                for (let pass = 0; pass < passes; pass++) brushes.smooth(data, stroke, 1, changedSamples);","            } else if (edit.tool === 'paint') {","                const layer = clampInteger(numberOr(edit.layer, 1) - 1, 0, LAYER_COUNT - 1);","                brushes.paint(data, stroke, layer, strength, changedSamples);","            } else if (edit.tool === 'tint') {","                const color = gdjs.rgbOrHexToRGBColor(typeof edit.color === 'string' ? edit.color : '255;255;255');","                brushes.tint(data, stroke, color, strength, changedSamples);","            } else if (edit.tool === 'wetness') {","                brushes.wet(data, stroke, numberOr(edit.amount, 1), strength, changedSamples);","            } else if (edit.tool === 'hole') {","                brushes.hole(data, stroke, changedSamples);","            } else if (edit.tool === 'fill') {","                brushes.fill(data, stroke, changedSamples);","            } else {","                console.warn('Unknown tool in the edits of a terrain: \"' + edit.tool + '\" (use raise, flatten, smooth, paint, tint, wetness, hole or fill).');","            }","        }","    },","};","","/**"," * @param {gdjs.RuntimeGame} game"," * @param {string} imageResourceName"," * @returns {CanvasImageSource | null} The image, or null if it's not loaded (yet)."," */","const getLoadedImage = (game, imageResourceName) => {","    const imageManager = game.getImageManager();","    if (typeof imageManager.getImageSource === 'function') return imageManager.getImageSource(imageResourceName);","    // Older GDevelop versions: a 192 x 192 placeholder is given for images that are not loaded.","    const texture = imageManager.getPIXITexture(imageResourceName);","    return texture && texture !== imageManager.getInvalidPIXITexture() ? texture.baseTexture.getDrawableSource() : null;","};","","/**"," * Loads heights from an image: black is the lowest, white the highest."," * Heights have 16 bits of precision when the red channel holds the most"," * significant byte and the green one the least significant (a gray image"," * works as expected too)."," * @param {TerrainData} data"," * @param {gdjs.RuntimeGame} game"," * @param {string} imageResourceName"," * @returns {boolean} true if the image could be read."," */","const loadHeightsFromImage = (data, game, imageResourceName) => {","    const source = getLoadedImage(game, imageResourceName);","    if (!source) return false;","","    const canvas = document.createElement('canvas');","    canvas.width = source.width;","    canvas.height = source.height;","    const context = canvas.getContext('2d', { willReadFrequently: true });","    if (!context) return false;","    context.drawImage(source, 0, 0);","    const pixels = context.getImageData(0, 0, source.width, source.height).data;","    // Pixels are decoded before being interpolated, to keep the 16 bits.","    const pixelHeight = (x, y) => {","        const offset = (y * source.width + x) * 4;","        return (256 * pixels[offset] + pixels[offset + 1]) / 65535;","    };","    for (let j = 0; j < data.size; j++) {","        const y = (j / data.resolution) * (source.height - 1);","        const y0 = Math.floor(y);","        const y1 = Math.min(y0 + 1, source.height - 1);","        for (let i = 0; i < data.size; i++) {","            const x = (i / data.resolution) * (source.width - 1);","            const x0 = Math.floor(x);","            const x1 = Math.min(x0 + 1, source.width - 1);","            const top = pixelHeight(x0, y0) + (x - x0) * (pixelHeight(x1, y0) - pixelHeight(x0, y0));","            const bottom = pixelHeight(x0, y1) + (x - x0) * (pixelHeight(x1, y1) - pixelHeight(x0, y1));","            data.heights[j * data.size + i] = top + (y - y0) * (bottom - top);","        }","    }","    return true;","};","","/**"," * Stores the data in a string. Only the differences with the base data (from"," * the relief or the heightmap) are stored: heights on 16 bits, layer weights"," * on 8 bits, then (since format 2) the tint and wetness on 8 bits. Each value is predicted from its neighbors and the"," * prediction errors are written as variable length integers, with runs of"," * zeros collapsed. Untouched or smoothly changed areas take almost no space."," */","const codec = (() => {","    const formatVersion = '2';","    // Format 1 has no tint and wetness.","    const readableFormatVersions = ['1', '2'];","","    class ByteWriter {","        constructor() {","            this.bytes = new Uint8Array(1024);","            this.length = 0;","        }","        writeVarUint(value) {","            if (this.length + 5 > this.bytes.length) {","                const bytes = new Uint8Array(this.bytes.length * 2);","                bytes.set(this.bytes);","                this.bytes = bytes;","            }","            while (value >= 0x80) {","                this.bytes[this.length++] = (value & 0x7f) | 0x80;","                value >>>= 7;","            }","            this.bytes[this.length++] = value;","        }","    }","","    class ByteReader {","        /** @param {Uint8Array} bytes */","        constructor(bytes) {","            this.bytes = bytes;","            this.position = 0;","        }","        readVarUint() {","            let value = 0;","            let shift = 0;","            let byte;","            do {","                if (this.position >= this.bytes.length) throw new Error('Truncated terrain data.');","                byte = this.bytes[this.position++];","                value += (byte & 0x7f) * Math.pow(2, shift);","                shift += 7;","            } while (byte & 0x80);","            return value;","        }","    }","","    /** Predicts a value from the left, top and top-left ones. */","    const predict = (values, size, index) => {","        const i = index % size;","        if (index < size) return i === 0 ? 0 : values[index - 1];","        if (i === 0) return values[index - size];","        return values[index - 1] + values[index - size] - values[index - size - 1];","    };","","    /**","     * @param {ByteWriter} writer","     * @param {Int32Array} values A grid of `size * size` values.","     */","    const writeGrid = (writer, values, size) => {","        let zeroRun = 0;","        for (let index = 0; index < values.length; index++) {","            const error = values[index] - predict(values, size, index);","            if (error === 0) {","                zeroRun++;","                continue;","            }","            if (zeroRun > 0) {","                writer.writeVarUint(0);","                writer.writeVarUint(zeroRun);","                zeroRun = 0;","            }","            // Zigzag: small negative and positive numbers get small codes.","            writer.writeVarUint(error > 0 ? error * 2 : -error * 2 - 1);","        }","        if (zeroRun > 0) {","            writer.writeVarUint(0);","            writer.writeVarUint(zeroRun);","        }","    };","","    /** @param {ByteReader} reader */","    const readGrid = (reader, size) => {","        const values = new Int32Array(size * size);","        let zeroRun = 0;","        for (let index = 0; index < values.length; index++) {","            let error = 0;","            if (zeroRun > 0) {","                zeroRun--;","            } else {","                const code = reader.readVarUint();","                if (code === 0) {","                    zeroRun = reader.readVarUint() - 1;","                } else {","                    error = code % 2 === 0 ? code / 2 : -(code + 1) / 2;","                }","            }","            values[index] = predict(values, size, index) + error;","        }","        return values;","    };","","    const toBase64 = (bytes, length) => {","        let binary = '';","        for (let offset = 0; offset < length; offset += 0x8000) {","            binary += String.fromCharCode.apply(null, bytes.subarray(offset, Math.min(offset + 0x8000, length)));","        }","        return btoa(binary);","    };","","    const fromBase64 = (base64) => {","        const binary = atob(base64);","        const bytes = new Uint8Array(binary.length);","        for (let index = 0; index < binary.length; index++) {","            bytes[index] = binary.charCodeAt(index);","        }","        return bytes;","    };","","    return {","        /**","         * @param {TerrainData} data","         * @param {TerrainData} baseData The data without changes, with the same resolution.","         */","        encode(data, baseData) {","            const writer = new ByteWriter();","            const values = new Int32Array(data.heights.length);","            for (let index = 0; index < values.length; index++) {","                values[index] = Math.round((data.heights[index] - baseData.heights[index]) * 65535);","            }","            writeGrid(writer, values, data.size);","            for (let layer = 0; layer < LAYER_COUNT; layer++) {","                for (let index = 0; index < values.length; index++) {","                    const offset = index * LAYER_COUNT + layer;","                    values[index] = data.splat[offset] - baseData.splat[offset];","                }","                writeGrid(writer, values, data.size);","            }","            // Not painted, these grids are zeros: a few bytes each.","            for (let channel = 0; channel < 4; channel++) {","                for (let index = 0; index < values.length; index++) {","                    const offset = index * 4 + channel;","                    values[index] = data.colors[offset] - baseData.colors[offset];","                }","                writeGrid(writer, values, data.size);","            }","            return formatVersion + ';' + data.resolution + ';' + toBase64(writer.bytes, writer.length);","        },","","        /**","         * Store grids of integers in a string, like the terrain data. Used by other objects (the scattered models).","         * @param {Int32Array[]} grids Grids of `size * size` values.","         * @param {number} size","         */","        encodeGrids(grids, size) {","            const writer = new ByteWriter();","            for (const grid of grids) writeGrid(writer, grid, size);","            return toBase64(writer.bytes, writer.length);","        },","","        /**","         * @param {string} base64 A string from `encodeGrids`.","         * @param {number} size","         * @param {number} count The number of grids.","         * @returns {Int32Array[]} The grids (an error is thrown if the string is not valid).","         */","        decodeGrids(base64, size, count) {","            const reader = new ByteReader(fromBase64(base64));","            return Array.from({ length: count }, () => readGrid(reader, size));","        },","","        /**","         * @param {string} text","         * @param {(resolution: number) => TerrainData} createBaseData","         * @returns {TerrainData | null} null if the text is empty or not valid.","         */","        decode(text, createBaseData) {","            if (!text) return null;","            const parts = text.split(';');","            const resolution = parseInt(parts[1], 10);","            if (readableFormatVersions.indexOf(parts[0]) === -1 || RESOLUTIONS.indexOf(resolution) === -1) {","                return null;","            }","            try {","                const reader = new ByteReader(fromBase64(parts[2]));","                const data = createBaseData(resolution);","                const heightChanges = readGrid(reader, data.size);","                for (let index = 0; index < heightChanges.length; index++) {","                    data.heights[index] = clamp01(data.heights[index] + heightChanges[index] / 65535);","                }","                for (let layer = 0; layer < LAYER_COUNT; layer++) {","                    const weightChanges = readGrid(reader, data.size);","                    for (let index = 0; index < weightChanges.length; index++) {","                        const offset = index * LAYER_COUNT + layer;","                        // The base may have changed since the data was saved.","                        data.splat[offset] = Math.min(Math.max(data.splat[offset] + weightChanges[index], 0), 255);","                    }","                }","                if (parts[0] !== '1') {","                    for (let channel = 0; channel < 4; channel++) {","                        const colorChanges = readGrid(reader, data.size);","                        for (let index = 0; index < colorChanges.length; index++) {","                            const offset = index * 4 + channel;","                            data.colors[offset] = Math.min(Math.max(data.colors[offset] + colorChanges[index], 0), 255);","                        }","                    }","                }","                return data;","            } catch (error) {","                console.error('Terrain data could not be read:', error);","                return null;","            }","        },","    };","})();","","const lodIndices = new Map();","/**"," * The triangles of a chunk, shared by all chunks of the same size. Chunk"," * borders have a skirt going down, hiding the gaps between chunks drawn"," * with different levels of detail."," * @param {number} chunkCells"," * @param {number} step"," */","const getLodIndex = (chunkCells, step) => {","    const key = chunkCells + ';' + step;","    const existingIndex = lodIndices.get(key);","    if (existingIndex) return existingIndex;","","    const sideVertices = chunkCells + 1;","    const gridVertices = sideVertices * sideVertices;","    const indices = [];","    const grid = (i, j) => j * sideVertices + i;","    for (let j = 0; j < chunkCells; j += step) {","        for (let i = 0; i < chunkCells; i += step) {","            const topLeft = grid(i, j);","            const topRight = grid(i + step, j);","            const bottomLeft = grid(i, j + step);","            const bottomRight = grid(i + step, j + step);","            indices.push(topLeft, topRight, bottomLeft, topRight, bottomRight, bottomLeft);","        }","    }","    const borders = [","        (k) => grid(k, 0),","        (k) => grid(k, chunkCells),","        (k) => grid(0, k),","        (k) => grid(chunkCells, k),","    ];","    borders.forEach((borderVertex, border) => {","        const skirtVertex = (k) => gridVertices + border * sideVertices + k;","        for (let k = 0; k < chunkCells; k += step) {","            const a = borderVertex(k);","            const b = borderVertex(k + step);","            const skirtA = skirtVertex(k);","            const skirtB = skirtVertex(k + step);","            // Both faces, as a skirt can be seen from either side.","            indices.push(a, b, skirtB, a, skirtB, skirtA, a, skirtB, b, a, skirtA, skirtB);","        }","    });","    const index = new THREE.BufferAttribute(new Uint16Array(indices), 1);","    lodIndices.set(key, index);","    return index;","};","","const vertexShaderDeclarations = `","varying vec2 vTerrainLocalXY;","varying float vTerrainLocalZ;","uniform float terrainWorldScale;","varying vec2 vTerrainWorldXY;","varying float vTerrainUp;","`;","const vertexShaderCode = `","vTerrainLocalXY = position.xy;","vTerrainLocalZ = position.z;","vTerrainWorldXY = (modelMatrix * vec4(transformed, 1.0)).xy * terrainWorldScale;","// The world normal, from the camera space normal (computed by Three.js with a","// matrix inverted on the CPU), instead of inverting a matrix for each vertex.","vTerrainUp = inverseTransformDirection(transformedNormal, viewMatrix).z;","`;","/** @param {(layer: number) => string} getLayerCode */","const forEachLayerCode = (getLayerCode) => [0, 1, 2, 3].map(getLayerCode).join('\\n');","","// Noise is read from a texture of random values, repeated every","// NOISE_MAP_SIZE units of noise: 1 texture read instead of 16 hashes.","const NOISE_MAP_SIZE = 256;","","const fragmentShaderDeclarations = `","uniform sampler2D terrainSplatMap;","uniform vec2 terrainSplatUvScaleAndOffset;","uniform vec3 terrainLayerColors[4];","uniform sampler2D terrainLayerMap0;","uniform sampler2D terrainLayerMap1;","uniform sampler2D terrainLayerMap2;","uniform sampler2D terrainLayerMap3;","uniform vec3 terrainLayerAverageColors[4];","uniform sampler2D terrainLayerNormalMap0;","uniform sampler2D terrainLayerNormalMap1;","uniform sampler2D terrainLayerNormalMap2;","uniform sampler2D terrainLayerNormalMap3;","uniform float terrainNormalMapStrength;","uniform float terrainTextureSize;","uniform float terrainHeightBlending;","uniform float terrainTextureVariation;","uniform vec4 terrainCliffLayer;","uniform vec2 terrainCliffCosines;","uniform vec4 terrainBrush;","uniform sampler2D terrainColorMap;","uniform sampler2D terrainNoiseMap;","uniform vec3 terrainWetShore;","varying vec2 vTerrainLocalXY;","varying float vTerrainLocalZ;","varying vec2 vTerrainWorldXY;","varying float vTerrainUp;","","// The rotation of the copies of textures used to make repetition less visible.","const mat2 terrainCopyRotation = mat2(0.8, -0.6, 0.6, 0.8);","/** A bump of a normal map (from -1 to 1), mixed with its rotated copy in patches. */","vec3 terrainSampleNormal(sampler2D normalMap, vec2 uv, vec2 uv2, float patches) {","  vec3 bump = texture2D(normalMap, uv).xyz * 2.0 - 1.0;","  if (patches <= 0.0) return bump;","  vec3 copyBump = texture2D(normalMap, uv2).xyz * 2.0 - 1.0;","  // The bumps of the copy are rotated back with the inverse rotation.","  copyBump.xy = transpose(terrainCopyRotation) * copyBump.xy;","  return mix(bump, copyBump, patches);","}","/**"," * 4 independent value noises (one by channel), from 0 to 1, smoothly varying"," * between random values at integer positions."," */","vec4 terrainNoise(vec2 p) {","  vec2 i = floor(p);","  vec2 f = p - i;","  // The read position is moved so that the linear interpolation of the","  // texture between 2 random values becomes a smooth one.","  return texture2D(terrainNoiseMap, (i + f * f * (3.0 - 2.0 * f) + 0.5) / ${NOISE_MAP_SIZE}.0);","}","`;","// Holes are samples without any painted layer: the interpolated sum of the","// weights gives smooth edges. Only compiled for terrains having holes, as","// discard makes drawing slower on some GPUs.","const holeShaderCode = `","#ifdef TERRAIN_HOLES","if (dot(texture2D(terrainSplatMap, vTerrainLocalXY * terrainSplatUvScaleAndOffset.x + terrainSplatUvScaleAndOffset.y), vec4(1.0)) < 0.5) discard;","#endif","`;","// For the shadows: the depth of holes is not drawn.","const holeDepthShaderDeclarations = `","uniform sampler2D terrainSplatMap;","uniform vec2 terrainSplatUvScaleAndOffset;","varying vec2 vTerrainLocalXY;","`;","","// Layers without texture, normal map, height blending or texture variation","// are compiled out (see TerrainRenderer.updateMaterial).","const fragmentShaderCode = holeShaderCode + `","// Borders between layers are made irregular and sharper, to look painted.","vec4 terrainJitter = terrainNoise(vTerrainWorldXY / 24.0);","// Layer weights are in a texture, so that painted details stay the same","// whatever the level of detail of the ground.","vec2 terrainSplatUv = vTerrainLocalXY * terrainSplatUvScaleAndOffset.x + terrainSplatUvScaleAndOffset.y;","vec4 terrainWeights = texture2D(terrainSplatMap, terrainSplatUv) * (0.7 + 0.6 * terrainJitter);","terrainWeights = terrainWeights * terrainWeights;","terrainWeights /= max(dot(terrainWeights, vec4(1.0)), 0.00001);","float terrainCliff = 1.0 - smoothstep(terrainCliffCosines.x, terrainCliffCosines.y, vTerrainUp);","terrainWeights = mix(terrainWeights, terrainCliffLayer, terrainCliff * dot(terrainCliffLayer, vec4(1.0)));","","vec2 terrainUv = vTerrainWorldXY / terrainTextureSize;","${forEachLayerCode(","    (layer) => `#ifdef TERRAIN_LAYER_MAP_${layer}","vec3 terrainTexture${layer} = texture2D(terrainLayerMap${layer}, terrainUv).rgb;","#else","vec3 terrainTexture${layer} = vec3(1.0);","#endif`",")}","","// Less visible repetition: in irregular patches, textures are replaced by a","// rotated and shifted copy of themselves, and colors slowly vary.","float terrainPatches = 0.0;","vec2 terrainUv2 = terrainUv;","float terrainColorVariation = 1.0;","#ifdef TERRAIN_TEXTURE_VARIATION","// Up to half of the ground is covered by the copies, each patch showing","// only one of them (mixing them would make them blurry).","float terrainPatchThreshold = 1.0 - 0.5 * terrainTextureVariation;","terrainPatches = smoothstep(terrainPatchThreshold - 0.05, terrainPatchThreshold + 0.05, terrainNoise(terrainUv * 0.23 + 7.3).x);","terrainUv2 = terrainCopyRotation * terrainUv + vec2(0.31, 0.73);","${forEachLayerCode(","    (layer) => `#ifdef TERRAIN_LAYER_MAP_${layer}","terrainTexture${layer} = mix(terrainTexture${layer}, texture2D(terrainLayerMap${layer}, terrainUv2).rgb, terrainPatches);","#endif`",")}","terrainColorVariation += terrainTextureVariation * 0.3 *","  (terrainNoise(terrainUv * 0.11).y + 0.5 * terrainNoise(terrainUv * 0.37 + 3.1).z - 0.75);","#endif","","// Height-based blending: the brightness of a texture, compared to its","// average, is used as its height. Where layers meet, the high parts (stones,","// tufts) cover the low parts (sand, gaps) instead of fading into each other.","#ifdef TERRAIN_HEIGHT_BLENDING","// Averages are computed once on the CPU, or read from the smallest mipmap","// when the image can't be read by the CPU.","${forEachLayerCode(","    (layer) => `#ifdef TERRAIN_LAYER_MIPMAP_AVERAGE_${layer}","vec3 terrainAverage${layer} = textureLod(terrainLayerMap${layer}, vec2(0.5), 16.0).rgb;","#else","vec3 terrainAverage${layer} = terrainLayerAverageColors[${layer}];","#endif`",")}","const vec3 terrainLuminance = vec3(0.299, 0.587, 0.114);","vec4 terrainHeights = vec4(","  dot(terrainTexture0 - terrainAverage0, terrainLuminance),","  dot(terrainTexture1 - terrainAverage1, terrainLuminance),","  dot(terrainTexture2 - terrainAverage2, terrainLuminance),","  dot(terrainTexture3 - terrainAverage3, terrainLuminance)",");","vec4 terrainHeightWeights = terrainWeights + terrainHeights;","float terrainTop = max(max(terrainHeightWeights.x, terrainHeightWeights.y), max(terrainHeightWeights.z, terrainHeightWeights.w));","// Only painted layers (and the cliff layer) can show.","vec4 terrainHeightBlend = max(terrainHeightWeights - terrainTop + 0.1, 0.0) * step(0.004, terrainWeights);","terrainHeightBlend /= max(dot(terrainHeightBlend, vec4(1.0)), 0.00001);","terrainWeights = mix(terrainWeights, terrainHeightBlend, terrainHeightBlending);","#endif","","vec3 terrainColor = terrainColorVariation * (","  terrainWeights.x * terrainLayerColors[0] * terrainTexture0 +","  terrainWeights.y * terrainLayerColors[1] * terrainTexture1 +","  terrainWeights.z * terrainLayerColors[2] * terrainTexture2 +","  terrainWeights.w * terrainLayerColors[3] * terrainTexture3);","","// The painted tint multiplies all layers. Wet ground is darker (and","// shinier, see the roughness).","vec4 terrainTintAndWetness = texture2D(terrainColorMap, terrainSplatUv);","float terrainWetness = max(","  terrainTintAndWetness.a,","  terrainWetShore.z * (1.0 - smoothstep(terrainWetShore.x, terrainWetShore.x + terrainWetShore.y, vTerrainLocalZ))",");","terrainColor *= terrainTintAndWetness.rgb * (1.0 - 0.4 * terrainWetness);","diffuseColor.rgb *= terrainColor;","","if (terrainBrush.w > 0.5) {","  float brushDistance = distance(vTerrainWorldXY, terrainBrush.xy);","  float ringWidth = max(terrainBrush.z * 0.04, 1.5);","  float ring = 1.0 - smoothstep(0.0, ringWidth, abs(brushDistance - terrainBrush.z));","  float disc = brushDistance < terrainBrush.z ? 0.12 : 0.0;","  diffuseColor.rgb = mix(diffuseColor.rgb, vec3(1.0), max(ring * 0.85, disc));","}","`;","","const fragmentShaderRoughnessCode = `","roughnessFactor = mix(roughnessFactor, 0.3, terrainWetness);","`;","","const fragmentShaderNormalCode = `","#ifdef TERRAIN_NORMAL_MAPS","// Layers without normal map are flat.","vec3 terrainMapNormal = vec3(0.0);","${forEachLayerCode(","    (layer) => `#ifdef TERRAIN_LAYER_NORMAL_MAP_${layer}","terrainMapNormal += terrainWeights[${layer}] * terrainSampleNormal(terrainLayerNormalMap${layer}, terrainUv, terrainUv2, terrainPatches);","#else","terrainMapNormal.z += terrainWeights[${layer}];","#endif`",")}","terrainMapNormal.xy *= terrainNormalMapStrength;","// The X and Y of textures follow the X and Y of the 3D world, projected on","// the ground (the camera space of the normal is used).","vec3 terrainTangent = (viewMatrix * vec4(1.0, 0.0, 0.0, 0.0)).xyz;","terrainTangent -= normal * dot(normal, terrainTangent);","// A ground facing the X axis (a rotated terrain) uses the Y axis instead.","if (dot(terrainTangent, terrainTangent) < 0.000001) {","  terrainTangent = (viewMatrix * vec4(0.0, 1.0, 0.0, 0.0)).xyz;","  terrainTangent -= normal * dot(normal, terrainTangent);","}","terrainTangent = normalize(terrainTangent);","vec3 terrainBitangent = cross(normal, terrainTangent);","normal = normalize(mat3(terrainTangent, terrainBitangent, normal) * terrainMapNormal);","#endif","`;","","let whiteTexture = null;","const getWhiteTexture = () => {","    if (!whiteTexture) {","        whiteTexture = new THREE.DataTexture(new Uint8Array([255, 255, 255, 255]), 1, 1);","        whiteTexture.needsUpdate = true;","    }","    return whiteTexture;","};","","let flatNormalTexture = null;","const getFlatNormalTexture = () => {","    if (!flatNormalTexture) {","        flatNormalTexture = new THREE.DataTexture(new Uint8Array([128, 128, 255, 255]), 1, 1);","        flatNormalTexture.needsUpdate = true;","    }","    return flatNormalTexture;","};","","let noiseTexture = null;","/** Random values, in 4 independent channels, read by `terrainNoise` in the shader. */","const getNoiseTexture = () => {","    if (!noiseTexture) {","        const random = createRandom(1);","        const bytes = new Uint8Array(NOISE_MAP_SIZE * NOISE_MAP_SIZE * 4);","        for (let index = 0; index < bytes.length; index++) {","            bytes[index] = Math.floor(random() * 256);","        }","        noiseTexture = new THREE.DataTexture(bytes, NOISE_MAP_SIZE, NOISE_MAP_SIZE);","        noiseTexture.wrapS = THREE.RepeatWrapping;","        noiseTexture.wrapT = THREE.RepeatWrapping;","        // No mipmaps: the shader moves the read position between samples.","        noiseTexture.magFilter = THREE.LinearFilter;","        noiseTexture.minFilter = THREE.LinearFilter;","        noiseTexture.needsUpdate = true;","    }","    return noiseTexture;","};","","const DEFAULT_ANISOTROPY = 4;","/** @type {WeakMap<THREE.Texture, Map<number, THREE.Texture>>} */","const layerTextures = new WeakMap();","/** @type {WeakMap<THREE.Texture, Map<number, THREE.Texture>>} */","const layerNormalMaps = new WeakMap();","/**"," * Textures of the image manager have no mipmaps: they would shimmer when"," * repeated in the distance."," * @param {gdjs.RuntimeGame} game"," * @param {string} resourceName"," * @param {boolean} isNormalMap Normal maps are directions, not colors."," * @param {number} anisotropy"," */","const getLayerTexture = (game, resourceName, isNormalMap, anisotropy) => {","    if (!resourceName) return isNormalMap ? getFlatNormalTexture() : getWhiteTexture();","    const imageTexture = game.getImageManager().getThreeTexture(resourceName);","    const texturesByImage = isNormalMap ? layerNormalMaps : layerTextures;","    let texturesByAnisotropy = texturesByImage.get(imageTexture);","    if (!texturesByAnisotropy) {","        texturesByAnisotropy = new Map();","        texturesByImage.set(imageTexture, texturesByAnisotropy);","    }","    let texture = texturesByAnisotropy.get(anisotropy);","    if (!texture) {","        texture = imageTexture.clone();","        if (isNormalMap) texture.colorSpace = THREE.NoColorSpace;","        texture.wrapS = THREE.RepeatWrapping;","        texture.wrapT = THREE.RepeatWrapping;","        texture.minFilter = THREE.LinearMipmapLinearFilter;","        texture.generateMipmaps = true;","        texture.anisotropy = anisotropy;","        texture.needsUpdate = true;","        texturesByAnisotropy.set(anisotropy, texture);","    }","    return texture;","};","","/** @type {Float32Array | null} */","let srgbToLinearValues = null;","/** @type {WeakMap<object, THREE.Vector3>} */","const linearAverageColors = new WeakMap();","/**"," * @param {THREE.Texture} texture"," * @returns {THREE.Vector3 | null} The average color of the texture, in the"," * linear color space (like colors read by shaders), or null if the image"," * can't be read: not loaded yet, or from another domain without CORS."," */","const getLinearAverageColor = (texture) => {","    const image = texture.image;","    if (!image) return null;","    const cachedColor = linearAverageColors.get(image);","    if (cachedColor) return cachedColor;","    const isDrawable =","        typeof document !== 'undefined' &&","        ((image instanceof HTMLImageElement && image.complete && image.naturalWidth > 0) ||","            image instanceof HTMLCanvasElement ||","            (typeof ImageBitmap !== 'undefined' && image instanceof ImageBitmap));","    if (!isDrawable) return null;","    const size = 64;","    let pixels;","    try {","        const canvas = document.createElement('canvas');","        canvas.width = size;","        canvas.height = size;","        const context = canvas.getContext('2d');","        // Downscaled with filtering, so that all pixels are counted.","        context.imageSmoothingEnabled = true;","        context.imageSmoothingQuality = 'high';","        context.drawImage(image, 0, 0, size, size);","        pixels = context.getImageData(0, 0, size, size).data;","    } catch (error) {","        return null;","    }","    if (!srgbToLinearValues) {","        srgbToLinearValues = new Float32Array(256);","        for (let value = 0; value < 256; value++) {","            const srgb = value / 255;","            srgbToLinearValues[value] = srgb <= 0.04045 ? srgb / 12.92 : Math.pow((srgb + 0.055) / 1.055, 2.4);","        }","    }","    const isSrgb = texture.colorSpace === THREE.SRGBColorSpace;","    let red = 0;","    let green = 0;","    let blue = 0;","    for (let index = 0; index < pixels.length; index += 4) {","        red += isSrgb ? srgbToLinearValues[pixels[index]] : pixels[index] / 255;","        green += isSrgb ? srgbToLinearValues[pixels[index + 1]] : pixels[index + 1] / 255;","        blue += isSrgb ? srgbToLinearValues[pixels[index + 2]] : pixels[index + 2] / 255;","    }","    const count = size * size;","    const color = new THREE.Vector3(red / count, green / count, blue / count);","    linearAverageColors.set(image, color);","    return color;","};","","/**"," * A texture of 4 bytes per sample of a grid of `size * size` samples (layer"," * weights, tint and wetness...), interpolated between samples."," * @param {Uint8Array} bytes"," * @param {number} size"," */","const createGridTexture = (bytes, size) => {","    const texture = new THREE.DataTexture(bytes, size, size);","    texture.magFilter = THREE.LinearFilter;","    texture.minFilter = THREE.LinearFilter;","    texture.userData.isUploaded = false;","    texture.onUpdate = () => {","        texture.userData.isUploaded = true;","    };","    return texture;","};","","/**"," * Send the rows of the changed samples to the GPU, or the whole texture"," * before its first upload (and in older GDevelop versions)."," * @param {THREE.DataTexture} texture"," * @param {SampleRectangle} samples"," */","const uploadGridTextureRows = (texture, samples) => {","    if (texture.userData.isUploaded && typeof texture.addUpdateRange === 'function') {","        const size = texture.image.width;","        for (let j = samples.minJ; j <= samples.maxJ; j++) {","            texture.addUpdateRange((j * size + samples.minI) * 4, (samples.maxI - samples.minI + 1) * 4);","        }","    }","    texture.needsUpdate = true;","};","","class TerrainRenderer {","    /** @param {Terrain} terrain */","    constructor(terrain) {","        this.terrain = terrain;","        this.group = new THREE.Group();","        terrain.object.get3DRendererObject().add(this.group);","        /** @type {Array<{mesh: THREE.Mesh, geometry: THREE.BufferGeometry, firstI: number, firstJ: number, center: THREE.Vector3, lod: number}>} */","        this.chunks = [];","        this.chunksPerSide = 0;","        this.chunkCells = 0;","        this.chunkSideVertices = 0;","        this.chunkGridVertices = 0;","        this.chunkVertices = 0;","        /** @type {THREE.DataTexture | null} */","        this.splatTexture = null;","        /** @type {THREE.DataTexture | null} */","        this.colorTexture = null;","        this.uniforms = {","            terrainSplatMap: { value: getWhiteTexture() },","            terrainSplatUvScaleAndOffset: { value: new THREE.Vector2() },","            terrainLayerColors: { value: [new THREE.Color(), new THREE.Color(), new THREE.Color(), new THREE.Color()] },","            terrainLayerMap0: { value: getWhiteTexture() },","            terrainLayerMap1: { value: getWhiteTexture() },","            terrainLayerMap2: { value: getWhiteTexture() },","            terrainLayerMap3: { value: getWhiteTexture() },","            // Used by the height blending, in the linear color space.","            terrainLayerAverageColors: {","                value: [new THREE.Vector3(1, 1, 1), new THREE.Vector3(1, 1, 1), new THREE.Vector3(1, 1, 1), new THREE.Vector3(1, 1, 1)],","            },","            terrainLayerNormalMap0: { value: getFlatNormalTexture() },","            terrainLayerNormalMap1: { value: getFlatNormalTexture() },","            terrainLayerNormalMap2: { value: getFlatNormalTexture() },","            terrainLayerNormalMap3: { value: getFlatNormalTexture() },","            terrainNormalMapStrength: { value: 1 },","            terrainTextureSize: { value: 256 },","            terrainHeightBlending: { value: 0 },","            terrainTextureVariation: { value: 0 },","            terrainCliffLayer: { value: new THREE.Vector4() },","            terrainCliffCosines: { value: new THREE.Vector2() },","            terrainBrush: { value: new THREE.Vector4() },","            terrainColorMap: { value: getWhiteTexture() },","            terrainNoiseMap: { value: getNoiseTexture() },","            // Z (in the terrain group) under which the ground is wet, fade height, and 1 if it's used.","            terrainWetShore: { value: new THREE.Vector3() },","            // Scene units by 3D world unit.","            terrainWorldScale: { value: 1 },","        };","        this.material = new THREE.MeshStandardMaterial({ roughness: 1, metalness: 0 });","        this.material.onBeforeCompile = (shader) => {","            Object.assign(shader.uniforms, this.uniforms);","            shader.vertexShader = patchShaderCode(shader.vertexShader, [","                ['#include <common>', '#include <common>\\n' + vertexShaderDeclarations],","                ['#include <begin_vertex>', '#include <begin_vertex>\\n' + vertexShaderCode],","            ], 'Terrain3D');","            shader.fragmentShader = patchShaderCode(shader.fragmentShader, [","                ['#include <common>', '#include <common>\\n' + fragmentShaderDeclarations],","                ['#include <map_fragment>', fragmentShaderCode],","                ['#include <roughnessmap_fragment>', '#include <roughnessmap_fragment>\\n' + fragmentShaderRoughnessCode],","                ['#include <normal_fragment_maps>', '#include <normal_fragment_maps>\\n' + fragmentShaderNormalCode],","            ], 'Terrain3D');","        };","        this.hasHoles = false;","        /** The defines of the features used by the terrain (see `updateMaterial`), without holes. */","        this.featureDefines = [];","        /** All the defines of the shader, separated by semicolons. */","        this.shaderKey = '';","        this.material.customProgramCacheKey = () => 'Terrain3D;' + this.shaderKey;","        // Without them, holes would cast shadows.","        this.depthMaterial = this._createHoleDepthMaterial(new THREE.MeshDepthMaterial());","        this.distanceMaterial = this._createHoleDepthMaterial(new THREE.MeshDistanceMaterial());","        this._cameraPosition = new THREE.Vector3();","        this._chunkPosition = new THREE.Vector3();","        this._scale = new THREE.Vector3();","    }","","    /**","     * @param {THREE.MeshDepthMaterial | THREE.MeshDistanceMaterial} material","     * @returns The material, drawing nothing in holes.","     */","    _createHoleDepthMaterial(material) {","        material.defines = { TERRAIN_HOLES: '' };","        material.onBeforeCompile = (shader) => {","            Object.assign(shader.uniforms, this.uniforms);","            shader.vertexShader = patchShaderCode(shader.vertexShader, [","                ['#include <common>', '#include <common>\\nvarying vec2 vTerrainLocalXY;'],","                ['#include <begin_vertex>', '#include <begin_vertex>\\nvTerrainLocalXY = position.xy;'],","            ], 'Terrain3D shadows');","            shader.fragmentShader = patchShaderCode(shader.fragmentShader, [","                ['#include <common>', '#include <common>\\n' + holeDepthShaderDeclarations],","                ['#include <clipping_planes_fragment>', holeShaderCode + '#include <clipping_planes_fragment>'],","            ], 'Terrain3D shadows');","        };","        material.customProgramCacheKey = () => 'Terrain3DHoles';","        return material;","    }","","    /**","     * Use the shaders drawing holes, or the faster ones without them.","     * @param {boolean} hasHoles","     */","    setHasHoles(hasHoles) {","        if (hasHoles === this.hasHoles) return;","        this.hasHoles = hasHoles;","        this._updateShaderDefines();","        for (const chunk of this.chunks) this._setChunkShadowMaterials(chunk.mesh);","    }","","    /**","     * Compile the shader only with the features used by the terrain. It is","     * compiled again only when they change: properties only change in the","     * editor, holes can be made by actions.","     */","    _updateShaderDefines() {","        const defines = this.hasHoles ? [...this.featureDefines, 'TERRAIN_HOLES'] : this.featureDefines;","        const shaderKey = defines.join(';');","        if (shaderKey === this.shaderKey) return;","        // The material has its own defines (STANDARD).","        for (const name of this.shaderKey ? this.shaderKey.split(';') : []) {","            delete this.material.defines[name];","        }","        for (const name of defines) {","            this.material.defines[name] = '';","        }","        this.shaderKey = shaderKey;","        this.material.needsUpdate = true;","    }","","    /** @param {THREE.Mesh} mesh */","    _setChunkShadowMaterials(mesh) {","        mesh.customDepthMaterial = this.hasHoles ? this.depthMaterial : undefined;","        mesh.customDistanceMaterial = this.hasHoles ? this.distanceMaterial : undefined;","    }","","    /** Recreate all the chunks, for example after the resolution changed. */","    rebuild() {","        this.disposeChunks();","        const { data } = this.terrain;","        this.chunkCells = getChunkCells(data.resolution);","        this.chunkSideVertices = this.chunkCells + 1;","        this.chunkGridVertices = this.chunkSideVertices * this.chunkSideVertices;","        this.chunkVertices = this.chunkGridVertices + 4 * this.chunkSideVertices;","        this.chunksPerSide = data.resolution / this.chunkCells;","        const cellSize = AREA_SIZE / data.resolution;","        // Sample centers are at the texel centers.","        this.splatTexture = createGridTexture(data.splat, data.size);","        this.uniforms.terrainSplatMap.value = this.splatTexture;","        this.colorTexture = createGridTexture(data.colors, data.size);","        // Tints are colors chosen like the layer colors.","        this.colorTexture.colorSpace = THREE.SRGBColorSpace;","        this.uniforms.terrainColorMap.value = this.colorTexture;","        this.uniforms.terrainSplatUvScaleAndOffset.value.set(1 / (cellSize * data.size), 0.5 / data.size);","        for (let chunkJ = 0; chunkJ < this.chunksPerSide; chunkJ++) {","            for (let chunkI = 0; chunkI < this.chunksPerSide; chunkI++) {","                const firstI = chunkI * this.chunkCells;","                const firstJ = chunkJ * this.chunkCells;","                const positions = new Float32Array(this.chunkVertices * 3);","                for (let j = 0; j < this.chunkSideVertices; j++) {","                    for (let i = 0; i < this.chunkSideVertices; i++) {","                        const vertex = j * this.chunkSideVertices + i;","                        positions[vertex * 3] = (firstI + i) * cellSize;","                        positions[vertex * 3 + 1] = (firstJ + j) * cellSize;","                    }","                }","                // Skirt vertices are below border vertices.","                this._forEachSkirtVertex((skirtVertex, borderVertex) => {","                    positions[skirtVertex * 3] = positions[borderVertex * 3];","                    positions[skirtVertex * 3 + 1] = positions[borderVertex * 3 + 1];","                });","                const geometry = new THREE.BufferGeometry();","                geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));","                geometry.setAttribute('normal', new THREE.BufferAttribute(new Float32Array(this.chunkVertices * 3), 3));","                geometry.setIndex(getLodIndex(this.chunkCells, LOD_STEPS[0]));","                geometry.boundingBox = new THREE.Box3();","                geometry.boundingSphere = new THREE.Sphere();","                const mesh = new THREE.Mesh(geometry, this.material);","                mesh.matrixAutoUpdate = false;","                // Rays hit the ground at its full resolution, whatever the level of","                // detail drawn, and go through holes.","                const chunkCells = this.chunkCells;","                const terrainData = () => this.terrain.data;","                const localPoint = new THREE.Vector3();","                mesh.raycast = function (raycaster, intersects) {","                    const drawnIndex = geometry.index;","                    const firstIntersection = intersects.length;","                    geometry.setIndex(getLodIndex(chunkCells, LOD_STEPS[0]));","                    THREE.Mesh.prototype.raycast.call(this, raycaster, intersects);","                    geometry.setIndex(drawnIndex);","                    const data = terrainData();","                    const cellSize = AREA_SIZE / data.resolution;","                    for (let index = intersects.length - 1; index >= firstIntersection; index--) {","                        this.worldToLocal(localPoint.copy(intersects[index].point));","                        if (data.sampleSolidity(localPoint.x / cellSize, localPoint.y / cellSize) < 0.5) {","                            intersects.splice(index, 1);","                        }","                    }","                };","                this._setChunkShadowMaterials(mesh);","                this.group.add(mesh);","                this.chunks.push({","                    mesh,","                    geometry,","                    firstI,","                    firstJ,","                    center: new THREE.Vector3(","                        (firstI + this.chunkCells / 2) * cellSize,","                        (firstJ + this.chunkCells / 2) * cellSize,","                        0","                    ),","                    lod: 0,","                });","            }","        }","        this.updateSamples(new SampleRectangle().set(0, 0, data.resolution, data.resolution), true);","        this.updateMaterial();","    }","","    _forEachSkirtVertex(callback) {","        for (let k = 0; k < this.chunkSideVertices; k++) {","            callback(this.chunkGridVertices + k, k);","            callback(this.chunkGridVertices + this.chunkSideVertices + k, this.chunkCells * this.chunkSideVertices + k);","            callback(this.chunkGridVertices + 2 * this.chunkSideVertices + k, k * this.chunkSideVertices);","            callback(","                this.chunkGridVertices + 3 * this.chunkSideVertices + k,","                k * this.chunkSideVertices + this.chunkCells","            );","        }","    }","","    /**","     * Skirts go down only to the lowest point a coarser neighbor chunk can","     * draw along the border, so that they can't be seen through holes.","     * @param {Float32Array} positions","     */","    _updateSkirtHeights(positions) {","        const coarsestStep = LOD_STEPS[LOD_STEPS.length - 1];","        const borderVertices = [","            (k) => k,","            (k) => this.chunkCells * this.chunkSideVertices + k,","            (k) => k * this.chunkSideVertices,","            (k) => k * this.chunkSideVertices + this.chunkCells,","        ];","        borderVertices.forEach((borderVertex, border) => {","            for (let k = 0; k < this.chunkSideVertices; k++) {","                let minZ = Infinity;","                const from = Math.max(k - coarsestStep, 0);","                const to = Math.min(k + coarsestStep, this.chunkCells);","                for (let other = from; other <= to; other++) {","                    minZ = Math.min(minZ, positions[borderVertex(other) * 3 + 2]);","                }","                const skirtVertex = this.chunkGridVertices + border * this.chunkSideVertices + k;","                positions[skirtVertex * 3 + 2] = minZ;","            }","        });","    }","","    /**","     * Update the vertices of the chunks sharing the given samples.","     * @param {SampleRectangle} samples","     * @param {boolean} hasPaintChanged","     */","    updateSamples(samples, hasPaintChanged) {","        if (samples.isEmpty()) return;","        const { data } = this.terrain;","        const cellSize = AREA_SIZE / data.resolution;","        const slopeFactor = AREA_DEPTH / cellSize;","        // Normals of samples next to changed ones change too.","        const minI = Math.max(samples.minI - 1, 0);","        const minJ = Math.max(samples.minJ - 1, 0);","        const maxI = Math.min(samples.maxI + 1, data.resolution);","        const maxJ = Math.min(samples.maxJ + 1, data.resolution);","        const firstChunkI = Math.max(Math.ceil(minI / this.chunkCells) - 1, 0);","        const firstChunkJ = Math.max(Math.ceil(minJ / this.chunkCells) - 1, 0);","        const lastChunkI = Math.min(Math.floor(maxI / this.chunkCells), this.chunksPerSide - 1);","        const lastChunkJ = Math.min(Math.floor(maxJ / this.chunkCells), this.chunksPerSide - 1);","","        for (let chunkJ = firstChunkJ; chunkJ <= lastChunkJ; chunkJ++) {","            for (let chunkI = firstChunkI; chunkI <= lastChunkI; chunkI++) {","                const chunk = this.chunks[chunkJ * this.chunksPerSide + chunkI];","                const positions = chunk.geometry.attributes.position.array;","                const normals = chunk.geometry.attributes.normal.array;","                const fromI = Math.max(minI - chunk.firstI, 0);","                const toI = Math.min(maxI - chunk.firstI, this.chunkCells);","                const fromJ = Math.max(minJ - chunk.firstJ, 0);","                const toJ = Math.min(maxJ - chunk.firstJ, this.chunkCells);","                for (let j = fromJ; j <= toJ; j++) {","                    const gridJ = chunk.firstJ + j;","                    for (let i = fromI; i <= toI; i++) {","                        const gridI = chunk.firstI + i;","                        const vertex = j * this.chunkSideVertices + i;","                        const sample = gridJ * data.size + gridI;","                        positions[vertex * 3 + 2] = data.heights[sample] * AREA_DEPTH;","","                        const leftI = Math.max(gridI - 1, 0);","                        const rightI = Math.min(gridI + 1, data.resolution);","                        const upJ = Math.max(gridJ - 1, 0);","                        const downJ = Math.min(gridJ + 1, data.resolution);","                        const nx =","                            ((data.getHeight(leftI, gridJ) - data.getHeight(rightI, gridJ)) * slopeFactor) /","                            (rightI - leftI);","                        const ny =","                            ((data.getHeight(gridI, upJ) - data.getHeight(gridI, downJ)) * slopeFactor) /","                            (downJ - upJ);","                        const inverseLength = 1 / Math.sqrt(nx * nx + ny * ny + 1);","                        normals[vertex * 3] = nx * inverseLength;","                        normals[vertex * 3 + 1] = ny * inverseLength;","                        normals[vertex * 3 + 2] = inverseLength;","                    }","                }","                this._forEachSkirtVertex((skirtVertex, borderVertex) => {","                    for (let axis = 0; axis < 3; axis++) {","                        normals[skirtVertex * 3 + axis] = normals[borderVertex * 3 + axis];","                    }","                });","                this._updateSkirtHeights(positions);","                let maxZ = 0;","                for (let vertex = 0; vertex < this.chunkGridVertices; vertex++) {","                    maxZ = Math.max(maxZ, positions[vertex * 3 + 2]);","                }","                const chunkSize = this.chunkCells * cellSize;","                chunk.geometry.boundingBox.min.set(chunk.firstI * cellSize, chunk.firstJ * cellSize, 0);","                chunk.geometry.boundingBox.max.set(","                    chunk.firstI * cellSize + chunkSize,","                    chunk.firstJ * cellSize + chunkSize,","                    maxZ","                );","                chunk.geometry.boundingBox.getBoundingSphere(chunk.geometry.boundingSphere);","                chunk.center.z = maxZ / 2;","                chunk.geometry.attributes.position.needsUpdate = true;","                chunk.geometry.attributes.normal.needsUpdate = true;","            }","        }","        if (hasPaintChanged) {","            // The data may have been replaced by one with the same resolution.","            this.splatTexture.image.data = data.splat;","            uploadGridTextureRows(this.splatTexture, samples);","            this.colorTexture.image.data = data.colors;","            uploadGridTextureRows(this.colorTexture, samples);","        }","    }","","    updateMaterial() {","        const { object } = this.terrain;","        const game = object.getRuntimeScene().getGame();","        const colors = [object._getLayer1Color(), object._getLayer2Color(), object._getLayer3Color(), object._getLayer4Color()];","        const textures = [","            object._getLayer1Texture(),","            object._getLayer2Texture(),","            object._getLayer3Texture(),","            object._getLayer4Texture(),","        ];","        const normalMaps = [","            object._getLayer1NormalMap(),","            object._getLayer2NormalMap(),","            object._getLayer3NormalMap(),","            object._getLayer4NormalMap(),","        ];","        const anisotropy = Math.max(parseInt(object._getAnisotropy(), 10) || DEFAULT_ANISOTROPY, 1);","        const heightBlending = clamp01(object._getHeightBlending());","        const textureVariation = clamp01(object._getTextureVariation());","        const featureDefines = [];","        for (let layer = 0; layer < LAYER_COUNT; layer++) {","            this.uniforms.terrainLayerColors.value[layer].set(gdjs.rgbOrHexStringToNumber(colors[layer]));","            const layerTexture = getLayerTexture(game, textures[layer], false, anisotropy);","            this.uniforms['terrainLayerMap' + layer].value = layerTexture;","            this.uniforms['terrainLayerNormalMap' + layer].value = getLayerTexture(game, normalMaps[layer], true, anisotropy);","            const averageColor = this.uniforms.terrainLayerAverageColors.value[layer];","            if (textures[layer]) {","                featureDefines.push('TERRAIN_LAYER_MAP_' + layer);","                const linearAverageColor = heightBlending > 0 ? getLinearAverageColor(layerTexture) : null;","                if (linearAverageColor) {","                    averageColor.copy(linearAverageColor);","                } else if (heightBlending > 0) {","                    featureDefines.push('TERRAIN_LAYER_MIPMAP_AVERAGE_' + layer);","                }","            } else {","                averageColor.set(1, 1, 1);","            }","            if (normalMaps[layer]) featureDefines.push('TERRAIN_LAYER_NORMAL_MAP_' + layer);","        }","        if (normalMaps.some((normalMap) => !!normalMap)) featureDefines.push('TERRAIN_NORMAL_MAPS');","        if (heightBlending > 0) featureDefines.push('TERRAIN_HEIGHT_BLENDING');","        if (textureVariation > 0) featureDefines.push('TERRAIN_TEXTURE_VARIATION');","        this.featureDefines = featureDefines;","        this._updateShaderDefines();","        this.uniforms.terrainNormalMapStrength.value = Math.max(object._getNormalMapStrength(), 0);","        this.uniforms.terrainTextureSize.value = Math.max(object._getTextureSize(), 1);","        this.uniforms.terrainHeightBlending.value = heightBlending;","        this.uniforms.terrainTextureVariation.value = textureVariation;","","        const cliffLayer = parseInt(object._getCliffLayer(), 10);","        const cliffAngle = gdjs.toRad(object._getCliffAngle());","        const cliffBlendAngle = gdjs.toRad(4);","        this.uniforms.terrainCliffLayer.value.set(","            cliffLayer === 1 ? 1 : 0,","            cliffLayer === 2 ? 1 : 0,","            cliffLayer === 3 ? 1 : 0,","            cliffLayer === 4 ? 1 : 0","        );","        this.uniforms.terrainCliffCosines.value.set(","            Math.cos(cliffAngle + cliffBlendAngle),","            Math.cos(cliffAngle - cliffBlendAngle)","        );","","        const castShadow = object._getCastShadow();","        const receiveShadow = object._getReceiveShadow();","        for (const chunk of this.chunks) {","            chunk.mesh.castShadow = castShadow;","            chunk.mesh.receiveShadow = receiveShadow;","        }","    }","","    /**","     * Show the brush circle of the editor.","     * @param {THREE.Vector3 | null} localPosition","     * @param {number} radius In scene units.","     */","    setBrush(localPosition, radius) {","        const brush = this.uniforms.terrainBrush.value;","        if (!localPosition) {","            brush.w = 0;","            return;","        }","        this.group.updateWorldMatrix(true, false);","        const worldPosition = this._chunkPosition.copy(localPosition).applyMatrix4(this.group.matrixWorld);","        const worldScale = this.uniforms.terrainWorldScale.value;","        brush.set(worldPosition.x * worldScale, worldPosition.y * worldScale, radius, 1);","    }","","    /** @param {THREE.Camera | null} camera */","    updateLevelsOfDetail(camera) {","        if (!camera || !this.group.visible) return;","        const matrixWorld = this.group.matrixWorld;","        this._cameraPosition.setFromMatrixPosition(camera.matrixWorld);","        this._scale.setFromMatrixScale(matrixWorld);","        const cellSize = AREA_SIZE / this.terrain.data.resolution;","        const chunkWorldSize = this.chunkCells * cellSize * Math.max(this._scale.x, this._scale.y);","        for (const chunk of this.chunks) {","            const distance =","                this._chunkPosition.copy(chunk.center).applyMatrix4(matrixWorld).distanceTo(this._cameraPosition) /","                chunkWorldSize;","            let lod = LOD_DISTANCES.length - 1;","            while (lod > 0 && distance < LOD_DISTANCES[lod]) lod--;","            if (lod !== chunk.lod) {","                chunk.lod = lod;","                chunk.geometry.setIndex(getLodIndex(this.chunkCells, LOD_STEPS[lod]));","            }","        }","    }","","    disposeChunks() {","        for (const chunk of this.chunks) {","            chunk.mesh.removeFromParent();","            // The index is shared by all chunks: it must stay on the GPU.","            chunk.geometry.setIndex(null);","            chunk.geometry.dispose();","        }","        this.chunks.length = 0;","        if (this.splatTexture) this.splatTexture.dispose();","        this.splatTexture = null;","        if (this.colorTexture) this.colorTexture.dispose();","        this.colorTexture = null;","    }","","    dispose() {","        this.disposeChunks();","        this.material.dispose();","        this.depthMaterial.dispose();","        this.distanceMaterial.dispose();","        this.group.removeFromParent();","    }","}","","/**"," * Makes a Physics3D behavior use a height field shape following the terrain."," * Changes of heights are applied to the shape without recreating it."," * @implements {gdjs.Physics3DRuntimeBehavior.BodyUpdater}"," */","class TerrainBodyUpdater {","    /**","     * @param {Terrain} terrain","     * @param {gdjs.Physics3DRuntimeBehavior} physics","     */","    constructor(terrain, physics) {","        this.terrain = terrain;","        this.physics = physics;","        this.defaultBodyUpdater = physics.bodyUpdater;","        this.changedSamples = new SampleRectangle();","        /** @type {Jolt.HeightFieldShape | null} */","        this.heightField = null;","        this.heightScale = 1;","        this.heightsBufferPointer = 0;","        this.heightsBufferLength = 0;","        this.bodyX = 0;","        this.bodyY = 0;","        this.bodyZ = 0;","        this.bodyHeight = 0;","        physics.bodyType = 'Static';","        physics.bodyUpdater = this;","    }","","    createShape() {","        const { data, object } = this.terrain;","        const worldInvScale = this.physics._sharedData.worldInvScale;","        const { size } = data;","        this.heightScale = object.getDepth() * worldInvScale;","","        // Changes of heights (SetHeights) break collisions unless the sample","        // count is a power of 2: extra samples have no collision.","        const sampleCount = Math.pow(2, Math.ceil(Math.log2(size)));","        const settings = new Jolt.HeightFieldShapeSettings();","        settings.mScale.Set(","            (object.getWidth() / data.resolution) * worldInvScale,","            1,","            (object.getHeight() / data.resolution) * worldInvScale","        );","        settings.mSampleCount = sampleCount;","        settings.mBlockSize = 4;","        // Allows later changes of heights on the whole depth of the object.","        settings.mMinHeightValue = 0;","        settings.mMaxHeightValue = this.heightScale;","        settings.mHeightSamples.resize(sampleCount * sampleCount);","        const samples = new Float32Array(","            Jolt.HEAPF32.buffer,","            Jolt.getPointer(settings.mHeightSamples.data()),","            sampleCount * sampleCount","        );","        const noCollision = Jolt.HeightFieldShapeConstantValues.prototype.cNoCollisionValue;","        samples.fill(noCollision);","        // Height fields go along X and Z: rows are flipped so that, once","        // rotated to have heights along Z, rows go along Y.","        for (let j = 0; j < size; j++) {","            const row = (size - 1 - j) * sampleCount;","            for (let i = 0; i < size; i++) {","                samples[row + i] = this._getSampleHeight(j * size + i, noCollision);","            }","        }","        const shape = settings.Create().Get();","        Jolt.destroy(settings);","        this.heightField = Jolt.castObject(shape, Jolt.HeightFieldShape);","        this.changedSamples.clear();","        return shape;","    }","","    /** @returns {number} The height of a sample in the shape, or no collision in a hole. */","    _getSampleHeight(index, noCollision) {","        const height = this.terrain.surfaceHeights[index];","        return Number.isNaN(height) ? noCollision : height * this.heightScale;","    }","","    _getBodyPosition() {","        const { object } = this.terrain;","        const worldInvScale = this.physics._sharedData.worldInvScale;","        this.bodyX = object.getX();","        this.bodyY = object.getY();","        this.bodyZ = object.getZ();","        // The origin of the height field is at the bottom of the terrain (see createShape).","        this.bodyHeight = object.getHeight();","        return this.physics._sharedData.getRVec3(","            object.getX() * worldInvScale,","            (object.getY() + object.getHeight()) * worldInvScale,","            object.getZ() * worldInvScale","        );","    }","","    _getBodyRotation() {","        // A quarter turn around X: heights go along Z.","        return this.physics._sharedData.getQuat(Math.SQRT1_2, 0, 0, Math.SQRT1_2);","    }","","    createAndAddBody() {","        const { physics } = this;","        const { bodyInterface } = physics._sharedData;","        const shape = this.createShape();","        const settings = new Jolt.BodyCreationSettings(","            shape,","            this._getBodyPosition(),","            this._getBodyRotation(),","            Jolt.EMotionType_Static,","            physics.getBodyLayer()","        );","        settings.mFriction = physics.friction;","        settings.mRestitution = physics.restitution;","        const body = bodyInterface.CreateBody(settings);","        Jolt.destroy(settings);","        bodyInterface.AddBody(body.GetID(), Jolt.EActivation_DontActivate);","        return body;","    }","","    updateObjectFromBody() {","        // The terrain is static: the body never moves it.","    }","","    updateBodyFromObject() {","        const { physics } = this;","        const body = physics._body;","        if (!body) return;","        const { object } = this.terrain;","        const { bodyInterface } = physics._sharedData;","        if (","            object.getX() !== this.bodyX ||","            object.getY() !== this.bodyY ||","            object.getZ() !== this.bodyZ ||","            object.getHeight() !== this.bodyHeight","        ) {","            bodyInterface.SetPositionAndRotation(","                body.GetID(),","                this._getBodyPosition(),","                this._getBodyRotation(),","                Jolt.EActivation_DontActivate","            );","        }","        if (!this.changedSamples.isEmpty()) {","            this._applyChangedHeights(body);","        }","    }","","    _applyChangedHeights(body) {","        const { data } = this.terrain;","        const { size } = data;","        const { minI, minJ, maxI, maxJ } = this.changedSamples;","        // Jolt only changes blocks of samples. Rows are flipped and extra","        // samples have no collision (see createShape).","        const blockSize = this.heightField.GetBlockSize();","        const sampleCount = this.heightField.GetSampleCount();","        const alignDown = (value) => Math.floor(value / blockSize) * blockSize;","        const alignUp = (value) => Math.min(Math.ceil(value / blockSize) * blockSize, sampleCount);","        const firstX = alignDown(minI);","        const firstRow = alignDown(size - 1 - maxJ);","        const width = alignUp(maxI + 1) - firstX;","        const height = alignUp(size - minJ) - firstRow;","        if (width * height > this.heightsBufferLength) {","            if (this.heightsBufferPointer) Jolt._webidl_free(this.heightsBufferPointer);","            this.heightsBufferLength = width * height;","            this.heightsBufferPointer = Jolt._webidl_malloc(this.heightsBufferLength * 4);","        }","        const heights = new Float32Array(Jolt.HEAPF32.buffer, this.heightsBufferPointer, width * height);","        const noCollision = Jolt.HeightFieldShapeConstantValues.prototype.cNoCollisionValue;","        for (let row = 0; row < height; row++) {","            const j = size - 1 - (firstRow + row);","            for (let column = 0; column < width; column++) {","                const i = firstX + column;","                heights[row * width + column] =","                    i < size && j >= 0 ? this._getSampleHeight(j * size + i, noCollision) : noCollision;","            }","        }","        const sharedData = this.physics._sharedData;","        this.heightField.SetHeights(","            firstX,","            firstRow,","            width,","            height,","            this.heightsBufferPointer,","            width,","            sharedData.jolt.GetTempAllocator()","        );","        sharedData.bodyInterface.NotifyShapeChanged(","            body.GetID(),","            sharedData.getVec3(0, 0, 0),","            false,","            Jolt.EActivation_DontActivate","        );","        this._wakeUpBodiesOnChangedSamples();","        this.changedSamples.clear();","    }","","    /** Bodies sleeping on the changed area would otherwise float or sink. */","    _wakeUpBodiesOnChangedSamples() {","        const { object, data } = this.terrain;","        const worldInvScale = this.physics._sharedData.worldInvScale;","        const cellWidth = object.getWidth() / data.resolution;","        const cellHeight = object.getHeight() / data.resolution;","        const { minI, minJ, maxI, maxJ } = this.changedSamples;","        const min = new Jolt.Vec3(","            (object.getX() + (minI - 1) * cellWidth) * worldInvScale,","            (object.getY() + (minJ - 1) * cellHeight) * worldInvScale,","            (object.getZ() - 1) * worldInvScale","        );","        const max = new Jolt.Vec3(","            (object.getX() + (maxI + 1) * cellWidth) * worldInvScale,","            (object.getY() + (maxJ + 1) * cellHeight) * worldInvScale,","            (object.getZ() + object.getDepth() + 1) * worldInvScale","        );","        const box = new Jolt.AABox(min, max);","        const broadPhaseLayerFilter = new Jolt.BroadPhaseLayerFilter();","        const objectLayerFilter = new Jolt.ObjectLayerFilter();","        this.physics._sharedData.bodyInterface.ActivateBodiesInAABox(box, broadPhaseLayerFilter, objectLayerFilter);","        Jolt.destroy(min);","        Jolt.destroy(max);","        Jolt.destroy(box);","        Jolt.destroy(broadPhaseLayerFilter);","        Jolt.destroy(objectLayerFilter);","    }","","    recreateShape() {","        const body = this.physics._body;","        if (!body) return;","        this.physics._sharedData.bodyInterface.SetShape(","            body.GetID(),","            this.createShape(),","            false,","            Jolt.EActivation_DontActivate","        );","        const { resolution } = this.terrain.data;","        this.changedSamples.set(0, 0, resolution, resolution);","        this._wakeUpBodiesOnChangedSamples();","        this.changedSamples.clear();","    }","","    destroyBody() {","        this.defaultBodyUpdater.destroyBody();","        this.heightField = null;","    }","","    dispose() {","        if (this.heightsBufferPointer) Jolt._webidl_free(this.heightsBufferPointer);","        this.heightsBufferPointer = 0;","        this.heightsBufferLength = 0;","    }","}","","/** @param {TerrainData} data */","const copyTerrainData = (data) => {","    const copy = new TerrainData(data.resolution);","    copy.copyFrom(data);","    return copy;","};","","// Generating a relief or reading an image is long for big terrains, and done","// for every instance and every hot-reload: the results are kept.","const baseDataCache = new Map();","const MAX_CACHED_BASE_DATA = 8;","// Changes of the shape of a terrain kept for consumers of its surface that","// missed some versions: older changes update the whole surface.","const MAX_SURFACE_CHANGES = 64;","// Unique among all terrains: a terrain replaced by another one never has its version.","let lastGroundVersion = 0;","","/**"," * The terrain of a Terrain3D object: its data, how it's drawn and its"," * surface (for collisions and navigation meshes). Positions are in the scene."," */","class Terrain {","    /** @param {gdjs.CustomRuntimeObject3D} object */","    constructor(object) {","        this.object = object;","        /** @type {TerrainData} */","        this.data = new TerrainData(DEFAULT_RESOLUTION);","        /** The data before any sculpting or painting, from the relief or heightmap. */","        this.baseData = this.data;","        this.renderer = new TerrainRenderer(this);","        /** @type {TerrainBodyUpdater[]} */","        this.bodyUpdaters = [];","        this.changedSamples = new SampleRectangle();","        this.hasPaintChanged = false;","        /** Increased each time the ground changes, for objects following it (like grass). */","        this.version = 0;","        /** Increased each time the shape of the ground changes (not its paint or position). */","        this.surfaceVersion = 0;","        /**","         * The last changes of the shape of the ground, for `getChangedArea`.","         * @type {Array<{version: number, samples: SampleRectangle}>}","         */","        this.surfaceChanges = [];","        /** The changes since this version are all in `surfaceChanges`. */","        this.surfaceChangesStartVersion = 0;","        this._stroke = { cellWidth: 1, cellHeight: 1, ax: 0, ay: 0, bx: 0, by: 0, radius: 0 };","        this._strokeChangedSamples = new SampleRectangle();","        /** The properties the data was loaded from, to reload it only if they change. */","        this.loadedFrom = '';","        /** The heightmap image being loaded: the relief is used until it is. */","        this.loadingHeightmapImage = '';","        this.isDisposed = false;","        /** The last value of the sculpt data property read or saved. */","        this.sculptData = '';","        /**","         * Values saved by the editor tools: the editor sends them back with a","         * hot-reload, possibly after newer ones were saved.","         * @type {string[]}","         */","        this.savedSculptData = [];","        /** The heights of the surface: the heights of the data, and NaN in holes. */","        this.surfaceHeights = new Float32Array(0);","        this.loadFromProperties();","        this._transform = this._getTransform();","        getGrounds(object.getRuntimeScene()).add(this);","        /**","         * The shape of the ground, for the physics engine and navigation meshes.","         * @type {gdjs.Surface}","         */","        this.surface = {","            getVersion: () => this.surfaceVersion,","            getChangedArea: (sinceVersion) => this.getChangedArea(sinceVersion),","            getTriangles: () => null,","            getHeightField: () => ({ columns: this.data.size, rows: this.data.size, heights: this.surfaceHeights }),","        };","        if (typeof object.setSurface === 'function') {","            object.setSurface(this.surface);","        } else if (gdjs.Physics3DRuntimeBehavior) {","            // Older GDevelop versions don't use surfaces.","            for (const behavior of object._behaviors) {","                if (behavior instanceof gdjs.Physics3DRuntimeBehavior) {","                    this.bodyUpdaters.push(new TerrainBodyUpdater(this, behavior));","                }","            }","        }","    }","","    _getSourceProperties() {","        const { object } = this;","        return [","            object._getResolution(),","            object._getRelief(),","            object._getSeed(),","            object._getHeightmapImage(),","            object._getEdits(),","        ].join('|');","    }","","    loadFromProperties() {","        const { object } = this;","        const resolution = parseInt(object._getResolution(), 10);","        const validResolution = RESOLUTIONS.indexOf(resolution) !== -1 ? resolution : DEFAULT_RESOLUTION;","        this.sculptData = object._getSculptData();","        this.loadedFrom = this._getSourceProperties();","","        this.baseData = this._getBaseData(validResolution);","        let data = codec.decode(this.sculptData, (resolution) => copyTerrainData(this._getBaseData(resolution)));","        if (data && data.resolution !== validResolution) {","            data = data.resampled(validResolution);","        }","        this.setData(data || copyTerrainData(this.baseData));","    }","","    /**","     * @param {number} resolution","     * @returns {TerrainData} The data from the relief or the heightmap, shared: it must not be changed.","     */","    _getBaseData(resolution) {","        const { object } = this;","        const key = [resolution, object._getRelief(), object._getSeed(), object._getHeightmapImage(), object._getEdits()].join('|');","        const cachedData = baseDataCache.get(key);","        if (cachedData) return cachedData;","","        const data = new TerrainData(resolution);","        const heightmapImage = object._getHeightmapImage();","        const isHeightmapLoaded =","            !!heightmapImage && loadHeightsFromImage(data, object.getRuntimeScene().getGame(), heightmapImage);","        if (!isHeightmapLoaded) {","            relief.generate(data, object._getRelief(), object._getSeed());","            if (heightmapImage) this._reloadOnceLoaded(heightmapImage);","        }","        edits.apply(data, object._getEdits());","        // Not kept if the image is missing: it may be loaded later.","        if (isHeightmapLoaded || !heightmapImage) baseDataCache.set(key, data);","        if (baseDataCache.size > MAX_CACHED_BASE_DATA) {","            baseDataCache.delete(baseDataCache.keys().next().value);","        }","        return data;","    }","","    /** @param {TerrainData} data */","    setData(data) {","        this.version = ++lastGroundVersion;","        this.surfaceVersion = this.version;","        this.surfaceChanges.length = 0;","        this.surfaceChangesStartVersion = this.version;","        const hasSameResolution = data.resolution === this.data.resolution && this.renderer.chunks.length > 0;","        this.data = data;","        const allSamples = new SampleRectangle().set(0, 0, data.resolution, data.resolution);","        this.surfaceHeights = new Float32Array(data.heights.length);","        this.renderer.setHasHoles(false);","        this._updateSurfaceHeights(allSamples);","        if (hasSameResolution) {","            this.renderer.updateSamples(allSamples, true);","        } else {","            this.renderer.rebuild();","        }","        for (const bodyUpdater of this.bodyUpdaters) {","            bodyUpdater.recreateShape();","        }","    }","","    onHotReloading() {","        const sculptData = this.object._getSculptData();","        const savedIndex = this.savedSculptData.indexOf(sculptData);","        if (savedIndex !== -1 && this._getSourceProperties() === this.loadedFrom) {","            // The terrain already has this data, or newer changes.","            this.savedSculptData.splice(0, savedIndex + 1);","        } else if (sculptData !== this.sculptData || this._getSourceProperties() !== this.loadedFrom) {","            this.savedSculptData.length = 0;","            this.loadFromProperties();","        }","        this.renderer.updateMaterial();","    }","","    /** @returns {string} The data to save in the sculpt data property. */","    save() {","        this.sculptData = codec.encode(this.data, this.baseData);","        this.savedSculptData.push(this.sculptData);","        return this.sculptData;","    }","","    getCellWidth() {","        return this.object.getWidth() / this.data.resolution;","    }","","    getCellHeight() {","        return this.object.getHeight() / this.data.resolution;","    }","","    _toGridX(x) {","        return (x - this.object.getX()) / this.getCellWidth();","    }","","    _toGridY(y) {","        return (y - this.object.getY()) / this.getCellHeight();","    }","","    /** @returns {number} The Z position of the ground. */","    getHeightAt(x, y) {","        return this.object.getZ() + this.data.sampleHeight(this._toGridX(x), this._toGridY(y)) * this.object.getDepth();","    }","","    /** @returns {number} The angle of the ground with the horizontal, in degrees. */","    getSlopeAt(x, y) {","        const gridX = this._toGridX(x);","        const gridY = this._toGridY(y);","        const { data } = this;","        const depth = this.object.getDepth();","        const slopeX = ((data.sampleHeight(gridX + 0.5, gridY) - data.sampleHeight(gridX - 0.5, gridY)) * depth) / this.getCellWidth();","        const slopeY = ((data.sampleHeight(gridX, gridY + 0.5) - data.sampleHeight(gridX, gridY - 0.5)) * depth) / this.getCellHeight();","        return gdjs.toDegrees(Math.atan(Math.hypot(slopeX, slopeY)));","    }","","    /** @returns {number} The layer painted the most, from 1 to 4. */","    getLayerAt(x, y) {","        return this.data.getDominantLayer(this._toGridX(x), this._toGridY(y)) + 1;","    }","","    /**","     * @param {number} layer From 1 to 4.","     * @returns {number} How much the layer is painted, from 0 to 1.","     */","    getLayerWeightAt(x, y, layer) {","        const layerIndex = clampInteger(layer - 1, 0, LAYER_COUNT - 1);","        return this.data.sampleLayerWeight(this._toGridX(x), this._toGridY(y), layerIndex);","    }","","    /** @returns {number[]} The painted tint: red, green and blue, from 0 to 255 (white when there is none). */","    getTintAt(x, y) {","        const gridX = this._toGridX(x);","        const gridY = this._toGridY(y);","        return [0, 1, 2].map((channel) => Math.round(this.data.sampleColor(gridX, gridY, channel) * 255));","    }","","    /** @returns {number} How wet the ground is, from 0 (dry) to 1, painted or near the water (see the wet shore). */","    getWetnessAt(x, y) {","        const paintedWetness = this.data.sampleColor(this._toGridX(x), this._toGridY(y), 3);","        const { object } = this;","        if (!object._getWetShore()) return paintedWetness;","        const fade = Math.max(object._getWetShoreFade(), 0.001);","        const shoreWetness = clamp01((object._getWetShoreZ() + fade - this.getHeightAt(x, y)) / fade);","        // Like the smoothstep of the shader.","        return Math.max(paintedWetness, shoreWetness * shoreWetness * (3 - 2 * shoreWetness));","    }","","    _isInArea(x, y) {","        const { object } = this;","        return (","            x >= object.getX() &&","            x <= object.getX() + object.getWidth() &&","            y >= object.getY() &&","            y <= object.getY() + object.getHeight()","        );","    }","","    /** @returns {boolean} true if the position is above or under the terrain, and not in a hole. */","    containsPoint(x, y) {","        return this._isInArea(x, y) && this.data.sampleSolidity(this._toGridX(x), this._toGridY(y)) >= 0.5;","    }","","    /** @returns {boolean} true if there is a hole in the terrain at the position, like what is drawn. */","    isHoleAt(x, y) {","        return this._isInArea(x, y) && this.data.sampleSolidity(this._toGridX(x), this._toGridY(y)) < 0.5;","    }","","    _getStroke(x1, y1, x2, y2, radius) {","        const stroke = this._stroke;","        stroke.cellWidth = this.getCellWidth();","        stroke.cellHeight = this.getCellHeight();","        stroke.ax = x1 - this.object.getX();","        stroke.ay = y1 - this.object.getY();","        stroke.bx = x2 - this.object.getX();","        stroke.by = y2 - this.object.getY();","        stroke.radius = Math.max(radius, 0);","        return stroke;","    }","","    /**","     * @param {SampleRectangle} samples","     * @param {boolean} haveHeightsChanged false when only the paint changed.","     */","    _onSamplesChanged(samples, haveHeightsChanged) {","        if (samples.isEmpty()) return;","        this.version = ++lastGroundVersion;","        this.changedSamples.add(samples);","        // Painting changes the surface when it makes holes or fills them.","        const hasSurfaceChanged = this._updateSurfaceHeights(samples);","        if (!haveHeightsChanged && !hasSurfaceChanged) return;","        this.surfaceVersion = this.version;","        this.surfaceChanges.push({ version: this.version, samples: new SampleRectangle().set(samples.minI, samples.minJ, samples.maxI, samples.maxJ) });","        if (this.surfaceChanges.length > MAX_SURFACE_CHANGES) {","            this.surfaceChangesStartVersion = this.surfaceChanges.shift().version;","        }","        for (const bodyUpdater of this.bodyUpdaters) {","            bodyUpdater.changedSamples.add(samples);","        }","    }","","    /**","     * @param {SampleRectangle} samples","     * @returns {boolean} true if heights of the surface changed, or holes were made or filled.","     */","    _updateSurfaceHeights(samples) {","        const { data, surfaceHeights } = this;","        let hasChanged = false;","        let hasHoles = false;","        for (let j = samples.minJ; j <= samples.maxJ; j++) {","            for (let i = samples.minI; i <= samples.maxI; i++) {","                const index = j * data.size + i;","                const isHole = data.isHole(index);","                const height = isHole ? NaN : data.heights[index];","                const previousHeight = surfaceHeights[index];","                if (isHole) {","                    hasHoles = true;","                    if (Number.isNaN(previousHeight)) continue;","                } else if (height === previousHeight) {","                    continue;","                }","                surfaceHeights[index] = height;","                hasChanged = true;","            }","        }","        // Filled holes keep the shaders drawing holes until the data is loaded again.","        if (hasHoles) this.renderer.setHasHoles(true);","        return hasChanged;","    }","","    /** @param {number} height In scene units, negative to lower the ground. */","    raise(x1, y1, x2, y2, radius, height) {","        const samples = this._strokeChangedSamples;","        brushes.raise(this.data, this._getStroke(x1, y1, x2, y2, radius), height / this.object.getDepth(), samples);","        this._onSamplesChanged(samples, true);","    }","","    /** @param {number} z The Z position to flatten the ground to. */","    /** @param {number} [toZ] The Z position at the end of the segment, for a slope. The same as z by default. */","    flatten(x1, y1, x2, y2, radius, z, strength, toZ = z) {","        const samples = this._strokeChangedSamples;","        const toHeight = (value) => (value - this.object.getZ()) / this.object.getDepth();","        brushes.flatten(this.data, this._getStroke(x1, y1, x2, y2, radius), toHeight(z), strength, samples, toHeight(toZ));","        this._onSamplesChanged(samples, true);","    }","","    smooth(x1, y1, x2, y2, radius, strength) {","        const samples = this._strokeChangedSamples;","        brushes.smooth(this.data, this._getStroke(x1, y1, x2, y2, radius), strength, samples);","        this._onSamplesChanged(samples, true);","    }","","    /** @param {number} layer From 1 to 4. */","    paint(x1, y1, x2, y2, radius, layer, strength) {","        const layerIndex = clampInteger(layer - 1, 0, LAYER_COUNT - 1);","        const samples = this._strokeChangedSamples;","        brushes.paint(this.data, this._getStroke(x1, y1, x2, y2, radius), layerIndex, strength, samples);","        this.hasPaintChanged = true;","        this._onSamplesChanged(samples, false);","    }","","    /** @param {number[]} color The red, green and blue (0-255) of the tint: white removes it. */","    tint(x1, y1, x2, y2, radius, color, strength) {","        const samples = this._strokeChangedSamples;","        brushes.tint(this.data, this._getStroke(x1, y1, x2, y2, radius), color, strength, samples);","        this.hasPaintChanged = true;","        this._onSamplesChanged(samples, false);","    }","","    /** @param {number} wetness From 0 (dry) to 1. */","    wet(x1, y1, x2, y2, radius, wetness, strength) {","        const samples = this._strokeChangedSamples;","        brushes.wet(this.data, this._getStroke(x1, y1, x2, y2, radius), wetness, strength, samples);","        this.hasPaintChanged = true;","        this._onSamplesChanged(samples, false);","    }","","    /** Make a hole around a segment (`fillHoles` fills it again). */","    makeHole(x1, y1, x2, y2, radius) {","        const samples = this._strokeChangedSamples;","        brushes.hole(this.data, this._getStroke(x1, y1, x2, y2, radius), samples);","        this.hasPaintChanged = true;","        this._onSamplesChanged(samples, false);","    }","","    /** Fill the holes around a segment with the layers of the ground around them. */","    fillHoles(x1, y1, x2, y2, radius) {","        const samples = this._strokeChangedSamples;","        brushes.fill(this.data, this._getStroke(x1, y1, x2, y2, radius), samples);","        this.hasPaintChanged = true;","        this._onSamplesChanged(samples, false);","    }","","    /**","     * Make the entrance of a tunnel or a cave: a hole, with the ground in","     * front of it flattened to the floor of the tunnel.","     * @param {number} angle The direction going into the ground, in degrees.","     * @param {number} floorZ","     * @param {number} length The length of the flat ground in front of the entrance.","     */","    carveEntrance(x, y, radius, angle, floorZ, length) {","        const directionX = Math.cos(gdjs.toRad(angle));","        const directionY = Math.sin(gdjs.toRad(angle));","        this.flatten(x - directionX * length, y - directionY * length, x, y, radius * 1.5, floorZ, 1);","        this.makeHole(x, y, x + directionX * radius, y + directionY * radius, radius);","    }","","    generate(reliefName, seed) {","        this.baseData = new TerrainData(this.data.resolution);","        relief.generate(this.baseData, reliefName, seed);","        this.setData(copyTerrainData(this.baseData));","    }","","    loadHeightmap(imageResourceName) {","        const baseData = new TerrainData(this.data.resolution);","        if (loadHeightsFromImage(baseData, this.object.getRuntimeScene().getGame(), imageResourceName)) {","            baseData.splat.set(this.data.splat);","            baseData.colors.set(this.data.colors);","            this.baseData = baseData;","            this.setData(copyTerrainData(baseData));","        }","    }","","    /** @param {gdjs.RuntimeObject[]} objects */","    placeOnGround(objects) {","        for (const object of objects) {","            if (object === this.object || !gdjs.Base3DHandler.is3D(object)) continue;","            const groundZ = this.getHeightAt(object.getCenterXInScene(), object.getCenterYInScene());","            // The origin of the object is not always at its bottom.","            object.setZ(groundZ + object.getZ() - object.getUnrotatedAABBMinZ());","        }","    }","","    /**","     * @returns {THREE.Vector3 | null} The point of the ground under the cursor,","     * in the terrain group coordinates. Holes are hit too, so that brushes can fill them.","     */","    raycastFromCursor(game, raycaster, ndc) {","        const layer = this.object.getInstanceContainer().getLayer(this.object.getLayer());","        const camera = layer.getRenderer().getThreeCamera();","        if (!camera) return null;","        const inputManager = game.getInputManager();","        ndc.set(","            (inputManager.getCursorX() / game.getGameResolutionWidth()) * 2 - 1,","            -(inputManager.getCursorY() / game.getGameResolutionHeight()) * 2 + 1","        );","        raycaster.setFromCamera(ndc, camera);","        this.renderer.group.updateWorldMatrix(true, false);","        const ray = raycaster.ray.clone().applyMatrix4(this.renderer.group.matrixWorld.clone().invert());","        ray.direction.normalize();","","        const box = new THREE.Box3(new THREE.Vector3(0, 0, 0), new THREE.Vector3(AREA_SIZE, AREA_SIZE, AREA_DEPTH));","        const entry = box.containsPoint(ray.origin) ? ray.origin.clone() : ray.intersectBox(box, new THREE.Vector3());","        if (!entry) return null;","        const cellSize = AREA_SIZE / this.data.resolution;","        const groundZAt = (point) => this.data.sampleHeight(point.x / cellSize, point.y / cellSize) * AREA_DEPTH;","        const step = cellSize / 2;","        const point = entry.clone();","        const previousPoint = entry.clone();","        for (let distance = 0; distance < AREA_SIZE * 2; distance += step) {","            if (point.z <= groundZAt(point)) {","                // Refine between the last point above the ground and this one.","                for (let iteration = 0; iteration < 8; iteration++) {","                    const middle = previousPoint.clone().lerp(point, 0.5);","                    if (middle.z <= groundZAt(middle)) point.copy(middle);","                    else previousPoint.copy(middle);","                }","                return point;","            }","            if (!box.containsPoint(point)) return null;","            previousPoint.copy(point);","            point.addScaledVector(ray.direction, step);","        }","        return null;","    }","","    /**","     * @param {THREE.Vector3} localPosition In the terrain group coordinates (like from `raycastFromCursor`).","     * @returns {{x: number, y: number, z: number}} The position in the scene.","     */","    toScenePosition(localPosition) {","        const { object } = this;","        return {","            x: object.getX() + (localPosition.x / AREA_SIZE) * object.getWidth(),","            y: object.getY() + (localPosition.y / AREA_SIZE) * object.getHeight(),","            z: object.getZ() + (localPosition.z / AREA_DEPTH) * object.getDepth(),","        };","    }","","    /** Draw the changes of the ground (collisions are updated by the physics engine). */","    applyChanges() {","        this.renderer.updateSamples(this.changedSamples, this.hasPaintChanged);","        this.changedSamples.clear();","        this.hasPaintChanged = false;","    }","","    /** @returns {number} A number changing each time the ground changes (see `getGrounds`). */","    getVersion() {","        return this.version;","    }","","    /**","     * @param {number} sinceVersion","     * @returns {gdjs.SurfaceArea | null} The part of the ground whose shape changed since the version (see `gdjs.Surface`).","     */","    getChangedArea(sinceVersion) {","        if (sinceVersion < this.surfaceChangesStartVersion) return null;","        const samples = new SampleRectangle();","        for (const change of this.surfaceChanges) {","            if (change.version > sinceVersion) samples.add(change.samples);","        }","        if (samples.isEmpty()) return { minX: 0, minY: 0, maxX: 0, maxY: 0 };","        const { resolution } = this.data;","        return {","            minX: samples.minI / resolution,","            minY: samples.minJ / resolution,","            maxX: samples.maxI / resolution,","            maxY: samples.maxJ / resolution,","        };","    }","","    _getTransform() {","        const { object } = this;","        return [object.getX(), object.getY(), object.getZ(), object.getWidth(), object.getHeight(), object.getDepth()].join(',');","    }","","    /** @param {string} imageResourceName A heightmap image that is not loaded yet. */","    _reloadOnceLoaded(imageResourceName) {","        if (this.loadingHeightmapImage === imageResourceName) return;","        this.loadingHeightmapImage = imageResourceName;","        const game = this.object.getRuntimeScene().getGame();","        game.getImageManager()","            .loadResource(imageResourceName)","            .then(() => {","                if (this.isDisposed || this.loadingHeightmapImage !== imageResourceName) return;","                this.loadingHeightmapImage = '';","                if (getLoadedImage(game, imageResourceName)) this.loadFromProperties();","            })","            .catch(() => {});","    }","","    update() {","        const transform = this._getTransform();","        if (transform !== this._transform) {","            this._transform = transform;","            this.version = ++lastGroundVersion;","        }","        this.applyChanges();","        this.renderer.uniforms.terrainWorldScale.value = getWorldScale(this.object);","        this._updateWetShore();","        const layer = this.object.getInstanceContainer().getLayer(this.object.getLayer());","        this.renderer.updateLevelsOfDetail(layer.getRenderer().getThreeCamera());","    }","","    _updateWetShore() {","        const { object } = this;","        // In the coordinates of the terrain group, like the vertices.","        const depthScale = AREA_DEPTH / Math.max(object.getDepth(), 0.0001);","        this.renderer.uniforms.terrainWetShore.value.set(","            (object._getWetShoreZ() - object.getZ()) * depthScale,","            Math.max(object._getWetShoreFade(), 0.001) * depthScale,","            object._getWetShore() ? 1 : 0","        );","    }","","    dispose() {","        this.isDisposed = true;","        getGrounds(this.object.getRuntimeScene()).delete(this);","        if (typeof this.object.setSurface === 'function' && this.object.getSurface() === this.surface) {","            this.object.setSurface(null);","        }","        this.renderer.dispose();","        for (const bodyUpdater of this.bodyUpdaters) {","            bodyUpdater.dispose();","        }","    }","}","","/**"," * @param {gdjs.RuntimeObject} object"," * @returns {number} The number of scene units by 3D world unit (1 in GDevelop versions before the world scale)."," */","const getWorldScale = (object) => {","    const scene = object.getRuntimeScene();","    return typeof scene.getRenderer3DWorldScale === 'function' ? scene.getRenderer3DWorldScale() : 1;","};","","/** @type {WeakMap<THREE.Vector3, THREE.Color>} */","const averageColors = new WeakMap();","let white = null;","/**"," * @param {THREE.Texture} texture"," * @returns {THREE.Color} The average color of the texture (white when it can't be read)."," */","const getAverageColor = (texture) => {","    const linearAverageColor = getLinearAverageColor(texture);","    if (!linearAverageColor) return white || (white = new THREE.Color(1, 1, 1));","    let color = averageColors.get(linearAverageColor);","    if (!color) {","        color = new THREE.Color(linearAverageColor.x, linearAverageColor.y, linearAverageColor.z);","        averageColors.set(linearAverageColor, color);","    }","    return color;","};","","const svgIcon = (content) =>","    'data:image/svg+xml,' +","    encodeURIComponent('<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">' + content + '</svg>');","const strokes = 'fill=\"none\" stroke=\"#000\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"';","const toolIcons = {","    Raise: svgIcon('<path ' + strokes + ' d=\"M3 20h18M6 20c2-6 4-9 6-9s4 3 6 9M12 3v5M9 5l3-3 3 3\"/>'),","    Lower: svgIcon('<path ' + strokes + ' d=\"M3 12h4c2 6 3 8 5 8s3-2 5-8h4M12 2v6M9 5l3 3 3-3\"/>'),","    Smooth: svgIcon('<path ' + strokes + ' d=\"M3 15c3-6 6 2 9-3s6 3 9-3M3 20h18\"/>'),","    Flatten: svgIcon('<path ' + strokes + ' d=\"M3 14h18M3 20h18M8 9V4M16 9V4M5 7l3 2 3-2M13 7l3 2 3-2\"/>'),","    Size: svgIcon('<circle ' + strokes + ' cx=\"12\" cy=\"12\" r=\"9\"/><circle ' + strokes + ' cx=\"12\" cy=\"12\" r=\"4\"/>'),","    Strength: svgIcon('<path ' + strokes + ' d=\"M5 20v-3M10 20v-7M15 20v-11M20 20V4\"/>'),","    Undo: svgIcon('<path ' + strokes + ' d=\"M9 14L4 9l5-5M4 9h10a6 6 0 0 1 0 12h-3\"/>'),","    Hole: svgIcon('<ellipse ' + strokes + ' cx=\"12\" cy=\"16\" rx=\"9\" ry=\"4\"/><path ' + strokes + ' d=\"M12 3v9M9 9l3 3 3-3\"/>'),","    FillHoles: svgIcon('<ellipse ' + strokes + ' cx=\"12\" cy=\"16\" rx=\"9\" ry=\"4\"/><path ' + strokes + ' d=\"M12 12V3M9 6l3-3 3 3\"/>'),","    Wetness: svgIcon('<path ' + strokes + ' d=\"M12 3c-3 5-6 8-6 11a6 6 0 0 0 12 0c0-3-3-6-6-11z\"/><path ' + strokes + ' d=\"M9 15a3 3 0 0 0 3 3\"/>'),","};","// Tints for the color brush when the editor has no color picker (older GDevelop versions).","const tintPresets = ['#e2c879', '#a5c45a', '#8a6a48', '#c98a62', '#9a9a92', '#ffffff'];","","/**"," * The sculpt and paint tools shown in the scene editor when a terrain is"," * selected. Without the needed editor functions (older GDevelop versions),"," * nothing is shown: the terrain can still be changed with events."," */","class TerrainEditorTools {","    constructor() {","        /** '' when no brush is used. */","        this.toolName = '';","        this.sizePercent = 30;","        this.strengthPercent = 50;","        /** @type {Terrain | null} */","        this.terrain = null;","        /** @type {gdjs.InGameEditor | null} */","        this.editor = null;","        this.isStroking = false;","        this.flattenHeight = 0;","        /** The color of the \"Tint\" brush, as \"#rrggbb\". */","        this.tintColor = tintPresets[0];","        this.wetnessPercent = 100;","        this.lastStrokeTime = 0;","        /** @type {{data: TerrainData, baseData: TerrainData}[]} */","        this.undoSteps = [];","        this.raycaster = new THREE.Raycaster();","        this.ndc = new THREE.Vector2();","        this._swatchColor = new THREE.Color();","    }","","    /** @param {gdjs.InGameEditor} editor */","    update(editor) {","        if (typeof editor.showToolbar !== 'function') {","            // Older GDevelop versions: the terrain can only be changed with events.","            return;","        }","        this.editor = editor;","        const selectedObjects = editor.getSelectedObjects();","        const terrain =","            selectedObjects.length === 1 && selectedObjects[0].__terrain3D ? selectedObjects[0].__terrain3D : null;","        if (terrain !== this.terrain) {","            this._endStroke();","            if (this.terrain) this.terrain.renderer.setBrush(null, 0);","            this.terrain = terrain;","            this.undoSteps.length = 0;","        }","        if (terrain) editor.showToolbar('Terrain3D', this._getToolbarItems(terrain));","        const game = editor.getRuntimeGame();","        if (!terrain || !this.toolName) {","            if (terrain) terrain.renderer.setBrush(null, 0);","            return;","        }","","        const inputManager = game.getInputManager();","        if (inputManager.wasKeyJustPressed(gdjs.evtTools.input.keysNameToCode.Escape)) {","            this._endStroke();","            this.toolName = '';","            terrain.renderer.setBrush(null, 0);","            return;","        }","        editor.captureLeftMouseButton();","        const hit = terrain.raycastFromCursor(game, this.raycaster, this.ndc);","        const radius = this._getRadius();","        terrain.renderer.setBrush(hit, radius);","","        // Older GDevelop versions don't have it.","        const isPressedForTool =","            typeof editor.isCapturedLeftMouseButtonPressed === 'function'","                ? editor.isCapturedLeftMouseButtonPressed()","                : inputManager.isMouseButtonPressed(0);","        // The button is released outside the canvas when the mouse is on a toolbar.","        const isPressed = isPressedForTool && inputManager.isMouseInsideCanvas();","        if (isPressed && hit && !this.isStroking) {","            this._startStroke(terrain, hit);","        }","        if (this.isStroking && isPressed && hit) {","            this._applyBrush(terrain, hit, radius);","        }","        if (!isPressed) {","            this._endStroke();","        }","    }","","    _getRadius() {","        const { object } = this.terrain;","        const maxRadius = Math.max(object.getWidth(), object.getHeight()) / 4;","        return Math.max(maxRadius * Math.pow(this.sizePercent / 100, 2), this.terrain.getCellWidth());","    }","","    _startStroke(terrain, hit) {","        this.isStroking = true;","        this.lastStrokeTime = performance.now();","        this.flattenHeight = terrain.toScenePosition(hit).z;","        this.undoSteps.push({ data: copyTerrainData(terrain.data), baseData: terrain.baseData });","        const maxUndoSteps = Math.max(Math.floor(UNDO_STEPS_SAMPLES / terrain.data.heights.length), 2);","        while (this.undoSteps.length > maxUndoSteps) this.undoSteps.shift();","    }","","    _endStroke() {","        if (!this.isStroking) return;","        this.isStroking = false;","        this._save();","    }","","    _applyBrush(terrain, hit, radius) {","        const now = performance.now();","        const elapsedSeconds = Math.min((now - this.lastStrokeTime) / 1000, 0.1);","        this.lastStrokeTime = now;","        const { x, y } = terrain.toScenePosition(hit);","        const amount = (this.strengthPercent / 100) * elapsedSeconds;","        const depth = terrain.object.getDepth();","        if (this.toolName === 'Raise') terrain.raise(x, y, x, y, radius, amount * depth * 0.5);","        else if (this.toolName === 'Lower') terrain.raise(x, y, x, y, radius, -amount * depth * 0.5);","        else if (this.toolName === 'Smooth') terrain.smooth(x, y, x, y, radius, amount * 10);","        else if (this.toolName === 'Flatten') terrain.flatten(x, y, x, y, radius, this.flattenHeight, amount * 10);","        else if (this.toolName.startsWith('Paint')) {","            terrain.paint(x, y, x, y, radius, parseInt(this.toolName.slice(5), 10), amount * 8);","        } else if (this.toolName === 'Hole') {","            terrain.makeHole(x, y, x, y, radius);","        } else if (this.toolName === 'FillHoles') {","            terrain.fillHoles(x, y, x, y, radius);","        } else if (this.toolName === 'Tint') {","            terrain.tint(x, y, x, y, radius, gdjs.rgbOrHexToRGBColor(this.tintColor), amount * 8);","        } else if (this.toolName === 'Wetness') {","            terrain.wet(x, y, x, y, radius, this.wetnessPercent / 100, amount * 8);","        }","        // Drawn now, as the terrain was updated earlier in this frame.","        terrain.applyChanges();","    }","","    _save() {","        const { terrain, editor } = this;","        if (!terrain || !editor) return;","        editor.updateObjectProperties(terrain.object.getName(), { SculptData: terrain.save() });","    }","","    _undo() {","        const undoStep = this.undoSteps.pop();","        // The relief, the edits or the resolution may have changed since the stroke.","        if (!this.terrain || !undoStep || undoStep.baseData !== this.terrain.baseData) {","            this.undoSteps.length = 0;","            return;","        }","        this.terrain.setData(undoStep.data);","        this._save();","    }","","    /** @returns {Array<gdjs.InGameEditorToolbarItem>} The settings of the tint or wetness brush, when it's used. */","    _getColorToolItems() {","        const { editor } = this;","        if (this.toolName === 'Tint') {","            if (editor && typeof editor.isToolbarItemTypeSupported === 'function' && editor.isToolbarItemTypeSupported('color')) {","                return [","                    {","                        type: 'color',","                        id: 'TintColor',","                        tooltip: 'Color of the tint',","                        value: this.tintColor,","                        onChange: (color) => (this.tintColor = color),","                    },","                ];","            }","            return tintPresets.map((color) => ({","                type: 'button',","                id: 'TintPreset' + color,","                tooltip: color === '#ffffff' ? 'No tint' : 'Tint with this color',","                color,","                isActive: this.tintColor === color,","                onClick: () => (this.tintColor = color),","            }));","        }","        if (this.toolName === 'Wetness') {","            return [","                {","                    type: 'slider',","                    id: 'WetnessAmount',","                    tooltip: 'Wetness',","                    iconUrl: toolIcons.Wetness,","                    min: 0,","                    max: 100,","                    value: this.wetnessPercent,","                    onChange: (value) => (this.wetnessPercent = value),","                },","            ];","        }","        return [];","    }","","    /**","     * @param {Terrain} terrain","     * @returns {Array<gdjs.InGameEditorToolbarItem>} The toolbar for the current state (the editor only","     * updates what changed).","     */","    _getToolbarItems(terrain) {","        const { object } = terrain;","        const toolButton = (toolName, tooltip, color) => ({","            type: 'button',","            id: toolName,","            tooltip,","            iconUrl: toolIcons[toolName],","            color,","            isActive: this.toolName === toolName,","            onClick: () => (this.toolName = this.toolName === toolName ? '' : toolName),","        });","        const layerColors = [object._getLayer1Color(), object._getLayer2Color(), object._getLayer3Color(), object._getLayer4Color()];","        // Layers are shown with their color, tinting their texture.","        const swatchColors = layerColors.map((color, index) =>","            this._swatchColor","                .set(gdjs.rgbOrHexStringToNumber(color))","                .multiply(getAverageColor(terrain.renderer.uniforms['terrainLayerMap' + index].value))","                .getHexString()","        );","        return [","            toolButton('Raise', 'Raise the ground (drag on the terrain)'),","            toolButton('Lower', 'Lower the ground'),","            toolButton('Smooth', 'Smooth the ground'),","            toolButton('Flatten', 'Flatten the ground to the height where the drag starts'),","            { type: 'divider', id: 'PaintDivider' },","            ...swatchColors.map((swatchColor, index) =>","                toolButton('Paint' + (index + 1), 'Paint layer ' + (index + 1), '#' + swatchColor)","            ),","            toolButton('Hole', 'Make a hole, for the entrance of a tunnel or a cave'),","            toolButton('FillHoles', 'Fill holes, with the layers of the ground around them'),","            { type: 'divider', id: 'ColorDivider' },","            toolButton('Tint', 'Tint the ground (white removes the tint)', this.tintColor),","            toolButton('Wetness', 'Make the ground wet, or dry with a wetness of 0'),","            ...this._getColorToolItems(),","            { type: 'divider', id: 'BrushDivider' },","            {","                type: 'slider',","                id: 'Size',","                tooltip: 'Brush size',","                iconUrl: toolIcons.Size,","                min: 1,","                max: 100,","                value: this.sizePercent,","                onChange: (value) => (this.sizePercent = value),","            },","            {","                type: 'slider',","                id: 'Strength',","                tooltip: 'Brush strength',","                iconUrl: toolIcons.Strength,","                min: 5,","                max: 100,","                value: this.strengthPercent,","                onChange: (value) => (this.strengthPercent = value),","            },","            { type: 'button', id: 'Undo', tooltip: 'Undo the last stroke on this terrain', iconUrl: toolIcons.Undo, onClick: () => this._undo() },","        ];","    }","}","","const editorTools = new TerrainEditorTools();","if (gdjs.registerInGameEditorPostStepCallback) {","    gdjs.registerInGameEditorPostStepCallback((editor) => editorTools.update(editor));","}","","gdjs.__terrain3DExtension = {","    Terrain,","    // Used by the terrain grass and the scattered models.","    getWorldScale,","    getGrounds,","    patchShaderCode,","    createRandom,","    findHighestGround,","    GroundPlacement,","    svgIcon,","    toolIcons,","    // Exposed for tests.","    TerrainBodyUpdater,","    TerrainData,","    SampleRectangle,","    brushes,","    edits,","    codec,","    relief,","};"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[],"objectGroups":[]},{"description":"Define grass helper classes JavaScript code.","fullName":"Define grass helper classes","functionType":"Action","name":"DefineGrassHelperClasses","private":true,"sentence":"Define grass helper classes JavaScript code","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["if (gdjs.__terrainGrassExtension) {","    return;","}","// Blades grow on the grounds of the scene: the 3D terrains (see `getGrounds`","// in the terrain helper).","","// Size of the object inner area: instances are scaled from it.","const AREA_SIZE = 1000;","const AREA_DEPTH = 40;","const CHUNK_SIZE = 500;","const MAX_BENDING_OBJECTS = 8;","","/**"," * A blade: a thin, tapered strip. Its width and height are 1: blades are"," * scaled by the shader."," */","const createBladeGeometry = () => {","    const halfWidths = [0.5, 0.42, 0.28, 0];","    const heights = [0, 0.35, 0.7, 1];","    const positions = [];","    halfWidths.forEach((halfWidth, level) => {","        positions.push(-halfWidth, 0, heights[level]);","        if (halfWidth > 0) positions.push(halfWidth, 0, heights[level]);","    });","    const indices = [0, 1, 2, 1, 3, 2, 2, 3, 4, 3, 5, 4, 4, 5, 6];","    const geometry = new THREE.InstancedBufferGeometry();","    geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));","    geometry.setAttribute('normal', new THREE.Float32BufferAttribute(new Array(positions.length).fill(0), 3));","    geometry.setIndex(indices);","    return geometry;","};","","const vertexShaderDeclarations = `","attribute vec4 grassRoot;","attribute vec2 grassShape;","// The tint of the ground at the root (linear, from 0 to 1).","attribute vec3 grassGroundTint;","uniform mat3 grassWorldToLocal;","uniform float grassWorldScale;","uniform float grassBladeWidth;","uniform float grassTime;","uniform float grassWindStrength;","uniform float grassWindSpeed;","uniform vec4 grassBenders[${MAX_BENDING_OBJECTS}];","uniform vec3 grassBaseColor;","uniform vec3 grassTipColor;","varying vec3 vGrassColor;","`;","const vertexShaderPosition = `","// Blades are shaped in scene units (with Y flipped like the 3D world), then","// moved back in the (scaled) object space.","float bladeHeight = position.z;","float grassAngle = grassRoot.w;","float bladeWidth = position.x * grassBladeWidth;","vec3 blade = vec3(","  bladeWidth * cos(grassAngle),","  bladeWidth * sin(grassAngle),","  bladeHeight * grassShape.x",");","vec3 rootWorld = (modelMatrix * vec4(grassRoot.xyz, 1.0)).xyz * grassWorldScale;","// Tips bend more than the base.","float bendFactor = bladeHeight * bladeHeight * grassShape.x;","float gust = sin(grassTime * grassWindSpeed + rootWorld.x * 0.013 + rootWorld.y * 0.011);","float flutter = sin(grassTime * grassWindSpeed * 2.7 + grassShape.y * 40.0) * 0.3;","blade.xy += vec2(0.8, 0.5) * (gust + flutter + 0.6) * grassWindStrength * 0.35 * bendFactor;","for (int i = 0; i < ${MAX_BENDING_OBJECTS}; i++) {","  vec4 bender = grassBenders[i];","  if (bender.z <= 0.0) continue;","  vec2 away = rootWorld.xy - bender.xy;","  float distanceToBender = length(away);","  float push = 1.0 - smoothstep(bender.z * 0.3, bender.z, distanceToBender);","  if (push > 0.0) {","    blade.xy += normalize(away + vec2(0.001)) * push * bendFactor * 0.9;","    blade.z *= 1.0 - push * 0.5;","  }","}","vec3 transformed = grassRoot.xyz + grassWorldToLocal * (blade / grassWorldScale);","vGrassColor = mix(grassBaseColor, grassTipColor, bladeHeight) * (0.85 + 0.3 * grassShape.y) * grassGroundTint;","`;","const vertexShaderNormal = `","// Blades are lit like the ground below them.","transformedNormal = normalize((viewMatrix * vec4(0.0, 0.0, 1.0, 0.0)).xyz);","`;","const fragmentShaderDeclarations = `","varying vec3 vGrassColor;","`;","const fragmentShaderColor = `","diffuseColor.rgb *= vGrassColor;","`;","// Both faces of blades are lit like the ground (not flipped for back faces).","const fragmentShaderNormal = `","#include <normal_fragment_begin>","normal = normalize(vNormal);","nonPerturbedNormal = normal;","`;","","const { getWorldScale, patchShaderCode, createRandom, findHighestGround, GroundPlacement } = gdjs.__terrain3DExtension;","","/**"," * The grass of a terrain grass object: blades drawn with GPU instancing, in chunks"," * that are hidden when off-screen and thinned out with the distance. They grow"," * on the grounds below, like 3D terrains (only where a given layer is painted)."," */","class Grass {","    /** @param {gdjs.CustomRuntimeObject3D} object */","    constructor(object) {","        this.object = object;","        this.group = new THREE.Group();","        object.get3DRendererObject().add(this.group);","        this.bladeGeometry = createBladeGeometry();","        /** @type {Array<{mesh: THREE.Mesh, blades: number, center: THREE.Vector3}>} */","        this.chunks = [];","        this.placement = new GroundPlacement(object.getRuntimeScene());","        this._groundAtBlade = { ground: null, z: 0 };","        this.uniforms = {","            grassWorldToLocal: { value: new THREE.Matrix3() },","            // Scene units by 3D world unit.","            grassWorldScale: { value: 1 },","            grassBladeWidth: { value: 1 },","            grassTime: { value: 0 },","            grassWindStrength: { value: 1 },","            grassWindSpeed: { value: 1 },","            grassBenders: { value: Array.from({ length: MAX_BENDING_OBJECTS }, () => new THREE.Vector4()) },","            grassBaseColor: { value: new THREE.Color() },","            grassTipColor: { value: new THREE.Color() },","        };","        this.material = new THREE.MeshStandardMaterial({ roughness: 1, metalness: 0, side: THREE.DoubleSide });","        this.material.onBeforeCompile = (shader) => {","            Object.assign(shader.uniforms, this.uniforms);","            shader.vertexShader = patchShaderCode(shader.vertexShader, [","                ['#include <common>', '#include <common>\\n' + vertexShaderDeclarations],","                ['#include <begin_vertex>', vertexShaderPosition],","                ['#include <defaultnormal_vertex>', '#include <defaultnormal_vertex>\\n' + vertexShaderNormal],","            ], 'TerrainGrass');","            shader.fragmentShader = patchShaderCode(shader.fragmentShader, [","                ['#include <common>', '#include <common>\\n' + fragmentShaderDeclarations],","                ['#include <color_fragment>', '#include <color_fragment>\\n' + fragmentShaderColor],","                ['#include <normal_fragment_begin>', fragmentShaderNormal],","            ], 'TerrainGrass');","        };","        this.material.customProgramCacheKey = () => 'TerrainGrass';","","        this._matrix = new THREE.Matrix4();","        this._cameraPosition = new THREE.Vector3();","        this._chunkPosition = new THREE.Vector3();","        this._scale = new THREE.Vector3();","        this.updateFromProperties();","    }","","    updateFromProperties() {","        const { object } = this;","        this.uniforms.grassBaseColor.value.set(gdjs.rgbOrHexStringToNumber(object._getBaseColor()));","        this.uniforms.grassTipColor.value.set(gdjs.rgbOrHexStringToNumber(object._getTipColor()));","        this.uniforms.grassWindStrength.value = object._getWindStrength();","        this.uniforms.grassWindSpeed.value = object._getWindSpeed();","        this.uniforms.grassBladeWidth.value = Math.max(object._getBladeWidth(), 0);","        this.material.needsUpdate = true;","        this.placement.placeAgain();","    }","","    _getPlacementKey() {","        const { object } = this;","        return [","            object.getX(), object.getY(), object.getZ(), object.getWidth(), object.getHeight(), object.getDepth(),","            object._getDensity(), object._getBladeHeight(), object._getGroundLayer(), object._getMaxSlope(),","            object._getSeed(),","        ].join('|');","    }","","    /** Place the blades again, for example after the ground or the object changed. */","    rebuild() {","        const grounds = Array.from(this.placement.grounds);","        for (const chunk of this.chunks) {","            chunk.mesh.removeFromParent();","            chunk.mesh.geometry.dispose();","        }","        this.chunks.length = 0;","","        const { object } = this;","        const width = object.getWidth();","        const height = object.getHeight();","        const scaleX = width / AREA_SIZE;","        const scaleY = height / AREA_SIZE;","        const scaleZ = Math.max(object.getDepth() / AREA_DEPTH, 0.0001);","        const bladesPerChunk = Math.round((Math.max(object._getDensity(), 0) * CHUNK_SIZE * CHUNK_SIZE) / 10000);","        const groundLayer = parseInt(object._getGroundLayer(), 10) || 0;","        const maxSlope = object._getMaxSlope();","        const chunksX = Math.max(Math.ceil(width / CHUNK_SIZE), 1);","        const chunksY = Math.max(Math.ceil(height / CHUNK_SIZE), 1);","        const nextRandom = createRandom(object._getSeed() * 7919 + 1);","        const bladeHeight = Math.max(object._getBladeHeight(), 0);","","        for (let chunkY = 0; chunkY < chunksY; chunkY++) {","            for (let chunkX = 0; chunkX < chunksX; chunkX++) {","                const roots = new Float32Array(bladesPerChunk * 4);","                const shapes = new Float32Array(bladesPerChunk * 2);","                const groundTints = new Uint8Array(bladesPerChunk * 3).fill(255);","                let blades = 0;","                let minZ = Infinity;","                let maxZ = -Infinity;","                for (let attempt = 0; attempt < bladesPerChunk; attempt++) {","                    // In scene units, relative to the object.","                    const x = (chunkX + nextRandom()) * CHUNK_SIZE;","                    const y = (chunkY + nextRandom()) * CHUNK_SIZE;","                    const angle = nextRandom() * Math.PI * 2;","                    const heightFactor = 0.6 + 0.8 * nextRandom();","                    const tint = nextRandom();","                    const growth = nextRandom();","                    if (x > width || y > height) continue;","                    const sceneX = object.getX() + x;","                    const sceneY = object.getY() + y;","                    const { ground, z } = findHighestGround(grounds, sceneX, sceneY, this._groundAtBlade);","                    const groundZ = ground ? z : object.getZ();","                    if (ground) {","                        if (groundLayer > 0 && growth > ground.getLayerWeightAt(sceneX, sceneY, groundLayer)) continue;","                        if (ground.getSlopeAt(sceneX, sceneY) > maxSlope) continue;","                        if (typeof ground.getTintAt === 'function') {","                            const tint = ground.getTintAt(sceneX, sceneY);","                            for (let channel = 0; channel < 3; channel++) {","                                groundTints[blades * 3 + channel] = Math.round(255 * Math.pow(tint[channel] / 255, 2.2));","                            }","                        }","                    }","                    const localZ = (groundZ - object.getZ()) / scaleZ;","                    roots[blades * 4] = x / scaleX;","                    roots[blades * 4 + 1] = y / scaleY;","                    roots[blades * 4 + 2] = localZ;","                    roots[blades * 4 + 3] = angle;","                    shapes[blades * 2] = heightFactor * bladeHeight;","                    shapes[blades * 2 + 1] = tint;","                    minZ = Math.min(minZ, localZ);","                    maxZ = Math.max(maxZ, localZ);","                    blades++;","                }","                if (blades === 0) continue;","","                const geometry = new THREE.InstancedBufferGeometry();","                geometry.index = this.bladeGeometry.index;","                geometry.setAttribute('position', this.bladeGeometry.attributes.position);","                geometry.setAttribute('normal', this.bladeGeometry.attributes.normal);","                geometry.setAttribute('grassRoot', new THREE.InstancedBufferAttribute(roots.subarray(0, blades * 4), 4));","                geometry.setAttribute('grassShape', new THREE.InstancedBufferAttribute(shapes.subarray(0, blades * 2), 2));","                geometry.setAttribute('grassGroundTint', new THREE.InstancedBufferAttribute(groundTints.subarray(0, blades * 3), 3, true));","                geometry.instanceCount = blades;","                // The furthest tips can go with the wind and the bending objects (see the shader).","                const maxBladeHeight = bladeHeight * 1.4;","                const lean =","                    (0.35 * 1.9 * 0.943 * Math.max(object._getWindStrength(), 0) + 0.9) * maxBladeHeight +","                    Math.max(object._getBladeWidth(), 0) / 2;","                const leanX = lean / scaleX;","                const leanY = lean / scaleY;","                geometry.boundingBox = new THREE.Box3(","                    new THREE.Vector3((chunkX * CHUNK_SIZE) / scaleX - leanX, (chunkY * CHUNK_SIZE) / scaleY - leanY, minZ),","                    new THREE.Vector3(","                        Math.min((chunkX + 1) * CHUNK_SIZE, width) / scaleX + leanX,","                        Math.min((chunkY + 1) * CHUNK_SIZE, height) / scaleY + leanY,","                        maxZ + (bladeHeight * 1.4) / scaleZ","                    )","                );","                geometry.boundingSphere = geometry.boundingBox.getBoundingSphere(new THREE.Sphere());","                const mesh = new THREE.Mesh(geometry, this.material);","                mesh.receiveShadow = true;","                // Raycasts would only test one blade: the selection plane is used instead.","                mesh.raycast = () => {};","                this.group.add(mesh);","                this.chunks.push({ mesh, blades, center: geometry.boundingSphere.center.clone() });","            }","        }","    }","","    _updateBendingObjects() {","        const benders = this.uniforms.grassBenders.value;","        const objectName = this.object._getBendingObject();","        const bendingObjects = objectName ? this.object.getInstanceContainer().getObjects(objectName) || [] : [];","        for (let index = 0; index < MAX_BENDING_OBJECTS; index++) {","            const bendingObject = bendingObjects[index];","            if (!bendingObject) {","                benders[index].set(0, 0, 0, 0);","                continue;","            }","            // Blades are pushed in the 3D scene, which is flipped on Y.","            const radius = Math.max(bendingObject.getWidth(), bendingObject.getHeight()) * 1.2;","            benders[index].set(bendingObject.getCenterXInScene(), -bendingObject.getCenterYInScene(), radius, 0);","        }","    }","","    /**","     * @param {number} elapsedSeconds","     * @param {number} time In seconds, the same for all grass objects.","     */","    update(elapsedSeconds, time, camera) {","        if (this.placement.shouldPlaceAgain(elapsedSeconds, this._getPlacementKey())) {","            this.rebuild();","        }","","        this.uniforms.grassTime.value = time;","        this.uniforms.grassWorldScale.value = getWorldScale(this.object);","        // The object transformation is applied just before rendering, it's needed now.","        this.object.getRenderer().ensureUpToDate();","        this.group.updateWorldMatrix(true, false);","        this.uniforms.grassWorldToLocal.value.setFromMatrix4(this._matrix.copy(this.group.matrixWorld).invert());","        this._updateBendingObjects();","        if (!camera) return;","","        // Far chunks are hidden, and thinned out before (in 3D world units).","        const fadeDistance = Math.max(this.object._getFadeDistance(), 1) / getWorldScale(this.object);","        this._cameraPosition.setFromMatrixPosition(camera.matrixWorld);","        for (const chunk of this.chunks) {","            const distance = this._chunkPosition","                .copy(chunk.center)","                .applyMatrix4(this.group.matrixWorld)","                .distanceTo(this._cameraPosition);","            const density = gdjs.evtTools.common.clamp((fadeDistance - distance) / (fadeDistance * 0.5), 0, 1);","            chunk.mesh.visible = density > 0;","            chunk.mesh.geometry.instanceCount = Math.ceil(chunk.blades * density);","        }","    }","","    dispose() {","        for (const chunk of this.chunks) {","            chunk.mesh.geometry.dispose();","        }","        this.bladeGeometry.dispose();","        this.material.dispose();","        this.group.removeFromParent();","    }","}","","gdjs.__terrainGrassExtension = { Grass };"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[],"objectGroups":[]},{"description":"Define scattered models helper classes JavaScript code.","fullName":"Define scattered models helper classes","functionType":"Action","name":"DefineScatterHelperClasses","private":true,"sentence":"Define scattered models helper classes JavaScript code","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["if (gdjs.__terrainScatterExtension) {","    return;","}","// Copies grow on the grounds of the scene, like the terrain grass (see","// `getGrounds` in the terrain helper).","","const {","    getWorldScale,","    getGrounds,","    patchShaderCode,","    createRandom,","    findHighestGround,","    GroundPlacement,","    SampleRectangle,","    brushes,","    codec,","    svgIcon,","    toolIcons,","} = gdjs.__terrain3DExtension;","","// Size of the object inner area: instances are scaled from it.","const AREA_SIZE = 2000;","const AREA_DEPTH = 200;","// The painted density is stored in a grid of this many cells on each side,","// whatever the size of the object.","const MASK_RESOLUTION = 256;","const MASK_FORMAT_VERSION = '1';","// Copies are hidden in chunks: big chunks mean fewer draw calls, small ones","// hide more copies out of the screen.","const MIN_CHUNK_SIZE = 500;","const MAX_CHUNK_SIZE = 2000;","// Copies shrink to nothing over this part of the draw distance, instead of popping out.","const FADE_PART = 0.15;","const MAX_COPIES = 200000;","// Prisms of the trunk collisions.","const TRUNK_SIDES = 6;","","const clamp01 = (value) => (value < 0 ? 0 : value > 1 ? 1 : value);","","/**"," * @returns {number} A number for a cell of the copies grid, changing with the seed."," */","const hashCell = (seed, i, j) => {","    let h = Math.imul(i, 374761393) + Math.imul(j, 668265263) + Math.imul(seed, 982451653);","    h = Math.imul(h ^ (h >>> 13), 1274126177);","    return (h ^ (h >>> 16)) >>> 0;","};","","/**"," * How dense copies are, from 0 to 1, in a grid covering the object: painted"," * with the editor brushes, the edits or events."," */","class DensityMask {","    /** @param {number} fillValue From 0 to 255. */","    constructor(fillValue) {","        // `resolution` and `size` let terrain brushes paint it.","        this.resolution = MASK_RESOLUTION;","        this.size = MASK_RESOLUTION + 1;","        this.values = new Uint8Array(this.size * this.size).fill(fillValue);","    }","","    /**","     * @param {number} u From 0 to 1, along the object width.","     * @param {number} v From 0 to 1, along the object height.","     * @returns {number} The density, from 0 to 1, interpolated between samples.","     */","    sample(u, v) {","        const x = clamp01(u) * this.resolution;","        const y = clamp01(v) * this.resolution;","        const i = Math.min(Math.floor(x), this.resolution - 1);","        const j = Math.min(Math.floor(y), this.resolution - 1);","        const fx = x - i;","        const fy = y - j;","        const value = (i, j) => this.values[j * this.size + i];","        const top = value(i, j) + fx * (value(i + 1, j) - value(i, j));","        const bottom = value(i, j + 1) + fx * (value(i + 1, j + 1) - value(i, j + 1));","        return (top + fy * (bottom - top)) / 255;","    }","","    /**","     * Bring the density towards a target around a segment: fully up to 70%","     * of the radius, then fading out (forests have dense centers and soft edges).","     * @param {{cellWidth: number, cellHeight: number, ax: number, ay: number, bx: number, by: number, radius: number}} stroke","     * @param {number} density The target, from 0 to 1.","     * @param {number} strength From 0 to 1.","     * @param {SampleRectangle} changedSamples","     */","    paint(stroke, density, strength, changedSamples) {","        const { values } = this;","        const target = Math.round(clamp01(density) * 255);","        brushes.forEachSample(","            this,","            stroke,","            (index, falloff) => {","                // The falloff of terrain brushes is (1 - distance² / radius²)².","                const weight = clamp01(2 * Math.sqrt(falloff));","                // Rounded towards the target, so that light strokes still paint.","                const change = (target - values[index]) * clamp01(weight * strength);","                values[index] += change > 0 ? Math.ceil(change) : Math.floor(change);","            },","            changedSamples","        );","    }","","    /** @returns {DensityMask} */","    clone() {","        const mask = new DensityMask(0);","        mask.values.set(this.values);","        return mask;","    }","}","","/**"," * Edits written in the Edits property: a JSON list of brush strokes, like"," * `[{\"tool\": \"add\", \"x\": 0.5, \"y\": 0.5, \"radius\": 0.2}]`. Positions and"," * radius are fractions of the object size, like the terrain edits."," */","const applyEdits = (mask, text) => {","    if (!text.trim()) return;","    let editList;","    try {","        editList = JSON.parse(text);","    } catch (error) {","        console.warn('The edits of scattered models are not valid JSON: ' + error.message);","        return;","    }","    if (!Array.isArray(editList)) {","        console.warn('The edits of scattered models must be a JSON list (like [{\"tool\": \"add\", ...}]).');","        return;","    }","    const numberOr = (value, defaultValue) => (typeof value === 'number' && isFinite(value) ? value : defaultValue);","    const changedSamples = new SampleRectangle();","    for (const edit of editList) {","        if (!edit || typeof edit !== 'object') continue;","        const x = numberOr(edit.x, 0.5);","        const y = numberOr(edit.y, 0.5);","        const stroke = {","            cellWidth: 1 / mask.resolution,","            cellHeight: 1 / mask.resolution,","            ax: x,","            ay: y,","            bx: numberOr(edit.toX, x),","            by: numberOr(edit.toY, y),","            radius: numberOr(edit.radius, 0.1),","        };","        const strength = clamp01(numberOr(edit.strength, 1));","        if (edit.tool === 'add') {","            mask.paint(stroke, numberOr(edit.density, 1), strength, changedSamples);","        } else if (edit.tool === 'erase') {","            mask.paint(stroke, 0, strength, changedSamples);","        } else {","            console.warn('Unknown tool in the edits of scattered models: \"' + edit.tool + '\" (use add or erase).');","        }","    }","};","","/**"," * The density painted in the editor, stored as its difference with the"," * density from the properties (the coverage and the edits), like the terrain"," * sculpt data."," */","const maskCodec = {","    /**","     * @param {DensityMask} mask","     * @param {DensityMask} baseMask","     */","    encode(mask, baseMask) {","        const changes = new Int32Array(mask.values.length);","        let hasChanges = false;","        for (let index = 0; index < changes.length; index++) {","            changes[index] = mask.values[index] - baseMask.values[index];","            if (changes[index] !== 0) hasChanges = true;","        }","        if (!hasChanges) return '';","        return MASK_FORMAT_VERSION + ';' + MASK_RESOLUTION + ';' + codec.encodeGrids([changes], mask.size);","    },","","    /**","     * @param {string} text","     * @param {DensityMask} baseMask","     * @returns {DensityMask | null} null if the text is empty or not valid.","     */","    decode(text, baseMask) {","        if (!text) return null;","        const parts = text.split(';');","        if (parts[0] !== MASK_FORMAT_VERSION || parseInt(parts[1], 10) !== MASK_RESOLUTION) return null;","        try {","            const mask = baseMask.clone();","            const [changes] = codec.decodeGrids(parts[2], mask.size, 1);","            for (let index = 0; index < changes.length; index++) {","                // The base may have changed since the data was saved.","                mask.values[index] = Math.min(Math.max(mask.values[index] + changes[index], 0), 255);","            }","            return mask;","        } catch (error) {","            console.error('The painted data of scattered models could not be read:', error);","            return null;","        }","    },","};","","const fadeShaderDeclarations = `","uniform float scatterDrawDistance;","`;","// Instance matrices are applied after this: copies shrink towards their base.","const fadeShaderCode = `","#ifdef USE_INSTANCING","vec3 scatterCopyPosition = (modelMatrix * instanceMatrix * vec4(0.0, 0.0, 0.0, 1.0)).xyz;","transformed *= clamp(","  (scatterDrawDistance - distance(scatterCopyPosition, cameraPosition)) / (scatterDrawDistance * ${FADE_PART}),","  0.0,","  1.0",");","#endif","`;","","const flipTriangles = (geometry) => {","    const index = geometry.index;","    for (let offset = 0; offset + 2 < index.count; offset += 3) {","        const second = index.getX(offset + 1);","        index.setX(offset + 1, index.getX(offset + 2));","        index.setX(offset + 2, second);","    }","};","","/**"," * The parts of a model, ready to be drawn with instancing: each glTF"," * primitive with its material. Geometries are moved so that the model base"," * is at the origin, its height is 1 and it stands along Z (like 3D model"," * objects with a 90° rotation around X)."," * @param {THREE.Object3D} modelScene"," * @param {object} uniforms Uniforms added to the materials."," * @returns {{parts: Array<{geometry: THREE.BufferGeometry, material: THREE.Material | THREE.Material[]}>, width: number, depth: number}}"," */","const createModelParts = (modelScene, uniforms) => {","    modelScene.updateMatrixWorld(true);","    const rootInverse = modelScene.matrixWorld.clone().invert();","    const standUp = new THREE.Matrix4().makeRotationX(Math.PI / 2);","    /** @type {Array<{mesh: THREE.Mesh, matrix: THREE.Matrix4}>} */","    const meshes = [];","    const box = new THREE.Box3();","    modelScene.traverse((node) => {","        if (!node.isMesh || !node.geometry || !node.geometry.attributes.position) return;","        const matrix = standUp.clone().multiply(rootInverse).multiply(node.matrixWorld);","        if (!node.geometry.boundingBox) node.geometry.computeBoundingBox();","        box.union(node.geometry.boundingBox.clone().applyMatrix4(matrix));","        meshes.push({ mesh: node, matrix });","    });","    if (box.isEmpty()) return { parts: [], width: 0, depth: 0 };","","    const height = Math.max(box.max.z - box.min.z, 0.000001);","    // The Y axis of the scene goes down: the model is flipped, like 3D model objects.","    const normalization = new THREE.Matrix4()","        .makeScale(1 / height, -1 / height, 1 / height)","        .multiply(","            new THREE.Matrix4().makeTranslation(","                -(box.min.x + box.max.x) / 2,","                -(box.min.y + box.max.y) / 2,","                -box.min.z","            )","        );","    const parts = meshes.map(({ mesh, matrix }) => {","        let geometry = mesh.geometry.clone();","        if (!geometry.index) {","            const indices = Array.from({ length: geometry.attributes.position.count }, (_, index) => index);","            geometry.setIndex(indices);","        }","        geometry.applyMatrix4(normalization.clone().multiply(matrix));","        // The flip turned the faces inside out.","        flipTriangles(geometry);","        geometry.computeBoundingSphere();","        geometry.computeBoundingBox();","        const patchMaterial = (originalMaterial) => {","            const material = originalMaterial.clone();","            // Like 3D model objects (\"Standard without metalness\"), which look better without an environment map.","            if (material.metalness) material.metalness = 0;","            material.onBeforeCompile = (shader) => {","                Object.assign(shader.uniforms, uniforms);","                shader.vertexShader = patchShaderCode(shader.vertexShader, [","                    ['#include <common>', '#include <common>\\n' + fadeShaderDeclarations],","                    ['#include <begin_vertex>', '#include <begin_vertex>\\n' + fadeShaderCode],","                ], 'ScatteredModels');","            };","            material.customProgramCacheKey = () => 'ScatteredModels';","            return material;","        };","        const material = Array.isArray(mesh.material) ? mesh.material.map(patchMaterial) : patchMaterial(mesh.material);","        return { geometry, material };","    });","    return {","        parts,","        width: (box.max.x - box.min.x) / height,","        depth: (box.max.y - box.min.y) / height,","    };","};","","/**"," * A copy of the model: its base position in the scene, its scale (the"," * height of the copy) and the key of its cell in the grid of copies."," * @typedef {{x: number, y: number, z: number, angle: number, height: number, key: number}} Copy"," */","","/**"," * The scattered models of an object: copies of a 3D model placed on the"," * grounds of the scene, drawn with GPU instancing in chunks that are hidden"," * when far or off-screen."," */","class Scatter {","    /** @param {gdjs.CustomRuntimeObject3D} object */","    constructor(object) {","        this.object = object;","        this.group = new THREE.Group();","        object.get3DRendererObject().add(this.group);","        /** @type {Array<{firstCellI: number, firstCellJ: number, meshes: THREE.InstancedMesh[], copies: Copy[], center: THREE.Vector3, radius: number}>} */","        this.chunks = [];","        /**","         * The grid of copies: one copy at most in each cell, cells grouped in chunks.","         * @type {{spacing: number, cellsPerChunk: number, cellsX: number, cellsY: number} | null}","         */","        this.grid = null;","        this.placement = new GroundPlacement(object.getRuntimeScene());","        this.uniforms = {","            // In 3D world units.","            scatterDrawDistance: { value: 1 },","        };","        /** @type {{parts: Array<{geometry: THREE.BufferGeometry, material: THREE.Material | THREE.Material[]}>, width: number, depth: number}} */","        this.model = { parts: [], width: 0, depth: 0 };","        this.modelResourceName = '';","        this.loadingModelResourceName = '';","        /**","         * Copies removed by events (for example, cut trees), by key.","         * @type {Map<number, Copy>}","         */","        this.removedCopies = new Map();","        /** Increased each time copies change, for the collisions. */","        this.version = 0;","        this.isDisposed = false;","        /** The last value of the painted data property read or saved. */","        this.paintData = '';","        /**","         * Values saved by the editor tools: the editor sends them back with a","         * hot-reload, possibly after newer ones were saved.","         * @type {string[]}","         */","        this.savedPaintData = [];","        this.maskSource = '';","        /** @type {DensityMask} */","        this.baseMask = new DensityMask(255);","        /** @type {DensityMask} */","        this.mask = this.baseMask;","        this.changedSamples = new SampleRectangle();","        this._stroke = { cellWidth: 1, cellHeight: 1, ax: 0, ay: 0, bx: 0, by: 0, radius: 0 };","        this._groundAtCopy = { ground: null, z: 0 };","        this._matrix = new THREE.Matrix4();","        this._raycastSphere = new THREE.Sphere();","        this._raycastRay = new THREE.Ray();","        this._raycastBox = new THREE.Box3();","        this._raycastInverseMatrix = new THREE.Matrix4();","        this._raycastScale = new THREE.Vector3();","        /** Placed on a copy to test the triangles of the model. */","        this._raycastMesh = new THREE.Mesh();","        /** @type {THREE.Intersection[]} */","        this._raycastHits = [];","        this._color = new THREE.Color();","        this._tint = new THREE.Color();","        this._cameraPosition = new THREE.Vector3();","        this._chunkPosition = new THREE.Vector3();","        /**","         * Trunks, for the 3D physics behavior and navigation meshes. Always given,","         * empty without trunk collisions: otherwise these behaviors would use the","         * object box, covering the whole area.","         * @type {gdjs.Surface}","         */","        this.surface = {","            getVersion: () => this.version,","            getChangedArea: () => null,","            getTriangles: () => this._getTrunkTriangles(),","            getHeightField: () => null,","        };","        /** The trunk collision properties, changing the surface. */","        this.trunkKey = '';","        this.loadMaskFromProperties();","        this.updateFromProperties();","        // Before the behaviors create their shapes.","        this._updateSurface();","    }","","    _getMaskSource() {","        return this.object._getCoverage() + '|' + this.object._getEdits();","    }","","    loadMaskFromProperties() {","        const { object } = this;","        this.maskSource = this._getMaskSource();","        this.paintData = object._getPaintData();","        this.baseMask = new DensityMask(object._getCoverage() === 'Painted' ? 0 : 255);","        applyEdits(this.baseMask, object._getEdits());","        this.mask = maskCodec.decode(this.paintData, this.baseMask) || this.baseMask.clone();","        this.placement.placeAgain();","    }","","    onHotReloading() {","        const paintData = this.object._getPaintData();","        const savedIndex = this.savedPaintData.indexOf(paintData);","        if (savedIndex !== -1 && this._getMaskSource() === this.maskSource) {","            // The object already has this data, or newer changes.","            this.savedPaintData.splice(0, savedIndex + 1);","        } else if (paintData !== this.paintData || this._getMaskSource() !== this.maskSource) {","            this.savedPaintData.length = 0;","            this.loadMaskFromProperties();","        }","        this.updateFromProperties();","    }","","    /** @returns {string} The data to save in the painted data property. */","    save() {","        this.paintData = maskCodec.encode(this.mask, this.baseMask);","        this.savedPaintData.push(this.paintData);","        return this.paintData;","    }","","    updateFromProperties() {","        const { object } = this;","        const modelResourceName = object._getModel();","        if (modelResourceName !== this.modelResourceName) {","            this.modelResourceName = modelResourceName;","            this._loadModel();","        }","        this.placement.placeAgain();","    }","","    _disposeModel() {","        for (const part of this.model.parts) {","            part.geometry.dispose();","            for (const material of Array.isArray(part.material) ? part.material : [part.material]) {","                material.dispose();","            }","        }","        this.model = { parts: [], width: 0, depth: 0 };","    }","","    _loadModel() {","        this._disposeChunks(this.chunks);","        this._disposeModel();","        const resourceName = this.modelResourceName;","        if (!resourceName) return;","        const game = this.object.getRuntimeScene().getGame();","        const modelManager = game.getModel3DManager();","        const gltf = modelManager.getModel(resourceName);","        if (gltf === modelManager._invalidModel) {","            // Not loaded yet, for example a model just chosen in the editor.","            if (this.loadingModelResourceName === resourceName) return;","            this.loadingModelResourceName = resourceName;","            game.getResourceLoader()","                .loadResource(resourceName)","                .then(() => {","                    if (this.isDisposed || this.modelResourceName !== resourceName) return;","                    this.loadingModelResourceName = '';","                    if (modelManager.getModel(resourceName) !== modelManager._invalidModel) {","                        this._loadModel();","                        this.placement.placeAgain();","                    }","                })","                .catch(() => {});","            return;","        }","        this.model = createModelParts(gltf.scene, this.uniforms);","    }","","    _getPlacementKey() {","        const { object } = this;","        return [","            object.getX(), object.getY(), object.getZ(), object.getWidth(), object.getHeight(), object.getDepth(),","            object._getDensity(), object._getSize(), object._getMinScale(), object._getMaxScale(),","            object._getRandomRotation(), object._getRandomTint(), object._getGroundLayer(), object._getMaxSlope(),","            object._getMinGroundZ(), object._getMaxGroundZ(), object._getSeed(), object._getDrawDistance(),","            object._getCastShadow(), object._getReceiveShadow(), this.model.parts.length,","        ].join('|');","    }","","    _getChunkSize() {","        return Math.min(Math.max(this.object._getDrawDistance() / 4, MIN_CHUNK_SIZE), MAX_CHUNK_SIZE);","    }","","    /** @returns {number} The distance between copies (one copy per cell of this size at most). */","    _getSpacing() {","        const { object } = this;","        const density = Math.max(object._getDensity(), 0);","        if (density <= 0) return 0;","        const spacing = 100 / Math.sqrt(density);","        // Too many cells would freeze the game: the density is lowered.","        const cellCount = (object.getWidth() / spacing) * (object.getHeight() / spacing);","        return cellCount > MAX_COPIES ? spacing * Math.sqrt(cellCount / MAX_COPIES) : spacing;","    }","","    /**","     * Find the copy of a cell of the grid, if there is one.","     * @returns {Copy | null}","     */","    _placeCopy(cellI, cellJ, spacing, grounds) {","        const { object } = this;","        const width = object.getWidth();","        const height = object.getHeight();","        const nextRandom = createRandom(hashCell(Math.floor(object._getSeed()), cellI, cellJ));","        // Always drawn in the same order, so that a copy stays the same when properties change.","        const x = (cellI + nextRandom()) * spacing;","        const y = (cellJ + nextRandom()) * spacing;","        const presence = nextRandom();","        const growth = nextRandom();","        const scaleFactor = nextRandom();","        const angle = nextRandom() * Math.PI * 2;","        if (x > width || y > height) return null;","        if (presence >= this.mask.sample(x / width, y / height)) return null;","        const key = cellJ * 65536 + cellI;","        if (this.removedCopies.has(key)) return null;","","        const sceneX = object.getX() + x;","        const sceneY = object.getY() + y;","        const { ground, z } = findHighestGround(grounds, sceneX, sceneY, this._groundAtCopy);","        const groundZ = ground ? z : object.getZ();","        if (groundZ < object._getMinGroundZ() || groundZ > object._getMaxGroundZ()) return null;","        const copyHeight =","            Math.max(object._getSize(), 0) *","            (object._getMinScale() + (object._getMaxScale() - object._getMinScale()) * scaleFactor);","        if (ground) {","            if (ground.getSlopeAt(sceneX, sceneY) > object._getMaxSlope()) return null;","            const groundLayer = parseInt(object._getGroundLayer(), 10) || 0;","            if (groundLayer > 0) {","                if (growth > ground.getLayerWeightAt(sceneX, sceneY, groundLayer)) return null;","                // Copies don't stand at the border of their layer, so that trees don't cover roads.","                const margin = (copyHeight * Math.max(this.model.width, this.model.depth)) / 4;","                for (const [offsetX, offsetY] of [[margin, 0], [-margin, 0], [0, margin], [0, -margin]]) {","                    if (ground.getLayerWeightAt(sceneX + offsetX, sceneY + offsetY, groundLayer) < 0.5) return null;","                }","            }","        }","        return {","            x: sceneX,","            y: sceneY,","            z: groundZ,","            angle: object._getRandomRotation() ? angle : 0,","            height: copyHeight,","            key,","        };","    }","","    _disposeChunks(chunks) {","        for (const chunk of chunks) {","            for (const mesh of chunk.meshes) {","                mesh.removeFromParent();","                // Geometries and materials are the ones of the model.","                mesh.dispose();","            }","        }","        if (chunks === this.chunks) this.chunks = [];","    }","","    /** Place the copies again, for example after the ground or the object changed. */","    rebuild() {","        this._disposeChunks(this.chunks);","        this.version++;","        const { object } = this;","        const spacing = this._getSpacing();","        if (spacing <= 0 || this.model.parts.length === 0) {","            this.grid = null;","            return;","        }","        const cellsPerChunk = Math.max(Math.round(this._getChunkSize() / spacing), 1);","        const grid = {","            spacing,","            cellsPerChunk,","            cellsX: Math.ceil(object.getWidth() / spacing),","            cellsY: Math.ceil(object.getHeight() / spacing),","        };","        this.grid = grid;","        for (let firstCellJ = 0; firstCellJ < grid.cellsY; firstCellJ += cellsPerChunk) {","            for (let firstCellI = 0; firstCellI < grid.cellsX; firstCellI += cellsPerChunk) {","                this._createChunk(firstCellI, firstCellJ);","            }","        }","    }","","    /**","     * Place again the copies of the chunks touching a rectangle of the scene,","     * for example after painting.","     */","    _rebuildArea(minX, minY, maxX, maxY) {","        const { grid, object } = this;","        if (!grid) return;","        const chunkSize = grid.spacing * grid.cellsPerChunk;","        const firstChunkI = Math.max(Math.floor((minX - object.getX()) / chunkSize), 0);","        const firstChunkJ = Math.max(Math.floor((minY - object.getY()) / chunkSize), 0);","        const lastChunkI = Math.min(Math.floor((maxX - object.getX()) / chunkSize), Math.ceil(grid.cellsX / grid.cellsPerChunk) - 1);","        const lastChunkJ = Math.min(Math.floor((maxY - object.getY()) / chunkSize), Math.ceil(grid.cellsY / grid.cellsPerChunk) - 1);","        if (firstChunkI > lastChunkI || firstChunkJ > lastChunkJ) return;","        const isInArea = (chunk) => {","            const chunkI = chunk.firstCellI / grid.cellsPerChunk;","            const chunkJ = chunk.firstCellJ / grid.cellsPerChunk;","            return chunkI >= firstChunkI && chunkI <= lastChunkI && chunkJ >= firstChunkJ && chunkJ <= lastChunkJ;","        };","        this._disposeChunks(this.chunks.filter(isInArea));","        this.chunks = this.chunks.filter((chunk) => !isInArea(chunk));","        for (let chunkJ = firstChunkJ; chunkJ <= lastChunkJ; chunkJ++) {","            for (let chunkI = firstChunkI; chunkI <= lastChunkI; chunkI++) {","                this._createChunk(chunkI * grid.cellsPerChunk, chunkJ * grid.cellsPerChunk);","            }","        }","        this.version++;","    }","","    _createChunk(firstCellI, firstCellJ) {","        const { grid } = this;","        const grounds = Array.from(this.placement.grounds);","        /** @type {Copy[]} */","        const copies = [];","        for (let cellJ = firstCellJ; cellJ < Math.min(firstCellJ + grid.cellsPerChunk, grid.cellsY); cellJ++) {","            for (let cellI = firstCellI; cellI < Math.min(firstCellI + grid.cellsPerChunk, grid.cellsX); cellI++) {","                const copy = this._placeCopy(cellI, cellJ, grid.spacing, grounds);","                if (copy) copies.push(copy);","            }","        }","        if (copies.length === 0) return;","","        const { object } = this;","        // Copies are placed in scene units, and the object group is scaled","        // from its inner area: they are scaled back to keep their proportions.","        const scaleX = Math.max(object.getWidth() / AREA_SIZE, 0.0001);","        const scaleY = Math.max(object.getHeight() / AREA_SIZE, 0.0001);","        const scaleZ = Math.max(object.getDepth() / AREA_DEPTH, 0.0001);","        const matrices = new Float32Array(copies.length * 16);","        const tintColor = gdjs.rgbOrHexStringToNumber(object._getRandomTint());","        const hasTint = tintColor !== 0xffffff;","        const colors = hasTint ? new Float32Array(copies.length * 3) : null;","        this._tint.setHex(tintColor);","        const min = new THREE.Vector3(Infinity, Infinity, Infinity);","        const max = new THREE.Vector3(-Infinity, -Infinity, -Infinity);","        copies.forEach((copy, index) => {","            const cos = Math.cos(copy.angle) * copy.height;","            const sin = Math.sin(copy.angle) * copy.height;","            const localX = (copy.x - object.getX()) / scaleX;","            const localY = (copy.y - object.getY()) / scaleY;","            const localZ = (copy.z - object.getZ()) / scaleZ;","            this._matrix.set(","                cos / scaleX, -sin / scaleX, 0, localX,","                sin / scaleY, cos / scaleY, 0, localY,","                0, 0, copy.height / scaleZ, localZ,","                0, 0, 0, 1","            );","            this._matrix.toArray(matrices, index * 16);","            if (colors) {","                // The tint of each copy is between white and the tint color.","                this._color.setRGB(1, 1, 1).lerp(this._tint, createRandom(copy.key + 1)());","                this._color.toArray(colors, index * 3);","            }","            const reach = (copy.height * Math.max(this.model.width, this.model.depth)) / 2;","            min.min(this._chunkPosition.set(copy.x - reach, copy.y - reach, copy.z));","            max.max(this._chunkPosition.set(copy.x + reach, copy.y + reach, copy.z + copy.height));","        });","        const instanceMatrix = new THREE.InstancedBufferAttribute(matrices, 16);","        const instanceColor = colors ? new THREE.InstancedBufferAttribute(colors, 3) : null;","        const castShadow = object._getCastShadow();","        const receiveShadow = object._getReceiveShadow();","        const meshes = this.model.parts.map((part) => {","            const mesh = new THREE.InstancedMesh(part.geometry, part.material, 0);","            // All the parts of the model share the positions of the copies.","            mesh.instanceMatrix = instanceMatrix;","            mesh.instanceColor = instanceColor;","            mesh.count = copies.length;","            mesh.computeBoundingSphere();","            mesh.castShadow = castShadow;","            mesh.receiveShadow = receiveShadow;","            // The first mesh tests all the parts of the copies.","            mesh.raycast = () => {};","            this.group.add(mesh);","            return mesh;","        });","        const center = new THREE.Vector3(","            ((min.x + max.x) / 2 - object.getX()) / scaleX,","            ((min.y + max.y) / 2 - object.getY()) / scaleY,","            ((min.z + max.z) / 2 - object.getZ()) / scaleZ","        );","        const chunk = { firstCellI, firstCellJ, meshes, copies, center, radius: min.distanceTo(max) / 2 };","        // Used by the scene editor to select the object when a copy is clicked.","        meshes[0].raycast = (raycaster, intersects) => this._raycastChunk(chunk, raycaster, intersects);","        this.chunks.push(chunk);","    }","","    /**","     * Add the hits of a ray on the copies of a chunk, like they are drawn. There","     * can be thousands of copies: only the ones whose box is crossed by the ray","     * are tested with the triangles of the model.","     * @param {{meshes: THREE.InstancedMesh[], copies: Copy[], center: THREE.Vector3, radius: number}} chunk","     * @param {THREE.Raycaster} raycaster","     * @param {THREE.Intersection[]} intersects","     */","    _raycastChunk(chunk, raycaster, intersects) {","        const { object, group } = this;","        this._raycastSphere.center.copy(chunk.center).applyMatrix4(group.matrixWorld);","        this._raycastSphere.radius = chunk.radius / getWorldScale(object);","        if (!raycaster.ray.intersectsSphere(this._raycastSphere)) return;","","        // The ray in the scene coordinates, like the copies.","        const scale = this._raycastScale.set(","            Math.max(object.getWidth() / AREA_SIZE, 0.0001),","            Math.max(object.getHeight() / AREA_SIZE, 0.0001),","            Math.max(object.getDepth() / AREA_DEPTH, 0.0001)","        );","        const ray = this._raycastRay.copy(raycaster.ray).applyMatrix4(this._raycastInverseMatrix.copy(group.matrixWorld).invert());","        ray.origin.multiply(scale).add(this._chunkPosition.set(object.getX(), object.getY(), object.getZ()));","        ray.direction.multiply(scale);","","        const reachPerHeight = Math.max(this.model.width, this.model.depth) / 2;","        const instanceMatrices = chunk.meshes[0].instanceMatrix.array;","        chunk.copies.forEach((copy, index) => {","            const reach = copy.height * reachPerHeight;","            this._raycastBox.min.set(copy.x - reach, copy.y - reach, copy.z);","            this._raycastBox.max.set(copy.x + reach, copy.y + reach, copy.z + copy.height);","            if (!ray.intersectsBox(this._raycastBox)) return;","            this._raycastMesh.matrixWorld.fromArray(instanceMatrices, index * 16).premultiply(group.matrixWorld);","            for (const mesh of chunk.meshes) {","                this._raycastMesh.geometry = mesh.geometry;","                this._raycastMesh.material = mesh.material;","                this._raycastHits.length = 0;","                this._raycastMesh.raycast(raycaster, this._raycastHits);","                for (const hit of this._raycastHits) {","                    hit.object = mesh;","                    hit.instanceId = index;","                    intersects.push(hit);","                }","            }","        });","    }","","    /** @param {THREE.Camera | null} camera */","    _hideFarChunks(camera) {","        if (!camera) return;","        const worldScale = getWorldScale(this.object);","        const drawDistance = Math.max(this.object._getDrawDistance(), 1) / worldScale;","        this.uniforms.scatterDrawDistance.value = drawDistance;","        this._cameraPosition.setFromMatrixPosition(camera.matrixWorld);","        for (const chunk of this.chunks) {","            const distance = this._chunkPosition","                .copy(chunk.center)","                .applyMatrix4(this.group.matrixWorld)","                .distanceTo(this._cameraPosition);","            const isVisible = distance - chunk.radius / worldScale < drawDistance;","            for (const mesh of chunk.meshes) mesh.visible = isVisible;","        }","    }","","    /**","     * @param {number} elapsedSeconds","     * @param {THREE.Camera | null} camera","     */","    update(elapsedSeconds, camera) {","        if (this.placement.shouldPlaceAgain(elapsedSeconds, this._getPlacementKey())) {","            this.rebuild();","        }","        if (!this.changedSamples.isEmpty()) {","            const { object } = this;","            const sampleWidth = object.getWidth() / MASK_RESOLUTION;","            const sampleHeight = object.getHeight() / MASK_RESOLUTION;","            const { minI, minJ, maxI, maxJ } = this.changedSamples;","            // Copies between samples use the density of the samples around them.","            this._rebuildArea(","                object.getX() + (minI - 1) * sampleWidth,","                object.getY() + (minJ - 1) * sampleHeight,","                object.getX() + (maxI + 1) * sampleWidth,","                object.getY() + (maxJ + 1) * sampleHeight","            );","            this.changedSamples.clear();","        }","        // The object transformation is applied just before rendering, it's needed now.","        this.object.getRenderer().ensureUpToDate();","        this.group.updateWorldMatrix(true, false);","        this._hideFarChunks(camera);","        this._updateSurface();","    }","","    _updateSurface() {","        const { object } = this;","        if (typeof object.setSurface !== 'function') return;","        const trunkKey = object._getTrunkCollisions() + '|' + object._getTrunkDiameter();","        if (trunkKey !== this.trunkKey) {","            this.trunkKey = trunkKey;","            this.version++;","        }","        if (object.getSurface() !== this.surface) object.setSurface(this.surface);","    }","","    /** @returns {Copy[]} */","    getCopies() {","        const copies = [];","        for (const chunk of this.chunks) copies.push(...chunk.copies);","        return copies;","    }","","    /**","     * @returns {Copy | null} The copy whose base is the nearest to a position (on X and Y), if any.","     */","    findNearestCopy(x, y) {","        let nearestCopy = null;","        let nearestDistanceSquared = Infinity;","        for (const chunk of this.chunks) {","            for (const copy of chunk.copies) {","                const distanceSquared = (copy.x - x) * (copy.x - x) + (copy.y - y) * (copy.y - y);","                if (distanceSquared < nearestDistanceSquared) {","                    nearestDistanceSquared = distanceSquared;","                    nearestCopy = copy;","                }","            }","        }","        return nearestCopy;","    }","","    getCopyCount() {","        let count = 0;","        for (const chunk of this.chunks) count += chunk.copies.length;","        return count;","    }","","    /** Remove the copies whose base is in a circle (they come back when the scene is restarted). */","    removeCopies(x, y, radius) {","        let hasRemovedCopies = false;","        for (const chunk of this.chunks) {","            for (const copy of chunk.copies) {","                if ((copy.x - x) * (copy.x - x) + (copy.y - y) * (copy.y - y) <= radius * radius) {","                    this.removedCopies.set(copy.key, copy);","                    hasRemovedCopies = true;","                }","            }","        }","        if (hasRemovedCopies) this._rebuildArea(x - radius, y - radius, x + radius, y + radius);","    }","","    /** Paint the full density around a position, and bring back the copies removed there. */","    addCopies(x, y, radius) {","        for (const [key, copy] of this.removedCopies) {","            if ((copy.x - x) * (copy.x - x) + (copy.y - y) * (copy.y - y) <= radius * radius) {","                this.removedCopies.delete(key);","            }","        }","        this.paint(x, y, x, y, radius, 1, 1);","    }","","    _getStroke(x1, y1, x2, y2, radius) {","        const { object } = this;","        const stroke = this._stroke;","        stroke.cellWidth = object.getWidth() / MASK_RESOLUTION;","        stroke.cellHeight = object.getHeight() / MASK_RESOLUTION;","        stroke.ax = x1 - object.getX();","        stroke.ay = y1 - object.getY();","        stroke.bx = x2 - object.getX();","        stroke.by = y2 - object.getY();","        stroke.radius = Math.max(radius, 0);","        return stroke;","    }","","    /**","     * Paint the density around a segment (copies are placed again at the next frame).","     * @param {number} density From 0 (erase) to 1 (as dense as the Density property).","     * @param {number} strength From 0 to 1.","     */","    paint(x1, y1, x2, y2, radius, density, strength) {","        const changedSamples = new SampleRectangle();","        this.mask.paint(this._getStroke(x1, y1, x2, y2, radius), density, strength, changedSamples);","        this.changedSamples.add(changedSamples);","    }","","    /** @param {DensityMask} mask */","    setMask(mask) {","        this.mask = mask;","        this.rebuild();","    }","","    /**","     * Prisms around the trunks, from 0 to 1 in the object box (see `gdjs.Surface`).","     * @returns {gdjs.SurfaceTriangles}","     */","    _getTrunkTriangles() {","        const { object } = this;","        const copies = object._getTrunkCollisions() ? this.getCopies() : [];","        const verticesPerCopy = TRUNK_SIDES * 2 + 1;","        const positions = new Float32Array(copies.length * verticesPerCopy * 3);","        const indices = new Uint32Array(copies.length * TRUNK_SIDES * 3 * 3);","        const width = object.getWidth() || 1;","        const height = object.getHeight() || 1;","        const depth = object.getDepth() || 1;","        let indexOffset = 0;","        copies.forEach((copy, copyIndex) => {","            const radius = (Math.max(object._getTrunkDiameter(), 0) / 2) * (copy.height / Math.max(object._getSize(), 1));","            const top = copy.z + copy.height * 0.8;","            const firstVertex = copyIndex * verticesPerCopy;","            const setVertex = (vertex, x, y, z) => {","                positions[vertex * 3] = (x - object.getX()) / width;","                positions[vertex * 3 + 1] = (y - object.getY()) / height;","                positions[vertex * 3 + 2] = (z - object.getZ()) / depth;","            };","            for (let side = 0; side < TRUNK_SIDES; side++) {","                const angle = ((side + 0.5) / TRUNK_SIDES) * Math.PI * 2;","                const x = copy.x + Math.cos(angle) * radius;","                const y = copy.y + Math.sin(angle) * radius;","                // Starting a bit under the ground, which can be sloped.","                setVertex(firstVertex + side * 2, x, y, copy.z - radius);","                setVertex(firstVertex + side * 2 + 1, x, y, top);","            }","            const center = firstVertex + TRUNK_SIDES * 2;","            setVertex(center, copy.x, copy.y, top);","            for (let side = 0; side < TRUNK_SIDES; side++) {","                const bottom = firstVertex + side * 2;","                const nextBottom = firstVertex + ((side + 1) % TRUNK_SIDES) * 2;","                // Triangles face out of the prism (vertices at odd indices are at the top).","                indices.set([bottom, nextBottom, bottom + 1, nextBottom, nextBottom + 1, bottom + 1], indexOffset);","                indices.set([center, bottom + 1, nextBottom + 1], indexOffset + 6);","                indexOffset += 9;","            }","        });","        if (copies.length === 0) {","            // Without triangles, the physics engine and navigation meshes would use","            // the object box: a tiny triangle under the object is used instead.","            return { positions: new Float32Array([0, 0, -1, 0.0001, 0, -1, 0, 0.0001, -1]), indices: new Uint32Array([0, 2, 1]) };","        }","        return { positions, indices };","    }","","    dispose() {","        this.isDisposed = true;","        if (typeof this.object.setSurface === 'function' && this.object.getSurface() === this.surface) {","            this.object.setSurface(null);","        }","        this._disposeChunks(this.chunks);","        this._disposeModel();","        this.group.removeFromParent();","    }","}","","const scatterToolIcons = {","    Add: svgIcon(","        '<path fill=\"none\" stroke=\"#000\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M8 21v-4M8 17l-4-1 4-9 4 9zM17 21v-6M17 15l-3-1 3-6 3 6zM19 3v4M17 5h4\"/>'","    ),","    Erase: svgIcon(","        '<path fill=\"none\" stroke=\"#000\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M8 21v-4M8 17l-4-1 4-9 4 9zM15 4l6 6M21 4l-6 6\"/>'","    ),","};","","/**"," * The brushes shown in the scene editor when scattered models are selected,"," * to add or erase copies. Without the needed editor functions (older GDevelop"," * versions), nothing is shown: copies can still be painted with events."," */","class ScatterEditorTools {","    constructor() {","        /** '' when no brush is used. */","        this.toolName = '';","        this.sizePercent = 30;","        this.strengthPercent = 50;","        /** @type {Scatter | null} */","        this.scatter = null;","        /** @type {gdjs.InGameEditor | null} */","        this.editor = null;","        this.isStroking = false;","        this.lastStrokeTime = 0;","        /** @type {Array<{mask: DensityMask, baseMask: DensityMask}>} */","        this.undoSteps = [];","        this.raycaster = new THREE.Raycaster();","        this.ndc = new THREE.Vector2();","        this._groundAtCursor = { ground: null, z: 0 };","        /** A circle following the ground under the cursor. */","        this.brushRing = new THREE.LineLoop(","            new THREE.BufferGeometry().setAttribute('position', new THREE.BufferAttribute(new Float32Array(64 * 3), 3)),","            new THREE.LineBasicMaterial({ color: 0xffffff, depthTest: false, transparent: true })","        );","        this.brushRing.renderOrder = 1000;","        this.brushRing.frustumCulled = false;","        this.brushRing.raycast = () => {};","    }","","    /** @param {gdjs.InGameEditor} editor */","    update(editor) {","        if (typeof editor.showToolbar !== 'function') return;","        this.editor = editor;","        const selectedObjects = editor.getSelectedObjects();","        const scatter =","            selectedObjects.length === 1 && selectedObjects[0].__terrainScatter ? selectedObjects[0].__terrainScatter : null;","        if (scatter !== this.scatter) {","            this._endStroke();","            this.scatter = scatter;","            this.undoSteps.length = 0;","        }","        if (scatter) editor.showToolbar('ScatteredModels', this._getToolbarItems());","        const game = editor.getRuntimeGame();","        if (!scatter || !this.toolName) {","            this.brushRing.removeFromParent();","            return;","        }","        const inputManager = game.getInputManager();","        if (inputManager.wasKeyJustPressed(gdjs.evtTools.input.keysNameToCode.Escape)) {","            this._endStroke();","            this.toolName = '';","            this.brushRing.removeFromParent();","            return;","        }","        editor.captureLeftMouseButton();","        const hit = this._getPositionUnderCursor(scatter, game);","        const radius = this._getRadius();","        this._showBrushRing(scatter, hit, radius);","","        const isPressedForTool =","            typeof editor.isCapturedLeftMouseButtonPressed === 'function'","                ? editor.isCapturedLeftMouseButtonPressed()","                : inputManager.isMouseButtonPressed(0);","        // The button is released outside the canvas when the mouse is on a toolbar.","        const isPressed = isPressedForTool && inputManager.isMouseInsideCanvas();","        if (isPressed && hit && !this.isStroking) {","            this._startStroke(scatter);","        }","        if (this.isStroking && isPressed && hit) {","            this._applyBrush(scatter, hit, radius);","        }","        if (!isPressed) {","            this._endStroke();","        }","    }","","    _getRadius() {","        const { object } = this.scatter;","        const maxRadius = Math.max(object.getWidth(), object.getHeight()) / 4;","        return Math.max(maxRadius * Math.pow(this.sizePercent / 100, 2), 10);","    }","","    /**","     * @returns {{x: number, y: number} | null} The position of the scene under the cursor: on the","     * highest ground hit, or on the plane at the object Z.","     */","    _getPositionUnderCursor(scatter, game) {","        let hit = null;","        for (const ground of getGrounds(scatter.object.getRuntimeScene())) {","            if (typeof ground.raycastFromCursor !== 'function') continue;","            const localHit = ground.raycastFromCursor(game, this.raycaster, this.ndc);","            if (!localHit) continue;","            const sceneHit = ground.toScenePosition(localHit);","            if (!hit || sceneHit.z > hit.z) hit = sceneHit;","        }","        if (hit) return hit;","","        const { object } = scatter;","        const layer = object.getInstanceContainer().getLayer(object.getLayer());","        const camera = layer.getRenderer().getThreeCamera();","        if (!camera) return null;","        const inputManager = game.getInputManager();","        this.ndc.set(","            (inputManager.getCursorX() / game.getGameResolutionWidth()) * 2 - 1,","            -(inputManager.getCursorY() / game.getGameResolutionHeight()) * 2 + 1","        );","        this.raycaster.setFromCamera(this.ndc, camera);","        scatter.group.updateWorldMatrix(true, false);","        const ray = this.raycaster.ray.clone().applyMatrix4(scatter.group.matrixWorld.clone().invert());","        const point = ray.intersectPlane(new THREE.Plane(new THREE.Vector3(0, 0, 1), 0), new THREE.Vector3());","        if (!point) return null;","        return {","            x: object.getX() + (point.x / AREA_SIZE) * object.getWidth(),","            y: object.getY() + (point.y / AREA_SIZE) * object.getHeight(),","        };","    }","","    _showBrushRing(scatter, hit, radius) {","        if (!hit) {","            this.brushRing.removeFromParent();","            return;","        }","        const { object } = scatter;","        if (this.brushRing.parent !== scatter.group) scatter.group.add(this.brushRing);","        const grounds = getGrounds(object.getRuntimeScene());","        const positions = this.brushRing.geometry.attributes.position;","        for (let index = 0; index < positions.count; index++) {","            const angle = (index / positions.count) * Math.PI * 2;","            const x = hit.x + Math.cos(angle) * radius;","            const y = hit.y + Math.sin(angle) * radius;","            const { ground, z } = findHighestGround(grounds, x, y, this._groundAtCursor);","            positions.setXYZ(","                index,","                ((x - object.getX()) / object.getWidth()) * AREA_SIZE,","                ((y - object.getY()) / object.getHeight()) * AREA_SIZE,","                (((ground ? z : object.getZ()) + 2 - object.getZ()) / Math.max(object.getDepth(), 0.0001)) * AREA_DEPTH","            );","        }","        positions.needsUpdate = true;","    }","","    _startStroke(scatter) {","        this.isStroking = true;","        this.lastStrokeTime = performance.now();","        this.undoSteps.push({ mask: scatter.mask.clone(), baseMask: scatter.baseMask });","        while (this.undoSteps.length > 30) this.undoSteps.shift();","    }","","    _endStroke() {","        if (!this.isStroking) return;","        this.isStroking = false;","        this._save();","    }","","    _applyBrush(scatter, hit, radius) {","        const now = performance.now();","        const elapsedSeconds = Math.min((now - this.lastStrokeTime) / 1000, 0.1);","        this.lastStrokeTime = now;","        const strength = (this.strengthPercent / 100) * elapsedSeconds * 8;","        scatter.paint(hit.x, hit.y, hit.x, hit.y, radius, this.toolName === 'Add' ? 1 : 0, strength);","    }","","    _save() {","        const { scatter, editor } = this;","        if (!scatter || !editor) return;","        editor.updateObjectProperties(scatter.object.getName(), { PaintData: scatter.save() });","    }","","    _undo() {","        const undoStep = this.undoSteps.pop();","        // The coverage or the edits may have changed since the stroke.","        if (!this.scatter || !undoStep || undoStep.baseMask !== this.scatter.baseMask) {","            this.undoSteps.length = 0;","            return;","        }","        this.scatter.setMask(undoStep.mask);","        this._save();","    }","","    /** @returns {Array<gdjs.InGameEditorToolbarItem>} */","    _getToolbarItems() {","        const toolButton = (toolName, tooltip) => ({","            type: 'button',","            id: toolName,","            tooltip,","            iconUrl: scatterToolIcons[toolName],","            isActive: this.toolName === toolName,","            onClick: () => (this.toolName = this.toolName === toolName ? '' : toolName),","        });","        return [","            toolButton('Add', 'Add copies (drag on the ground)'),","            toolButton('Erase', 'Erase copies'),","            { type: 'divider', id: 'BrushDivider' },","            {","                type: 'slider',","                id: 'Size',","                tooltip: 'Brush size',","                iconUrl: toolIcons.Size,","                min: 1,","                max: 100,","                value: this.sizePercent,","                onChange: (value) => (this.sizePercent = value),","            },","            {","                type: 'slider',","                id: 'Strength',","                tooltip: 'Brush strength',","                iconUrl: toolIcons.Strength,","                min: 5,","                max: 100,","                value: this.strengthPercent,","                onChange: (value) => (this.strengthPercent = value),","            },","            {","                type: 'button',","                id: 'Undo',","                tooltip: 'Undo the last stroke on these scattered models',","                iconUrl: toolIcons.Undo,","                onClick: () => this._undo(),","            },","        ];","    }","}","","const editorTools = new ScatterEditorTools();","if (gdjs.registerInGameEditorPostStepCallback) {","    gdjs.registerInGameEditorPostStepCallback((editor) => editorTools.update(editor));","}","","g