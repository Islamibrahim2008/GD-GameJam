t":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::ScatteredModels","type":"object"}],"objectGroups":[]},{"description":"Paint the density of copies around a position, up to the density of the object (copies removed with \"Erase copies\" come back). The effect fades out up to the radius.","fullName":"Add copies","functionType":"Action","group":"Paint","name":"AddCopies","sentence":"Add copies of _PARAM0_ around _PARAM1_; _PARAM2_ with a radius of _PARAM3_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const x = eventsFunctionContext.getArgument(\"X\");","const y = eventsFunctionContext.getArgument(\"Y\");","const radius = eventsFunctionContext.getArgument(\"Radius\");","object.__terrainScatter.addCopies(x, y, radius);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::ScatteredModels","type":"object"},{"description":"X position of the center","name":"X","type":"expression"},{"description":"Y position of the center","name":"Y","type":"expression"},{"description":"Radius","name":"Radius","type":"expression"}],"objectGroups":[]},{"description":"Remove the copies standing in a circle, for example a tree cut by the player (use the position of the nearest copy and a small radius) or a forest cleared for a building. They come back when the scene is restarted.","fullName":"Erase copies","functionType":"Action","group":"Paint","name":"EraseCopies","sentence":"Erase the copies of _PARAM0_ in a circle at _PARAM1_; _PARAM2_ with a radius of _PARAM3_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const x = eventsFunctionContext.getArgument(\"X\");","const y = eventsFunctionContext.getArgument(\"Y\");","const radius = eventsFunctionContext.getArgument(\"Radius\");","object.__terrainScatter.removeCopies(x, y, radius);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::ScatteredModels","type":"object"},{"description":"X position of the center","name":"X","type":"expression"},{"description":"Y position of the center","name":"Y","type":"expression"},{"description":"Radius","name":"Radius","type":"expression"}],"objectGroups":[]},{"description":"the number of copies placed in the area.","fullName":"Number of copies","functionType":"ExpressionAndCondition","group":"Copies","name":"CopyCount","sentence":"the number of copies","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","eventsFunctionContext.returnValue = object.__terrainScatter.getCopyCount();"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::ScatteredModels","type":"object"}],"objectGroups":[]},{"description":"The X position of the base of the copy nearest to a position (the position itself if there is no copy).","fullName":"X position of the nearest copy","functionType":"Expression","group":"Copies","name":"NearestCopyX","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const x = eventsFunctionContext.getArgument(\"X\");","const y = eventsFunctionContext.getArgument(\"Y\");","const copy = object.__terrainScatter.findNearestCopy(x, y);","eventsFunctionContext.returnValue = copy ? copy.x : x;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::ScatteredModels","type":"object"},{"description":"X position","name":"X","type":"expression"},{"description":"Y position","name":"Y","type":"expression"}],"objectGroups":[]},{"description":"The Y position of the base of the copy nearest to a position (the position itself if there is no copy).","fullName":"Y position of the nearest copy","functionType":"Expression","group":"Copies","name":"NearestCopyY","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const x = eventsFunctionContext.getArgument(\"X\");","const y = eventsFunctionContext.getArgument(\"Y\");","const copy = object.__terrainScatter.findNearestCopy(x, y);","eventsFunctionContext.returnValue = copy ? copy.y : y;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::ScatteredModels","type":"object"},{"description":"X position","name":"X","type":"expression"},{"description":"Y position","name":"Y","type":"expression"}],"objectGroups":[]},{"description":"The Z position of the base of the copy nearest to a position (on the ground).","fullName":"Z position of the nearest copy","functionType":"Expression","group":"Copies","name":"NearestCopyZ","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const x = eventsFunctionContext.getArgument(\"X\");","const y = eventsFunctionContext.getArgument(\"Y\");","const copy = object.__terrainScatter.findNearestCopy(x, y);","eventsFunctionContext.returnValue = copy ? copy.z : object.getZ();"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::ScatteredModels","type":"object"},{"description":"X position","name":"X","type":"expression"},{"description":"Y position","name":"Y","type":"expression"}],"objectGroups":[]},{"description":"the distance (on X and Y) from a position to the base of the nearest copy. It's a very big number when there is no copy.","fullName":"Distance to the nearest copy","functionType":"ExpressionAndCondition","group":"Copies","name":"NearestCopyDistance","sentence":"the distance from _PARAM1_; _PARAM2_ to the nearest copy","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const x = eventsFunctionContext.getArgument(\"X\");","const y = eventsFunctionContext.getArgument(\"Y\");","const copy = object.__terrainScatter.findNearestCopy(x, y);","eventsFunctionContext.returnValue = copy ? Math.hypot(copy.x - x, copy.y - y) : Number.MAX_VALUE;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::ScatteredModels","type":"object"},{"description":"X position","name":"X","type":"expression"},{"description":"Y position","name":"Y","type":"expression"}],"objectGroups":[]}],"eventsFunctionsFolderStructure":{"folderName":"__ROOT","children":[{"functionName":"onCreated"},{"functionName":"onDestroy"},{"functionName":"doStepPostEvents"},{"functionName":"onHotReloading"},{"folderName":"Paint","children":[{"functionName":"AddCopies"},{"functionName":"EraseCopies"}]},{"folderName":"Copies","children":[{"functionName":"CopyCount"},{"functionName":"NearestCopyX"},{"functionName":"NearestCopyY"},{"functionName":"NearestCopyZ"},{"functionName":"NearestCopyDistance"}]}]},"propertyDescriptors":[{"value":"","type":"Resource","label":"3D model","description":"The model copied everywhere (a .glb file). Models standing on the Y axis, like most models of the asset store, are stood up along Z.","group":"Model","extraInformation":["model3D"],"choices":[],"name":"Model"},{"value":"300","type":"Number","unit":"Pixel","label":"Height of a copy","description":"Copies keep the proportions of the model.","group":"Model","name":"Size"},{"value":"0.8","type":"Number","label":"Smallest random scale","description":"Each copy is scaled at random between the smallest and the largest scale.","group":"Model","name":"MinScale"},{"value":"1.2","type":"Number","label":"Largest random scale","group":"Model","name":"MaxScale"},{"value":"true","type":"Boolean","label":"Random rotation","description":"Turn each copy around the Z axis at random.","group":"Model","name":"RandomRotation"},{"value":"255;255;255","type":"Color","label":"Random tint","description":"Each copy is tinted between white and this color, at random. White for no tint.","group":"Model","name":"RandomTint"},{"value":"0.3","type":"Number","label":"Density","description":"The number of copies in a square of 100 x 100 pixels where the density is fully painted (0.3 is about one copy every 180 pixels). Copies never overlap their neighbors much: they are placed at random in a grid.","group":"Placement","name":"Density"},{"value":"1","type":"Number","label":"Seed","description":"Each seed places copies differently.","group":"Placement","name":"Seed"},{"value":"Everywhere","type":"Choice","label":"Copies grow","description":"Everywhere in the area, or only where they are painted with the \"Add copies\" brush (or the edits).","group":"Placement","choices":[{"label":"Everywhere (erase them with the brush)","value":"Everywhere"},{"label":"Only where painted","value":"Painted"}],"name":"Coverage"},{"value":"1","type":"Choice","label":"Grows on terrain layer","description":"On a 3D terrain, copies only grow where this layer is painted, away from its borders (so that trees don't stand on roads painted with another layer). A new terrain has layer 1 painted everywhere.","group":"Ground","choices":[{"label":"Any","value":"0"},{"label":"Layer 1","value":"1"},{"label":"Layer 2","value":"2"},{"label":"Layer 3","value":"3"},{"label":"Layer 4","value":"4"}],"name":"GroundLayer"},{"value":"30","type":"Number","unit":"DegreeAngle","label":"Maximum slope","description":"No copies grow on steeper ground.","group":"Ground","name":"MaxSlope"},{"value":"-100000","type":"Number","unit":"Pixel","label":"Minimum ground Z","description":"No copies grow where the ground is lower (for example, under the water level).","group":"Ground","name":"MinGroundZ"},{"value":"100000","type":"Number","unit":"Pixel","label":"Maximum ground Z","description":"No copies grow where the ground is higher (for example, above the tree line).","group":"Ground","name":"MaxGroundZ"},{"value":"false","type":"Boolean","label":"Trunk collisions","description":"Give each copy a static collision shape around its trunk, for the 3D physics behavior (add it to this object, with the \"Static\" type) and navigation meshes. Without them, these behaviors have no effect on this object.","group":"Collisions","name":"TrunkCollisions"},{"value":"30","type":"Number","unit":"Pixel","label":"Trunk diameter","description":"The diameter of the collision shape of a copy at the height given in \"Height of a copy\" (it is scaled with the copy).","group":"Collisions","name":"TrunkDiameter"},{"value":"8000","type":"Number","unit":"Pixel","label":"Draw distance","description":"Copies shrink and are hidden at this distance from the camera.","group":"Rendering","name":"DrawDistance"},{"value":"true","type":"Boolean","label":"Cast shadows","group":"Rendering","name":"CastShadow"},{"value":"true","type":"Boolean","label":"Receive shadows","group":"Rendering","name":"ReceiveShadow"},{"value":"","type":"MultilineString","label":"Edits","description":"Where copies are added or erased, applied in order, as a JSON list, for example [{\"tool\": \"add\", \"x\": 0.3, \"y\": 0.4, \"radius\": 0.15}, {\"tool\": \"erase\", \"x\": 0.1, \"y\": 0.9, \"toX\": 0.8, \"toY\": 0.2, \"radius\": 0.02}]. Tools: add (density: from 0 to 1, 1 by default, how dense copies are compared to the Density property) and erase. strength (from 0 to 1) makes a stroke lighter. x, y and radius are fractions (0 to 1) of the object size (x is (scene X - object X) / object width). Add toX and toY to paint along a line (a row of trees, a path through a forest). With \"Copies grow: only where painted\", only the added areas have copies. Shown in the scene editor.","group":"Placement","advanced":true,"name":"Edits"},{"value":"","type":"String","label":"Painted data","description":"Written by the brushes of the scene editor, in a compact format not meant to be read or written by hand: use Edits instead. Clear it to go back to the coverage and the edits.","advanced":true,"name":"PaintData"}],"propertiesFolderStructure":{"folderName":"__ROOT","children":[{"folderName":"Model","children":[{"propertyName":"Model"},{"propertyName":"Size"},{"propertyName":"MinScale"},{"propertyName":"MaxScale"},{"propertyName":"RandomRotation"},{"propertyName":"RandomTint"}]},{"folderName":"Placement","children":[{"propertyName":"Density"},{"propertyName":"Seed"},{"propertyName":"Coverage"},{"propertyName":"Edits"}]},{"folderName":"Ground","children":[{"propertyName":"GroundLayer"},{"propertyName":"MaxSlope"},{"propertyName":"MinGroundZ"},{"propertyName":"MaxGroundZ"}]},{"folderName":"Collisions","children":[{"propertyName":"TrunkCollisions"},{"propertyName":"TrunkDiameter"}]},{"folderName":"Rendering","children":[{"propertyName":"DrawDistance"},{"propertyName":"CastShadow"},{"propertyName":"ReceiveShadow"}]},{"propertyName":"PaintData"}]},"variants":[]}]},{"author":"","category":"General","dimension":"3D","extensionNamespace":"","fullName":"Calculate 3D Vector","gdevelopVersion":"","helpPath":"","iconUrl":"data:image/svg+xml;base64,","name":"Calculate3DVector","previewIconUrl":"","shortDescription":"3D vector math expressions: build vectors from distance and angles, camera forward/right vectors, normalize, dot/cross product, angles and distances. Designed to work with A3F.","version":"1.0.0","description":["3D vector expressions for GDevelop, consistent with the A3F extension:  ","- Vec3_X / Vec3_Y / Vec3_Z: vector from distance, Z angle and X angle (camera convention)","- CameraForward / CameraRight: vectors from the camera rotation, no -90 offset needed","- Length, Normalize, Distance, Dot, Cross, AngleBetween, AngleZ, AngleX","- DistanceToPoint: distance from a 3D object to a position (center or origin point)","","Angles are in degrees. Z angle: 0 = +X, 90 = +Y. X angle: 0 = down, 90 = horizontal, 180 = up (same as the 3D camera RotationX)."],"tags":["3d","vector","math","camera","direction","distance","angle"],"authorIds":[],"dependencies":[],"globalVariables":[],"sceneVariables":[],"eventsFunctions":[{"description":"Returns the X component of a 3D vector built from a distance, a horizontal angle (Z) and a vertical angle (X).","fullName":"↗️Vector X from distance and angles","functionType":"Expression","group":"Spherical vectors","name":"Vec3_X","sentence":"↗️Vector X (Distance: _PARAM1_, Z angle: _PARAM2_, X angle: _PARAM3_)","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const N = (v) => { v = Number(v); return Number.isFinite(v) ? v : 0; };","const C = (v) => { v = Math.round(v * 1e10) / 1e10; return v === 0 ? 0 : v; };","const A = (n) => N(eventsFunctionContext.getArgument(n));","","const D=A('Distance'), z=gdjs.toRad(A('AngleZ')), x=gdjs.toRad(A('AngleX'));","eventsFunctionContext.returnValue = C(D * Math.sin(x) * Math.cos(z));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Distance (length of the vector)","name":"Distance","type":"expression"},{"description":"Horizontal angle in degrees (Z rotation)","longDescription":"0 = towards +X, 90 = towards +Y. For a camera pointing forward use CameraRotationZ - 90, or use the Camera forward expressions.","name":"AngleZ","type":"expression"},{"description":"Vertical angle in degrees (X rotation, camera convention)","longDescription":"Same convention as the 3D camera RotationX: 0 = straight down (-Z), 90 = horizontal, 180 = straight up (+Z).","name":"AngleX","type":"expression"}],"objectGroups":[]},{"description":"Returns the Y component of a 3D vector built from a distance, a horizontal angle (Z) and a vertical angle (X).","fullName":"↗️Vector Y from distance and angles","functionType":"Expression","group":"Spherical vectors","name":"Vec3_Y","sentence":"↗️Vector Y (Distance: _PARAM1_, Z angle: _PARAM2_, X angle: _PARAM3_)","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const N = (v) => { v = Number(v); return Number.isFinite(v) ? v : 0; };","const C = (v) => { v = Math.round(v * 1e10) / 1e10; return v === 0 ? 0 : v; };","const A = (n) => N(eventsFunctionContext.getArgument(n));","","const D=A('Distance'), z=gdjs.toRad(A('AngleZ')), x=gdjs.toRad(A('AngleX'));","eventsFunctionContext.returnValue = C(D * Math.sin(x) * Math.sin(z));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Distance (length of the vector)","name":"Distance","type":"expression"},{"description":"Horizontal angle in degrees (Z rotation)","longDescription":"0 = towards +X, 90 = towards +Y. For a camera pointing forward use CameraRotationZ - 90, or use the Camera forward expressions.","name":"AngleZ","type":"expression"},{"description":"Vertical angle in degrees (X rotation, camera convention)","longDescription":"Same convention as the 3D camera RotationX: 0 = straight down (-Z), 90 = horizontal, 180 = straight up (+Z).","name":"AngleX","type":"expression"}],"objectGroups":[]},{"description":"Returns the Z component of a 3D vector built from a distance, a horizontal angle (Z) and a vertical angle (X).","fullName":"↗️Vector Z from distance and angles","functionType":"Expression","group":"Spherical vectors","name":"Vec3_Z","sentence":"↗️Vector Z (Distance: _PARAM1_, Z angle: _PARAM2_, X angle: _PARAM3_)","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const N = (v) => { v = Number(v); return Number.isFinite(v) ? v : 0; };","const C = (v) => { v = Math.round(v * 1e10) / 1e10; return v === 0 ? 0 : v; };","const A = (n) => N(eventsFunctionContext.getArgument(n));","","const D=A('Distance'), z=gdjs.toRad(A('AngleZ')), x=gdjs.toRad(A('AngleX'));","eventsFunctionContext.returnValue = C(-D * Math.cos(x));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Distance (length of the vector)","name":"Distance","type":"expression"},{"description":"Horizontal angle in degrees (Z rotation)","longDescription":"0 = towards +X, 90 = towards +Y. For a camera pointing forward use CameraRotationZ - 90, or use the Camera forward expressions.","name":"AngleZ","type":"expression"},{"description":"Vertical angle in degrees (X rotation, camera convention)","longDescription":"Same convention as the 3D camera RotationX: 0 = straight down (-Z), 90 = horizontal, 180 = straight up (+Z).","name":"AngleX","type":"expression"}],"objectGroups":[]},{"description":"Returns the X component of the vector pointing where the camera looks, scaled by Distance. Equivalent to Vec3_X(Distance, CameraRotationZ - 90, CameraRotationX).","fullName":"🎥Camera forward X","functionType":"Expression","group":"Camera","name":"CameraForward_X","sentence":"🎥Camera forward X (Distance: _PARAM1_, Camera Z: _PARAM2_, Camera X: _PARAM3_)","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const N = (v) => { v = Number(v); return Number.isFinite(v) ? v : 0; };","const C = (v) => { v = Math.round(v * 1e10) / 1e10; return v === 0 ? 0 : v; };","const A = (n) => N(eventsFunctionContext.getArgument(n));","","const D=A('Distance'), z=gdjs.toRad(A('CameraRotationZ') - 90), x=gdjs.toRad(A('CameraRotationX'));","eventsFunctionContext.returnValue = C(D*Math.sin(x)*Math.cos(z));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Distance (length of the vector)","name":"Distance","type":"expression"},{"description":"Camera Z rotation (degrees)","name":"CameraRotationZ","type":"expression"},{"description":"Camera X rotation (degrees)","name":"CameraRotationX","type":"expression"}],"objectGroups":[]},{"description":"Returns the Y component of the vector pointing where the camera looks, scaled by Distance. Equivalent to Vec3_Y(Distance, CameraRotationZ - 90, CameraRotationX).","fullName":"🎥Camera forward Y","functionType":"Expression","group":"Camera","name":"CameraForward_Y","sentence":"🎥Camera forward Y (Distance: _PARAM1_, Camera Z: _PARAM2_, Camera X: _PARAM3_)","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const N = (v) => { v = Number(v); return Number.isFinite(v) ? v : 0; };","const C = (v) => { v = Math.round(v * 1e10) / 1e10; return v === 0 ? 0 : v; };","const A = (n) => N(eventsFunctionContext.getArgument(n));","","const D=A('Distance'), z=gdjs.toRad(A('CameraRotationZ') - 90), x=gdjs.toRad(A('CameraRotationX'));","eventsFunctionContext.returnValue = C(D*Math.sin(x)*Math.sin(z));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Distance (length of the vector)","name":"Distance","type":"expression"},{"description":"Camera Z rotation (degrees)","name":"CameraRotationZ","type":"expression"},{"description":"Camera X rotation (degrees)","name":"CameraRotationX","type":"expression"}],"objectGroups":[]},{"description":"Returns the Z component of the vector pointing where the camera looks, scaled by Distance. Equivalent to Vec3_Z(Distance, CameraRotationZ - 90, CameraRotationX).","fullName":"🎥Camera forward Z","functionType":"Expression","group":"Camera","name":"CameraForward_Z","sentence":"🎥Camera forward Z (Distance: _PARAM1_, Camera Z: _PARAM2_, Camera X: _PARAM3_)","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const N = (v) => { v = Number(v); return Number.isFinite(v) ? v : 0; };","const C = (v) => { v = Math.round(v * 1e10) / 1e10; return v === 0 ? 0 : v; };","const A = (n) => N(eventsFunctionContext.getArgument(n));","","const D=A('Distance'), z=gdjs.toRad(A('CameraRotationZ') - 90), x=gdjs.toRad(A('CameraRotationX'));","eventsFunctionContext.returnValue = C(-D*Math.cos(x));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Distance (length of the vector)","name":"Distance","type":"expression"},{"description":"Camera Z rotation (degrees)","name":"CameraRotationZ","type":"expression"},{"description":"Camera X rotation (degrees)","name":"CameraRotationX","type":"expression"}],"objectGroups":[]},{"description":"Returns the X component of the horizontal vector pointing to the right of the camera, scaled by Distance.","fullName":"🎥Camera right X","functionType":"Expression","group":"Camera","name":"CameraRight_X","sentence":"🎥Camera right X (Distance: _PARAM1_, Camera Z: _PARAM2_)","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const N = (v) => { v = Number(v); return Number.isFinite(v) ? v : 0; };","const C = (v) => { v = Math.round(v * 1e10) / 1e10; return v === 0 ? 0 : v; };","const A = (n) => N(eventsFunctionContext.getArgument(n));","","const D=A('Distance'), z=gdjs.toRad(A('CameraRotationZ'));","eventsFunctionContext.returnValue = C(D*Math.cos(z));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Distance (length of the vector)","name":"Distance","type":"expression"},{"description":"Camera Z rotation (degrees)","name":"CameraRotationZ","type":"expression"}],"objectGroups":[]},{"description":"Returns the Y component of the horizontal vector pointing to the right of the camera, scaled by Distance.","fullName":"🎥Camera right Y","functionType":"Expression","group":"Camera","name":"CameraRight_Y","sentence":"🎥Camera right Y (Distance: _PARAM1_, Camera Z: _PARAM2_)","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const N = (v) => { v = Number(v); return Number.isFinite(v) ? v : 0; };","const C = (v) => { v = Math.round(v * 1e10) / 1e10; return v === 0 ? 0 : v; };","const A = (n) => N(eventsFunctionContext.getArgument(n));","","const D=A('Distance'), z=gdjs.toRad(A('CameraRotationZ'));","eventsFunctionContext.returnValue = C(D*Math.sin(z));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Distance (length of the vector)","name":"Distance","type":"expression"},{"description":"Camera Z rotation (degrees)","name":"CameraRotationZ","type":"expression"}],"objectGroups":[]},{"description":"Returns the length of the vector (X, Y, Z).","fullName":"📏Vector length","functionType":"Expression","group":"Vector math","name":"Length","sentence":"📏Vector length (_PARAM1_, _PARAM2_, _PARAM3_)","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const N = (v) => { v = Number(v); return Number.isFinite(v) ? v : 0; };","const C = (v) => { v = Math.round(v * 1e10) / 1e10; return v === 0 ? 0 : v; };","const A = (n) => N(eventsFunctionContext.getArgument(n));","","eventsFunctionContext.returnValue = Math.hypot(A('VX'), A('VY'), A('VZ'));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Vector X","name":"VX","type":"expression"},{"description":"Vector Y","name":"VY","type":"expression"},{"description":"Vector Z","name":"VZ","type":"expression"}],"objectGroups":[]},{"description":"Returns the X component of the vector (X, Y, Z) scaled to length 1 (0 if the vector is null).","fullName":"↗️Normalized vector X","functionType":"Expression","group":"Vector math","name":"Normalize_X","sentence":"↗️Normalized vector X (_PARAM1_, _PARAM2_, _PARAM3_)","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const N = (v) => { v = Number(v); return Number.isFinite(v) ? v : 0; };","const C = (v) => { v = Math.round(v * 1e10) / 1e10; return v === 0 ? 0 : v; };","const A = (n) => N(eventsFunctionContext.getArgument(n));","","const x=A('VX'), y=A('VY'), z=A('VZ'); const L=Math.hypot(x,y,z);","eventsFunctionContext.returnValue = L === 0 ? 0 : C(x / L);"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Vector X","name":"VX","type":"expression"},{"description":"Vector Y","name":"VY","type":"expression"},{"description":"Vector Z","name":"VZ","type":"expression"}],"objectGroups":[]},{"description":"Returns the Y component of the vector (X, Y, Z) scaled to length 1 (0 if the vector is null).","fullName":"↗️Normalized vector Y","functionType":"Expression","group":"Vector math","name":"Normalize_Y","sentence":"↗️Normalized vector Y (_PARAM1_, _PARAM2_, _PARAM3_)","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const N = (v) => { v = Number(v); return Number.isFinite(v) ? v : 0; };","const C = (v) => { v = Math.round(v * 1e10) / 1e10; return v === 0 ? 0 : v; };","const A = (n) => N(eventsFunctionContext.getArgument(n));","","const x=A('VX'), y=A('VY'), z=A('VZ'); const L=Math.hypot(x,y,z);","eventsFunctionContext.returnValue = L === 0 ? 0 : C(y / L);"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Vector X","name":"VX","type":"expression"},{"description":"Vector Y","name":"VY","type":"expression"},{"description":"Vector Z","name":"VZ","type":"expression"}],"objectGroups":[]},{"description":"Returns the Z component of the vector (X, Y, Z) scaled to length 1 (0 if the vector is null).","fullName":"↗️Normalized vector Z","functionType":"Expression","group":"Vector math","name":"Normalize_Z","sentence":"↗️Normalized vector Z (_PARAM1_, _PARAM2_, _PARAM3_)","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const N = (v) => { v = Number(v); return Number.isFinite(v) ? v : 0; };","const C = (v) => { v = Math.round(v * 1e10) / 1e10; return v === 0 ? 0 : v; };","const A = (n) => N(eventsFunctionContext.getArgument(n));","","const x=A('VX'), y=A('VY'), z=A('VZ'); const L=Math.hypot(x,y,z);","eventsFunctionContext.returnValue = L === 0 ? 0 : C(z / L);"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Vector X","name":"VX","type":"expression"},{"description":"Vector Y","name":"VY","type":"expression"},{"description":"Vector Z","name":"VZ","type":"expression"}],"objectGroups":[]},{"description":"Returns the distance between point A and point B in 3D.","fullName":"↔️Distance between two points","functionType":"Expression","group":"Vector math","name":"Distance","sentence":"↔️Distance (_PARAM1_, _PARAM2_, _PARAM3_) → (_PARAM4_, _PARAM5_, _PARAM6_)","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const N = (v) => { v = Number(v); return Number.isFinite(v) ? v : 0; };","const C = (v) => { v = Math.round(v * 1e10) / 1e10; return v === 0 ? 0 : v; };","const A = (n) => N(eventsFunctionContext.getArgument(n));","","eventsFunctionContext.returnValue = Math.hypot(A('BX')-A('AX'), A('BY')-A('AY'), A('BZ')-A('AZ'));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Vector A X","name":"AX","type":"expression"},{"description":"Vector A Y","name":"AY","type":"expression"},{"description":"Vector A Z","name":"AZ","type":"expression"},{"description":"Vector B X","name":"BX","type":"expression"},{"description":"Vector B Y","name":"BY","type":"expression"},{"description":"Vector B Z","name":"BZ","type":"expression"}],"objectGroups":[]},{"description":"Returns the dot product of vectors A and B.","fullName":"✖️Dot product","functionType":"Expression","group":"Vector math","name":"Dot","sentence":"✖️Dot product of A and B","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const N = (v) => { v = Number(v); return Number.isFinite(v) ? v : 0; };","const C = (v) => { v = Math.round(v * 1e10) / 1e10; return v === 0 ? 0 : v; };","const A = (n) => N(eventsFunctionContext.getArgument(n));","","eventsFunctionContext.returnValue = A('AX')*A('BX') + A('AY')*A('BY') + A('AZ')*A('BZ');"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Vector A X","name":"AX","type":"expression"},{"description":"Vector A Y","name":"AY","type":"expression"},{"description":"Vector A Z","name":"AZ","type":"expression"},{"description":"Vector B X","name":"BX","type":"expression"},{"description":"Vector B Y","name":"BY","type":"expression"},{"description":"Vector B Z","name":"BZ","type":"expression"}],"objectGroups":[]},{"description":"Returns the X component of the cross product A × B.","fullName":"✖️Cross product X","functionType":"Expression","group":"Vector math","name":"Cross_X","sentence":"✖️Cross product X of A × B","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const N = (v) => { v = Number(v); return Number.isFinite(v) ? v : 0; };","const C = (v) => { v = Math.round(v * 1e10) / 1e10; return v === 0 ? 0 : v; };","const A = (n) => N(eventsFunctionContext.getArgument(n));","","const ax=A('AX'), ay=A('AY'), az=A('AZ'), bx=A('BX'), by=A('BY'), bz=A('BZ');","eventsFunctionContext.returnValue = ay*bz - az*by;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Vector A X","name":"AX","type":"expression"},{"description":"Vector A Y","name":"AY","type":"expression"},{"description":"Vector A Z","name":"AZ","type":"expression"},{"description":"Vector B X","name":"BX","type":"expression"},{"description":"Vector B Y","name":"BY","type":"expression"},{"description":"Vector B Z","name":"BZ","type":"expression"}],"objectGroups":[]},{"description":"Returns the Y component of the cross product A × B.","fullName":"✖️Cross product Y","functionType":"Expression","group":"Vector math","name":"Cross_Y","sentence":"✖️Cross product Y of A × B","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const N = (v) => { v = Number(v); return Number.isFinite(v) ? v : 0; };","const C = (v) => { v = Math.round(v * 1e10) / 1e10; return v === 0 ? 0 : v; };","const A = (n) => N(eventsFunctionContext.getArgument(n));","","const ax=A('AX'), ay=A('AY'), az=A('AZ'), bx=A('BX'), by=A('BY'), bz=A('BZ');","eventsFunctionContext.returnValue = az*bx - ax*bz;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Vector A X","name":"AX","type":"expression"},{"description":"Vector A Y","name":"AY","type":"expression"},{"description":"Vector A Z","name":"AZ","type":"expression"},{"description":"Vector B X","name":"BX","type":"expression"},{"description":"Vector B Y","name":"BY","type":"expression"},{"description":"Vector B Z","name":"BZ","type":"expression"}],"objectGroups":[]},{"description":"Returns the Z component of the cross product A × B.","fullName":"✖️Cross product Z","functionType":"Expression","group":"Vector math","name":"Cross_Z","sentence":"✖️Cross product Z of A × B","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const N = (v) => { v = Number(v); return Number.isFinite(v) ? v : 0; };","const C = (v) => { v = Math.round(v * 1e10) / 1e10; return v === 0 ? 0 : v; };","const A = (n) => N(eventsFunctionContext.getArgument(n));","","const ax=A('AX'), ay=A('AY'), az=A('AZ'), bx=A('BX'), by=A('BY'), bz=A('BZ');","eventsFunctionContext.returnValue = ax*by - ay*bx;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Vector A X","name":"AX","type":"expression"},{"description":"Vector A Y","name":"AY","type":"expression"},{"description":"Vector A Z","name":"AZ","type":"expression"},{"description":"Vector B X","name":"BX","type":"expression"},{"description":"Vector B Y","name":"BY","type":"expression"},{"description":"Vector B Z","name":"BZ","type":"expression"}],"objectGroups":[]},{"description":"Returns the angle in degrees (0 to 180) between vectors A and B.","fullName":"📐Angle between two vectors","functionType":"Expression","group":"Vector math","name":"AngleBetween","sentence":"📐Angle between A and B","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const N = (v) => { v = Number(v); return Number.isFinite(v) ? v : 0; };","const C = (v) => { v = Math.round(v * 1e10) / 1e10; return v === 0 ? 0 : v; };","const A = (n) => N(eventsFunctionContext.getArgument(n));","","const ax=A('AX'), ay=A('AY'), az=A('AZ'), bx=A('BX'), by=A('BY'), bz=A('BZ');","const L = Math.hypot(ax,ay,az) * Math.hypot(bx,by,bz);","eventsFunctionContext.returnValue = L === 0 ? 0 : gdjs.toDegrees(Math.acos(Math.max(-1, Math.min(1, (ax*bx+ay*by+az*bz)/L))));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Vector A X","name":"AX","type":"expression"},{"description":"Vector A Y","name":"AY","type":"expression"},{"description":"Vector A Z","name":"AZ","type":"expression"},{"description":"Vector B X","name":"BX","type":"expression"},{"description":"Vector B Y","name":"BY","type":"expression"},{"description":"Vector B Z","name":"BZ","type":"expression"}],"objectGroups":[]},{"description":"Returns the horizontal angle in degrees of the vector (X, Y, Z). Inverse of Vec3_X/Y/Z for the Z angle.","fullName":"🧭Horizontal angle of a vector (Z)","functionType":"Expression","group":"Vector math","name":"AngleZ","sentence":"🧭Horizontal angle (Z) of (_PARAM1_, _PARAM2_, _PARAM3_)","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const N = (v) => { v = Number(v); return Number.isFinite(v) ? v : 0; };","const C = (v) => { v = Math.round(v * 1e10) / 1e10; return v === 0 ? 0 : v; };","const A = (n) => N(eventsFunctionContext.getArgument(n));","","eventsFunctionContext.returnValue = C(gdjs.toDegrees(Math.atan2(A('VY'), A('VX'))));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Vector X","name":"VX","type":"expression"},{"description":"Vector Y","name":"VY","type":"expression"},{"description":"Vector Z","name":"VZ","type":"expression"}],"objectGroups":[]},{"description":"Returns the vertical angle in degrees of the vector (X, Y, Z) using the camera convention (0 = down, 90 = horizontal, 180 = up).","fullName":"🧭Vertical angle of a vector (X)","functionType":"Expression","group":"Vector math","name":"AngleX","sentence":"🧭Vertical angle (X) of (_PARAM1_, _PARAM2_, _PARAM3_)","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const N = (v) => { v = Number(v); return Number.isFinite(v) ? v : 0; };","const C = (v) => { v = Math.round(v * 1e10) / 1e10; return v === 0 ? 0 : v; };","const A = (n) => N(eventsFunctionContext.getArgument(n));","","const x=A('VX'), y=A('VY'), z=A('VZ'); const L=Math.hypot(x,y,z);","eventsFunctionContext.returnValue = L === 0 ? 90 : C(gdjs.toDegrees(Math.acos(Math.max(-1, Math.min(1, -z / L)))));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Vector X","name":"VX","type":"expression"},{"description":"Vector Y","name":"VY","type":"expression"},{"description":"Vector Z","name":"VZ","type":"expression"}],"objectGroups":[]},{"description":"Returns the distance between a 3D object and a position in 3D (scene coordinates). Returns 0 when a 2D object is selected.","fullName":"↔️Distance from 3D object to a point","functionType":"Expression","group":"Position","name":"DistanceToPoint","sentence":"↔️Distance from 3D object to point (_PARAM1_, _PARAM2_, X: _PARAM3_, Y: _PARAM4_, Z: _PARAM5_)","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const N = (v) => { v = Number(v); return Number.isFinite(v) ? v : 0; };","const C = (v) => { v = Math.round(v * 1e10) / 1e10; return v === 0 ? 0 : v; };","const A = (n) => N(eventsFunctionContext.getArgument(n));","","const ObjectPoint = eventsFunctionContext.getArgument(\"ObjectPoint\");","if (objects.length == 0) {","    eventsFunctionContext.returnValue = 0;","    return;","}","const O = objects[0];","if (!O.get3DRendererObject || !O.get3DRendererObject()) {","    eventsFunctionContext.returnValue = 0;","    return;","}","let px, py, pz;","if (ObjectPoint === \"Center point\") {","    px = O.getCenterXInScene(); py = O.getCenterYInScene(); pz = O.getCenterZInScene();","} else {","    px = O.getX(); py = O.getY(); pz = O.getZ();","}","eventsFunctionContext.returnValue = Math.hypot(px - A('X'), py - A('Y'), pz - A('Z'));"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"objectList"},{"description":"Points of the 3D object","name":"ObjectPoint","supplementaryInformation":"[\"Center point\",\"Origin point\"]","type":"stringWithSelector"},{"description":"Target X (scene)","name":"X","type":"expression"},{"description":"Target Y (scene)","name":"Y","type":"expression"},{"description":"Target Z (scene)","name":"Z","type":"expression"}],"objectGroups":[]}],"eventsFunctionsFolderStructure":{"folderName":"__ROOT","children":[{"folderName":"Spherical vectors","children":[{"functionName":"Vec3_X"},{"functionName":"Vec3_Y"},{"functionName":"Vec3_Z"}]},{"folderName":"Camera","children":[{"functionName":"CameraForward_X"},{"functionName":"CameraForward_Y"},{"functionName":"CameraForward_Z"},{"functionName":"CameraRight_X"},{"functionName":"CameraRight_Y"}]},{"folderName":"Vector math","children":[{"functionName":"Length"},{"functionName":"Normalize_X"},{"functionName":"Normalize_Y"},{"functionName":"Normalize_Z"},{"functionName":"Distance"},{"functionName":"Dot"},{"functionName":"Cross_X"},{"functionName":"Cross_Y"},{"functionName":"Cross_Z"},{"functionName":"AngleBetween"},{"functionName":"AngleZ"},{"functionName":"AngleX"}]},{"folderName":"Position","children":[{"functionName":"DistanceToPoint"}]}]},"eventsBasedBehaviors":[],"eventsBasedObjects":[]},{"author":"","category":"Game mechanic","dimension":"","extensionNamespace":"","fullName":"Universal interaction system (نظام التفاعل الموحد)","gdevelopVersion":"","helpPath":"","iconUrl":"data:image/svg+xml;base64,","name":"UniversalInteraction","previewIconUrl":"data:image/svg+xml;base64,","shortDescription":"Detect what the player aims at in 3D, show its name / available action, then run the right interaction (door, pickup, inspect, talk...).","version":"1.0.0","description":["One unified system for 3D games: raycast detection (camera center or cursor, with wall occlusion), prompts (built-in overlay or Text object), highlight outline, and ready-made interactions: open/lock doors with keys, pick up items into an inventory, inspect notes, talk to characters, switches and custom interactions.","","Uses the Three.js bundled with GDevelop (only stable APIs: Raycaster, BoxHelper), world-scale aware."],"tags":["interaction","raycast","3d","door","pickup","inventory","prompt","npc","threejs"],"authorIds":[],"dependencies":[],"globalVariables":[],"sceneVariables":[],"eventsFunctions":[{"fullName":"onFirstSceneLoaded","functionType":"Action","name":"onFirstSceneLoaded","sentence":"","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"UniversalInteraction::DeclareLibrary"},"parameters":[""]}]}],"parameters":[],"objectGroups":[]},{"fullName":"onSceneLoaded","functionType":"Action","name":"onSceneLoaded","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":"const lib = gdjs._universalInteraction; if (lib) lib.getManager(runtimeScene);","parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[],"objectGroups":[]},{"fullName":"onScenePreEvents","functionType":"Action","name":"onScenePreEvents","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const lib = gdjs._universalInteraction; if (!lib) return;","const mgr = lib.getManager(runtimeScene);","mgr.update(lib.frameSeconds(runtimeScene));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[],"objectGroups":[]},{"fullName":"onScenePostEvents","functionType":"Action","name":"onScenePostEvents","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const lib = gdjs._universalInteraction; if (!lib) return;","const mgr = lib.getManager(runtimeScene);","mgr.endFrame();"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[],"objectGroups":[]},{"fullName":"onSceneUnloading","functionType":"Action","name":"onSceneUnloading","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const lib = gdjs._universalInteraction; if (!lib) return;","lib.getManager(runtimeScene).dispose();","runtimeScene._universalInteractionManager = null;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[],"objectGroups":[]},{"description":"Internal: declares the JavaScript library.","fullName":"Declare the interaction library","functionType":"Action","group":"Universal interaction","name":"DeclareLibrary","private":true,"sentence":"Declare the interaction library","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// ============================================================================","// Universal Interaction System - runtime library (declared once, idempotent)","// Uses only long-stable Three.js APIs (Raycaster, Vector2/3, BoxHelper) so it","// works with the THREE global bundled by GDevelop (tested against r185 API).","// ============================================================================","if (gdjs._universalInteraction) return;","","const VERSION = '1.0.0';","","// ---- Texts (verbs + messages). Overridable with the \"Set interaction text\" action.","const TEXTS = {","  en: {","    door_open: 'Open', door_close: 'Close', pickup: 'Pick up', inspect: 'Inspect',","    talk: 'Talk to', use: 'Use', custom: 'Interact',","    locked: \"It's locked.\", missing_item: 'You need the right key.',","    unlocked: 'Unlocked.', picked: 'Picked up: ',","  },","  ar: {","    door_open: 'فتح', door_close: 'إغلاق', pickup: 'التقاط', inspect: 'فحص',","    talk: 'التحدث إلى', use: 'استخدام', custom: 'تفاعل',","    locked: 'مقفل.', missing_item: 'تحتاج إلى المفتاح المناسب.',","    unlocked: 'تم فتح القفل.', picked: 'تم التقاط: ',","  },","};","","// ---- Small helpers","const toBool = (v) => v === true || v === 'true' || v === 1 || v === '1';","const toNum = (v, d = 0) => { const n = Number(v); return Number.isFinite(n) ? n : d; };","const getProp = (b, name, fallback) => {","  const f = b['_get' + name];","  if (typeof f !== 'function') return fallback;","  const v = f.call(b);","  return v === undefined || v === null ? fallback : v;","};","const setProp = (b, name, value) => {","  const f = b['_set' + name];","  if (typeof f === 'function') f.call(b, value);","};","const parseColor = (value, fallback) => {","  if (typeof value === 'number') return value;","  const s = String(value === undefined || value === null ? '' : value).trim();","  if (/^#?[0-9a-f]{6}$/i.test(s)) return parseInt(s.replace('#', ''), 16);","  const parts = s.split(';');","  if (parts.length >= 3) {","    const c = parts.slice(0, 3).map((x) => Math.max(0, Math.min(255, parseInt(x, 10) || 0)));","    return (c[0] << 16) | (c[1] << 8) | c[2];","  }","  return fallback;","};","const cssColor = (hex) => '#' + (hex >>> 0).toString(16).padStart(6, '0');","const rendererOf = (object) =>","  object && typeof object.get3DRendererObject === 'function' ? object.get3DRendererObject() : null;","const sceneOf = (object, fallback) => {","  const s = object && object.getRuntimeScene ? object.getRuntimeScene() : null;","  return s || fallback;","};","const OK_RESULTS = new Set(['opened', 'closed', 'unlocked', 'picked', 'inspected', 'talking', 'activated', 'deactivated', 'custom']);","","// ---- The manager (one per scene)","class InteractionManager {","  constructor(scene) {","    this.scene = scene;","    this.targets = new Set();","    this.blockers = new Set();","    this.inventory = new Map();","    this.texts = {};","    this.cfg = {","      enabled: true, mode: 'center', layer: '', maxDistance: 300, cooldown: 0.25,","      language: 'en', format: '[{key}] {verb} {name}', key: 'E', refName: '',","      highlight: true, highlightColor: 0xffd54a,","      overlay: false, overlayFontSize: 22, overlayColor: 0xffffff, overlayBottom: 90,","    };","    this.focus = null;","    this.cooldownLeft = 0;","    this.interacted = false;","    this.last = { kind: '', name: '', message: '', id: '', result: 'none', objectName: '' };","    this._ray = null; this._ndc = null; this._v3 = null;","    this._helper = null; this._helperRoot = null; this._helperTop = null;","    this._overlay = null;","  }","","  // -- registration","  register(b) { this.targets.add(b); }","  unregister(b) {","    this.targets.delete(b);","    if (this.focus && this.focus.behavior === b) this.focus = null;","  }","  registerBlocker(b) { this.blockers.add(b); }","  unregisterBlocker(b) { this.blockers.delete(b); }","","  // -- texts","  tr(key) {","    if (this.texts[key] !== undefined) return this.texts[key];","    const t = TEXTS[this.cfg.language] || TEXTS.en;","    return t[key] !== undefined ? t[key] : (TEXTS.en[key] || '');","  }","","  // -- inventory","  addItem(id, n = 1) { if (!id) return; this.inventory.set(id, (this.inventory.get(id) || 0) + n); }","  removeItem(id, n = 1) {","    const left = (this.inventory.get(id) || 0) - n;","    if (left > 0) this.inventory.set(id, left); else this.inventory.delete(id);","  }","  hasItem(id, n = 1) { return (this.inventory.get(id) || 0) >= n; }","  itemCount(id) { return this.inventory.get(id) || 0; }","  inventoryJSON() { return JSON.stringify(Object.fromEntries(this.inventory)); }","  loadInventoryJSON(json) {","    try {","      const o = JSON.parse(json);","      this.inventory.clear();","      Object.keys(o || {}).forEach((k) => { const n = toNum(o[k], 0); if (n > 0) this.inventory.set(k, n); });","    } catch (e) { console.warn('[UniversalInteraction] Invalid inventory JSON.', e); }","  }","","  // -- description of a target","  isCandidate(b) {","    const s = b._universalInteraction;","    if (!s || !s.object) return false;","    if (b.activated && !b.activated()) return false;","    if (!toBool(getProp(b, 'Enabled', true))) return false;","    if (s.object.isHidden && s.object.isHidden()) return false;","    return true;","  }","  nameOf(b) {","    const n = String(getProp(b, 'DisplayName', '') || '');","    return n || b._universalInteraction.object.getName();","  }","  kindOf(b) { return String(getProp(b, 'Kind', 'custom')); }","  verbOf(b) {","    const custom = String(getProp(b, 'Verb', '') || '');","    if (custom) return custom;","    const kind = this.kindOf(b);","    if (kind === 'door') return this.tr(toBool(getProp(b, 'IsOpen', false)) ? 'door_close' : 'door_open');","    return this.tr(kind);","  }","  statusOf(b) {","    const kind = this.kindOf(b);","    if (kind === 'door') return toBool(getProp(b, 'Locked', false)) ? 'locked' : (toBool(getProp(b, 'IsOpen', false)) ? 'open' : 'closed');","    if (kind === 'use') return toBool(getProp(b, 'Toggled', false)) ? 'on' : 'off';","    return '';","  }","  promptOf(d) {","    const c = this.cfg;","    return c.format","      .replace(/\\{key\\}/g, c.key).replace(/\\{verb\\}/g, d.verb)","      .replace(/\\{name\\}/g, d.name).replace(/\\{status\\}/g, d.status)","      .replace(/\\[\\s*\\]/g, '').replace(/\\s+/g, ' ').trim();","  }","  describe(b) {","    const d = { kind: this.kindOf(b), name: this.nameOf(b), verb: this.verbOf(b), status: this.statusOf(b) };","    d.prompt = this.promptOf(d);","    return d;","  }","","  // -- reference position (player) used to measure the interaction distance","  refPosition() {","    if (!this.cfg.refName) return null;","    const list = this.scene.getObjects(this.cfg.refName);","    const o = list && list[0];","    if (!o) return null;","    return {","      x: o.getCenterXInScene ? o.getCenterXInScene() : o.getX(),","      y: o.getCenterYInScene ? o.getCenterYInScene() : o.getY(),","      z: o.getCenterZInScene ? o.getCenterZInScene() : (o.getZ ? o.getZ() + (o.getDepth ? o.getDepth() / 2 : 0) : 0),","    };","  }","","  // -- per-frame detection","  update(dt) {","    this.cooldownLeft = Math.max(0, this.cooldownLeft - dt);","    this.detect();","    this.updateHighlight();","    this.updateOverlay();","  }","","  detect() {","    this.focus = null;","    const cfg = this.cfg;","    if (!cfg.enabled || typeof THREE === 'undefined' || this.targets.size === 0) return;","    const scene = this.scene;","    const layer = scene.getLayer(cfg.layer);","    const layerRenderer = layer && layer.getRenderer ? layer.getRenderer() : null;","    const camera = layerRenderer && layerRenderer.getThreeCamera ? layerRenderer.getThreeCamera() : null;","    if (!camera) return;","","    // World scale (see GDevelop docs: \"Handle 3D renderer world scale\").","    const inv = scene.getRenderer3DInverseWorldScale ? scene.getRenderer3DInverseWorldScale() : 1;","    const ws = scene.getRenderer3DWorldScale ? scene.getRenderer3DWorldScale() : 1;","","    // Aim point in normalized device coordinates.","    let nx = 0, ny = 0;","    if (cfg.mode === 'cursor') {","      const game = scene.getGame();","      const input = game.getInputManager();","      let px = input.getMouseX(), py = input.getMouseY();","      if (input.getTouchIds && input.getTouchIds().length > 0) {","        const id = input.getTouchIds()[0];","        px = input.getTouchX(id); py = input.getTouchY(id);","      }","      nx = (px / game.getGameResolutionWidth()) * 2 - 1;","      ny = -((py / game.getGameResolutionHeight()) * 2 - 1);","    }","","    // Collect renderer objects: interactables AND blockers (walls, closed doors...).","    const roots = [];","    const owners = new Map();","    let farPx = cfg.maxDistance;","    for (const b of this.targets) {","      const s = b._universalInteraction;","      if (!s || !s.object) continue;","      const root = rendererOf(s.object);","      if (!root) {","        if (!s.warned) { s.warned = true; console.warn('[UniversalInteraction] \"' + s.object.getName() + '\" is not a 3D object, it cannot be targeted.'); }","        continue;","      }","      if (s.object.isHidden && s.object.isHidden()) continue;","      root.updateWorldMatrix(true, true);","      owners.set(root, { b, root, blocker: false, ok: this.isCandidate(b) });","      roots.push(root);","      const d = toNum(getProp(b, 'InteractDistance', 0)); if (d > farPx) farPx = d;","    }","    for (const b of this.blockers) {","      const s = b._universalInteraction;","      const root = s && rendererOf(s.object);","      if (!root || (s.object.isHidden && s.object.isHidden())) continue;","      root.updateWorldMatrix(true, true);","      owners.set(root, { b, root, blocker: true, ok: false });","      roots.push(root);","    }","    if (roots.length === 0) return;","","    const ref = this.refPosition();","    let camToRef = 0;","    if (ref) {","      this._v3 = this._v3 || new THREE.Vector3();","      camera.getWorldPosition(this._v3);","      camToRef = Math.hypot(this._v3.x * ws - ref.x, this._v3.y * ws - ref.y, this._v3.z * ws - ref.z);","    }","","    this._ray = this._ray || new THREE.Raycaster();","    this._ndc = this._ndc || new THREE.Vector2();","    this._ndc.set(nx, ny);","    camera.updateMatrixWorld(true);","    this._ray.setFromCamera(this._ndc, camera);","    this._ray.near = 0;","    this._ray.far = (farPx + camToRef) * inv;","","    const hits = this._ray.intersectObjects(roots, true);","    for (const hit of hits) {","      let o = hit.object, entry = null;","      while (o && !(entry = owners.get(o))) o = o.parent;","      if (!entry) continue;","      if (!entry.ok) return; // the nearest thing is a wall / disabled object: no focus","      const b = entry.b;","      const p = hit.point;","      const point = { x: p.x * ws, y: p.y * ws, z: p.z * ws };","      const distance = ref ? Math.hypot(point.x - ref.x, point.y - ref.y, point.z - ref.z) : hit.distance * ws;","      const limit = toNum(getProp(b, 'InteractDistance', 0)) || cfg.maxDistance;","      if (distance > limit) return;","      const d = this.describe(b);","      this.focus = Object.assign(d, { behavior: b, object: b._universalInteraction.object, root: entry.root, distance, point });","      return;","    }","  }","","  // -- interaction","  interact(explicitBehavior) {","    if (!this.cfg.enabled) return false;","    let b = explicitBehavior;","    if (!b) {","      if (this.cooldownLeft > 0) return false;","      b = this.focus && this.focus.behavior;","    }","    if (!b || !b._universalInteraction || !this.isCandidate(b)) return false;","","    const s = b._universalInteraction;","    const object = s.object;","    const out = this.resolve(b);","    this.last = {","      kind: this.kindOf(b), name: this.nameOf(b), message: out.message, id: out.id,","      result: out.result, objectName: object.getName(),","    };","    this.interacted = true;","    s.interacted = true;","    this.cooldownLeft = this.cfg.cooldown;","","    if (OK_RESULTS.has(out.result) && toBool(getProp(b, 'SingleUse', false))) setProp(b, 'Enabled', false);","    if (out.destroy) {","      this.unregister(b);","      object.deleteFromScene(sceneOf(object, this.scene));","    }","    return true;","  }","","  // Lock logic shared by doors and switches.","  checkLock(b) {","    if (!toBool(getProp(b, 'Locked', false))) return null;","    const need = String(getProp(b, 'RequiredItem', '') || '');","    const custom = String(getProp(b, 'LockedMessage', '') || '');","    if (need && this.hasItem(need, 1)) {","      if (toBool(getProp(b, 'ConsumeItem', false))) this.removeItem(need, 1);","      setProp(b, 'Locked', false);","      return { unlocked: true, id: need };","    }","    return { unlocked: false, result: need ? 'missing_item' : 'locked', message: custom || this.tr(need ? 'missing_item' : 'locked'), id: need };","  }","","  resolve(b) {","    const s = b._universalInteraction;","    const kind = this.kindOf(b);","    const msg = String(getProp(b, 'Message', '') || '');","    let id = String(getProp(b, 'ActionId', '') || '');","    switch (kind) {","      case 'door': {","        const lock = this.checkLock(b);","        if (lock && !lock.unlocked) return { result: lock.result, message: lock.message, id: lock.id };","        const open = toBool(getProp(b, 'IsOpen', false));","        if (open && !toBool(getProp(b, 'CanClose', true))) return { result: 'none', message: '', id };","        setProp(b, 'IsOpen', !open);","        if (lock && lock.unlocked) return { result: 'unlocked', message: msg || this.tr('unlocked'), id: lock.id };","        return { result: open ? 'closed' : 'opened', message: msg, id };","      }","      case 'pickup': {","        const item = id || String(getProp(b, 'DisplayName', '') || '') || s.object.getName();","        this.addItem(item, Math.max(1, Math.floor(toNum(getProp(b, 'Quantity', 1), 1))));","        return { result: 'picked', message: msg || (this.tr('picked') + this.nameOf(b)), id: item, destroy: !toBool(getProp(b, 'KeepAfterPickup', false)) };","      }","      case 'inspect':","        return { result: 'inspected', message: msg, id };","      case 'talk':","        return { result: 'talking', message: msg, id };","      case 'use': {","        const lock = this.checkLock(b);","        if (lock && !lock.unlocked) return { result: lock.result, message: lock.message, id: lock.id };","        const on = !toBool(getProp(b, 'Toggled', false));","        setProp(b, 'Toggled', on);","        return { result: on ? 'activated' : 'deactivated', message: msg, id: lock && lock.unlocked ? lock.id : id };","      }","      default:","        return { result: 'custom', message: msg, id };","    }","  }","","  endFrame() {","    if (!this.interacted) return;","    this.interacted = false;","    for (const b of this.targets) if (b._universalInteraction) b._universalInteraction.interacted = false;","  }","","  // -- visuals","  updateHighlight() {","    const f = this.focus;","    if (!this.cfg.highlight || !f || typeof THREE === 'undefined' || !THREE.BoxHelper) {","      if (this._helper) this._helper.visible = false;","      return;","    }","    if (!this._helper || this._helperRoot !== f.root) {","      this.disposeHelper();","      let top = f.root; while (top.parent) top = top.parent;","      const h = new THREE.BoxHelper(f.root, this.cfg.highlightColor);","      h.material.depthTest = false; h.material.toneMapped = false;","      h.renderOrder = 999; h.frustumCulled = false;","      // BoxHelper vertices are in world space; the GDevelop THREE.Scene is scaled by the world scale.","      const sc = top.scale ? top.scale.x : 1;","      if (sc && sc !== 1) { h.matrixAutoUpdate = true; h.scale.setScalar(1 / sc); }","      top.add(h);","      this._helper = h; this._helperRoot = f.root; this._helperTop = top;","    }","    this._helper.material.color.setHex(this.cfg.highlightColor);","    this._helper.visible = true;","    this._helper.update();","  }","  disposeHelper() {","    if (!this._helper) return;","    if (this._helperTop) this._helperTop.remove(this._helper);","    if (this._helper.geometry) this._helper.geometry.dispose();","    if (this._helper.material) this._helper.material.dispose();","    this._helper = null; this._helperRoot = null; this._helperTop = null;","  }","  updateOverlay() {","    if (!this.cfg.overlay || typeof document === 'undefined') { this.removeOverlay(); return; }","    const game = this.scene.getGame();","    const renderer = game.getRenderer && game.getRenderer();","    const canvas = renderer && renderer.getCanvas ? renderer.getCanvas() : null;","    if (!canvas) return;","    if (!this._overlay) {","      const el = document.createElement('div');","      el.setAttribute('dir', 'auto');","      Object.assign(el.style, {","        position: 'fixed', transform: 'translate(-50%, -100%)', pointerEvents: 'none', zIndex: '1000',","        padding: '6px 14px', borderRadius: '8px', background: 'rgba(0,0,0,0.55)', whiteSpace: 'nowrap',","        fontFamily: 'system-ui, -apple-system, Segoe UI, Tahoma, sans-serif', textShadow: '0 1px 2px #000', display: 'none',","      });","      this._overlay = el;","    }","    const fs = document.fullscreenElement;","    const host = fs && fs.tagName !== 'CANVAS' ? fs : document.body;","    if (this._overlay.parentNode !== host) host.appendChild(this._overlay);","    const r = canvas.getBoundingClientRect();","    const st = this._overlay.style;","    st.left = r.left + r.width / 2 + 'px';","    st.top = r.bottom - this.cfg.overlayBottom + 'px';","    st.fontSize = this.cfg.overlayFontSize + 'px';","    st.color = cssColor(this.cfg.overlayColor);","    if (this.focus) { this._overlay.textContent = this.focus.prompt; st.display = 'block'; }","    else st.display = 'none';","  }","  removeOverlay() {","    if (this._overlay && this._overlay.parentNode) this._overlay.parentNode.removeChild(this._overlay);","    this._overlay = null;","  }","  dispose() {","    this.disposeHelper();","    this.removeOverlay();","    this.targets.clear(); this.blockers.clear(); this.focus = null;","  }","}","","// ---- Door animation (driven by the IsOpen property, so events can open doors too)","const stepDoor = (b, dt) => {","  const s = b._universalInteraction;","  if (!s || !s.object || String(getProp(b, 'Kind', '')) !== 'door') return;","  const o = s.object;","  const target = toBool(getProp(b, 'IsOpen', false)) ? 1 : 0;","  if (!s.base) {","    // Doors are authored in their CLOSED pose; a door that starts open snaps to the open pose.","    s.base = { x: o.getX(), y: o.getY(), z: o.getZ ? o.getZ() : 0, angle: o.getAngle(), w: o.getWidth() };","    s.progress = target; s.dirty = target === 1;","  }","  if (s.progress !== target) {","    const step = dt / Math.max(0.01, toNum(getProp(b, 'OpenDuration', 0.6), 0.6));","    s.progress = s.progress < target ? Math.min(target, s.progress + step) : Math.max(target, s.progress - step);","    s.dirty = true;","  }","  if (!s.dirty) return;","  s.dirty = false;","  const p = s.progress * s.progress * (3 - 2 * s.progress);","  const rad = (a) => (a * Math.PI) / 180;","  const motion = String(getProp(b, 'DoorMotion', 'rotate'));","  const a0 = s.base.angle;","  if (motion === 'rotate') {","    const a1 = a0 + toNum(getProp(b, 'OpenAngle', 90), 90) * p;","    const side = String(getProp(b, 'HingeSide', 'left'));","    const h = side === 'left' ? s.base.w / 2 : side === 'right' ? -s.base.w / 2 : 0;","    o.setAngle(a1);","    o.setX(s.base.x + h * (Math.cos(rad(a1)) - Math.cos(rad(a0))));","    o.setY(s.base.y + h * (Math.sin(rad(a1)) - Math.sin(rad(a0))));","  } else {","    const dist = toNum(getProp(b, 'SlideDistance', 150), 150) * p;","    if (motion === 'slide') { o.setX(s.base.x + Math.cos(rad(a0)) * dist); o.setY(s.base.y + Math.sin(rad(a0)) * dist); }","    else if (o.setZ) o.setZ(s.base.z + dist); // 'lift'","  }","};","","const getManager = (scene) => {","  if (!scene._universalInteractionManager) scene._universalInteractionManager = new InteractionManager(scene);","  return scene._universalInteractionManager;","};","const frameSeconds = (scene) => {","  const ms = scene.getElapsedTime ? scene.getElapsedTime() : (scene.getTimeManager ? scene.getTimeManager().getElapsedTime() : 16);","  return Math.min(0.1, Math.max(0, (ms || 16) / 1000));","};","const ensureState = (b, object) => {","  b._universalInteraction = b._universalInteraction || { object, base: null, progress: 0, dirty: false, interacted: false };","  b._universalInteraction.object = object;","  return b._universalInteraction;","};","","gdjs._universalInteraction = {","  version: VERSION,","  getManager,","  frameSeconds,","  registerTarget(object, behavior, fallbackScene) { ensureState(behavior, object); getManager(sceneOf(object, fallbackScene)).register(behavior); },","  unregisterTarget(object, behavior, fallbackScene) { getManager(sceneOf(object, fallbackScene)).unregister(behavior); },","  registerBlocker(object, behavior, fallbackScene) { ensureState(behavior, object); getManager(sceneOf(object, fallbackScene)).registerBlocker(behavior); },","  unregisterBlocker(object, behavior, fallbackScene) { getManager(sceneOf(object, fallbackScene)).unregisterBlocker(behavior); },","  stepTarget(behavior, dt) { stepDoor(behavior, dt); },","  parseColor,","  threeRevision() { return typeof THREE !== 'undefined' && THREE.REVISION ? String(THREE.REVISION) : ''; },","};",""],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[],"objectGroups":[]},{"description":"Choose how the target is detected: from the camera center (first/third person) or from the cursor, and the max distance.","fullName":"Configure detection","functionType":"Action","group":"Universal interaction","name":"ConfigureDetection","sentence":"Detect from _PARAM1_ on layer _PARAM3_, max distance _PARAM2_ px, cooldown _PARAM4_ s","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const lib = gdjs._universalInteraction; if (!lib) return;","const mgr = lib.getManager(runtimeScene);","const c = mgr.cfg;","c.mode = String(eventsFunctionContext.getArgument(\"Mode\")) === 'cursor' ? 'cursor' : 'center';","c.maxDistance = Math.max(0, Number(eventsFunctionContext.getArgument(\"MaxDistance\")) || 0);","c.layer = String(eventsFunctionContext.getArgument(\"Layer\") || '');","c.cooldown = Math.max(0, Number(eventsFunctionContext.getArgument(\"Cooldown\")) || 0);"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[{"defaultValue":"\"center\"","description":"Aim mode","name":"Mode","supplementaryInformation":"[\"center\", \"cursor\"]","type":"stringWithSelector"},{"defaultValue":"300","description":"Maximum interaction distance (pixels)","name":"MaxDistance","type":"expression"},{"defaultValue":"\"\"","description":"3D layer (empty = base layer)","name":"Layer","optional":true,"type":"layer"},{"defaultValue":"0.25","description":"Delay between two interactions (seconds)","name":"Cooldown","type":"expression"}],"objectGroups":[]},{"description":"Measure the interaction distance from this object (e.g. the player) instead of the camera. Recommended for third-person games.","fullName":"Measure distance from an object","functionType":"Action","group":"Universal interaction","name":"SetReferenceObject","sentence":"Measure the interaction distance from _PARAM1_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const lib = gdjs._universalInteraction; if (!lib) return;","const mgr = lib.getManager(runtimeScene);","const o = eventsFunctionContext.getObjects(\"Object\")[0];","mgr.cfg.refName = o ? o.getName() : '';"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":true}],"parameters":[{"description":"Object (e.g. the player)","name":"Object","type":"objectList"}],"objectGroups":[]},{"description":"Go back to measuring the interaction distance from the camera.","fullName":"Measure distance from the camera","functionType":"Action","group":"Universal interaction","name":"ClearReferenceObject","sentence":"Measure the interaction distance from the camera","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const lib = gdjs._universalInteraction; if (!lib) return;","const mgr = lib.getManager(runtimeScene);","mgr.cfg.refName = '';"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[],"objectGroups":[]},{"description":"Prompt template. Placeholders: {key} {verb} {name} {status}. The key is only a label: you bind the real key in your events.","fullName":"Configure the prompt text","functionType":"Action","group":"Universal interaction","name":"ConfigurePrompt","sentence":"Prompt format _PARAM1_, key label _PARAM2_, language _PARAM3_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const lib = gdjs._universalInteraction; if (!lib) return;","const mgr = lib.getManager(runtimeScene);","mgr.cfg.format = String(eventsFunctionContext.getArgument(\"Format\"));","mgr.cfg.key = String(eventsFunctionContext.getArgument(\"Key\"));","mgr.cfg.language = String(eventsFunctionContext.getArgument(\"Language\")) === 'ar' ? 'ar' : 'en';"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[{"defaultValue":"\"[{key}] {verb} {name}\"","description":"Format","name":"Format","type":"string"},{"defaultValue":"\"E\"","description":"Key label shown in the prompt","name":"Key","type":"string"},{"defaultValue":"\"en\"","description":"Built-in language","name":"Language","supplementaryInformation":"[\"en\", \"ar\"]","type":"stringWithSelector"}],"objectGroups":[]},{"description":"Override a built-in verb or message (use this to translate to any language).","fullName":"Set an interaction text","functionType":"Action","group":"Universal interaction","name":"SetText","sentence":"Set text _PARAM1_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const lib = gdjs._universalInteraction; if (!lib) return;","const mgr = lib.getManager(runtimeScene);","mgr.texts[String(eventsFunctionContext.getArgument(\"Which\"))] = String(eventsFunctionContext.getArgument(\"Text\"));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[{"defaultValue":"\"door_open\"","description":"Text","name":"Which","supplementaryInformation":"[\"door_open\", \"door_close\", \"pickup\", \"inspect\", \"talk\", \"use\", \"custom\", \"locked\", \"missing_item\", \"unlocked\", \"picked\"]","type":"stringWithSelector"},{"description":"New text","name":"Text","type":"string"}],"objectGroups":[]},{"description":"Draws a box outline (THREE.BoxHelper) around the targeted object.","fullName":"Configure the highlight outline","functionType":"Action","group":"Universal interaction","name":"ConfigureHighlight","sentence":"Highlight targeted object: _PARAM1_, color _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const lib = gdjs._universalInteraction; if (!lib) return;","const mgr = lib.getManager(runtimeScene);","mgr.cfg.highlight = !!eventsFunctionContext.getArgument(\"Enabled\");","mgr.cfg.highlightColor = lib.parseColor(eventsFunctionContext.getArgument(\"Color\"), 0xffd54a);"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[{"defaultValue":"yes","description":"Enabled","name":"Enabled","type":"yesorno"},{"defaultValue":"\"255;213;74\"","description":"Color","name":"Color","type":"color"}],"objectGroups":[]},{"description":"Shows the prompt as an HTML overlay at the bottom of the game. No Text object needed.","fullName":"Configure the built-in on-screen prompt","functionType":"Action","group":"Universal interaction","name":"ConfigureOverlay","sentence":"Built-in on-screen prompt: _PARAM1_, font size _PARAM2_, color _PARAM3_, offset from bottom _PARAM4_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const lib = gdjs._universalInteraction; if (!lib) return;","const mgr = lib.getManager(runtimeScene);","const c = mgr.cfg;","c.overlay = !!eventsFunctionContext.getArgument(\"Enabled\");","c.overlayFontSize = Number(eventsFunctionContext.getArgument(\"FontSize\")) || 22;","c.overlayColor = lib.parseColor(eventsFunctionContext.getArgument(\"Color\"), 0xffffff);","c.overlayBottom = Number(eventsFunctionContext.getArgument(\"Bottom\")) || 0;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[{"defaultValue":"yes","description":"Enabled","name":"Enabled","type":"yesorno"},{"defaultValue":"22","description":"Font size (px)","name":"FontSize","type":"expression"},{"defaultValue":"\"255;255;255\"","description":"Text color","name":"Color","type":"color"},{"defaultValue":"90","description":"Distance from the bottom of the game (px)","name":"Bottom","type":"expression"}],"objectGroups":[]},{"description":"Pause detection and interactions (cutscenes, menus, dialogues...).","fullName":"Enable or disable the system","functionType":"Action","group":"Universal interaction","name":"SetSystemEnabled","sentence":"Interaction system enabled: _PARAM1_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const lib = gdjs._universalInteraction; if (!lib) return;","const mgr = lib.getManager(runtimeScene);","mgr.cfg.enabled = !!eventsFunctionContext.getArgument(\"Enabled\");"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[{"defaultValue":"yes","description":"Enabled","name":"Enabled","type":"yesorno"}],"objectGroups":[]},{"description":"Runs the interaction of the object the player is aiming at (open, pick up, inspect, talk...).","fullName":"Interact with the targeted object","functionType":"Action","group":"Universal interaction","name":"Interact","sentence":"Interact with the targeted object","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const lib = gdjs._universalInteraction; if (!lib) return;","const mgr = lib.getManager(runtimeScene);","mgr.interact();"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[],"objectGroups":[]},{"fullName":"Add items to the inventory","functionType":"Action","group":"Universal interaction","name":"AddItem","sentence":"Add _PARAM2_ of item _PARAM1_ to the inventory","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const lib = gdjs._universalInteraction; if (!lib) return;","const mgr = lib.getManager(runtimeScene);","mgr.addItem(String(eventsFunctionContext.getArgument(\"ItemId\")), Math.max(1, Math.floor(Number(eventsFunctionContext.getArgument(\"Count\")) || 1)));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[{"description":"Item id","name":"ItemId","type":"string"},{"defaultValue":"1","description":"Quantity","name":"Count","type":"expression"}],"objectGroups":[]},{"fullName":"Remove items from the inventory","functionType":"Action","group":"Universal interaction","name":"RemoveItem","sentence":"Remove _PARAM2_ of item _PARAM1_ from the inventory","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const lib = gdjs._universalInteraction; if (!lib) return;","const mgr = lib.getManager(runtimeScene);","mgr.removeItem(String(eventsFunctionContext.getArgument(\"ItemId\")), Math.max(1, Math.floor(Number(eventsFunctionContext.getArgument(\"Count\")) || 1)));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[{"description":"Item id","name":"ItemId","type":"string"},{"defaultValue":"1","description":"Quantity","name":"Count","type":"expression"}],"objectGroups":[]},{"fullName":"Clear the inventory","functionType":"Action","group":"Universal interaction","name":"ClearInventory","sentence":"Clear the inventory","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const lib = gdjs._universalInteraction; if (!lib) return;","const mgr = lib.getManager(runtimeScene);","mgr.inventory.clear();"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[],"objectGroups":[]},{"description":"Restores an inventory previously read with InventoryJSON() (save games).","fullName":"Load the inventory from JSON","functionType":"Action","group":"Universal interaction","name":"LoadInventoryJSON","sentence":"Load the inventory from _PARAM1_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const lib = gdjs._universalInteraction; if (!lib) return;","const mgr = lib.getManager(runtimeScene);","mgr.loadInventoryJSON(String(eventsFunctionContext.getArgument(\"Json\")));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[{"description":"JSON text","name":"Json","type":"string"}],"objectGroups":[]},{"description":"True when the player is aiming at an interactable object in range.","fullName":"Something is targeted","functionType":"Condition","group":"Universal interaction","name":"HasFocus","sentence":"Something is targeted","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const lib = gdjs._universalInteraction; if (!lib) return;","const mgr = lib.getManager(runtimeScene);","eventsFunctionContext.returnValue = !!mgr.focus;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[],"objectGroups":[]},{"fullName":"Targeted object type","functionType":"Condition","group":"Universal interaction","name":"FocusKindIs","sentence":"The targeted object is of type _PARAM1_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const lib = gdjs._universalInteraction; if (!lib) return;","const mgr = lib.getManager(runtimeScene);","eventsFunctionContext.returnValue = !!mgr.focus && mgr.focus.kind === String(eventsFunctionContext.getArgument(\"Kind\"));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[{"defaultValue":"\"door\"","description":"Type","name":"Kind","supplementaryInformation":"[\"door\", \"pickup\", \"inspect\", \"talk\", \"use\", \"custom\"]","type":"stringWithSelector"}],"objectGroups":[]},{"description":"True during the frame where Interact ran successfully. Put the reaction events BELOW the event containing the Interact action.","fullName":"An interaction just happened","functionType":"Condition","group":"Universal interaction","name":"Interacted","sentence":"An interaction just happened","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const lib = gdjs._universalInteraction; if (!lib) return;","const mgr = lib.getManager(runtimeScene);","eventsFunctionContext.returnValue = mgr.interacted;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[],"objectGroups":[]},{"fullName":"Last interaction type","functionType":"Condition","group":"Universal interaction","name":"LastKindIs","sentence":"The last interaction type is _PARAM1_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const lib = gdjs._universalInteraction; if (!lib) return;","const mgr = lib.getManager(runtimeScene);","eventsFunctionContext.returnValue = mgr.interacted && mgr.last.kind === String(eventsFunctionContext.getArgument(\"Kind\"));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[{"defaultValue":"\"door\"","description":"Type","name":"Kind","supplementaryInformation":"[\"door\", \"pickup\", \"inspect\", \"talk\", \"use\", \"custom\"]","type":"stringWithSelector"}],"objectGroups":[]},{"fullName":"Last interaction result","functionType":"Condition","group":"Universal interaction","name":"LastResultIs","sentence":"The last interaction result is _PARAM1_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const lib = gdjs._universalInteraction; if (!lib) return;","const mgr = lib.getManager(runtimeScene);","eventsFunctionContext.returnValue = mgr.interacted && mgr.last.result === String(eventsFunctionContext.getArgument(\"Result\"));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[{"defaultValue":"\"opened\"","description":"Result","name":"Result","supplementaryInformation":"[\"opened\", \"closed\", \"unlocked\", \"locked\", \"missing_item\", \"picked\", \"inspected\", \"talking\", \"activated\", \"deactivated\", \"custom\", \"none\"]","type":"stringWithSelector"}],"objectGroups":[]},{"fullName":"Has item","functionType":"Condition","group":"Universal interaction","name":"HasItem","sentence":"The inventory has at least _PARAM2_ of item _PARAM1_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const lib = gdjs._universalInteraction; if (!lib) return;","const mgr = lib.getManager(runtimeScene);","eventsFunctionContext.returnValue = mgr.hasItem(String(eventsFunctionContext.getArgument(\"ItemId\")), Number(eventsFunctionContext.getArgument(\"Count\")) || 1);"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[{"description":"Item id","name":"ItemId","type":"string"},{"defaultValue":"1","description":"Quantity","name":"Count","type":"expression"}],"objectGroups":[]},{"description":"Display name of the targeted object","fullName":"Targeted object name","functionType":"StringExpression","group":"Universal interaction","name":"FocusName","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const lib = gdjs._universalInteraction; if (!lib) return;","const mgr = lib.getManager(runtimeScene);","eventsFunctionContext.returnValue = mgr.focus ? mgr.focus.name : '';"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"expressionType":{"type":"string"},"parameters":[],"objectGroups":[]},{"description":"Action available on the targeted object (Open, Pick up...)","fullName":"Available action","functionType":"StringExpression","group":"Universal interaction","name":"FocusVerb","sentence":"","events":[{"type":"Bu