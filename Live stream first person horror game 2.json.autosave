type":{"value":"CompareTimer"},"parameters":["","\"WdMem\"",">","0.5"]}],"actions":[{"type":{"value":"ResetTimer"},"parameters":["","\"WdMem\""]}],"events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["  const vars = runtimeScene.getVariables();","  const G = (n) => vars.get(n).getAsNumber();","  if (vars.get(\"MonsterState\").getAsString() !== \"Patrol\") return;","  if (G(\"PlayerVisible\") === 1) return;","  const zs = runtimeScene.getObjects(\"Zombie\");","  if (!zs.length) return;","  const zx = zs[0].getCenterX(), zy = zs[0].getCenterY();","  const R = Math.max(G(\"Cfg_MemVisitDist\"), 1) * 1.2;","  for (let i = 1; i <= 6; i++) {","    const w = G(\"Mem\" + i + \"W\");","    if (w <= 0) continue;","    if (Math.hypot(G(\"Mem\" + i + \"X\") - zx, G(\"Mem\" + i + \"Y\") - zy) < R) vars.get(\"Mem\" + i + \"W\").setNumber(Math.max(0, w - 0.35));","  }"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}]}],"parameters":[]},{"aiGeneratedEventId":"01M6Y0YPM3MFX89PHM5D42WG7H","colorB":228,"colorG":176,"colorR":74,"creationTime":0,"folded":true,"name":"05 — Animation Polish","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"AnimatableCapability::AnimatableBehavior::SetSpeedScale"},"parameters":["Zombie","Animation","=","clamp(0.6 + ZSpeed / 120, 0.6, 2.2)"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringVariable"},"parameters":["MonsterState","=","\"Ambush\""]},{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["AmbushPhase","=","1"]}],"actions":[{"type":{"value":"Scene3D::Base3DBehavior::SetScaleZ"},"parameters":["Zombie","Object3D","=","0.82"]},{"type":{"value":"AnimatableCapability::AnimatableBehavior::SetSpeedScale"},"parameters":["Zombie","Animation","=","0.35"]}]},{"type":"BuiltinCommonInstructions::Else","conditions":[],"actions":[{"type":{"value":"Scene3D::Base3D