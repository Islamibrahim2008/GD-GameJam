anternFuel",""]},{"type":{"value":"Light3D::PointLight3D::SetRange"},"parameters":["LanternFlame","=","160",""]}]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Matching light in the world, at the lantern's spot relative to the player camera (lights the scene)."},{"aiGeneratedEventId":"01M6XYNR65MJ3PXWYK8VM1BX02","type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BooleanObjectVariable"},"parameters":["LanternFlame","IsViewmodel","False",""]}],"actions":[{"type":{"value":"SetXY"},"parameters":["LanternFlame","=","CameraCenterX(\"\") + 35 * Scene3D::CameraRightX(\"\") + 60 * Scene3D::CameraForwardX(\"\") - 30 * Scene3D::CameraUpX(\"\")","=","CameraCenterY(\"\") + 35 * Scene3D::CameraRightY(\"\") + 60 * Scene3D::CameraForwardY(\"\") - 30 * Scene3D::CameraUpY(\"\")"]},{"type":{"value":"Scene3D::Base3DBehavior::SetZ"},"parameters":["LanternFlame","Object3D","=","Scene3D::CameraZ(\"\") + 35 * Scene3D::CameraRightZ(\"\") + 60 * Scene3D::CameraForwardZ(\"\") - 30 * Scene3D::CameraUpZ(\"\")"]},{"type":{"value":"Light3D::PointLight3D::SetIntensity"},"parameters":["LanternFlame","=","20 * LanternFlicker * LanternFuel",""]},{"type":{"value":"Light3D::PointLight3D::SetRange"},"parameters":["LanternFlame","=","(750 + 150 * LanternFlicker) * (0.35 + 0.65 * LanternFuel)",""]}]}],"parameters":[]},{"aiGeneratedEventId":"01M6XYNBHKSS2FPFWSQ3TNBPD2","colorB":228,"colorG":176,"colorR":74,"creationTime":0,"name":"Fireplace Light Source","source":"","type":"BuiltinCommonInstructions::Group","events":[{"aiGeneratedEventId":"01M6XYQ52NXW4PCN4P4JTENS8D","type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"Light3D::PointLight3D::SetIntensity"},"parameters":["FireplaceLight","=","22 * (0.85 + 0.08 * sin(TimeFromStart() * 7.1) + 0.06 * sin(TimeFromStart() * 15.3 + 2) + 0.05 * sin(TimeFromStart() * 3.3 + 1))",""]}]}],"parameters":[]}]},{"associatedLayout":"Game Scene","name":"javascript systems","events":[{"folded":true,"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"DepartScene"},"parameters":[""]}],"actions":[],"events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Light cone size\n"},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const light = runtimeScene.getObjects(\"light\")[0];","if (light && light.__light3D && !light.__edgeMapApplied) {","    const s = light.__light3D;","","    const size  = 256;","    const inner = 0.60;  // لحد هنا الضوء كامل (0 إلى 1 من نص القطر)","    const outer = 1.00;  // عند هنا الضوء بيبقى صفر","    const curve = 2.0;   // 1 = خطي، أكبر = الحافة بتقفل أسرع وأنعم","","    const canvas = document.createElement(\"canvas\");","    canvas.width = canvas.height = size;","    const ctx = canvas.getContext(\"2d\");","    const img = ctx.createImageData(size, size);","","    for (let y = 0; y < size; y++) {","        for (let x = 0; x < size; x++) {","            const dx = (x + 0.5) / size * 2 - 1;","            const dy = (y + 0.5) / size * 2 - 1;","            const d = Math.sqrt(dx * dx + dy * dy);","","            let t = (d - inner) / (outer - inner);","            t = Math.min(1, Math.max(0, t));","            t = t * t * (3 - 2 * t);               // smoothstep","            const v = Math.round(255 * Math.pow(1 - t, curve));","","            const i = (y * size + x) * 4;","            img.data[i] = img.data[i + 1] = img.data[i + 2] = v;","            img.data[i + 3] = 255;","        }","    }","    ctx.putImageData(img, 0, 0);","","    const tex = new THREE.CanvasTexture(canvas);","    tex.colorSpace = THREE.SRGBColorSpace;","    s.map = tex;","    s.penumbra = 0;               // الحافة هتتحكم فيها الخريطة","","    light.__edgeMapApplied = true; // تتنفذ مرة واحدة بس","}"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}]}]},{"associatedLayout":"Game Scen