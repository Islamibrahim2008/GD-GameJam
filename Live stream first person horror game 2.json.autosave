DirY * Cfg_JS_Gap"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_FaceZ","=","JS_ZZ + JS_ZD * Cfg_JS_FaceRatio"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_CX1","=","JS_MX1 - JS_DirX * Cfg_JS_CamDist"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_CY1","=","JS_MY1 - JS_DirY * Cfg_JS_CamDist"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_Z1","=","JS_FaceZ - Cfg_JS_StartBelow"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_AimZ","=","JS_Z1 + Cfg_JS_LiftHeight * 0.5"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_TYaw","=","AngleBetweenPositions(JS_CX1, JS_CY1, JS_MX1, JS_MY1) + 90"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_TPitch","=","90 - ToDeg(atan2(JS_AimZ - JS_FaceZ, max(1, Cfg_JS_CamDist)))"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["JS_Active","=","1"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["JS_T","+","TimeDelta()"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["JS_Active","=","1"]}],"actions":[{"type":{"value":"SetStringVariable"},"parameters":["MonsterState","=","\"Grab\""]},{"type":{"value":"SetNumberVariable"},"parameters":["AttackPending","=","0"]},{"type":{"value":"NavMeshPathfinding::NavMeshCharacterBehavior::SetMaxSpeed"},"parameters":["Zombie","NavMeshCharacter","=","0"]},{"type":{"value":"Physics3D::PhysicsCharacter3D::SetForwardSpeedMax"},"parameters":["Player","PhysicsCharacter3D","=","0"]},{"type":{"value":"Physics3D::PhysicsCharacter3D::SetSidewaysSpeedMax"},"parameters":["Player","PhysicsCharacter3D","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["CamX","=","JS_Yaw0"]},{"type":{"value":"SetNumberVariable"},"parameters":["CamY","=","JS_CamY0"]},{"type":{"value":"AnimatableCapability::AnimatableBehavior::SetName"},"parameters":["Zombie","Animation","=","Cfg_JS_Anim"]},{"type":{"value":"AnimatableCapability::AnimatableBehavior::SetSpeedScale"},"parameters":["Zombie","Animation","=","1"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["JS_Active","=","1"]},{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["JS_T",">=","Cfg_JS_ScreamAt"]},{"type":{"value":"BuiltinCommonInstructions::Once"},"parameters":[]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["JS_Scream","=","1"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["JS_Active","=","1"]},{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["JS_T","<","Cfg_JS_FlickerTime"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["Flicker","=","RandomFloatInRange(0.3, 0.9)"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["JS_Active","=","1"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["JS_ePush","=","AdvancedMathTools::Ease(\"quadOut\", clamp(JS_T / Cfg_JS_PushTime, 0, 1))"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_eTurn","=","AdvancedMathTools::Ease(\"quadOut\", clamp(JS_T / Cfg_JS_TurnTime, 0, 1))"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_eLift","=","AdvancedMathTools::Ease(\"sineInOut\", clamp((JS_T - Cfg_JS_LiftDelay) / Cfg_JS_LiftTime, 0, 1))"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_Extra","=","max(0, JS_T - Cfg_JS_LiftDelay - Cfg_JS_LiftTime) * Cfg_JS_RiseSpeed"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_Prog","=","clamp(JS_T / max(0.01, Cfg_JS_EndTime), 0, 1)"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_SqX","=","clamp((JS_T - Cfg_JS_SqStart) / max(0.1, Cfg_JS_SqTime), 0, 1)"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_Sq","=","JS_SqX * JS_SqX * (3 - 2 * JS_SqX)"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_NeckT","=","max(0, JS_T - Cfg_JS_NeckAt)"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_Snp","=","clamp(JS_NeckT * 25, 0, 1)"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_Dang","=","JS_Snp * (1 + 0.2 * exp(-5 * JS_NeckT) * sin(JS_NeckT * 14))"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_Creep","=","Cfg_JS_Creep * JS_Prog"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_SinceScream","=","clamp((JS_T - Cfg_JS_ScreamAt) * 50, 0, 1)"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_ShkA","=","(Cfg_JS_CamShake * (3 * exp(-5 * JS_T) + 0.45 + 1.8 * exp(-3 * max(0, JS_T - Cfg_JS_ScreamAt)) * JS_SinceScream + 2.2 * JS_Crush * Cfg_JS_CrushShake)) * (1 - 0.85 * JS_Snp) * Cfg_JS_ShakeScale"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_ShkX","=","JS_ShkA * (sin(JS_T * 47) * 0.6 + sin(JS_T * 83 + 1) * 0.4 + RandomFloatInRange(-0.3, 0.3))"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_ShkY","=","JS_ShkA * (cos(JS_T * 41) * 0.6 + sin(JS_T * 71 + 2) * 0.4 + RandomFloatInRange(-0.3, 0.3)) * 0.8"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_ShkR","=","JS_ShkA * 1.4 * (sin(JS_T * 37 + 3) * 0.6 + RandomFloatInRange(-0.3, 0.3))"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_Tw","=","Cfg_JS_Twitch * clamp((JS_T - Cfg_JS_ScreamAt) * 20, 0, 1)"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_MX","=","lerp(JS_MX0, JS_MX1, JS_ePush) - JS_DirX * JS_Creep * 0.5"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_MY","=","lerp(JS_MY0, JS_MY1, JS_ePush) - JS_DirY * JS_Creep * 0.5"]},{"type":{"value":"SetXY"},"parameters":["Zombie","=","JS_MX + RandomFloatInRange(-1, 1) * JS_Tw","=","JS_MY + RandomFloatInRange(-1, 1) * JS_Tw"]},{"type":{"value":"SetAngle"},"parameters":["Zombie","=","AngleBetweenPositions(JS_MX, JS_MY, JS_PX, JS_PY) + RandomFloatInRange(-1, 1) * JS_Tw * 3 + sin(JS_T * 6) * Cfg_JS_HeadSway * clamp((JS_T - Cfg_JS_LiftDelay) * 2, 0, 1)"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_CX","=","lerp(JS_CX0, JS_CX1, JS_ePush) + JS_DirX * JS_Creep * 0.5"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_CY","=","lerp(JS_CY0, JS_CY1, JS_ePush) + JS_DirY * JS_Creep * 0.5"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_CZ","=","max(lerp(JS_CZ0, JS_Z1, JS_ePush) + Cfg_JS_LiftHeight * JS_eLift + JS_Extra + sin(JS_T * 1.3) * 0.6 - Cfg_JS_NeckDrop * JS_Dang, Player.Object3D::Z() + Cfg_JS_MinCamH)"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_Yaw","=","JS_Yaw0 + AdvancedMathTools::DeltaAngle(JS_Yaw0, JS_TYaw) * JS_eTurn + JS_ShkX + Cfg_JS_NeckYaw * JS_Dang"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_Pitch","=","lerp(JS_Pitch0, JS_TPitch, JS_eTurn) + JS_ShkY - Cfg_JS_NeckPitch * JS_Dang"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_Roll","=","JS_Roll0 * (1 - JS_eTurn) + JS_ShkR + Cfg_JS_Dutch * JS_Prog + Cfg_JS_NeckRoll * JS_Dang + 5 * exp(-3 * JS_NeckT) * sin(JS_NeckT * 8) * JS_Snp"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_Fov","=","lerp(JS_Fov0, Cfg_JS_FovEnd, JS_eTurn) + Cfg_JS_FovKick * exp(-9 * JS_T) + Cfg_JS_ScreamKick * exp(-6 * max(0, JS_T - Cfg_JS_ScreamAt)) * JS_SinceScream - Cfg_JS_Vertigo * JS_Prog - Cfg_JS_SqFov * JS_Sq - 3 * JS_Crush + Cfg_JS_NeckKick * exp(-12 * JS_NeckT) * JS_Snp"]},{"type":{"value":"SetCameraCenterX"},"parameters":["","=","JS_CX","",""]},{"type":{"value":"SetCameraCenterY"},"parameters":["","=","JS_CY","",""]},{"type":{"value":"Scene3D::SetCameraZ"},"parameters":["","=","JS_CZ","",""]},{"type":{"value":"SetCameraAngle"},"parameters":["","=","JS_Yaw","",""]},{"type":{"value":"Scene3D::SetCameraRotationX"},"parameters":["","=","JS_Pitch","",""]},{"type":{"value":"Scene3D::SetCameraRotationY"},"parameters":["","=","JS_Roll","",""]},{"type":{"value":"Scene3D::SetCameraFov"},"parameters":["","=","JS_Fov","",""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["JS_Active","=","1"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["JS_Fade","=","clamp((JS_T - Cfg_JS_FadeStart) / max(0.01, Cfg_JS_EndTime - Cfg_JS_FadeStart), 0, 1)"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["JS_Active","=","1"]},{"type":{"value":"NumberVariable"},"parameters":["JS_GameOver","=","0"]},{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["JS_T",">=","Cfg_JS_EndTime"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["JS_GameOver","=","1"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_Done","=","1"]}]},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["(function () {","\"use strict\";","var S = runtimeScene, G = S.getGame();","try { var W0 = window.__JSFX; if (W0 && W0.dead) fail(null); else main(); } catch (err0) { fail(err0); }","// crash shield: on any error the FX are switched off and the game keeps running (never a white/frozen screen)","function fail(e) {","  var W = window.__JSFX || (window.__JSFX = {});","  if (e) { W.errN = (W.errN || 0) + 1; try { S.getVariables().get(\"JS_Error\").setNumber(W.errN); } catch (x0) {} if (!W.errLogged) { W.errLogged = true; console.error(\"[JumpscareFX] error, effects reduced:\", e); } if (W.errN > 20) W.dead = true; }","  try { if (W.c) W.c.style.display = \"none\"; if (W.pg && W.pg.rc) W.pg.rc.style.display = \"none\"; var cv0 = G.getRenderer().getCanvas(); if (cv0) { cv0.style.filter = \"\"; cv0.style.transform = \"\"; } } catch (x1) {}","  try {","    if (W.failScene !== S) { W.failScene = S; W.restarting = false; }","    var gv = S.getVariables();","    if (!W.restarting && gv.has(\"JS_GameOver\") && gv.get(\"JS_GameOver\").getAsNumber() === 1) {","      W.restarting = true; W.pending = true;","      S.requestChange(gdjs.SceneChangeRequest.REPLACE_SCENE, S.getName());","    }","  } catch (x2) {}","}","function main() {","var W = window.__JSFX || (window.__JSFX = {});","if (!W.splats) { W.splats = []; W.age = 0; W.ph = 0; W.wake = -1; W.pending = false; W.restarting = false; W.layerSnap = null; W.on = false; W.lastF = null; }","if (!W.tn) W.tn = 0;","if (!W.tt) W.tt = 0;","if (!W.fl) W.fl = {};","if (!W.cph) W.cph = 0;","if (!W.crush) W.crush = 0;","function V(n) { var a = S.getVariables(), b = G.getVariables(); return (a.has(n) || !b.has(n)) ? a.get(n) : b.get(n); }","function N(n) { return V(n).getAsNumber(); }","// optional number with default (new settings work even if you never created them)","function O(n, d) { var a = S.getVariables(), b = G.getVariables(); if (a.has(n)) return a.get(n).getAsNumber(); if (b.has(n)) return b.get(n).getAsNumber(); return d; }","function SV(n, x) { V(n).setNumber(x); }","var clamp = function (x, a, b) { return x < a ? a : (x > b ? b : x); };","var sm = function (x) { x = clamp(x, 0, 1); return x * x * (3 - 2 * x); };","var lerp = function (a, b, t) { return a + (b - a) * t; };","var bump = function (u, c, wd, pk) { var d = (u - c) / wd; return pk * Math.exp(-d * d); };","var rnd = Math.random;","var TAU = Math.PI * 2;","var dt = Math.min(0.1, S.getElapsedTime() / 1000);","var mk = function (seed) { var a = seed >>> 0; return function () { a = (a + 0x6D2B79F5) | 0; var t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; };","var newHal = function () { return { left: 0, dur: 0, gap: 0.2, kind: 0, last: -1, seed: 1, inv: false, tint: 0, chain: 0, beat: 0, p: -1, a: 0, word: false }; };","","// ================== Procedural synth audio (no sound files needed). Set Cfg_JS_SynthAudio = 0 to disable ==================","var audioOn = O(\"Cfg_JS_SynthAudio\", 1) === 1;","function auInit() {","  if (!audioOn || W.acFail) return null;","  if (W.ac) {","    if (W.ac.state === \"suspended\") { try { var pr = W.ac.resume(); if (pr && pr.catch) pr.catch(function () {}); } catch (e0) {} }","    return W.ac;","  }","  try {","    var AC = window.AudioContext || window.webkitAudioContext;","    if (!AC) { W.acFail = true; return null; }","    var a = new AC(), comp = a.createDynamicsCompressor(), lp = a.createBiquadFilter(), mg = a.createGain(), i;","    lp.type = \"lowpass\"; lp.frequency.value = 20000; mg.gain.value = O(\"Cfg_JS_Volume\", 0.8);","    lp.connect(comp); comp.connect(mg); mg.connect(a.destination);","    try {","      var rl = Math.floor(a.sampleRate * 2.4), ib = a.createBuffer(2, rl, a.sampleRate), rch, rq;","      for (rch = 0; rch < 2; rch++) { var rd = ib.getChannelData(rch); for (rq = 0; rq < rl; rq++) rd[rq] = (Math.random() * 2 - 1) * Math.pow(1 - rq / rl, 3.2); }","      var cvn = a.createConvolver(); cvn.buffer = ib; var rg = a.createGain(); rg.gain.value = 0.3; lp.connect(rg); rg.connect(cvn); cvn.connect(comp);","    } catch (eR) {}","    var nb = a.createBuffer(1, a.sampleRate * 2, a.sampleRate), d = nb.getChannelData(0);","    for (i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;","    var cu = new Float32Array(1024);","    for (i = 0; i < 1024; i++) cu[i] = Math.tanh((i * 2 / 1024 - 1) * 6);","    W.ac = a; W.aLp = lp; W.aMg = mg; W.aNoise = nb; W.aCurve = cu;","  } catch (e) { W.acFail = true; W.ac = null; }","  return W.ac;","}","// filtered noise burst","function nz(t0, dur, ft, f0, f1, q, g0, atk) {","  var a = W.ac, s = a.createBufferSource(), f = a.createBiquadFilter(), g = a.createGain();","  s.buffer = W.aNoise; s.loop = true; f.type = ft; f.Q.value = q;","  f.frequency.setValueAtTime(f0, t0); f.frequency.exponentialRampToValueAtTime(Math.max(20, f1), t0 + dur);","  g.gain.setValueAtTime(0.0001, t0); g.gain.linearRampToValueAtTime(g0, t0 + atk); g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);","  s.connect(f); f.connect(g); g.connect(W.aLp); s.start(t0); s.stop(t0 + dur + 0.05);","}","// oscillator sweep","function tn(t0, dur, type, f0, f1, g0, atk) {","  var a = W.ac, o = a.createOscillator(), g = a.createGain();","  o.type = type; o.frequency.setValueAtTime(f0, t0); o.frequency.exponentialRampToValueAtTime(Math.max(10, f1), t0 + dur);","  g.gain.setValueAtTime(0.0001, t0); g.gain.linearRampToValueAtTime(g0, t0 + atk); g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);","  o.connect(g); g.connect(W.aLp); o.start(t0); o.stop(t0 + dur + 0.05);","}","function sImpact() {","  var a = auInit(); if (!a) return; var t = a.currentTime + 0.005, i, fr = [233, 247, 349, 370];","  tn(t, 1.1, \"sine\", 120, 28, 1.0, 0.004);","  tn(t, 0.5, \"triangle\", 70, 30, 0.6, 0.004);","  nz(t, 0.6, \"lowpass\", 4000, 120, 0.7, 0.9, 0.002);","  nz(t, 0.18, \"bandpass\", 3200, 900, 1.2, 0.55, 0.001);","  for (i = 0; i < fr.length; i++) tn(t, 1.8, \"sawtooth\", fr[i], fr[i] * 0.98, 0.07, 0.01);","}","function sScream() {","  var a = auInit(); if (!a) return; var t = a.currentTime + 0.005, i, mult = [1, 1.414, 0.5];","  var mix = a.createGain(), ws = a.createWaveShaper(), f1 = a.createBiquadFilter(), f2 = a.createBiquadFilter();","  var out = a.createGain(), lfo = a.createOscillator(), lg = a.createGain();","  ws.curve = W.aCurve; mix.gain.value = 0.55;","  f1.type = \"bandpass\"; f1.frequency.value = 850; f1.Q.value = 3;","  f2.type = \"bandpass\"; f2.frequency.value = 2600; f2.Q.value = 5;","  out.gain.setValueAtTime(0.0001, t); out.gain.linearRampToValueAtTime(0.9, t + 0.04);","  out.gain.setValueAtTime(0.9, t + 0.9); out.gain.exponentialRampToValueAtTime(0.0001, t + 2.0);","  lfo.frequency.value = 8; lg.gain.value = 40; lfo.connect(lg);","  for (i = 0; i < 3; i++) {","    var o = a.createOscillator(); o.type = i === 1 ? \"square\" : \"sawtooth\";","    o.frequency.setValueAtTime(380 * mult[i], t);","    o.frequency.exponentialRampToValueAtTime(1050 * mult[i], t + 0.22);","    o.frequency.exponentialRampToValueAtTime(760 * mult[i], t + 1.8);","    lg.connect(o.frequency); o.connect(mix); o.start(t); o.stop(t + 2.1);","  }","  lfo.start(t); lfo.stop(t + 2.1);","  mix.connect(ws); ws.connect(f1); ws.connect(f2); f1.connect(out); f2.connect(out); out.connect(W.aLp);","  nz(t, 1.6, \"bandpass\", 2800, 1800, 1.5, 0.35, 0.05);","}","function sThump(v) {","  var a = auInit(); if (!a) return; var t = a.currentTime + 0.002;","  tn(t, 0.22, \"sine\", 75, 38, v, 0.006);","  nz(t, 0.1, \"lowpass\", 400, 100, 0.8, v * 0.35, 0.004);","  tn(t + 0.17, 0.22, \"sine\", 62, 34, v * 0.7, 0.006);","}","function sBreath() { var a = auInit(); if (!a) return; nz(a.currentTime + 0.05, 1.4, \"bandpass\", 450, 1100, 1.2, 0.3, 0.6); }","function tinSet(v) {","  if (!W.ac) return;","  if (v > 0.001 && !W.tin) {","    var a = W.ac, g = a.createGain(), o1 = a.createOscillator(), o2 = a.createOscillator();","    g.gain.value = 0; o1.frequency.value = 6900; o2.frequency.value = 7060;","    o1.connect(g); o2.connect(g); g.connect(W.aMg); o1.start(); o2.start(); W.tin = { g: g, o1: o1, o2: o2 };","  }","  if (W.tin) W.tin.g.gain.setTargetAtTime(v, W.ac.currentTime, 0.05);","}","function tinKill() { if (W.tin) { try { W.tin.o1.stop(); W.tin.o2.stop(); } catch (e) {} W.tin = null; } }","function setMuffle(fr) { if (W.ac && W.aLp) W.aLp.frequency.setTargetAtTime(clamp(fr, 200, 20000), W.ac.currentTime, 0.06); }","","// ---- NEW (from v5): parasite sounds: bone crack on each squeeze, whip when tentacles shoot out, bite at the end ----","function sCrack() {","  var a = auInit(); if (!a) return; var t = a.currentTime + 0.002, i;","  for (i = 0; i < 3; i++) nz(t + i * 0.045 + rnd() * 0.03, 0.06, \"bandpass\", 3500 + rnd() * 1500, 1200, 3, 0.8, 0.002);","  tn(t, 0.6, \"sawtooth\", 85, 38, 0.4, 0.01);","}","function sWhip() {","  var a = auInit(); if (!a) return; var t = a.currentTime + 0.002;","  nz(t, 0.35, \"bandpass\", 400, 3000, 1.2, 0.5, 0.05); nz(t, 0.5, \"lowpass\", 1800, 200, 1, 0.55, 0.01); tn(t, 0.4, \"sine\", 130, 55, 0.5, 0.01);","}","function sNeck() {","  var a = auInit(); if (!a) return; var t = a.currentTime + 0.002, i;","  for (i = 0; i < 5; i++) nz(t + i * 0.03 + rnd() * 0.02, 0.07, \"bandpass\", 2500 + rnd() * 2500, 800, 4, 1.0, 0.001);","  tn(t, 0.7, \"sine\", 70, 24, 1.0, 0.002); nz(t, 0.25, \"lowpass\", 1500, 120, 1, 0.9, 0.001);","  tn(t + 0.12, 0.3, \"sawtooth\", 140, 50, 0.35, 0.002);","  for (i = 0; i < 3; i++) nz(t + 0.22 + i * 0.05, 0.06, \"bandpass\", 1800 + rnd() * 1500, 600, 3, 0.6, 0.001);","  nz(t + 0.4, 1.0, \"bandpass\", 650, 220, 1.2, 0.22, 0.25);","}","function sBite() {","  var a = auInit(); if (!a) return; var t = a.currentTime + 0.002, i;","  nz(t, 0.35, \"lowpass\", 2600, 200, 1, 0.9, 0.002); tn(t, 0.6, \"sine\", 95, 32, 0.9, 0.004);","  for (i = 0; i < 4; i++) nz(t + i * 0.05, 0.06, \"bandpass\", 3000, 1000, 3, 0.6, 0.002);","}","","// ================== NEW (from v5): PARASITE - two fanged tentacles (Three.js) that coil around the player and crush ==================","function mkTex() {","  var NN = 256, c = document.createElement(\"canvas\"); c.width = c.height = NN; var x = c.getContext(\"2d\");","  var sd = 1234567; var r = function () { sd = (sd * 16807) % 2147483647; return sd / 2147483647; };","  x.fillStyle = \"#7a4640\"; x.fillRect(0, 0, NN, NN);","  var cols = [\"150,80,70\", \"100,36,42\", \"180,120,100\", \"120,95,50\", \"110,124,60\", \"84,40,66\"], i, j, k, t;","  for (i = 0; i < 70; i++) { var px = r() * NN, py = r() * NN, rad = 18 + r() * 60, g = x.createRadialGradient(px, py, 0, px, py, rad), cl = cols[i % 6];","    g.addColorStop(0, \"rgba(\" + cl + \",.5)\"); g.addColorStop(1, \"rgba(\" + cl + \",0)\"); x.fillStyle = g; x.fillRect(px - rad, py - rad, rad * 2, rad * 2); }","  for (k = 0; k < 4; k++) { var pk = 32 + k * 64, g2 = x.createLinearGradient(pk - 10, 0, pk + 10, 0); g2.addColorStop(0, \"rgba(30,6,12,0)\"); g2.addColorStop(0.5, \"rgba(30,6,12,.85)\"); g2.addColorStop(1, \"rgba(30,6,12,0)\"); x.fillStyle = g2; x.fillRect(pk - 10, 0, 20, NN); }","  x.strokeStyle = \"rgba(70,8,26,.8)\"; x.lineCap = \"round\";","  for (i = 0; i < 22; i++) { var qx = r() * NN, qy = r() * NN, an = r() * TAU; x.lineWidth = 1 + r() * 2.5; x.beginPath(); x.moveTo(qx, qy); for (j = 0; j < 14; j++) { an += (r() - 0.5) * 0.8; qx += Math.cos(an) * 10; qy += Math.sin(an) * 10; x.lineTo(qx, qy); } x.stroke(); }","  for (i = 0; i < 26; i++) { var ax = r() * NN, ay = r() * NN, ar = 3 + r() * 9, g3 = x.createRadialGradient(ax, ay, 0, ax, ay, ar); g3.addColorStop(0, \"rgba(236,222,150,.95)\"); g3.addColorStop(1, \"rgba(70,22,26,.9)\"); x.fillStyle = g3; x.beginPath(); x.arc(ax, ay, ar, 0, TAU); x.fill(); }","  for (i = 0; i < 7; i++) { var mx = r() * NN, my = r() * NN, mr = 9 + r() * 8; x.fillStyle = \"#1a0006\"; x.beginPath(); x.arc(mx, my, mr, 0, TAU); x.fill(); x.fillStyle = \"#e4d8b8\";","    for (t = 0; t < 10; t++) { var ta = t / 10 * TAU; x.beginPath(); x.moveTo(mx + Math.cos(ta - 0.15) * mr * 0.85, my + Math.sin(ta - 0.15) * mr * 0.85); x.lineTo(mx + Math.cos(ta) * mr * 0.35, my + Math.sin(ta) * mr * 0.35); x.lineTo(mx + Math.cos(ta + 0.15) * mr * 0.85, my + Math.sin(ta + 0.15) * mr * 0.85); x.fill(); } }","  for (i = 0; i < 3; i++) { var ex = 30 + r() * 196, ey = 30 + r() * 196, er = 14 + r() * 6; x.fillStyle = \"#e6dcc0\"; x.beginPath(); x.ellipse(ex, ey, er * 1.1, er * 0.8, 0, 0, TAU); x.fill();","    x.fillStyle = \"#a89a2c\"; x.beginPath(); x.arc(ex, ey, er * 0.5, 0, TAU); x.fill(); x.fillStyle = \"#000\"; x.beginPath(); x.ellipse(ex, ey, er * 0.1, er * 0.46, 0, 0, TAU); x.fill();","    x.strokeStyle = \"#2a0508\"; x.lineWidth = 3; x.beginPath(); x.ellipse(ex, ey, er * 1.1, er * 0.8, 0, 0, TAU); x.stroke(); x.strokeStyle = \"rgba(70,8,26,.8)\"; }","  var tx = new THREE.CanvasTexture(c); tx.wrapS = tx.wrapT = THREE.RepeatWrapping; if (THREE.SRGBColorSpace) tx.colorSpace = THREE.SRGBColorSpace; return tx;","}","var SEG = 64, RAD = 12, BACK = 6, GH = 0.8;","function buildPara() {","  var V3 = THREE.Vector3, tx = mkTex();","  var body = new THREE.MeshStandardMaterial({ map: tx, bumpMap: tx, bumpScale: 2, roughness: 0.4, metalness: 0, emissive: new THREE.Color(0x3a0c0c), emissiveMap: tx, emissiveIntensity: 0.6, side: THREE.DoubleSide, fog: false });","  var tooth = new THREE.MeshStandardMaterial({ color: 0xe6d9b6, emissive: 0x3d3524, roughness: 0.3, fog: false }), mouth = new THREE.MeshBasicMaterial({ color: 0x14040a, fog: false });","  var tongue = new THREE.MeshStandardMaterial({ color: 0x9a2c3c, emissive: 0x3a0810, fog: false }), eyeM = new THREE.MeshStandardMaterial({ color: 0xe8dfc0, emissive: 0x40361c, fog: false }), pup = new THREE.MeshBasicMaterial({ color: 0, fog: false });","  var sph = new THREE.SphereGeometry(1, 16, 12), cone = new THREE.ConeGeometry(0.2, 1.5, 6), Zv = new V3(0, 0, 1), Yv = new V3(0, 1, 0);","  var group = new THREE.Group(); group.visible = false;","  var mkRope = function (c) {","    var n = (SEG + 1) * (RAD + 1), pos = new Float32Array(n * 3), nor = new Float32Array(n * 3), uv = new Float32Array(n * 2), idx = [], i, j;","    for (i = 0; i < SEG; i++) for (j = 0; j < RAD; j++) { var a = i * (RAD + 1) + j, b = a + RAD + 1; idx.push(a, b, a + 1, b, b + 1, a + 1); }","    for (i = 0; i <= SEG; i++) for (j = 0; j <= RAD; j++) uv[(i * (RAD + 1) + j) * 2 + 1] = j / RAD;","    var geo = new THREE.BufferGeometry(); geo.setAttribute(\"position\", new THREE.BufferAttribute(pos, 3)); geo.setAttribute(\"normal\", new THREE.BufferAttribute(nor, 3)); geo.setAttribute(\"uv\", new THREE.BufferAttribute(uv, 2)); geo.setIndex(idx);","    var mesh = new THREE.Mesh(geo, body); mesh.frustumCulled = false;","    var head = new THREE.Group(), skull = new THREE.Mesh(sph, body); skull.scale.set(1.7, 1.7, 2.4); skull.position.z = 0.7;","    var mo = new THREE.Mesh(sph, mouth); mo.scale.set(1.15, 1.15, 0.55); mo.position.z = 2.85;","    var to = new THREE.Mesh(sph, tongue); to.scale.set(0.5, 0.25, 0.9); to.position.set(0, -0.25, 2.7); head.add(skull, mo, to);","    var fangs = [];","    for (i = 0; i < 8; i++) { var an = i / 8 * TAU, pv = new THREE.Object3D(); pv.position.set(Math.cos(an) * 1.15, Math.sin(an) * 1.15, 2.6);","      var cn = new THREE.Mesh(cone, tooth); cn.rotation.x = Math.PI / 2; cn.position.z = 0.75; pv.add(cn); head.add(pv); fangs.push({ pv: pv, qz: new THREE.Quaternion().setFromAxisAngle(Zv, an) }); }","    for (var sd = -1; sd <= 1; sd += 2) { var e = new THREE.Mesh(sph, eyeM); e.scale.setScalar(0.42); e.position.set(sd * 1.25, 1, 1);","      var p = new THREE.Mesh(sph, pup); p.scale.set(0.1, 0.34, 0.1); p.position.set(sd * 1.19, 1, 1.4); head.add(e, p); }","    group.add(mesh, head);","    return Object.assign({ mesh: mesh, head: head, geo: geo, pos: pos, nor: nor, uv: uv, fangs: fangs, H: new V3(), Hb: new V3(), A: new V3(), Tl: new V3(),","      pts: Array.from({ length: SEG + 1 }, function () { return new V3(); }), arc: new Float32Array(SEG + 1),","      rest: new V3(c.rest[0], c.rest[1], c.rest[2]), lunge: new V3(c.lunge[0], c.lunge[1], c.lunge[2]) }, c);","  };","  var ropes = [","    mkRope({ hand: 1, r0: 26, y0s: -24, y0e: 8, turns: 4.4, th0: Math.PI, phase: 0, rest: [6, -4.5, -14], lunge: [0.6, -0.9, -3.4] }),","    mkRope({ hand: -1, r0: 30, y0s: -26, y0e: 6, turns: 3.8, th0: Math.PI * 1.2, phase: 2.3, rest: [-7.5, -6.5, -17], lunge: [-3.2, -3.2, -4.8] })];","  var light = new THREE.DirectionalLight(0xff7a62, 1.1); light.position.set(0, 6, 8); group.add(light);","  var scn = new THREE.Scene(), pcam = new THREE.PerspectiveCamera(58, 1, 0.1, 400);","  var rc = document.createElement(\"canvas\"); rc.style.cssText = \"position:fixed;left:0;top:0;pointer-events:none;z-index:2147482999;display:none;\";","  (cv.parentNode || document.body).appendChild(rc);","  var rdr = new THREE.WebGLRenderer({ canvas: rc, alpha: true, antialias: Qual >= 1, premultipliedAlpha: true });","  rdr.setClearColor(0x000000, 0);","  scn.add(pcam); scn.add(group); scn.add(new THREE.AmbientLight(0xffffff, 0.6));","  return { rc: rc, rdr: rdr, scn: scn, pcam: pcam, group: group, ropes: ropes, body: body, light: light, N: new V3(), B: new V3(), Tv: new V3(), qA: new THREE.Quaternion(), Zv: Zv, Yv: Yv,","    cosT: Array.from({ length: RAD + 1 }, function (_, j) { return Math.cos(j / RAD * TAU); }), sinT: Array.from({ length: RAD + 1 }, function (_, j) { return Math.sin(j / RAD * TAU); }) };","}","function updPara(g, T, Q, crush, End, NeckAt) {","  var tS = O(\"Cfg_JS_PA_Start\", 0.2), tG = Math.max(0.2, O(\"Cfg_JS_PA_Grow\", 1.1)), L = sm((T - tS) / tG);","  var RB = O(\"Cfg_JS_PA_Radius\", 2.1) * O(\"Cfg_JS_PA_Scale\", 1), fade = 1 - sm((T - (End - 0.5)) / 0.4), lungeK = sm((T - (NeckAt - 1.7)) / 0.7);","  var s = lerp(1, 0.42, Q) - 0.07 * crush, Rt = RB * (0.55 + 0.45 * s) * (1 + 0.18 * crush), wob = 1 - 0.65 * Q, tile = TAU * RB * 1.6;","  if (!W.fl.whip && T >= tS) { W.fl.whip = 1; sWhip(); }","  if (!W.fl.bite && T >= NeckAt - 0.15) { W.fl.bite = 1; sBite(); }","  var helix = function (rp, gg, out) { var th = Math.min(gg / GH, 1), ang = rp.th0 + rp.hand * TAU * rp.turns * th, ph = T * 7 + rp.phase, rr = rp.r0 * (1 + 0.07 * wob * Math.sin(gg * 26 - ph));","    var y0 = lerp(rp.y0s, rp.y0e, th) + 9 * Q + 1.8 * wob * Math.sin(gg * 17 - ph * 0.8); out.set(s * rr * Math.sin(ang), s * y0, BACK + s * (-rr * Math.cos(ang))); };","  var path = function (rp, gg, out) { if (gg <= GH) { helix(rp, gg, out); return; } var b = (gg - GH) / (1 - GH); helix(rp, GH, rp.A);","    if (b < 0.7) { var k = sm(b / 0.7); out.lerpVectors(rp.A, rp.Hb, k); out.y += 5 * Math.sin(Math.PI * k); out.x += 2.5 * Math.sin(k * TAU + T * 3) * (1 - k); } else out.lerpVectors(rp.Hb, rp.H, (b - 0.7) / 0.3); };","  var NV = g.N, BV = g.B, Tv = g.Tv, ri, i, j;","  for (ri = 0; ri < g.ropes.length; ri++) {","    var rp = g.ropes[ri], H = rp.H; H.copy(rp.rest); H.x += Math.sin(T * 1.9 + rp.phase) * 1.4; H.y += Math.sin(T * 2.6 + rp.phase * 1.3); H.z += Math.sin(T * 1.3 + rp.phase) * 1.2 + 2.4 * crush;","    H.lerp(rp.lunge, lungeK); rp.Hb.copy(H).normalize().multiplyScalar(12).add(H);","    var pts = rp.pts, arc = rp.arc; for (i = 0; i <= SEG; i++) path(rp, L * i / SEG, pts[i]);","    arc[0] = 0; for (i = 1; i <= SEG; i++) arc[i] = arc[i - 1] + pts[i].distanceTo(pts[i - 1]);","    for (i = 0; i <= SEG; i++) {","      var a0 = pts[Math.max(i - 1, 0)], a1 = pts[Math.min(i + 1, SEG)]; Tv.subVectors(a1, a0); if (Tv.lengthSq() < 1e-10) Tv.set(0, 0, -1); Tv.normalize();","      if (i === 0) { var ref = Math.abs(Tv.y) < 0.9 ? g.Yv : g.Zv; NV.copy(ref).addScaledVector(Tv, -ref.dot(Tv)).normalize(); } else NV.addScaledVector(Tv, -NV.dot(Tv)).normalize();","      BV.crossVectors(Tv, NV); if (i === SEG) rp.Tl.copy(Tv);","      var u = i / SEG, r = Rt * (1.25 - 0.3 * u); r *= 1 + (0.1 + 0.22 * crush) * Math.sin(arc[i] * 0.45 - T * 9); if (u > 0.93) r *= 1 + 0.6 * Math.sin((u - 0.93) / 0.07 * Math.PI / 2);","      var pt = pts[i];","      for (j = 0; j <= RAD; j++) { var cx = g.cosT[j], sx = g.sinT[j], th = j / RAD * TAU, lump = 1 + 0.09 * Math.sin(3 * th + arc[i] * 0.11) + 0.05 * Math.sin(5 * th - arc[i] * 0.2 + T * 0.6);","        var nx = NV.x * cx + BV.x * sx, ny = NV.y * cx + BV.y * sx, nzz = NV.z * cx + BV.z * sx, o = (i * (RAD + 1) + j) * 3, rr = r * lump;","        rp.pos[o] = pt.x + nx * rr; rp.pos[o + 1] = pt.y + ny * rr; rp.pos[o + 2] = pt.z + nzz * rr; rp.nor[o] = nx; rp.nor[o + 1] = ny; rp.nor[o + 2] = nzz; rp.uv[(i * (RAD + 1) + j) * 2] = arc[i] / tile; }","    }","    rp.geo.attributes.position.needsUpdate = true; rp.geo.attributes.normal.needsUpdate = true; rp.geo.attributes.uv.needsUpdate = true;","    var hd = rp.head; hd.position.copy(pts[SEG]).addScaledVector(rp.Tl, -Rt * 0.4); hd.quaternion.setFromUnitVectors(g.Zv, rp.Tl);","    hd.scale.setScalar(Rt * 0.85 * (1 + 0.35 * lungeK) * (1 + 0.04 * Math.sin(T * 6)));","    var ch = lungeK > 0.5 ? 0.5 + 0.5 * Math.sin(T * 18 + rp.phase) : 0, open = 0.18 + 0.55 * lungeK * (0.4 + 0.6 * ch) + 0.35 * crush + 0.05 * Math.sin(T * 25);","    for (j = 0; j < rp.fangs.length; j++) { var fg = rp.fangs[j]; fg.pv.quaternion.copy(fg.qz).multiply(g.qA.setFromAxisAngle(g.Yv, open * 1.25)); }","    rp.head.visible = rp.mesh.visible = L > 0.02;","  }","  g.body.emissive.setRGB(0.23 + 0.45 * crush, 0.05 + 0.03 * crush, 0.05); g.body.emissiveIntensity = 0.5 + 0.18 * Math.sin(T * 3.5) + 0.7 * crush;","  g.light.intensity = (1.1 + 0.8 * crush + 0.25 * Math.sin(T * 9)) * fade; g.group.visible = L > 0.02;","}","","// (hallucination scenes removed)","","// ---- Layers: restore saved visibility (works after scene restart too) ----","function restoreLayers() {","  var snap = W.layerSnap; W.layerSnap = null;","  if (!snap) return;","  for (var nm in snap) { if (S.hasLayer(nm)) S.getLayer(nm).show(snap[nm]); }","}","","if (!W.hal) W.hal = newHal();","if (W.scene !== S) {","  W.scene = S; W.splatsDone = false; W.restarting = false; W.ph = 0; W.hal = newHal();","  W.aImp = false; W.aScr = false; W.aWake = false; W.sub = false; W.tn = 0; W.tt = 0;","  W.fl = {}; W.cph = 0; W.crush = 0; if (W.pg) { try { W.pg.rc.parentNode.removeChild(W.pg.rc); W.pg.rdr.dispose(); } catch (e9) {} } W.pg = null; W.ch = false; W.paraOff = false;","  restoreLayers();","  if (W.pending) { W.pending = false; W.wake = 0; }","}","var H = W.hal;","var cv = G.getRenderer().getCanvas();","if (!cv) return;","if (!W.visHook && typeof document !== \"undefined\" && document.addEventListener) {","  W.visHook = true;","  document.addEventListener(\"visibilitychange\", function () { try { if (W.ac) { if (document.hidden) W.ac.suspend(); else W.ac.resume(); } } catch (e) {} });","}","if (W.aMg && W.ac) W.aMg.gain.setTargetAtTime(clamp(O(\"Cfg_JS_Volume\", 0.8), 0, 1.5), W.ac.currentTime, 0.05);","if (!W.c || !W.c.isConnected || W.cvRef !== cv) {","  if (W.c && W.c.parentNode) W.c.parentNode.removeChild(W.c);","  var c = document.createElement(\"canvas\");","  c.style.cssText = \"position:fixed;left:0;top:0;pointer-events:none;z-index:2147483000;display:none;\";","  (cv.parentNode || document.body).appendChild(c);","  W.c = c; W.x = c.getContext(\"2d\"); W.cvRef = cv; W.prevFilter = cv.style.filter || \"\"; W.prevTf = cv.style.transform || \"\";","  var nc = document.createElement(\"canvas\"); nc.width = nc.height = 128;","  var nx = nc.getContext(\"2d\"), id = nx.createImageData(128, 128);","  for (var i = 0; i < id.data.length; i += 4) {","    var v = rnd() < 0.5 ? 0 : 255;","    id.data[i] = id.data[i + 1] = id.data[i + 2] = v; id.data[i + 3] = (rnd() * 255) | 0;","  }","  nx.putImageData(id, 0, 0); W.noise = nc;","    W.watch = [];","  for (var wi = 0; wi < 7; wi++) W.watch.push({ x: rnd() < 0.5 ? 0.04 + rnd() * 0.16 : 0.80 + rnd() * 0.16, y: 0.15 + rnd() * 0.7, s: 0.018 + rnd() * 0.02, ph: rnd() * 6.283 });","  W.veins = [];","  var vein = function (x, y, a, steps, w) {","    var pts = [[x, y]];","    for (var i = 0; i < steps; i++) {","      a += (rnd() - 0.5) * 0.7; x += Math.cos(a) * 0.022; y += Math.sin(a) * 0.022; pts.push([x, y]);","      if (i > 3 && rnd() < 0.12 && w > 0.6) vein(x, y, a + (rnd() < 0.5 ? -1 : 1) * (0.5 + rnd() * 0.5), Math.floor(steps * 0.55), w * 0.6);","    }","    W.veins.push({ p: pts, w: w });","  };","  for (var k = 0; k < 22; k++) {","    var e = Math.floor(rnd() * 4), t = rnd(), x0, y0, a0;","    if (e === 0) { x0 = t; y0 = 0; a0 = Math.PI / 2; } else if (e === 1) { x0 = 1; y0 = t; a0 = Math.PI; }","    else if (e === 2) { x0 = t; y0 = 1; a0 = -Math.PI / 2; } else { x0 = 0; y0 = t; a0 = 0; }","    vein(x0, y0, a0, 14 + Math.floor(rnd() * 10), 2.2);","  }","}","var active = N(\"JS_Active\") === 1;","var T = N(\"JS_T\");","var D0 = N(\"Cfg_JS_FadeStart\"), EndT = N(\"Cfg_JS_EndTime\"), NeckAt = O(\"Cfg_JS_NeckAt\", 4.8);","var Qual = clamp(Math.round(O(\"Cfg_JS_Quality\", 2)), 0, 2), SAFE = O(\"Cfg_JS_Safe\", 0) === 1;","var halOn = false, halStart = O(\"Cfg_JS_HalStart\", 1.0), shakeOn = O(\"Cfg_JS_Shake\", 1) === 1;","","// hallucination scheduler: random bursts that get faster and longer as intensity rises","function stepHal(inten, allowed) {","  H.beat = 0;","  if (H.left > 0) { H.left -= dt; if (H.left < 0) H.left = 0; }","  else if (allowed) {","    H.gap -= dt;","    if (H.gap <= 0) {","      var kk = 0;","      H.last = kk; H.kind = kk; H.seed = (rnd() * 1e9) | 0; H.inv = rnd() < 0.08 + 0.25 * inten; H.tint = Math.floor(rnd() * 4);","      H.dur = 0.07 + rnd() * 0.13 + 0.1 * inten; H.left = H.dur; H.beat = 1; H.word = rnd() < 0.5;","      if (H.chain < 3 && rnd() < 0.25 + 0.35 * inten) { H.chain++; H.gap = 0.02; } else { H.chain = 0; H.gap = lerp(1.5, 0.3, inten) * (0.6 + rnd() * 0.9); }","    }","  }","  if (H.dur > 0 && H.left > 0) { H.p = 1 - H.left / H.dur; H.a = sm(H.p / 0.1) * (1 - sm((H.p - 0.86) / 0.14)); }","  else { H.p = -1; H.a = 0; }","}","","// ---- Layers: by default NOTHING is hidden. Optional: Cfg_JS_HideLayers = \"HUD,Crosshair\" (comma separated) ----","var hideStr = V(\"Cfg_JS_HideLayers\").getAsString();","var toHide = [];","if (hideStr && hideStr !== \"0\") {","  var parts = hideStr.split(\",\");","  for (var hi = 0; hi < parts.length; hi++) {","    var ln0 = parts[hi].trim();","    if (ln0 !== \"\" && S.hasLayer(ln0)) toHide.push(ln0);","  }","}","if (active && toHide.length > 0) {","  if (!W.layerSnap) {","    W.layerSnap = {};","    for (var li = 0; li < toHide.length; li++) W.layerSnap[toHide[li]] = S.getLayer(toHide[li]).isVisible();","  }","  for (var lj = 0; lj < toHide.length; lj++) S.getLayer(toHide[lj]).show(false);","} else if (!active && W.layerSnap) {","  restoreLayers();","}","","if (N(\"JS_GameOver\") === 1 && N(\"Cfg_JS_AutoRestart\") === 1 && !W.restarting) {","  W.restarting = true; W.pending = true;","  try {","    if (typeof gdjs.SceneChangeRequest !== \"undefined\" && gdjs.SceneChangeRequest.REPLACE_SCENE !== undefined)","      S.requestChange(gdjs.SceneChangeRequest.REPLACE_SCENE, S.getName());","    else S.requestChange(gdjs.RuntimeScene.REPLACE_SCENE, S.getName());","  } catch (err) { console.error(\"JS restart failed\", err); W.restarting = false; W.pending = false; }","}","SV(\"JS_Beat\", 0); SV(\"JS_HalBeat\", 0);","var wakeOn = !active && W.wake >= 0;","// parasite is only visible while the scare is active","if (!active) { if (W.pg) { W.pg.group.visible = false; W.pg.rc.style.display = \"none\"; } SV(\"JS_Crush\", 0); }","","// ---- TENSION phase: the closer the monster gets (before the catch) the stronger heartbeat/vignette/watchers ----","var tenOn = false;","if (!active && !wakeOn) {","  var tt0 = 0;","  if (O(\"Cfg_JS_Tension\", 1) === 1 && O(\"Cfg_JS_Enabled\", 1) === 1 && N(\"JS_Done\") === 0) {","    var dd = O(\"DistToPlayer\", 99999), cd = N(\"Cfg_JS_CatchDist\"), td = Math.max(cd + 1, O(\"Cfg_JS_TensionDist\", 520));","    tt0 = clamp(1 - (dd - cd) / (td - cd), 0, 1); tt0 = tt0 * tt0;","  }","  W.tn = lerp(W.tn, tt0, clamp(dt * 3, 0, 1));","  tenOn = W.tn > 0.02;","}","SV(\"JS_Tension\", active ? 1 : W.tn);","// JS_Phase: 0 idle, 1 tension, 2 grabbed, 3 squeezed, 4 neck broken, 5 waking up (use it in your own events: pause menu, HUD, music...)","var phase = active ? (T >= NeckAt ? 4 : (N(\"JS_Sq\") > 0.02 ? 3 : 2)) : (wakeOn ? 5 : (tenOn ? 1 : 0));","SV(\"JS_Phase\", phase); SV(\"JS_Snapped\", phase === 4 ? 1 : 0);","","if (!active && !wakeOn && !tenOn) {","  if (W.on) {","    W.on = false; W.c.style.display = \"none\"; W.x.clearRect(0, 0, W.c.width, W.c.height);","    W.hal = newHal();","    tinKill(); setMuffle(20000);","  }","  return;","}","if (tenOn) { W.tt += dt; T = W.tt; }","var P = { flash: 0, lid: 0, tun: 0.18, black: 0, blur: 0, sat: 1, con: 1, bri: 1, red: 0.1, pulse: 0, grain: 0.06,","glitch: 0, dark: 0, ca: 0, vein: 0, sa: 1, T: T, shake: 0, roll: 0, hue: 0, inv: 0, wat: 0, bars: 0, punch: 0 };","if (active) {","  if (!W.splatsDone) {","    W.splatsDone = true; W.splats = []; W.age = 0;","    var n = 10 + Math.floor(rnd() * 6);","    for (var i = 0; i < n; i++) {","      var big = i < 3;","      var s = { x: 0.12 + rnd() * 0.76, y: 0.1 + rnd() * 0.7, r: big ? 0.06 + rnd() * 0.05 : 0.015 + rnd() * 0.035,","        t: rnd() * 0.35, drip: rnd() < 0.7 ? 0.05 + rnd() * 0.25 : 0, sp: 0.02 + rnd() * 0.05, sat: [] };","      for (var k2 = 0; k2 < 4 + Math.floor(rnd() * 4); k2++) {","        var a = rnd() * 6.283, d = s.r * (1.1 + rnd() * 1.4);","        s.sat.push([Math.cos(a) * d, Math.sin(a) * d, s.r * (0.15 + rnd() * 0.25)]);","      }","      W.splats.push(s);","    }","  }","  W.age += dt;","  var dTotal = Math.max(0.1, EndT - D0);","  var dp = sm((T - D0) / dTotal);","  var u = clamp((T - D0) / Math.max(0.1, EndT - 0.6 - D0), 0, 1);","  SV(\"JS_Death\", dp);","  var bpm = lerp(150, 38, u);","  var prev = Math.floor(W.ph); W.ph += dt * bpm / 60;","  var beatNow = Math.floor(W.ph) > prev;","  var f = W.ph % 1;","  var strength = (1 - 0.7 * u) * (1 - sm((T - (EndT - 0.6)) / 0.4));","  var snp = clamp((T - NeckAt) * 25, 0, 1), post = Math.max(0, 1 - (T - NeckAt) * 6);","  if (beatNow && T < NeckAt) { SV(\"JS_Beat\", 1); sThump(0.25 + 0.6 * strength); }","  P.pulse = (Math.exp(-Math.pow(f * 12, 2)) + 0.55 * Math.exp(-Math.pow((f - 0.3) * 12, 2))) * strength * (T < NeckAt ? 1 : post);","  var sAt = N(\"Cfg_JS_ScreamAt\");","  P.flash = Math.exp(-T * 11) * 0.9 + (T >= sAt ? 0.35 * Math.exp(-(T - sAt) * 8) : 0);","  P.punch = 0.10 * Math.exp(-T * 9) + (T >= sAt ? 0.05 * Math.exp(-(T - sAt) * 7) : 0);","  P.blur = 5 * Math.exp(-T * 4.5) + 9 * sm(u * 1.2);","  P.sat = 1 + 0.35 * Math.exp(-T * 6) - 0.9 * dp;","  P.con = 1 + 0.3 * Math.exp(-T * 8) + 0.25 * dp;","  P.bri = 1 - 0.35 * dp;","  P.glitch = (T < 0.55 ? Math.exp(-T * 5) : 0) + ((T < N(\"Cfg_JS_FlickerTime\") && rnd() < 0.15) ? 0.8 : 0);","  P.ca = 0.35 * Math.exp(-T * 6) + 0.5 * dp;","  if (T > 0.3 && T < N(\"Cfg_JS_FlickerTime\") + 0.6 && rnd() < 0.07) P.dark = 0.85;","  P.tun = 0.30 + 0.70 * sm(u * 1.1);","  P.red = 0.35 * Math.exp(-T * 2.5) + 0.12 + P.pulse * 0.28 * (0.4 + 0.6 * (1 - u)) + 0.25 * dp;","  P.grain = 0.07 + 0.10 * dp;","  P.vein = sm((T - 0.4) / 1.5);","  var lid = Math.max(0.2 * sm(u / 0.55), bump(u, 0.17, 0.05, 0.38), bump(u, 0.40, 0.06, 0.62));","  if (T > NeckAt) lid = Math.max(lid, sm((T - NeckAt - 0.35) / 1.1));","  if (lid > 0 && lid < 1) lid = clamp(lid + 0.015 * Math.sin(T * 31), 0, 1);","  P.lid = lid;","  P.black = sm((T - (EndT - 0.6)) / 0.35);","  // cinematic bars slide in","  if (O(\"Cfg_JS_Bars\", 1) === 1) P.bars = 0.075 * sm(T / 0.6);","  // hallucinations, shake, dizzy camera, watchers","  stepHal(0.25 + 0.75 * u, halOn && T > halStart && T < EndT - 0.9);","  // one guaranteed subliminal screamer face shortly after the scream (the \"it's over... NOT yet\" scare)","  if (halOn && !W.sub && T >= sAt + 1.1 && T < EndT - 0.9) {","    W.sub = true; H.kind = 8; H.seed = (rnd() * 1e9) | 0; H.dur = 0.1; H.left = 0.1; H.tint = 1; H.inv = false; H.word = true; H.chain = 0; H.gap = 0.8; H.beat = 1;","  }","  if (H.beat) SV(\"JS_HalBeat\", 1);","  SV(\"JS_HalKind\", H.a > 0 ? H.kind : -1);","  P.shake = 0.9 * Math.exp(-T * 4) + 0.4 * dp + 0.3 * P.pulse + 0.9 * H.a;","  P.roll = Math.sin(T * 1.7) * 2.4 * dp + Math.sin(T * 0.9 + 1) * 1.2 * sm(u * 1.4);","  P.hue = H.a * (H.tint - 1) * 45 + 28 * dp * Math.sin(T * 3.1);","  P.inv = (H.a > 0 && H.inv && H.p < 0.22) ? 1 : 0;","  P.wat = 0.7 * sm((T - 1.2) / 2) * (1 - P.black);","  P.sat -= 0.25 * H.a; P.ca += 0.5 * H.a; P.glitch += 0.7 * H.a;","  // ---- NEW (from v5): PARASITE squeeze. JS_Sq (0..1) grows from Cfg_JS_SqStart over Cfg_JS_SqTime; JS_Crush pulses with each crushing squeeze ----","  var Q = clamp(N(\"JS_Sq\"), 0, 1), pfade = 1 - sm((T - (EndT - 0.5)) / 0.4);","  W.cph += dt * TAU / (1.5 - 0.7 * Q);","  var crush = Q * Math.pow(Math.max(0, Math.sin(W.cph)), 4) * pfade * (1 - clamp((T - NeckAt) * 25, 0, 1));","  if (crush > 0.6 && !W.ch) { W.ch = true; sCrack(); }","  if (crush < 0.25) W.ch = false;","  W.crush = crush; SV(\"JS_Crush\", crush);","  P.flash += 0.3 * crush; P.ca += 0.5 * crush; P.shake += 0.8 * crush;","  P.tun = Math.max(P.tun, 0.3 + 0.6 * Q + 0.1 * crush);","  P.red += 0.18 * Q + 0.3 * crush;","  P.vein = Math.max(P.vein, Q);","  P.lid = Math.max(P.lid, 0.1 * Q * (0.5 + 0.5 * Math.sin(T * 5)) + 0.22 * crush);","  if (O(\"Cfg_JS_Parasite\", 1) === 1 && typeof THREE !== \"undefined\" && THREE.WebGLRenderer && !W.paraOff) {","    try {","      if (!W.pg) W.pg = buildPara();","      var pg = W.pg, pr = cv.getBoundingClientRect(), PRES = [0.5, 0.75, 1][Qual];","      var pw = Math.max(2, Math.round(pr.width * PRES)), ph = Math.max(2, Math.round(pr.height * PRES));","      pg.rc.style.display = \"block\"; pg.rc.style.left = pr.left + \"px\"; pg.rc.style.top = pr.top + \"px\"; pg.rc.style.width = pr.width + \"px\"; pg.rc.style.height = pr.height + \"px\";","      if (pg.pw !== pw || pg.ph !== ph) { pg.rdr.setSize(pw, ph, false); pg.pw = pw; pg.ph = ph; pg.pcam.aspect = pw / ph; }","      pg.pcam.fov = clamp(O(\"JS_Fov\", 58), 25, 110); pg.pcam.updateProjectionMatrix();","      updPara(pg, T, Q, crush, EndT, NeckAt);","      pg.rdr.render(pg.scn, pg.pcam);","    } catch (perr) { W.paraOff = true; if (W.pg && W.pg.rc) W.pg.rc.style.display = \"none\"; console.error(\"[JumpscareFX] parasite disabled:\", perr); }","  }","  // ---- NECK SNAP: sudden crack, white-red flash, glitch burst, then the shaking stops (head hangs limp, eyes close) ----","  if (!W.fl.neck && T >= NeckAt) {","    W.fl.neck = 1; sNeck();","    for (var bi2 = 0; bi2 < 5; bi2++) {","      var bs = { x: 0.2 + rnd() * 0.6, y: 0.15 + rnd() * 0.6, r: 0.05 + rnd() * 0.05, t: W.age, drip: 0.1 + rnd() * 0.2, sp: 0.05 + rnd() * 0.05, sat: [] };","      for (var bk = 0; bk < 5; bk++) { var ba = rnd() * 6.283, bd = bs.r * (1.1 + rnd() * 1.4); bs.sat.push([Math.cos(ba) * bd, Math.sin(ba) * bd, bs.r * (0.15 + rnd() * 0.25)]); }","      W.splats.push(bs);","    }","  }","  if (T >= NeckAt) {","    var nt = T - NeckAt;","    P.flash += 0.95 * Math.exp(-nt * 9); P.glitch += 1.4 * Math.exp(-nt * 6); P.ca += 0.9 * Math.exp(-nt * 4);","    P.shake = P.shake * (1 - 0.85 * snp) + 1.2 * Math.exp(-nt * 10);","    P.red += 0.25 * Math.exp(-nt * 3);","  }","  // ---- audio ----","  if (!W.aImp) { W.aImp = true; sImpact(); }","  if (!W.aScr && T >= sAt) { W.aScr = true; sScream(); }","  if (T > 0.5) tinSet((0.04 + (T >= NeckAt ? 0.03 * sm((T - NeckAt) / 0.5) : 0)) * sm((T - 0.5) / 0.8) * (1 - P.black));","  setMuffle(20000 * Math.pow(0.02, Math.max(dp, 0.35 * sm((T - 0.5) / 0.5), T >= NeckAt ? 0.8 * sm((T - NeckAt) / 0.2) : 0)));","} else if (wakeOn) {","  var wd = Math.max(0.5, N(\"Cfg_JS_WakeTime\"));","  W.wake += dt;","  var k = clamp(W.wake / wd, 0, 1);","  var wl = 1 - sm((k - 0.1) / 0.45) + 0.28 * Math.exp(-Math.pow((k - 0.55) * 10, 2)) * (1 - k);","  P.lid = clamp(wl, 0, 1);","  P.black = k < 0.06 ? 1 : 0;","  P.blur = 9 * (1 - sm(k)); P.sat = 0.3 + 0.7 * sm(k); P.con = 1 + 0.2 * (1 - k); P.bri = 1 - 0.3 * (1 - k);","  P.tun = 0.8 * (1 - sm(k)) + 0.1; P.red = 0.2 * (1 - k) + 0.05;","  P.vein = 1 - sm(k * 1.2); P.sa = 1 - sm(k * 1.3); P.grain = 0.05 + 0.1 * (1 - k);","  var ph = 1.5 * (90 - 20 * k) / 60 * W.wake, ff = ph % 1;","  P.pulse = (Math.exp(-Math.pow(ff * 12, 2)) + 0.55 * Math.exp(-Math.pow((ff - 0.3) * 12, 2))) * 0.5 * (1 - k);","  // faint hallucinations while waking up (disorientation)","  stepHal(0.2 + 0.3 * (1 - k), halOn && k > 0.12 && k < 0.6);","  if (H.beat) SV(\"JS_HalBeat\", 1);","  P.shake = 0.35 * (1 - k) + 0.5 * H.a; P.roll = Math.sin(W.wake * 2.1) * 2.0 * (1 - sm(k));","  P.hue = H.a * 30 * (1 - k); P.glitch = 0.5 * H.a; P.ca = 0.4 * (1 - k) + 0.3 * H.a;","  if (!W.aWake) { W.aWake = true; sBreath(); }","  tinSet(0.035 * (1 - sm(k * 1.5)));","  setMuffle(500 * Math.pow(40, sm(k)));","  if (k >= 1) { W.wake = -1; W.splats = []; tinKill(); setMuffle(20000); }","} else {","  // tension: calm-but-wrong, escalating dread as the monster closes in","  var tz = W.tn;","  var bpm0 = lerp(66, 128, tz), prev0 = Math.floor(W.ph); W.ph += dt * bpm0 / 60;","  if (Math.floor(W.ph) > prev0) { SV(\"JS_Beat\", 1); sThump(0.10 + 0.55 * tz); }","  var f0 = W.ph % 1;","  P.pulse = (Math.exp(-Math.pow(f0 * 12, 2)) + 0.55 * Math.exp(-Math.pow((f0 - 0.3) * 12, 2))) * (0.25 + 0.75 * tz);","  P.tun = 0.18 + 0.45 * tz; P.red = 0.1 + 0.22 * tz + P.pulse * 0.15 * tz;","  P.vein = 0.35 * sm((tz - 0.3) / 0.7); P.sa = 0;","  P.sat = 1 - 0.35 * tz; P.con = 1 + 0.1 * tz; P.bri = 1 - 0.12 * tz; P.grain = 0.06 + 0.05 * tz;","  P.shake = 0.35 * tz * tz + 0.2 * P.pulse * tz; P.ca = 0.25 * tz * tz;","  P.glitch = (tz > 0.7 && rnd() < 0.01) ? 0.6 : 0;","  P.wat = 0.8 * sm((tz - 0.45) / 0.55);","}","var fK = O(\"Cfg_JS_FlashScale\", 1) * (SAFE ? 0.3 : 1), gK = O(\"Cfg_JS_GlitchScale\", 1) * (SAFE ? 0.3 : 1);","P.flash *= fK; P.glitch *= gK; if (SAFE) { P.dark = 0; P.ca *= 0.5; }","W.on = true;","// NOTE: the game canvas itself is never modified (no CSS filter / transform) -> no conflict with your own post-effects.","var r = cv.getBoundingClientRect(), RES = [0.35, 0.5, 0.75][Qual];","var w = Math.max(2, Math.round(r.width * RES)), h = Math.max(2, Math.round(r.height * RES));","var c2 = W.c, x = W.x;","// optional (Cfg_JS_CssFilter = 1): blur/desaturate what is BEHIND the overlay canvas only","var bf = O(\"Cfg_JS_CssFilter\", 0) === 1 ? \"blur(\" + (Math.round(P.blur * 5) / 5) + \"px) saturate(\" + clamp(P.sat, 0, 3).toFixed(2) + \")\" : \"\";","if (c2.__bf !== bf) { c2.style.backdropFilter = bf; c2.style.webkitBackdropFilter = bf; c2.__bf = bf; }","c2.style.display = \"block\"; c2.style.left = r.left + \"px\"; c2.style.top = r.top + \"px\";","c2.style.width = r.width + \"px\"; c2.style.height = r.height + \"px\";","if (c2.width !== w || c2.height !== h) { c2.width = w; c2.height = h; }","x.setTransform(1, 0, 0, 1, 0, 0); x.clearRect(0, 0, w, h); x.globalCompositeOperation = \"source-over\"; x.globalAlpha = 1;","","var cx = w / 2, cy = h / 2, md = Math.hypot(cx, cy), g;","g = x.createRadialGradient(cx, cy, md * 0.35, cx, cy, md);","g.addColorStop(0, \"rgba(140,0,10,0)\"); g.addColorStop(1, \"rgba(140,0,10,\" + clamp(P.red * 0.9, 0, 0.85) + \")\");","x.fillStyle = g; x.fillRect(0, 0, w, h);","if (P.vein > 0) {","  x.lineCap = \"round\"; x.lineJoin = \"round\";","  x.strokeStyle = \"rgba(90,0,6,\" + clamp(0.18 + 0.5 * P.pulse + 0.3 * P.vein, 0, 0.9) + \")\";","  for (var vi = 0; vi < W.veins.length; vi++) {","    var vv = W.veins[vi], cnt = Math.max(2, Math.floor(vv.p.length * P.vein));","    x.lineWidth = Math.max(0.6, w * 0.0022 * vv.w); x.beginPath(); x.moveTo(vv.p[0][0] * w, vv.p[0][1] * h);","    for (var pi = 1; pi < cnt; pi++) x.lineTo(vv.p[pi][0] * w, vv.p[pi][1] * h);","    x.stroke();","  }","}","if (P.sa > 0.01) for (var si = 0; si < W.splats.length; si++) {","  var sp = W.splats[si], ag = W.age - sp.t; if (ag < 0) continue;","  var gr = Math.min(1, ag * 9), R = sp.r * h * gr, px = sp.x * w, py = sp.y * h, al = 0.82 * P.sa;","  x.fillStyle = \"rgba(95,0,4,\" + al + \")\"; x.strokeStyle = x.fillStyle;","  x.beginPath(); x.arc(px, py, R, 0, 6.283); x.fill();","  for (var q = 0; q < sp.sat.length; q++) { x.beginPath(); x.arc(px + sp.sat[q][0] * h * gr, py + sp.sat[q][1] * h * gr, sp.sat[q][2] * h * gr, 0, 6.283); x.fill(); }","  if (sp.drip > 0) {","    var ln = Math.min(sp.drip, Math.max(0, ag - 0.4) * sp.sp) * h;","    if (ln > 0) { x.lineWidth = Math.max(1, R * 0.35); x.beginPath(); x.moveTo(px, py); x.lineTo(px, py + ln); x.stroke(); x.beginPath(); x.arc(px, py + ln, R * 0.25, 0, 6.283); x.fill(); }","  }","  x.fillStyle = \"rgba(255,170,160,\" + (0.16 * P.sa) + \")\";","  x.beginPath(); x.ellipse(px - R * 0.3, py - R * 0.35, R * 0.25, R * 0.14, -0.6, 0, 6.283); x.fill();","}","if (P.ca > 0.01) {","  var cw = w * 0.07 * Math.min(P.ca, 1.2);","  g = x.createLinearGradient(0, 0, cw, 0); g.addColorStop(0, \"rgba(255,0,40,\" + (0.5 * Math.min(P.ca, 1)) + \")\"); g.addColorStop(1, \"rgba(255,0,40,0)\");","  x.fillStyle = g; x.fillRect(0, 0, cw, h);","  g = x.createLinearGradient(w, 0, w - cw, 0); g.addColorStop(0, \"rgba(0,220,255,\" + (0.5 * Math.min(P.ca, 1)) + \")\"); g.addColorStop(1, \"rgba(0,220,255,0)\");","  x.fillStyle = g; x.fillRect(w - cw, 0, cw, h);","}","var R0 = md * lerp(1.05, 0.10, clamp(P.tun, 0, 1)) * (1 - 0.04 * P.pulse);","g = x.createRadialGradient(cx, cy, Math.max(0, R0), cx, cy, R0 + md * 0.55);","g.addColorStop(0, \"rgba(0,0,0,0)\"); g.addColorStop(1, \"rgba(0,0,0,\" + clamp(0.35 + 0.65 * P.tun, 0, 1) + \")\");","x.fillStyle = g; x.fillRect(0, 0, w, h);","// watchers: pairs of eyes blinking in the dark edges","if (P.wat > 0.01) {","  for (var wI = 0; wI < W.watch.length; wI++) {","    var wo = W.watch[wI], wa = clamp(Math.sin(T * 1.1 + wo.ph * 3) * 1.6 - 0.6, 0, 1) * P.wat;","    if (wa < 0.02) continue;","    var ex = wo.x * w, ey = wo.y * h, er = wo.s * w, gap = er * 2.6;","    for (var sd2 = -1; sd2 <= 1; sd2 += 2) {","      x.fillStyle = \"rgba(255,240,220,\" + (0.8 * wa) + \")\"; x.beginPath(); x.ellipse(ex + sd2 * gap / 2, ey, er, er * 0.38, 0, 0, 6.283); x.fill();","      x.fillStyle = \"rgba(160,0,0,\" + wa + \")\"; x.beginPath(); x.arc(ex + sd2 * gap / 2, ey, er * 0.28, 0, 6.283); x.fill();","    }","  }","}","x.globalAlpha = P.grain;","x.fillStyle = x.createPattern(W.noise, \"repeat\");","x.save(); x.translate((rnd() * 128) | 0, (rnd() * 128) | 0); x.fillRect(-128, -128, w + 256, h + 256); x.restore();","x.globalAlpha = 1;","if (P.glitch > 0.02) {","  var bars = 3 + Math.floor(Math.min(P.glitch, 2) * 5);","  for (var bi = 0; bi < bars; bi++) {","    var by = rnd() * h, bh = rnd() * h * 0.04 + 1, rr = rnd(), ga = 0.25 * Math.min(P.glitch, 1.5);","    x.fillStyle = rr < 0.4 ? \"rgba(0,255,255,\" + ga + \")\" : (rr < 0.8 ? \"rgba(255,0,60,\" + ga + \")\" : \"rgba(255,255,255,\" + (ga * 1.2) + \")\");","    x.fillRect(0, by, w, bh);","  }","}","var dim = clamp((1 - P.bri) + clamp(1 - P.sat, 0, 1) * 0.2, 0, 0.6);","if (dim > 0.01) { x.fillStyle = \"rgba(10,6,6,\" + dim.toFixed(3) + \")\"; x.fillRect(0, 0, w, h); }","if (P.flash > 0.01) { var fa = clamp(P.flash * 0.5, 0, 0.5); x.fillStyle = \"rgba(255,\" + Math.round(70 + 70 * (1 - fa * 2)) + \",\" + Math.round(60 + 60 * (1 - fa * 2)) + \",\" + fa.toFixed(3) + \")\"; x.fillRect(0, 0, w, h); }","if (P.bars > 0.001) { x.fillStyle = \"#000\"; x.fillRect(0, 0, w, h * P.bars); x.fillRect(0, h * (1 - P.bars), w, h * P.bars + 1); }","if (P.lid > 0.005) {","  var hh = P.lid * h * 0.5;","  x.save(); x.shadowColor = \"#000\"; x.shadowBlur = h * 0.04; x.fillStyle = \"#000\";","  x.beginPath(); x.moveTo(-5, -5); x.lineTo(w + 5, -5); x.lineTo(w + 5, hh * 0.75); x.quadraticCurveTo(cx, hh * 1.25, -5, hh * 0.75); x.closePath(); x.fill();","  x.beginPath(); x.moveTo(-5, h + 5); x.lineTo(w + 5, h + 5); x.lineTo(w + 5, h - hh * 0.75); x.quadraticCurveTo(cx, h - hh * 1.25, -5, h - hh * 0.75); x.closePath(); x.fill();","  x.restore();","  x.strokeStyle = \"rgba(90,10,10,\" + 0.35 * (1 - P.lid) + \")\"; x.lineWidth = Math.max(1, h * 0.006);","  x.beginPath(); x.moveTo(0, hh * 0.75); x.quadraticCurveTo(cx, hh * 1.25, w, hh * 0.75); x.stroke();","  x.beginPath(); x.moveTo(0, h - hh * 0.75); x.quadraticCurveTo(cx, h - hh * 1.25, w, h - hh * 0.75); x.stroke();","  if (P.lid > 0.85) { x.fillStyle = \"rgba(0,0,0,\" + sm((P.lid - 0.85) / 0.15) + \")\"; x.fillRect(0, 0, w, h); }","}","var bl = Math.max(P.black, P.dark);","if (bl > 0.001) { x.fillStyle = \"rgba(0,0,0,\" + clamp(bl, 0, 1) + \")\"; x.fillRect(0, 0, w, h); }","if (O(\"Cfg_JS_Debug\", 0) === 1) {","  var dl = [\"JumpscareFX  phase \" + phase + \"  t=\" + T.toFixed(2), \"squeeze \" + N(\"JS_Sq\").toFixed(2) + \"  crush \" + N(\"JS_Crush\").toFixed(2), \"quality \" + Qual + \"  safe \" + (SAFE ? 1 : 0) + \"  errors \" + (W.errN || 0) + (W.paraOff ? \"  PARASITE OFF\" : \"\")], di;","  x.font = \"bold \" + Math.max(9, Math.round(h * 0.035)) + \"px monospace\"; x.textAlign = \"left\"; x.textBaseline = \"top\"; x.fillStyle = \"#33ff66\";","  for (di = 0; di < dl.length; di++) x.fillText(dl[di], 6, 6 + di * Math.max(11, Math.round(h * 0.04)));","}","}","})();"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"colorB":60,"colorG":60,"colorR":220,"creationTime":0,"folded":true,"name":"PARASITE HOOKS v2 (lens pierce + slime + left/right slams)","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"PARASITE HOOKS ADD-ON v2 for Jumpscare v6 PRO. DELETE the previous 'HOOKS ADD-ON' group first, then paste this as the LAST event inside the Monster Jumpscare group (after its JS code).\nTIMELINE: 4 barbed biological hook-spikes burst out of the parasite and THRUST THROUGH THE CAMERA LENS (Cfg_JS_HookAt) -> blood + slime + mucus threads -> body hoisted (Cfg_JS_HkLift) -> 4 ground slams that fling the player LEFT / RIGHT (Cfg_JS_Slam1..4, alternating sides, Cfg_JS_HkSide = sideways distance) -> hoisted again -> FINAL SLAM = NECK SNAP (Cfg_JS_NeckAt).\nOUTPUT VARIABLES: JS_Slam (pulse after each slam), JS_SlamN (0..5), JS_HkSide (-1.25..1.25 current left/right swing), JS_Pierce, JS_Hooked (0..1), JS_HkLift, JS_HkFall, JS_HkH, JS_HkSX/SY (world camera offsets).\nSETTINGS: Cfg_JS_Hooks=0 disables all, Cfg_JS_HookVisual=0 = movement only (no 3D spikes / slime), Cfg_JS_HkSide (lower it if the camera clips walls), Cfg_JS_HkLook, Cfg_JS_SlamFall, Cfg_JS_HkRest. Respects Cfg_JS_Safe / Quality / FlashScale / SynthAudio / Volume."},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"SceneJustBegins"},"parameters":[""]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_Hooks","=","1"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_HookVisual","=","1"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_HookAt","=","2.2"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_HookStag","=","0.16"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_HookDur","=","0.16"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_HkLift","=","60"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_HkLook","=","0.6"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_HkSide","=","16"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_Slam1","=","4.6"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_Slam2","=","5.8"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_Slam3","=","7.0"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_Slam4","=","8.2"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_SlamFall","=","0.13"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_HkRest","=","0.45"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_RiseSpeed","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_SqTime","=","7.5"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_NeckAt","=","9.6"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_EndTime","=","12.2"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_HkH","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_HkPitch","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_HkRoll","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_HkYaw","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_HkFov","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_HkSX","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_HkSY","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_HkSide","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_HkLift","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_HkFall","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_Slam","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_SlamN","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_Pierce","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_Hooked","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["JS_HkD","=","0"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["JS_Active","=","1"]},{"type":{"value":"BuiltinCommonInstructions::Once"},"parameters":[]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["JS_HkD","=","max(0, JS_Z1 + Cfg_JS_LiftHeight - (Player.Object3D::Z() + Cfg_JS_MinCamH))"]}]},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["(function () {","\"use strict\";","var S = runtimeScene, G = S.getGame();","var W = window.__JSFX || (window.__JSFX = {});","var K = W.hk || (W.hk = { scene: null, err: 0, dead: false });","function O(n, d) { var a = S.getVariables(), b = G.getVariables(); if (a.has(n)) return a.get(n).getAsNumber(); if (b.has(n)) return b.get(n).getAsNumber(); return d; }","function SV(n, x) { S.getVariables().get(n).setNumber(x); }","var clamp = function (x, a, b) { return x < a ? a : (x > b ? b : x); };","var sm = function (x) { x = clamp(x, 0, 1); return x * x * (3 - 2 * x); };","var rnd = Math.random, TAU = Math.PI * 2;","var OUT = [\"JS_HkH\", \"JS_HkPitch\", \"JS_HkRoll\", \"JS_HkYaw\", \"JS_HkFov\", \"JS_HkSX\", \"JS_HkSY\", \"JS_HkSide\", \"JS_HkLift\", \"JS_HkFall\", \"JS_Slam\", \"JS_SlamN\", \"JS_Pierce\", \"JS_Hooked\"];","function zero() { for (var i = 0; i < OUT.length; i++) SV(OUT[i], 0); }","function hide() { if (K.rc3) K.rc3.style.display = \"none\"; if (K.c2) K.c2.style.display = \"none\"; }","function dispose() {","  try {","    if (K.rc3 && K.rc3.parentNode) K.rc3.parentNode.removeChild(K.rc3);","    if (K.h3 && K.h3.rdr) K.h3.rdr.dispose();","    if (K.c2 && K.c2.parentNode) K.c2.parentNode.removeChild(K.c2);","  } catch (e) {}","  K.h3 = null; K.rc3 = null; K.c2 = null; K.x2 = null; K.h3Off = false;","}","try { if (K.dead) { zero(); hide(); } else run(); } catch (e0) { K.err++; console.error(\"[HooksFX] error:\", e0); hide(); zero(); if (K.err > 10) K.dead = true; }","","// ---------- audio (re-uses the synth context created by the main jumpscare script) ----------","function nz(t0, dur, ft, f0, f1, q, g0, atk) {","  var a = W.ac, s = a.createBufferSource(), f = a.createBiquadFilter(), g = a.createGain();","  s.buffer = W.aNoise; s.loop = true; f.type = ft; f.Q.value = q;","  f.frequency.setValueAtTime(f0, t0); f.frequency.exponentialRampToValueAtTime(Math.max(20, f1), t0 + dur);","  g.gain.setValueAtTime(0.0001, t0); g.gain.linearRampToValueAtTime(g0, t0 + atk); g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);","  s.connect(f); f.connect(g); g.connect(W.aLp); s.start(t0); s.stop(t0 + dur + 0.05);","}","function tn(t0, dur, type, f0, f1, g0, atk) {","  var a = W.ac, o = a.createOscillator(), g = a.createGain();","  o.type = type; o.frequency.setValueAtTime(f0, t0); o.frequency.exponentialRampToValueAtTime(Math.max(10, f1), t0 + dur);","  g.gain.setValueAtTime(0.0001, t0); g.gain.linearRampToValueAtTime(g0, t0 + atk); g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);","  o.connect(g); g.connect(W.aLp); o.start(t0); o.stop(t0 + dur + 0.05);","}","function au() { return (O(\"Cfg_JS_SynthAudio\", 1) === 1 && W.ac && W.aNoise && W.aLp) ? W.ac : null; }","// wet organic stab: squelch + flesh tear + low thud + bubble pops","function sPierce() {","  var a = au(); if (!a) return; var t = a.currentTime + 0.002, i;","  nz(t, 0.16, \"bandpass\", 1400, 320, 3, 0.9, 0.002); nz(t, 0.35, \"lowpass\", 900, 100, 1, 0.8, 0.004);","  tn(t, 0.28, \"sine\", 150, 45, 0.8, 0.003); nz(t + 0.04, 0.5, \"bandpass\", 700, 220, 2, 0.4, 0.03);","  for (i = 0; i < 3; i++) tn(t + 0.06 + i * 0.07 + rnd() * 0.03, 0.08, \"sine\", 280 + rnd() * 200, 800 + rnd() * 400, 0.12, 0.004);","}","function sWrithe(v) {","  var a = au(); if (!a) return; var t = a.currentTime + 0.002;","  nz(t, 0.3, \"bandpass\", 420, 180, 3, 0.22 * v, 0.05); tn(t, 0.3, \"sawtooth\", 62, 52, 0.05 * v, 0.06);","}","function sFall() { var a = au(); if (!a) return; var t = a.currentTime + 0.002; nz(t, 0.16, \"bandpass\", 2400, 300, 1.2, 0.5, 0.03); }","function sSlam(p) {","  var a = au(); if (!a) return; var t = a.currentTime + 0.002, i;","  tn(t, 1.3, \"sine\", 95, 22, Math.min(1.2, 0.9 * p), 0.003); tn(t, 0.6, \"triangle\", 60, 25, 0.7, 0.003);","  nz(t, 0.7, \"lowpass\", 3000, 90, 0.8, Math.min(1.2, 0.9 * p), 0.002);","  for (i = 0; i < 6; i++) nz(t + i * 0.035 + rnd() * 0.02, 0.06, \"bandpass\", 2000 + rnd() * 3000, 700, 3, 0.8, 0.001);","  nz(t + 0.05, 0.6, \"bandpass\", 900, 250, 2, 0.5, 0.02); nz(t + 0.05, 1.1, \"bandpass\", 500, 150, 1, 0.35, 0.1);","}","","// ---------- parasite flesh texture ----------","function mkTex() {","  var NN = 256, c = document.createElement(\"canvas\"); c.width = c.height = NN; var x = c.getContext(\"2d\");","  var sd = 987654; var r = function () { sd = (sd * 16807) % 2147483647; return sd / 2147483647; };","  x.fillStyle = \"#6e4a46\"; x.fillRect(0, 0, NN, NN);","  var cols = [\"150,80,70\", \"100,36,42\", \"170,130,100\", \"110,120,60\", \"84,40,66\"], i, j;","  for (i = 0; i < 60; i++) { var px = r() * NN, py = r() * NN, rad = 18 + r() * 60, g = x.createRadialGradient(px, py, 0, px, py, rad), cl = cols[i % 5];","    g.addColorStop(0, \"rgba(\" + cl + \",.5)\"); g.addColorStop(1, \"rgba(\" + cl + \",0)\"); x.fillStyle = g; x.fillRect(px - rad, py - rad, rad * 2, rad * 2); }","  x.strokeStyle = \"rgba(70,8,26,.8)\"; x.lineCap = \"round\";","  for (i = 0; i < 26; i++) { var qx = r() * NN, qy = r() * NN, an = r() * TAU; x.lineWidth = 1 + r() * 2.5; x.beginPath(); x.moveTo(qx, qy);","    for (j = 0; j < 14; j++) { an += (r() - 0.5) * 0.8; qx += Math.cos(an) * 10; qy += Math.sin(an) * 10; x.lineTo(qx, qy); } x.stroke(); }","  for (i = 0; i < 34; i++) { var ax = r() * NN, ay = r() * NN, ar = 3 + r() * 9, g3 = x.createRadialGradient(ax, ay, 0, ax, ay, ar);","    g3.addColorStop(0, \"rgba(236,222,150,.95)\"); g3.addColorStop(1, \"rgba(70,22,26,.9)\"); x.fillStyle = g3; x.beginPath(); x.arc(ax, ay, ar, 0, TAU); x.fill(); }","  for (i = 0; i < 6; i++) { var mx = r() * NN, my = r() * NN, mr = 8 + r() * 8; x.fillStyle = \"#1a0006\"; x.beginPath(); x.arc(mx, my, mr, 0, TAU); x.fill(); x.fillStyle = \"#e4d8b8\";","    for (j = 0; j < 10; j++) { var ta = j / 10 * TAU; x.beginPath(); x.moveTo(mx + Math.cos(ta - 0.15) * mr * 0.85, my + Math.sin(ta - 0.15) * mr * 0.85); x.lineTo(mx + Math.cos(ta) * mr * 0.35, my + Math.sin(ta) * mr * 0.35); x.lineTo(mx + Math.cos(ta + 0.15) * mr * 0.85, my + Math.sin(ta + 0.15) * mr * 0.85); x.fill(); } }","  var tx = new THREE.CanvasTexture(c); tx.wrapS = tx.wrapT = THREE.RepeatWrapping; if (THREE.SRGBColorSpace) tx.colorSpace = THREE.SRGBColorSpace; return tx;","}","","// ---------- 3D: barbed biological hook-spikes that thrust through the camera lens ----------","var SEG = 48, RAD = 10;","function build3D(cv) {","  var V3 = THREE.Vector3, i, j, b;","  var rc = document.createElement(\"canvas\");","  rc.style.cssText = \"position:fixed;left:0;top:0;pointer-events:none;z-index:2147482998;display:none;\";","  (cv.parentNode || document.body).appendChild(rc);","  var rdr = new THREE.WebGLRenderer({ canvas: rc, alpha: true, antialias: true, premultipliedAlpha: true });","  rdr.setClearColor(0x000000, 0);","  var scn = new THREE.Scene(), cam = new THREE.PerspectiveCamera(58, 1, 0.05, 500);","  scn.add(cam); scn.add(new THREE.AmbientLight(0xffffff, 0.5));","  var dl = new THREE.DirectionalLight(0xffb09a, 1.5); dl.position.set(-3, 6, 4); scn.add(dl);","  var dl2 = new THREE.DirectionalLight(0xa8c0ff, 0.7); dl2.position.set(5, 2, 3); scn.add(dl2);","  var tx = mkTex();","  var flesh = new THREE.MeshPhysicalMaterial({ map: tx, bumpMap: tx, bumpScale: 2, roughness: 0.3, metalness: 0, clearcoat: 1, clearcoatRoughness: 0.12, emissive: new THREE.Color(0x2a0808), emissiveMap: tx, emissiveIntensity: 0.55, fog: false });","  var bone = new THREE.MeshStandardMaterial({ color: 0xd9ccaa, emissive: 0x2b2316, roughness: 0.28 });","  var slime = new THREE.MeshPhysicalMaterial({ color: 0xc2cf6a, emissive: 0x38410d, roughness: 0.05, transparent: true, opacity: 0.6, depthWrite: false, clearcoat: 1 });","  var barbG = new THREE.ConeGeometry(0.1, 0.7, 6); barbG.translate(0, 0.35, 0);","  var dripG = new THREE.CylinderGeometry(0.018, 0.012, 1, 5); dripG.translate(0, -0.5, 0);","  var beadG = new THREE.SphereGeometry(0.045, 8, 6);","  var CF = [","    { tip: [-1.15, -0.75, 1.2], base: [-14, 9, -75], ph: 0.4 },","    { tip: [1.2, -0.85, 1.2], base: [15, 8, -75], ph: 2.1 },","    { tip: [-0.45, -1.25, 1.0], base: [-9, -3, -70], ph: 4.0 },","    { tip: [0.55, -1.35, 1.0], base: [8, -4, -70], ph: 5.3 }];","  var Yv = new V3(0, 1, 0), hooks = [];","  for (i = 0; i < CF.length; i++) {","    var cf = CF[i], bs = new V3(cf.base[0], cf.base[1], cf.base[2]), tp = new V3(cf.tip[0], cf.tip[1], cf.tip[2]);","    var dir = new V3().subVectors(tp, bs).normalize(), R = new V3().crossVectors(dir, Yv).normalize(), U = new V3().crossVectors(R, dir).normalize();","    var n = (SEG + 1) * (RAD + 1), pos = new Float32Array(n * 3), nor = new Float32Array(n * 3), uv = new Float32Array(n * 2), idx = [];","    for (j = 0; j < SEG; j++) for (b = 0; b < RAD; b++) { var a0 = j * (RAD + 1) + b, a1 = a0 + RAD + 1; idx.push(a0, a1, a0 + 1, a1, a1 + 1, a0 + 1); }","    for (j = 0; j <= SEG; j++) for (b = 0; b <= RAD; b++) uv[(j * (RAD + 1) + b) * 2 + 1] = b / RAD;","    var geo = new THREE.BufferGeometry();","    geo.setAttribute(\"position\", new THREE.BufferAttribute(pos, 3)); geo.setAttribute(\"normal\", new THREE.BufferAttribute(nor, 3)); geo.setAttribute(\"uv\", new THREE.BufferAttribute(uv, 2)); geo.setIndex(idx);","    var mesh = new THREE.Mesh(geo, flesh); mesh.frustumCulled = false; mesh.visible = false; scn.add(mesh);","    var barbs = [], drips = [];","    for (j = 0; j < 9; j++) { var bm = new THREE.Mesh(barbG, bone); bm.visible = false; bm.frustumCulled = false; scn.add(bm); barbs.push({ m: bm, u: 0.78 + j * 0.026, an: j * 2.4 + i }); }","    for (j = 0; j < 5; j++) { var cy = new THREE.Mesh(dripG, slime), bd = new THREE.Mesh(beadG, slime); cy.visible = bd.visible = false; cy.frustumCulled = bd.frustumCulled = false; scn.add(cy); scn.add(bd);","      drips.push({ c: cy, b: bd, u: 0.72 + j * 0.05, ph: rnd(), sp: 0.25 + rnd() * 0.25 }); }","    hooks.push({ base: bs, tip: tp, dir: dir, R: R, U: U, ph: cf.ph, pos: pos, nor: nor, uv: uv, geo: geo, mesh: mesh, barbs: barbs, drips: drips,","      pts: Array.from({ length: SEG + 1 }, function () { return new V3(); }), rad: new Float32Array(SEG + 1), arc: new Float32Array(SEG + 1), f: 0 });","  }","  return { rc: rc, rdr: rdr, scn: scn, cam: cam, hooks: hooks, V: new V3(), Q: new THREE.Quaternion(), Yv: Yv,","    cosT: Array.from({ length: RAD + 1 }, function (_, q) { return Math.cos(q / RAD * TAU); }), sinT: Array.from({ length: RAD + 1 }, function (_, q) { return Math.sin(q / RAD * TAU); }) };","}","","// rebuild one hook tube + its barbs and drips for this frame","function updHook(g, o, f, T, amp, sideN, sl, lift) {","  var i, j, P, s, u, w, w2, r, pt, V = g.V, Q = g.Q;","  for (i = 0; i <= SEG; i++) {","    u = i / SEG; s = u * f; P = o.pts[i];","    P.copy(o.base).addScaledVector(o.dir, 0); P.x = o.base.x + (o.tip.x - o.base.x) * s; P.y = o.base.y + (o.tip.y - o.base.y) * s; P.z = o.base.z + (o.tip.z - o.base.z) * s;","    w = amp * Math.sin(u * 9 - T * 8 + o.ph) * Math.pow(1 - s, 1.2); w2 = amp * 0.7 * Math.cos(u * 7 - T * 6 + o.ph) * Math.pow(1 - s, 1.2);","    P.addScaledVector(o.R, w).addScaledVector(o.U, w2); P.x += -sideN * 2.5 * (1 - s) * (1 - s);","  }","  o.arc[0] = 0; for (i = 1; i <= SEG; i++) o.arc[i] = o.arc[i - 1] + o.pts[i].distanceTo(o.pts[i - 1]);","  for (i = 0; i <= SEG; i++) {","    u = i / SEG; s = u * f; pt = o.pts[i];","    r = (0.15 + 0.85 * Math.pow(1 - s, 1.4)) * (1 + 0.08 * Math.sin(u * 30 - T * 7) + 0.2 * sl) * (1 - 0.85 * sm((u - 0.88) / 0.12));","    o.rad[i] = r;","    for (j = 0; j <= RAD; j++) {","      var cx = g.cosT[j], sx = g.sinT[j], th = j / RAD * TAU, lump = 1 + 0.11 * Math.sin(3 * th + o.arc[i] * 0.3) + 0.06 * Math.sin(5 * th - o.arc[i] * 0.5 + T * 0.7);","      var nx = o.R.x * cx + o.U.x * sx, ny = o.R.y * cx + o.U.y * sx, nzz = o.R.z * cx + o.U.z * sx, k3 = (i * (RAD + 1) + j) * 3, rr = r * lump;","      o.pos[k3] = pt.x + nx * rr; o.pos[k3 + 1] = pt.y + ny * rr; o.pos[k3 + 2] = pt.z + nzz * rr; o.nor[k3] = nx; o.nor[k3 + 1] = ny; o.nor[k3 + 2] = nzz;","      o.uv[(i * (RAD + 1) + j) * 2] = o.arc[i] / 6;","    }","  }","  o.geo.attributes.position.needsUpdate = true; o.geo.attributes.normal.needsUpdate = true; o.geo.attributes.uv.needsUpdate = true;","  // barbs: curved bone thorns pointing back toward the base","  for (j = 0; j < o.barbs.length; j++) {","    var bb = o.barbs[j], bi = clamp(Math.round(bb.u * f * SEG / Math.max(0.001, f)), 1, SEG - 1), bp = o.pts[bi], br = o.rad[bi];","    var ca = Math.cos(bb.an), sa = Math.sin(bb.an);","    V.set(o.R.x * ca + o.U.x * sa, o.R.y * ca + o.U.y * sa, o.R.z * ca + o.U.z * sa);","    bb.m.position.copy(bp).addScaledVector(V, br * 0.9);","    V.multiplyScalar(0.85).addScaledVector(o.dir, -0.55).normalize(); Q.setFromUnitVectors(g.Yv, V); bb.m.quaternion.copy(Q);","    bb.m.scale.setScalar(Math.max(0.2, br * 6)); bb.m.visible = f > 0.3 && bb.u * f > 0.5;","  }","  // slime drips running off the spike","  for (j = 0; j < o.drips.length; j++) {","    var dd = o.drips[j], di = clamp(Math.round(dd.u * SEG), 1, SEG - 1), dp = o.pts[di], dr = o.rad[di];","    var cyc = (T * dd.sp * (1 + 0.8 * lift) + dd.ph) % 1, Ln = 0.8, len, by;","    if (cyc < 0.7) { len = Ln * sm(cyc / 0.7); by = dp.y - dr - len; } else { var fq = (cyc - 0.7) / 0.3; len = Ln * (1 - fq); by = dp.y - dr - Ln - 6 * fq * fq; }","    dd.c.position.set(dp.x, dp.y - dr * 0.9, dp.z + dr * 0.3); dd.c.scale.set(1, Math.max(0.001, len), 1);","    dd.b.position.set(dp.x, by, dp.z + dr * 0.3); dd.c.visible = dd.b.visible = f > 0.9;","  }","  o.mesh.visible = f > 0.02;","}","","function run() {","  if (O(\"Cfg_JS_Hooks\", 1) !== 1 || O(\"JS_Active\", 0) !== 1) { zero(); hide(); return; }","  var cv = G.getRenderer().getCanvas(); if (!cv) return;","  if (K.scene !== S) { dispose(); K.scene = S; K.fl = {}; K.spurts = []; K.drips = []; K.nSeen = 0; K.wT = 0; K.dT = 0; }","  var T = O(\"JS_T\", 0), dt = Math.min(0.1, S.getElapsedTime() / 1000), i, k;","","  // ===================== PHYSICS TIMELINE (lift / slam left-right) =====================","  var hookAt = O(\"Cfg_JS_HookAt\", 2.2), stag = O(\"Cfg_JS_HookStag\", 0.16), hdur = Math.max(0.05, O(\"Cfg_JS_HookDur\", 0.16));","  var NH = 4, pierceEnd = hookAt + (NH - 1) * stag + hdur;","  var liftAt = O(\"Cfg_JS_HkLiftAt\", pierceEnd + 0.35);","  var top = O(\"Cfg_JS_HkLift\", 60), D = Math.max(0, O(\"JS_HkD\", 60)) * 0.985;","  var fd = Math.max(0.05, O(\"Cfg_JS_SlamFall\", 0.13)), rest = Math.max(0.25, O(\"Cfg_JS_HkRest\", 0.45)), hang = 0.2;","  var NS = 5, SL = [O(\"Cfg_JS_Slam1\", 4.6), O(\"Cfg_JS_Slam2\", 5.8), O(\"Cfg_JS_Slam3\", 7.0), O(\"Cfg_JS_Slam4\", 8.2), O(\"Cfg_JS_NeckAt\", 9.6)];","  var PW = [1, 1.15, 1.3, 1.5, 1.9], DR = [-1, 1, -1, 1, -1], AS = [1, 1, 1, 1, 0.6], A = O(\"Cfg_JS_HkSide\", 16);","  var nSl = 0, since = 99;","  for (i = 0; i < NS; i++) if (T >= SL[i]) { nSl = i + 1; since = T - SL[i]; }","  var bounce = function (tt, a) { return a * Math.exp(-9 * tt) * Math.abs(Math.sin(tt * 15)); };","  var xAfter = function (j, ss) { return DR[j] * A * AS[j] * (1 + 0.25 * (1 - Math.exp(-ss * 8))); };","  var h = 0, lift = 0, fall = 0, x = 0;","  if (T >= liftAt) {","    if (nSl >= NS) { h = -D + bounce(since, 0.1 * top); x = xAfter(NS - 1, since); }","    else {","      var s0 = nSl === 0 ? liftAt : SL[nSl - 1] + rest, sN = SL[nSl], tp = top * (1 + 0.15 * nSl);","      var xw = -DR[nSl] * A * AS[nSl] * 0.7, xp = nSl === 0 ? 0 : xAfter(nSl - 1, rest);","      if (nSl > 0 && T < s0) {","        h = -D * (1 - sm((since - 0.12) / (rest - 0.12))) + bounce(since, 0.1 * top); x = xAfter(nSl - 1, since);","      } else if (T < sN - fd) {","        var riseEnd = sN - fd - hang, u = clamp((T - s0) / Math.max(0.2, riseEnd - s0), 0, 1);","        lift = sm(u); h = tp * lift + 6 * sm((T - riseEnd) / hang);","        x = xp + (xw - xp) * lift + 2.5 * Math.sin(T * 6.1) * lift;","      } else {","        var v = clamp((T - (sN - fd)) / fd, 0, 1); fall = 1; lift = 1 - v * v;","        h = (tp + 6) + (-D - (tp + 6)) * v * v; x = xw + (DR[nSl] * A * AS[nSl] - xw) * v * v;","      }","    }","  }","  var slP = nSl > 0 ? PW[nSl - 1] : 0, dCur = nSl > 0 ? DR[nSl - 1] : 0, sl = nSl > 0 ? Math.exp(-since * 7) * slP : 0;","  var pierce = 0;","  for (i = 0; i < NH; i++) { var th0 = hookAt + i * stag + hdur; if (T >= th0) pierce += Math.exp(-(T - th0) * 10); }","  if (T >= liftAt) pierce += 1.4 * Math.exp(-(T - liftAt) * 8);","  pierce = Math.min(pierce, 2);","  var hooked = clamp((T - hookAt) / Math.max(0.1, pierceEnd - hookAt), 0, 1);","  var camD = Math.max(1, O(\"Cfg_JS_CamDist\", 38)), ang = Math.atan2(h, camD) * 57.2958;","  var look = clamp(O(\"Cfg_JS_HkLook\", 0.6) * ang, -38, 45), sideN = A > 0 ? x / A : 0;","  var hkPitch = -look - 14 * slP * (nSl > 0 ? Math.exp(-since * 9) : 0) - 2.5 * pierce;","  var hkRoll = lift * (6 * Math.sin(T * 2.3) + 2.5 * Math.sin(T * 5.3)) - sideN * 9 + dCur * 9 * sl * Math.sin(since * 20) + 3 * pierce * Math.sin(T * 40);","  var hkYaw = lift * 4 * Math.sin(T * 1.7 + 1) + sl * 3 * Math.sin(since * 25) + sideN * 5;","  var hkFov = 14 * sl - 5 * lift + 3 * pierce - 6 * fall;","  var ty = O(\"JS_TYaw\", 0) * Math.PI / 180;","  SV(\"JS_HkH\", h); SV(\"JS_HkPitch\", hkPitch); SV(\"JS_HkRoll\", hkRoll); SV(\"JS_HkYaw\", hkYaw); SV(\"JS_HkFov\", hkFov);","  SV(\"JS_HkSX\", x * Math.cos(ty)); SV(\"JS_HkSY\", x * Math.sin(ty)); SV(\"JS_HkSide\", sideN);","  SV(\"JS_HkLift\", lift); SV(\"JS_HkFall\", fall); SV(\"JS_Slam\", sl); SV(\"JS_SlamN\", nSl); SV(\"JS_Pierce\", pierce); SV(\"JS_Hooked\", hooked);","","  // ===================== VISUALS =====================","  if (O(\"Cfg_JS_HookVisual\", 1) !== 1 || K.h3Off) return;","  if (T < hookAt - 0.3) return;","  if (typeof THREE === \"undefined\" || !THREE.WebGLRenderer) { K.h3Off = true; return; }","  var Q = clamp(Math.round(O(\"Cfg_JS_Quality\", 2)), 0, 2), SAFE = O(\"Cfg_JS_Safe\", 0) === 1;","  var fK = O(\"Cfg_JS_FlashScale\", 1) * (SAFE ? 0.3 : 1);","  var r = cv.getBoundingClientRect(), aspect = r.width / Math.max(1, r.height);","  var fovF = clamp(O(\"JS_Fov\", 58) + hkFov, 25, 110), tanH = Math.tan(fovF * Math.PI / 360);","  var EndT = O(\"Cfg_JS_EndTime\", 12.2);","  var vis = (1 - sm((T - (EndT - 0.6)) / 0.35)) * (1 - sm((T - SL[NS - 1] - 0.3) / 0.8));","  try { if (!K.h3) K.h3 = build3D(cv); } catch (eb) { K.h3Off = true; console.error(\"[HooksFX] 3D disabled:\", eb); return; }","  var hk = K.h3, pw = Math.max(2, Math.round(r.width * [0.6, 0.8, 1][Q])), ph = Math.max(2, Math.round(r.height * [0.6, 0.8, 1][Q]));","  var rc = hk.rc; rc.style.display = \"block\"; rc.style.left = r.left + \"px\"; rc.style.top = r.top + \"px\"; rc.style.width = r.width + \"px\"; rc.style.height = r.height + \"px\"; rc.style.opacity = vis.toFixed(3);","  if (hk.pw !== pw || hk.ph !== ph) { hk.rdr.setSize(pw, ph, false); hk.pw = pw; hk.ph = ph; hk.cam.aspect = pw / ph; }","  hk.cam.fov = fovF; hk.cam.updateProjectionMatrix();","","  var tension = fall ? 0.05 : 0.12 + 0.88 * sm(lift * 1.6);","  var amp = 0.5 + 2.2 * (1 - tension) + 1.2 * sl + 0.4 * pierce;","  for (i = 0; i < NH; i++) {","    var o = hk.hooks[i], t0 = hookAt + i * stag, tHit = t0 + hdur, uu = clamp((T - t0) / hdur, 0, 1);","    var fh = 1 - Math.pow(1 - uu, 3);","    if (uu <= 0) { o.mesh.visible = false; for (k = 0; k < o.barbs.length; k++) o.barbs[k].m.visible = false; for (k = 0; k < o.drips.length; k++) o.drips[k].c.visible = o.drips[k].b.visible = false; continue; }","    updHook(hk, o, fh, T, amp, sideN, sl, lift);","    if (uu >= 1 && !K.fl[\"h\" + i]) {","      K.fl[\"h\" + i] = 1; sPierce();","      var zc = -1.4, sp0 = (zc - o.base.z) / (o.tip.z - o.base.z);","      var ex = o.base.x + (o.tip.x - o.base.x) * sp0, ey = o.base.y + (o.tip.y - o.base.y) * sp0;","      var ndx = clamp(ex / (-zc * tanH * aspect), -0.93, 0.93), ndy = clamp(ey / (-zc * tanH), -0.93, 0.93);","      var rs = []; for (k = 0; k < 18; k++) rs.push({ a: rnd() * TAU, l: 0.4 + rnd() * 0.6 });","      K.spurts.push({ x: 0.5 + ndx * 0.5, y: 0.5 - ndy * 0.5, t: T, rs: rs, dr: 0.6 + rnd() * 0.8 });","      for (k = 0; k < 4; k++) K.drips.push({ x: 0.5 + ndx * 0.5 + (rnd() - 0.5) * 0.1, y: 0.5 - ndy * 0.5 - rnd() * 0.08, vy: 0.01 + rnd() * 0.03, len: 0.05 + rnd() * 0.1, w: 0.004 + rnd() * 0.006 });","      if (W.splats) W.splats.push({ x: 0.5 + ndx * 0.5, y: 0.5 - ndy * 0.5, r: 0.05 + rnd() * 0.04, t: W.age || 0, drip: 0.1 + rnd() * 0.2, sp: 0.05, sat: [] });","    }","  }","  hk.rdr.render(hk.scn, hk.cam);","","  // ---- audio triggers ----","  if (fall && !K.fl[\"f\" + nSl]) { K.fl[\"f\" + nSl] = 1; sFall(); }","  if (nSl > K.nSeen) {","    K.nSeen = nSl; sSlam(PW[nSl - 1]);","    for (k = 0; k < 3; k++) if (W.splats) W.splats.push({ x: 0.2 + rnd() * 0.6, y: 0.4 + rnd() * 0.5, r: 0.04 + rnd() * 0.05, t: W.age || 0, drip: 0.1 + rnd() * 0.25, sp: 0.05, sat: [] });","    for (k = 0; k < 8; k++) K.drips.push({ x: 0.05 + rnd() * 0.9, y: rnd() * 0.5, vy: 0.02 + rnd() * 0.05, len: 0.06 + rnd() * 0.14, w: 0.004 + rnd() * 0.008 });","  }","  K.wT -= dt; K.dT -= dt;","  if (lift > 0.02 && lift < 0.98 && !fall && K.wT <= 0) { K.wT = 0.28; sWrithe(0.4 + 0.6 * lift); }","  if (K.spurts.length && K.dT <= 0 && K.drips.length < 60) {","    K.dT = 0.35 - 0.2 * lift; var sq = K.spurts[(rnd() * K.spurts.length) | 0];","    K.drips.push({ x: sq.x + (rnd() - 0.5) * 0.12, y: Math.max(0.05, sq.y - 0.12 - rnd() * 0.2), vy: 0.01 + rnd() * 0.03, len: 0.05 + rnd() * 0.12, w: 0.004 + rnd() * 0.007 });","  }","","  // ===================== 2D: BLOOD / SECRETIONS / SLIME STRANDS / DUST / SHOCKWAVE =====================","  if (!K.c2 || !K.c2.isConnected) {","    var c = document.createElement(\"canvas\");","    c.style.cssText = \"position:fixed;left:0;top:0;pointer-events:none;z-index:2147483001;display:none;\";","    (cv.parentNode || document.body).appendChild(c); K.c2 = c; K.x2 = c.getContext(\"2d\");","    K.sk = []; for (k = 0; k < 20; k++) K.sk.push({ x: rnd(), l: 0.2 + rnd() * 0.3, s: 1 + rnd() * 1.5 });","  }","  var R2 = [0.4, 0.5, 0.7][Q], w = Math.max(2, Math.round(r.width * R2)), hh = Math.max(2, Math.round(r.height * R2));","  var c2 = K.c2, x2 = K.x2;","  c2.style.display = \"block\"; c2.style.left = r.left + \"px\"; c2.style.top = r.top + \"px\"; c2.style.width = r.width + \"px\"; c2.style.height = r.height + \"px\"; c2.style.opacity = vis.toFixed(3);","  if (c2.width !== w || c2.height !== hh) { c2.width = w; c2.height = hh; }","  x2.setTransform(1, 0, 0, 1, 0, 0); x2.clearRect(0, 0, w, hh); x2.globalAlpha = 1; x2.lineCap = \"round\";","  var gr;","  if (fall) {","    x2.strokeStyle = \"rgba(255,230,220,0.22)\"; x2.lineWidth = Math.max(1, hh * 0.004);","    for (k = 0; k < K.sk.length; k++) { var sk = K.sk[k], sx = ((sk.x + T * 0.7 * sk.s) % 1) * w, sy = ((T * 9 * sk.s) % 1) * hh, ln = hh * sk.l; x2.beginPath(); x2.moveTo(sx, sy - ln); x2.lineTo(sx, sy); x2.stroke(); }","  }","  // blood sprays + oozing wounds + yellow-green slime smears at each entry","  for (i = 0; i < K.spurts.length; i++) {","    var sp = K.spurts[i], ag = T - sp.t, px = sp.x * w, py = sp.y * hh;","    var orad = hh * 0.07 * Math.min(1, ag * 3) * (1 + 0.25 * sl);","    gr = x2.createRadialGradient(px, py, 0, px, py, orad + 1); gr.addColorStop(0, \"rgba(60,0,4,0.7)\"); gr.addColorStop(1, \"rgba(60,0,4,0)\");","    x2.fillStyle = gr; x2.fillRect(px - orad - 1, py - orad - 1, orad * 2 + 2, orad * 2 + 2);","    var srad = hh * 0.13 * Math.min(1, ag * 1.5);","    gr = x2.createRadialGradient(px, py, 0, px, py, srad + 1); gr.addColorStop(0, \"rgba(180,200,90,0.28)\"); gr.addColorStop(1, \"rgba(180,200,90,0)\");","    x2.fillStyle = gr; x2.fillRect(px - srad - 1, py - srad - 1, srad * 2 + 2, srad * 2 + 2);","    if (ag < 1) {","      x2.strokeStyle = \"rgba(140,0,8,\" + (0.9 * (1 - ag)).toFixed(3) + \")\"; x2.lineWidth = Math.max(1, hh * 0.008 * (1 - ag));","      for (k = 0; k < sp.rs.length; k++) { var rr = sp.rs[k], l2 = hh * 0.22 * rr.l * Math.sqrt(ag);","        x2.beginPath(); x2.moveTo(px + Math.cos(rr.a) * l2 * 0.2, py + Math.sin(rr.a) * l2 * 0.2); x2.lineTo(px + Math.cos(rr.a) * l2, py + Math.sin(rr.a) * l2 + hh * 0.12 * ag * ag * rr.l); x2.stroke(); }","    }","  }","  // saliva / mucus threads stretched between the entry points","  var PR = [[0, 1], [2, 3], [0, 2], [1, 3]];","  for (i = 0; i < PR.length; i++) {","    var sa = K.spurts[PR[i][0]], sb = K.spurts[PR[i][1]]; if (!sa || !sb) continue;","    var ax = sa.x * w, ay = sa.y * hh, bx = sb.x * w, by2 = sb.y * hh, mx = (ax + bx) / 2, my = (ay + by2) / 2 + hh * (0.07 + 0.05 * Math.sin(T * 2 + i)) + hh * 0.14 * (1 - lift) * Math.min(1, (T - Math.max(sa.t, sb.t)) * 1.5);","    x2.strokeStyle = \"rgba(185,205,100,0.38)\"; x2.lineWidth = Math.max(1.5, hh * 0.007); x2.beginPath(); x2.moveTo(ax, ay); x2.quadraticCurveTo(mx, my, bx, by2); x2.stroke();","    x2.strokeStyle = \"rgba(255,255,230,0.3)\"; x2.lineWidth = Math.max(1, hh * 0.002); x2.beginPath(); x2.moveTo(ax, ay - 1); x2.quadraticCurveTo(mx, my - 1, bx, by2 - 1); x2.stroke();","    for (k = 1; k <= 3; k++) { var tq = k / 4, qa = (1 - tq) * (1 - tq), qb = 2 * (1 - tq) * tq, qc = tq * tq;","      var bpx = qa * ax + qb * mx + qc * bx, bpy = qa * ay + qb * my + qc * by2 + hh * 0.004 * Math.sin(T * 3 + k);","      x2.fillStyle = \"rgba(190,210,100,0.45)\"; x2.beginPath(); x2.arc(bpx, bpy, Math.max(1.5, hh * 0.007), 0, TAU); x2.fill();","      x2.fillStyle = \"rgba(255,255,235,0.55)\"; x2.beginPath(); x2.arc(bpx - hh * 0.002, bpy - hh * 0.002, Math.max(0.7, hh * 0.002), 0, TAU); x2.fill(); }","  }","  // slime drips sliding down the lens","  for (i = K.drips.length - 1; i >= 0; i--) {","    var d = K.drips[i]; d.vy += dt * 0.04; d.y += d.vy * dt * 3;","    if (d.y - d.len > 1.1) { K.drips.splice(i, 1); continue; }","    var dx = d.x * w, dy = d.y * hh, dl = d.len * hh, dw = Math.max(1.5, d.w * hh);","    gr = x2.createLinearGradient(0, dy - dl, 0, dy); gr.addColorStop(0, \"rgba(175,195,85,0)\"); gr.addColorStop(1, \"rgba(175,195,85,0.5)\");","    x2.strokeStyle = gr; x2.lineWidth = dw; x2.beginPath(); x2.moveTo(dx, dy - dl); x2.lineTo(dx, dy); x2.stroke();","    x2.fillStyle = \"rgba(185,205,95,0.55)\"; x2.beginPath(); x2.arc(dx, dy, dw * 0.95, 0, TAU); x2.fill();","    x2.fillStyle = \"rgba(255,255,235,0.55)\"; x2.beginPath(); x2.arc(dx - dw * 0.3, dy - dw * 0.3, dw * 0.28, 0, TAU); x2.fill();","  }","  // ground impact: dust, red flash, shockwave ring","  if (nSl > 0 && sl > 0.01) {","    gr = x2.createLinearGradient(0, hh, 0, hh * 0.35); gr.addColorStop(0, \"rgba(150,130,110,\" + Math.min(0.7, 0.5 * sl).toFixed(3) + \")\"); gr.addColorStop(1, \"rgba(150,130,110,0)\");","    x2.fillStyle = gr; x2.fillRect(0, 0, w, hh);","    x2.fillStyle = \"rgba(255,40,30,\" + clamp(0.3 * sl * fK, 0, 0.5).toFixed(3) + \")\"; x2.fillRect(0, 0, w, hh);","    x2.strokeStyle = \"rgba(255,210,180,\" + clamp(0.6 * Math.exp(-since * 5), 0, 0.6).toFixed(3) + \")\"; x2.lineWidth = Math.max(2, hh * 0.02 * Math.exp(-since * 4));","    x2.beginPath(); x2.arc(w * (0.5 + 0.25 * dCur), hh * 0.78, since * 1.8 * hh, 0, TAU); x2.stroke();","    if (!SAFE && since < 0.04) { x2.fillStyle = \"rgba(0,0,0,\" + (0.8 * (1 - since / 0.04)).toFixed(3) + \")\"; x2.fillRect(0, 0, w, hh); }","  }","}","})();"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["JS_Active","=","1"]}],"actions":[{"type":{"value":"SetCameraCenterX"},"parameters":["","=","JS_CX + JS_HkSX","",""]},{"type":{"value":"SetCameraCenterY"},"parameters":["","=","JS_CY + JS_HkSY","",""]},{"type":{"value":"Scene3D::SetCameraZ"},"parameters":["","=","max(JS_CZ + JS_HkH, Player.Object3D::Z() + Cfg_JS_MinCamH)","",""]},{"type":{"value":"SetCameraAngle"},"parameters":["","=","JS_Yaw + JS_HkYaw","",""]},{"type":{"value":"Scene3D::SetCameraRotationX"},"parameters":["","=","JS_Pitch + JS_HkPitch","",""]},{"type":{"value":"Scene3D::SetCameraRotationY"},"parameters":["","=","JS_Roll + JS_HkRoll","",""]},{"type":{"value":"Scene3D::SetCameraFov"},"parameters":["","=","JS_Fov + JS_HkFov","",""]}]}],"parameters":[]},{"colorB":60,"colorG":60,"colorR":220,"creationTime":0,"name":"JUMPSCARE v7a - Layer FX + Depth of Field + Lens Stains","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"JUMPSCARE v7a - LAYER EFFECTS + DEPTH OF FIELD + LENS STAINS.\nPASTE AS THE LAST EVENT inside the 'Monster Jumpscare v6 PRO' group (after PARASITE HOOKS v2).\nREQUIRES these effects on the 3D layer (base layer by default), with EXACT names: JS_Bloom, JS_Glitch, JS_Noise, JS_Blur (Kawase), JS_Adjust (Color adjustment), DepthOfField. Missing ones are skipped (set Cfg_JS_FxDebug=1 to log them). The script disables them all at scene start and drives them from JS_Sq / JS_Crush / JS_Pierce / JS_Slam / JS_Death / JS_Tension.\nSETTINGS: Cfg_JS_FxScale (global strength), Cfg_JS_FxLayer (layer name, empty = base), Cfg_JS_DoF=0 off, DoFRange / DoFTrans / DoFMax / DoFBias (focus tuning), Cfg_JS_EdgeBlur=0 off (CSS edge blur around the monster face), Cfg_JS_Lens=0 disables persistent blood/slime on the lens (stains stay after each slam and get wiped at each blink). Respects Cfg_JS_Safe / Quality / FlashScale / GlitchScale."},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"SceneJustBegins"},"parameters":[""]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_FxScale","=","1"]},{"type":{"value":"SetStringVariable"},"parameters":["Cfg_JS_FxLayer","=","\"\""]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_FxDebug","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_DoF","=","1"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_DoFRange","=","40"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_DoFTrans","=","140"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_DoFMax","=","6"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_DoFBias","=","1"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_EdgeBlur","=","1"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_EdgeBlurMax","=","8"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_JS_Lens","=","1"]}]},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["(function () {","'use strict';","var S = runtimeScene, G = S.getGame();","var W = window.__JSFX || (window.__JSFX = {});","var F = W.fx7 || (W.fx7 = { scene: null, err: 0, dead: false, stains: [], smears: [], age: 0, on: {}, warned: {} });","var NAMES = ['JS_Bloom', 'JS_Glitch', 'JS_Noise', 'JS_Blur', 'JS_Adjust', 'DepthOfField'];","var rnd = Math.random, TAU = Math.PI * 2;","var clamp = function (x, a, b) { return x < a ? a : (x > b ? b : x); };","var sm = function (x) { x = clamp(x, 0, 1); return x * x * (3 - 2 * x); };","var lerp = function (a, b, t) { return a + (b - a) * t; };","var bump = function (u, c, wd, pk) { var d = (u - c) / wd; return pk * Math.exp(-d * d); };","","function O(n, d) { var a = S.getVariables(), b = G.getVariables(); if (a.has(n)) return a.get(n).getAsNumber(); if (b.has(n)) return b.get(n).getAsNumber(); return d; }","function OS(n, d) { var a = S.getVariables(), b = G.getVariables(); if (a.has(n)) return a.get(n).getAsString(); if (b.has(n)) return b.get(n).getAsString(); return d; }","function getLayer() { var nm = OS('Cfg_JS_FxLayer', ''); if (nm === '0') nm = ''; return S.hasLayer(nm) ? S.getLayer(nm) : null; }","function fxHas(L, nm) {","  var ok = false;","  try { ok = L.hasEffect(nm); } catch (e) { ok = false; }","  if (!ok && !F.warned[nm]) { F.warned[nm] = 1; if (O('Cfg_JS_FxDebug', 0) === 1) console.warn('[FX7] effect not found on layer: ' + nm); }","  return ok;","}","function fxEn(L, nm, on) {","  if (!fxHas(L, nm)) return false;","  if (F.on[nm] !== on) { L.enableEffect(nm, on); F.on[nm] = on; }","  return on;","}","function fxP(L, nm, p, v) { try { L.setEffectDoubleParameter(nm, p, v); } catch (e) {} }","","// distance camera -> monster face (world units), used as the depth-of-field focus","function faceDist(L) {","  var cx, cy, cz;","  try { cx = L.getCameraX(); cy = L.getCameraY(); cz = L.getCameraZ(); } catch (e) { return 60; }","  var dx = O('JS_MX', 0) - cx, dy = O('JS_MY', 0) - cy, dz = O('JS_FaceZ', 0) - cz;","  return Math.max(8, Math.sqrt(dx * dx + dy * dy + dz * dz));","}","","// persistent blood / slime stain on the lens (k: 0 blood, 1 slime)","function addStain(x, y, r, k, a, drip) {","  var st = { x: x, y: y, r: r, k: k, a: a, t0: F.age, drip: drip, len: 0, sp: 0.012 + rnd() * 0.03, sat: [], sx: 1, sy: 1, rot: 0 };","  var n = 4 + ((rnd() * 4) | 0), i, an, d;","  for (i = 0; i < n; i++) { an = rnd() * TAU; d = r * (1.1 + rnd() * 1.3); st.sat.push([Math.cos(an) * d, Math.sin(an) * d, r * (0.15 + rnd() * 0.3)]); }","  F.stains.push(st);","  if (F.stains.length > 70) F.stains.shift();","}","","// instant wipe on a blink: stains fade + smear, and leave wet streaks","function wipe(s) {","  var i, st, x0;","  for (i = F.stains.length - 1; i >= 0; i--) {","    st = F.stains[i]; st.a *= (1 - s); st.sx *= 1.25; st.sy *= 1.7; st.rot += (rnd() - 0.5) * 0.5; st.len *= 0.5;","    if (st.a < 0.05) F.stains.splice(i, 1);","  }","  for (i = 0; i < 2; i++) {","    x0 = 0.05 + rnd() * 0.5;","    F.smears.push({ x0: x0, y0: 0.1 + rnd() * 0.5, x1: x0 + 0.2 + rnd() * 0.4, y1: 0.35 + rnd() * 0.5, w: 0.035 + rnd() * 0.05, t: F.age, k: rnd() < 0.7 ? 0 : 1 });","  }","  if (F.smears.length > 10) F.smears.splice(0, F.smears.length - 10);","}","","function drawLens(w, h, a0, dt) {","  var x = F.x, i, j, st, ag, gr, R, px, py, al, ln, sm0;","  x.setTransform(1, 0, 0, 1, 0, 0); x.clearRect(0, 0, w, h); x.globalAlpha = 1; x.lineCap = 'round';","  for (i = 0; i < F.smears.length; i++) {","    sm0 = F.smears[i]; al = 0.32 * (1 - clamp((F.age - sm0.t) / 4, 0, 1)) * a0;","    if (al < 0.01) continue;","    x.strokeStyle = sm0.k === 0 ? 'rgba(90,0,6,' + al.toFixed(3) + ')' : 'rgba(165,188,76,' + (al * 0.7).toFixed(3) + ')';","    x.lineWidth = Math.max(2, sm0.w * h);","    x.beginPath(); x.moveTo(sm0.x0 * w, sm0.y0 * h);","    x.quadraticCurveTo((sm0.x0 + sm0.x1) * 0.5 * w, (sm0.y0 + sm0.y1) * 0.5 * h - h * 0.06, sm0.x1 * w, sm0.y1 * h);","    x.stroke();","  }","  for (i = 0; i < F.stains.length; i++) {","    st = F.stains[i]; ag = F.age - st.t0; if (ag < 0) continue;","    gr = Math.min(1, ag * 8); R = st.r * h * gr; px = st.x * w; py = st.y * h; al = st.a * a0;","    if (al < 0.01) continue;","    x.save(); x.translate(px, py); x.rotate(st.rot); x.scale(st.sx, st.sy);","    x.fillStyle = st.k === 0 ? 'rgba(96,0,6,' + (0.8 * al).toFixed(3) + ')' : 'rgba(168,190,78,' + (0.5 * al).toFixed(3) + ')';","    x.beginPath(); x.arc(0, 0, R, 0, TAU); x.fill();","    for (j = 0; j < st.sat.length; j++) { x.beginPath(); x.arc(st.sat[j][0] * h * gr, st.sat[j][1] * h * gr, st.sat[j][2] * h * gr, 0, TAU); x.fill(); }","    x.fillStyle = st.k === 0 ? 'rgba(255,170,160,' + (0.18 * al).toFixed(3) + ')' : 'rgba(255,255,230,' + (0.4 * al).toFixed(3) + ')';","    x.beginPath(); x.ellipse(-R * 0.3, -R * 0.35, R * 0.26, R * 0.14, -0.6, 0, TAU); x.fill();","    x.restore();","    if (st.drip > 0) {","      st.len = Math.min(st.drip, st.len + dt * st.sp); ln = st.len * h;","      if (ln > 1) {","        x.strokeStyle = st.k === 0 ? 'rgba(96,0,6,' + (0.8 * al).toFixed(3) + ')' : 'rgba(168,190,78,' + (0.5 * al).toFixed(3) + ')';","        x.lineWidth = Math.max(1, R * 0.35); x.beginPath(); x.moveTo(px, py); x.lineTo(px, py + ln); x.stroke();","        x.fillStyle = x.strokeStyle; x.beginPath(); x.arc(px, py + ln, Math.max(1, R * 0.25), 0, TAU); x.fill();","      }","    }","  }","}","","function cleanup() {","  try {","    if (F.c) F.c.style.display = 'none';","    if (F.eb) F.eb.style.display = 'none';","    var L = getLayer(), i;","    if (L) for (i = 0; i < NAMES.length; i++) { if (L.hasEffect(NAMES[i])) L.enableEffect(NAMES[i], false); F.on[NAMES[i]] = false; }","  } catch (e) {}","}","","function run() {","  var cv = G.getRenderer().getCanvas(); if (!cv) return;","  var L = getLayer(), i, j;","  var active = O('JS_Active', 0) === 1;","  var wakeOn = !active && typeof W.wake === 'number' && W.wake >= 0;","  if (F.scene !== S) {","    F.scene = S; F.on = {}; F.nSl = 0; F.nSp = 0; F.ch = false; F.bl1 = false; F.bl2 = false; F.neck = false; F.seedT = 0;","    if (!wakeOn) { F.stains = []; F.smears = []; F.age = 0; }","    if (L) for (i = 0; i < NAMES.length; i++) { if (fxHas(L, NAMES[i])) { L.enableEffect(NAMES[i], false); F.on[NAMES[i]] = false; } }","  }","  var Qual = clamp(Math.round(O('Cfg_JS_Quality', 2)), 0, 2), SAFE = O('Cfg_JS_Safe', 0) === 1;","  var dt = Math.min(0.1, S.getElapsedTime() / 1000), master = clamp(O('Cfg_JS_FxScale', 1), 0, 1.5);","  var fK = O('Cfg_JS_FlashScale', 1) * (SAFE ? 0.3 : 1), gK = O('Cfg_JS_GlitchScale', 1) * (SAFE ? 0.3 : 1);","  var lensOn = O('Cfg_JS_Lens', 1) === 1;","  var mode = active ? 2 : (wakeOn ? 3 : (O('JS_Tension', 0) > 0.03 ? 1 : 0));","  var E = { bl: 0, g: 0, no: 0, kb: 0, sat: 1, con: 1, r: 1, gr: 1, b: 1, dof: false, dFoc: 100, dRng: 40, dTr: 140, dMax: 0, eb: 0 };","  var lensA = 1;","","  if (mode === 2) {","    var T = O('JS_T', 0), sAt = O('Cfg_JS_ScreamAt', 0.35), NeckAt = O('Cfg_JS_NeckAt', 4.8), EndT = O('Cfg_JS_EndTime', 7), D0 = O('Cfg_JS_FadeStart', 2);","    var Sq = clamp(O('JS_Sq', 0), 0, 1), Cr = clamp(O('JS_Crush', 0), 0, 1), Pi = clamp(O('JS_Pierce', 0) / 1.5, 0, 1.3), Sl = clamp(O('JS_Slam', 0), 0, 1.9), dp = clamp(O('JS_Death', 0), 0, 1);","    var imp = Math.exp(-T * 9), scr = T >= sAt ? Math.exp(-(T - sAt) * 6) : 0;","    var sn = T >= NeckAt ? T - NeckAt : -1, snapK = sn >= 0 ? Math.exp(-sn * 5) : 0, snpS = sn >= 0 ? sm(sn / 0.4) : 0;","    // same blink timing as the eyelids of the main overlay","    var u = clamp((T - D0) / Math.max(0.1, EndT - 0.6 - D0), 0, 1);","    var b1 = bump(u, 0.17, 0.05, 0.38), b2 = bump(u, 0.40, 0.06, 0.62), blinkK = Math.max(b1 / 0.38, b2 / 0.62);","    F.age += dt;","","    E.bl = clamp(Math.max(0.9 * imp, 0.45 * scr, 0.85 * Math.min(1, Sl), 0.5 * Math.min(1, Pi), snapK, 0.7 * Cr) * fK, 0, 1.2);","    E.g = clamp((0.8 * imp + 1.3 * snapK + 0.5 * Cr + 0.4 * Math.min(1, Pi) + 0.35 * Math.min(1, Sl)) * gK, 0, 1.5);","    E.no = 0.04 + 0.22 * dp + 0.2 * Math.max(imp, snapK, Cr * 0.8);","    E.kb = (6 * Math.exp(-T * 4.5) + 4.5 * dp + 2.2 * Sq + 2.5 * Cr + 3 * snapK + 2.5 * blinkK) * (SAFE ? 0.7 : 1);","    E.sat = clamp(1 + 0.25 * imp - 0.75 * dp - 0.25 * Sq, 0.1, 2);","    E.con = 1 + 0.25 * imp + 0.2 * dp + 0.15 * Cr;","    E.r = 1 + 0.18 * Cr + 0.12 * Sq + 0.1 * imp; E.gr = 1 - 0.15 * Cr - 0.12 * Sq - 0.08 * dp; E.b = 1 - 0.2 * Cr - 0.15 * Sq - 0.12 * dp;","    E.eb = 3 * Math.exp(-T * 5) + 1.5 * sm(T / 0.3) + 3 * Sq + 3 * Cr + 2 * snapK + 2.5 * blinkK + 2 * snpS;","","    // depth of field: rack focus onto the monster face, tightens with the squeeze, re-focuses after each blink, slides to the floor after the neck snap","    E.dof = true;","    var dist = (L ? faceDist(L) : 60) * O('Cfg_JS_DoFBias', 1);","    E.dFoc = dist * lerp(2.6, 1, sm(T / 0.28)) * (1 + 1.2 * blinkK) * (1 - 0.7 * snpS);","    E.dRng = Math.max(10, O('Cfg_JS_DoFRange', 40) * (1 - 0.55 * Sq)) * (1 - 0.3 * snpS);","    E.dTr = Math.max(40, O('Cfg_JS_DoFTrans', 140) * (1 - 0.35 * Sq));","    E.dMax = Math.min(20, O('Cfg_JS_DoFMax', 6) * (0.55 + 0.9 * Sq + 0.8 * Cr + 0.7 * Math.min(1, E.bl) + 0.8 * blinkK + 0.9 * snpS) * (SAFE ? 0.7 : 1));","","    if (lensOn) {","      var nSl = O('JS_SlamN', 0);","      while (F.nSl < nSl && F.nSl < 8) {","        F.nSl++;","        for (j = 0; j < 3 + F.nSl; j++) addStain(0.08 + rnd() * 0.84, 0.35 + rnd() * 0.6, 0.03 + rnd() * 0.05, rnd() < 0.75 ? 0 : 1, 0.9, rnd() < 0.6 ? 0.06 + rnd() * 0.2 : 0);","      }","      var K = W.hk;","      if (K && K.scene === S && K.spurts && K.spurts.length > F.nSp) {","        for (j = F.nSp; j < K.spurts.length; j++) {","          var spt = K.spurts[j];","          addStain(spt.x + (rnd() - 0.5) * 0.03, spt.y + (rnd() - 0.5) * 0.03, 0.02 + rnd() * 0.02, 0, 0.9, 0.04 + rnd() * 0.1);","          addStain(spt.x + (rnd() - 0.5) * 0.08, spt.y + (rnd() - 0.5) * 0.06, 0.012 + rnd() * 0.015, 1, 0.9, 0.1 + rnd() * 0.15);","        }","        F.nSp = K.spurts.length;","      }","      if (Cr > 0.6 && !F.ch) { F.ch = true; for (j = 0; j < 2; j++) addStain(0.1 + rnd() * 0.8, 0.1 + rnd() * 0.8, 0.012 + rnd() * 0.02, 0, 0.85, rnd() < 0.5 ? 0.05 + rnd() * 0.1 : 0); }","      if (Cr < 0.25) F.ch = false;","      if (!F.neck && T >= NeckAt) { F.neck = true; for (j = 0; j < 7; j++) addStain(0.15 + rnd() * 0.7, 0.2 + rnd() * 0.7, 0.045 + rnd() * 0.06, j < 5 ? 0 : 1, 0.95, 0.1 + rnd() * 0.2); }","      if (!F.bl1 && b1 > 0.34) { F.bl1 = true; wipe(0.7); }","      if (!F.bl2 && b2 > 0.57) { F.bl2 = true; wipe(0.8); }","    }","  } else if (mode === 3) {","    var wd = Math.max(0.5, O('Cfg_JS_WakeTime', 2.6)), kk = clamp(W.wake / wd, 0, 1), wv = 1 - sm(kk);","    F.age += dt; lensA = 1 - sm(kk * 1.2);","    E.kb = 6 * wv; E.no = 0.04 + 0.14 * wv; E.sat = 0.3 + 0.7 * sm(kk); E.con = 1 + 0.15 * wv; E.bl = 0.35 * wv * fK; E.eb = 6 * wv;","    E.dof = true; E.dFoc = 300 * (1 + 1.5 * wv); E.dRng = 150; E.dTr = 300; E.dMax = O('Cfg_JS_DoFMax', 6) * 1.3 * wv;","  } else if (mode === 1) {","    var tz = clamp(O('JS_Tension', 0), 0, 1);","    E.no = 0.03 + 0.1 * tz; E.sat = 1 - 0.3 * tz; E.eb = 3 * tz * tz;","  }","  if (mode < 2 && !wakeOn) { F.stains = []; F.smears = []; }","","  // ---------- layer effects ----------","  if (L) {","    var q = master;","    if (fxEn(L, 'JS_Bloom', E.bl * q > 0.02)) {","      fxP(L, 'JS_Bloom', 'threshold', 0.55 - 0.15 * E.bl); fxP(L, 'JS_Bloom', 'bloomScale', 0.25 + 1.1 * E.bl * q);","      fxP(L, 'JS_Bloom', 'brightness', 1 + 0.5 * E.bl * q); fxP(L, 'JS_Bloom', 'blur', 6);","    }","    if (fxEn(L, 'JS_Glitch', E.g * q > 0.05)) {","      F.seedT -= dt; if (F.seedT <= 0) { F.seedT = 0.05; fxP(L, 'JS_Glitch', 'seed', rnd()); }","      fxP(L, 'JS_Glitch', 'offset', 70 * E.g * q); fxP(L, 'JS_Glitch', 'slices', 3 + Math.floor(7 * Math.min(E.g, 1.2)));","    }","    if (fxEn(L, 'JS_Noise', E.no * q > 0.01)) fxP(L, 'JS_Noise', 'noise', Math.min(0.6, E.no * q));","    if (fxEn(L, 'JS_Blur', E.kb * q > 0.25)) fxP(L, 'JS_Blur', 'blur', Math.min(14, E.kb * q));","    var adjOn = (Math.abs(E.sat - 1) + Math.abs(E.con - 1) + Math.abs(E.r - 1) + Math.abs(E.gr - 1) + Math.abs(E.b - 1)) > 0.02;","    if (fxEn(L, 'JS_Adjust', adjOn)) {","      fxP(L, 'JS_Adjust', 'saturation', E.sat); fxP(L, 'JS_Adjust', 'contrast', E.con);","      fxP(L, 'JS_Adjust', 'red', E.r); fxP(L, 'JS_Adjust', 'green', E.gr); fxP(L, 'JS_Adjust', 'blue', E.b);","    }","    var dofOn = E.dof && Qual >= 1 && O('Cfg_JS_DoF', 1) === 1;","    if (fxEn(L, 'DepthOfField', dofOn)) {","      fxP(L, 'DepthOfField', 'focusDistance', E.dFoc); fxP(L, 'DepthOfField', 'focusRange', E.dRng);","      fxP(L, 'DepthOfField', 'maxBlur', E.dMax * master); fxP(L, 'DepthOfField', 'transitionDistance', E.dTr);","    }","  }","","  // ---------- DOM overlays (edge blur + lens stains) ----------","  var r = cv.getBoundingClientRect();","  if (!F.c || !F.c.isConnected || !F.eb || !F.eb.isConnected || F.cvRef !== cv) {","    if (F.c && F.c.parentNode) F.c.parentNode.removeChild(F.c);","    if (F.eb && F.eb.parentNode) F.eb.parentNode.removeChild(F.eb);","    var par = cv.parentNode || document.body;","    var eb = document.createElement('div');","    var mk = 'radial-gradient(ellipse at 50% 50%,rgba(0,0,0,0) 40%,rgba(0,0,0,1) 100%)';","    eb.style.cssText = 'position:fixed;left:0;top:0;pointer-events:none;z-index:2147482997;display:none;-webkit-mask-image:' + mk + ';mask-image:' + mk + ';';","    par.appendChild(eb); F.eb = eb; F.ebS = '';","    var c = document.createElement('canvas');","    c.style.cssText = 'position:fixed;left:0;top:0;pointer-events:none;z-index:2147482999;display:none;';","    par.appendChild(c); F.c = c; F.x = c.getContext('2d'); F.cvRef = cv; F.pgSeen = null;","  }","  var ebV = (Qual >= 1 && O('Cfg_JS_EdgeBlur', 1) === 1) ? Math.min(O('Cfg_JS_EdgeBlurMax', 8), E.eb * master) : 0;","  if (ebV > 0.3) {","    var es = F.eb.style, bs = 'blur(' + (Math.round(ebV * 2) / 2) + 'px)';","    es.display = 'block'; es.left = r.left + 'px'; es.top = r.top + 'px'; es.width = r.width + 'px'; es.height = r.height + 'px';","    if (F.ebS !== bs) { es.backdropFilter = bs; es.webkitBackdropFilter = bs; F.ebS = bs; }","  } else F.eb.style.display = 'none';","","  var lensShow = lensOn && (mode === 2 || mode === 3) && (F.stains.length + F.smears.length) > 0;","  if (lensShow) {","    // keep the lens stains above the parasite canvas but below the main overlay (eyelids)","    if (W.pg && W.pg.rc && F.pgSeen !== W.pg.rc && F.c.parentNode) { F.c.parentNode.appendChild(F.c); F.pgSeen = W.pg.rc; }","    var RES = [0.4, 0.55, 0.8][Qual], w = Math.max(2, Math.round(r.width * RES)), h = Math.max(2, Math.round(r.height * RES)), cs = F.c.style;","    cs.display = 'block'; cs.left = r.left + 'px'; cs.top = r.top + 'px'; cs.width = r.width + 'px'; cs.height = r.height + 'px';","    if (F.c.width !== w || F.c.height !== h) { F.c.width = w; F.c.height = h; }","    drawLens(w, h, lensA, dt);","  } else F.c.style.display = 'none';","}","","if (!F.dead) {","  try { run(); } catch (e0) { F.err++; if (F.err < 4) console.error('[FX7] error:', e0); cleanup(); if (F.err > 15) F.dead = true; }","}","})();"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[]}],"parameters":[]}]}],"externalEventsFolderStructure":{"folderName":"__ROOT","children":[{"itemName":"player logic"},{"itemName":"javascript systems"},{"itemName":"monster"}]},"tests":[{"description":"Scene loads and portals exist without errors","lastRunAt":1794155517061.0,"lastRunDurationMs":6690.0,"lastRunFramesExecuted":121,"lastRunStatus":"failed","name":"portal-view-smoke","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(120);","const blue = harness.getObjects('PortalBlue');","const orange = harness.getObjects('PortalOrange');","harness.assert(blue.length > 0, 'PortalBlue exists');","harness.assert(orange.length > 0, 'PortalOrange exists');","const logs = harness.getEventLog ? [] : [];","await harness.takeScreenshot('portal-scene');"]},{"description":"Place both portals and verify cross-view renders without errors","lastRunAt":1792868385214.0,"lastRunDurationMs":12165.0,"lastRunFramesExecuted":187,"lastRunStatus":"failed","name":"portal-cross-view","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(60);","// Place Blue with left click (raycast from camera center)","harness.setMouseButtonPressed(true, 'left');","await harness.stepFrames(3);","harness.setMouseButtonPressed(false, 'left');","await harness.stepFrames(30);","// Place Orange with right click","harness.setMouseButtonPressed(true, 'right');","await harness.stepFrames(3);","harness.setMouseButtonPressed(false, 'right');","await harness.stepFrames(90);","const blue = harness.getObjects('PortalBlue')[0];","const orange = harness.getObjects('PortalOrange')[0];","const bActive = blue ? blue.variables.find(v => v.variableName === 'Active')?.value : undefined;","const oActive = orange ? orange.variables.find(v => v.variableName === 'Active')?.value : undefined;","harness.assert(bActive === 1, 'Blue portal became active after left click (Active=' + bActive + ')');","harness.assert(oActive === 1, 'Orange portal became active after right click (Active=' + oActive + ')');","await harness.takeScreenshot('both-portals');"]},{"description":"Verify wall GrabWeight via API","lastRunAt":1793542905874.0,"lastRunDurationMs":4957.0,"lastRunFramesExecuted":63,"lastRunStatus":"stopped","name":"grabpack-init-check","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(120);","const walls = harness.getObjects('wall');","harness.assert(walls.length>=1, 'wall exists');","const wid = walls[0].id;","const gv = harness.getObjectVariable(wid, 'GrabWeight');","harness.assert(gv!==undefined, 'GrabWeight var exists via API, got '+JSON.stringify(gv));","if (gv) harness.assert(Number(gv.value)===1, 'GrabWeight=1 got '+JSON.stringify(gv));","const gs = harness.getSceneVariable('GrabState');","harness.assert(gs && Number(gs.value)===0, 'GrabState 0');","await harness.takeScreenshot('grabpack-init');"]},{"description":"Verify heavy horror physics: walking, sprinting and jumping work with the tuned character controller.","lastRunAt":1792952761457.0,"lastRunDurationMs":4912.0,"lastRunFramesExecuted":178,"lastRunStatus":"stopped","name":"horror-physics-check","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(30);","const p0 = harness.getObjects('Player')[0];","harness.assert(!!p0, 'Player exists');","// Walk forward","harness.setKeyPressed('w', true);","const moved = await harness.stepUntil(() => { const p = harness.getObjects('Player')[0]; return p && Math.abs(p.x - p0.x) + Math.abs(p.y - p0.y) > 120; }, { maxFrames: 240 });","harness.setKeyPressed('w', false);","await harness.stepFrames(20);","harness.assert(moved, 'Player walks forward with new physics');","// Sprint should be faster per second","const p1 = harness.getObjects('Player')[0];","harness.setKeyPressed('w', true);","harness.setKeyPressed('LShift', true);","await harness.stepFrames(60);","harness.setKeyPressed('LShift', false);","harness.setKeyPressed('w', false);","await harness.stepFrames(20);","const p2 = harness.getObjects('Player')[0];","const sprintDist = Math.abs(p2.x - p1.x) + Math.abs(p2.y - p1.y);","harness.assert(sprintDist > 100, 'Sprint moves player noticeably (dist=' + sprintDist.toFixed(0) + ')');","// Jump: leaves floor and lands (measure from a standing start)","await harness.stepFrames(30);","const before = harness.getObjects('Player')[0];","harness.setKeyPressed('Space', true);","await harness.stepFrames(3);","harness.setKeyPressed('Space', false);","let maxZ = before.z;","for (let i = 0; i < 120; i++) { await harness.stepFrames(1); const p = harness.getObjects('Player')[0]; if (p && p.z > maxZ) maxZ = p.z; }","harness.assert(maxZ > before.z + 10, 'Player jumps (maxZ=' + maxZ.toFixed(0) + ', before=' + before.z.toFixed(0) + ')');","harness.takeScreenshot('horror-physics');"]},{"description":"Sprint banking: camera rolls slightly when strafing while sprinting, and returns to level when stopping.","lastRunAt":1792952006726.0,"lastRunDurationMs":2105.0,"lastRunFramesExecuted":1,"lastRunStatus":"stopped","name":"camera-roll-sprint","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(40);","// grab pointer lock so mouse look works","harness.setMouseButtonPressed(true);","await harness.stepFrames(3);","harness.setMouseButtonPressed(false);","await harness.stepFrames(3);","","const base = harness.getCameraState('') || harness.getCameraState();","const rollIdle = base ? base.rotationY : 0;","harness.assert(Math.abs(rollIdle) < 0.35, `idle roll is ~0 (got ${rollIdle})`);","","// sprint forward + strafe right","harness.setKeyPressed('LShift', true);","harness.setKeyPressed('w', true);","harness.setKeyPressed('d', true);","await harness.stepFrames(70);","const sprintCam = harness.getCameraState('');","const rollSprint = sprintCam ? sprintCam.rotationY : 0;","await harness.takeScreenshot('sprint-roll');","harness.assert(Math.abs(rollSprint) > 0.8, `camera rolls while sprint-strafing (got ${rollSprint})`);","harness.assert(Math.abs(rollSprint) < 6, `roll stays subtle, under 6 degrees (got ${rollSprint})`);","","// stop strafing, keep sprinting -> roll must come back","harness.setKeyPressed('d', false);","await harness.stepFrames(70);","const straightCam = harness.getCameraState('');","const rollStraight = straightCam ? straightCam.rotationY : 0;","harness.assert(Math.abs(rollStraight) < 0.6, `roll returns toward level when going straight (got ${rollStraight})`);","","// stop sprinting -> fully level","harness.setKeyPressed('LShift', false);","harness.setKeyPressed('w', false);","await harness.stepFrames(120);","const idleCam = harness.getCameraState('');","const rollEnd = idleCam ? idleCam.rotationY : 0;","harness.assert(Math.abs(rollEnd) < 0.25, `roll is level after stopping (got ${rollEnd})`);","await harness.takeScreenshot('level-after-stop');",""]},{"description":"Lever toggles via E key and via GrabPack cable hit","lastRunAt":1792953604725.0,"lastRunDurationMs":6105.0,"lastRunFramesExecuted":14,"lastRunStatus":"stopped","name":"lever-grabpack-pull","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(90);","let levers = harness.getObjects('Lever_Single');","harness.assert(levers.length > 0, 'Lever_Single exists in scene');","let lv = levers[0];","const players = harness.getObjects('Player');","harness.assert(players.length > 0, 'Player exists');","// --- E-key path: teleport player next to lever ---","harness.setObjectPosition(players[0].id, lv.centerX + 100, lv.centerY, lv.centerZ ?? 0);","await harness.stepFrames(5);","harness.setKeyPressed('e', true);","await harness.stepFrames(2);","harness.setKeyPressed('e', false);","await harness.stepFrames(5);","let v = harness.getObjectVariable(lv.id, 'LeverOn');","harness.assert(v && v.value === 1, 'E near lever toggles it ON');","await harness.stepFrames(60);","harness.setKeyPressed('e', true);","await harness.stepFrames(2);","harness.setKeyPressed('e', false);","await harness.stepFrames(5);","v = harness.getObjectVariable(lv.id, 'LeverOn');","harness.assert(v && v.value === 0, 'E again toggles it OFF');","levers = harness.getObjects('Lever_Single');","harness.assert(levers[0].animation === 'ToggleOff', 'Lever shows ToggleOff (got ' + levers[0].animation + ')');","// --- GrabPack cable path: simulate right-hand cable flying at the lever ---","await harness.stepFrames(60);","levers = harness.getObjects('Lever_Single');","lv = levers[0];","harness.setMouseButtonPressed(true, 'right');","harness.setSceneVariable('ToolMode', 1);","harness.setSceneVariable('GrabReleased', 0);","harness.setSceneVariable('GrabTX', lv.centerX);","harness.setSceneVariable('GrabTY', lv.centerY);","harness.setSceneVariable('GrabTZ', lv.centerZ ?? 0);","harness.setSceneVariable('GrabHX', lv.centerX + 30);","harness.setSceneVariable('GrabHY', lv.centerY);","harness.setSceneVariable('GrabHZ', lv.centerZ ?? 0);","harness.setSceneVariable('GrabKind', 2);","harness.setSceneVariable('GrabState', 1);","const pulled = await harness.stepUntil(() => {","  const vv = harness.getObjectVariable(lv.id, 'LeverOn');","  return vv && vv.value === 1;","}, {maxFrames: 300});","harness.setMouseButtonPressed(false, 'right');","harness.assert(pulled, 'GrabPack cable pulls the lever ON');","levers = harness.getObjects('Lever_Single');","harness.assert(levers[0].animation === 'ToggleOn', 'Lever shows ToggleOn (got ' + levers[0].animation + ')');","await harness.takeScreenshot('lever-grabpack');"]},{"description":"Verify zombie anim valid and memory vars exist","lastRunAt":1794157294685.0,"lastRunDurationMs":9666.0,"lastRunFramesExecuted":121,"lastRunStatus":"passed","name":"monster-ai-cunning","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(120);","const zombies = harness.getObjects('Zombie');","harness.assert(zombies.length > 0, 'Zombie exists');","const z = zombies[0];","harness.assert(['Idle','Run','Jump'].includes(z.animation), 'Zombie animation is valid model anim, got '+z.animation);","const memLoaded = harness.getSceneVariable('MemLoaded');","harness.assert(memLoaded !== undefined, 'MemLoaded variable exists');","const hot = harness.getSceneVariable('HotScore');","harness.assert(hot !== undefined, 'HotScore exists');","await harness.takeScreenshot('monster-check');"]},{"description":"Groq gpt-oss-120b strategist: persisted memory, real API call, validated decision, FSM execution","lastRunAt":1793228139960.0,"lastRunDurationMs":15553.0,"lastRunFramesExecuted":215,"lastRunStatus":"stopped","name":"monster-llm-memory","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(8);","","const gv = (n) => harness.getSceneVariable(n);","const nv = (n) => { const v = gv(n); return v ? Number(v.value) : NaN; };","const sv = (n) => { const v = gv(n); return v ? String(v.value) : ''; };","","harness.assert(nv('LLM_Enabled') === 1, 'LLM_Enabled initialised to 1');","harness.assert(nv('LLM_MemLoaded') === 1, 'persisted memory load pass ran');","harness.assert(sv('GroqModel') === 'openai/gpt-oss-120b', 'model = ' + sv('GroqModel'));","","// teach a hotspot, then bump the escape counter: it forces a memory snapshot + a fresh LLM request","harness.setSceneVariable('Mem1X', 1200);","harness.setSceneVariable('Mem1Y', 900);","harness.setSceneVariable('Mem1W', 3);","harness.setSceneVariable('EscapeCount', 3);","await harness.stepFrames(6);","const memJson = sv('LLM_MemJSON');","harness.assert(memJson.indexOf('1200') >= 0, 'memory persisted immediately on escape (LLM_MemJSON has the hotspot)');","harness.assert(memJson.indexOf('\"escape\"') >= 0, 'escape recorded in the memory history');","","const answered = await harness.stepUntil(() => Number(harness.getSceneVariable('LLM_Calls').value) > 0, { maxFrames: 900 });","const errText = sv('LLM_Err');","harness.assert(answered, 'Groq answered (LLM_Calls>0). error=\"' + errText + '\"');","if (answered) {","  const allowed = ['Patrol', 'Investigate', 'Search', 'Ambush', 'Stalk'];","  harness.assert(allowed.indexOf(sv('LLM_State')) >= 0, 'LLM state whitelisted: ' + sv('LLM_State'));","  const mul = nv('LLM_SpeedMul');","  harness.assert(mul >= 0.7 && mul <= 1.4, 'speed multiplier clamped: ' + mul);","  harness.assert(nv('LLM_Valid') === 1, 'directive valid');","  console.log('LLM strategy=' + sv('LLM_Strategy') + ' | state=' + sv('LLM_State') + ' | ambushIdx=' + nv('LLM_AmbushIdx') + ' | mul=' + mul + ' | reason=' + sv('LLM_Reason'));","}","","// FSM executes a validated tactic","harness.setSceneVariable('LLM_Enabled', 0);","harness.setSceneVariable('MonsterState', 'Patrol');","harness.setSceneVariable('PlayerVisible', 0);","harness.setSceneVariable('Suspicion', 0);","harness.setSceneVariable('AmbushPhase', 0);","harness.setSceneVariable('LLM_State', 'Ambush');","harness.setSceneVariable('LLM_AmbushOK', 1);","harness.setSceneVariable('LLM_AmbushX', 1500);","harness.setSceneVariable('LLM_AmbushY', 1500);","harness.setSceneVariable('LLM_Valid', 1);","harness.setSceneVariable('LLM_Expire', 20);","harness.setSceneVariable('LLM_SpeedMul', 1.2);","await harness.stepFrames(30);","harness.assert(sv('MonsterState') === 'Ambush', 'FSM switched to LLM ambush (state=' + sv('MonsterState') + ')');","harness.assert(Math.abs(nv('AmbushX') - 1500) < 200, 'ambush point from LLM hotspot (' + nv('AmbushX') + ',' + nv('AmbushY') + ')');","harness.assert(Math.abs(nv('Cfg_ChaseSpeed') - nv('LLM_BaseChase') * 1.2) < 1, 'chase speed scaled: ' + nv('Cfg_ChaseSpeed'));","await harness.takeScreenshot('llm-state');",""]},{"description":"Groq gpt-oss-120b closed loop: request -> validated plan -> applied to the FSM","lastRunAt":1793228734967.0,"lastRunDurationMs":9548.0,"lastRunFramesExecuted":146,"lastRunStatus":"stopped","name":"monster-llm-plan-loop","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(5);","const sv = n => { const v = harness.getSceneVariable(n); return v ? String(v.value) : ''; };","const nv = n => { const v = harness.getSceneVariable(n); return v ? Number(v.value) : NaN; };","","harness.setSceneVariable('Mem1X', 1200);","harness.setSceneVariable('Mem1Y', 900);","harness.setSceneVariable('Mem1W', 3);","harness.setSceneVariable('Mem2X', 600);","harness.setSceneVariable('Mem2Y', 400);","harness.setSceneVariable('Mem2W', 2);","","const log = [];","let answered = false;","for (let i = 0; i < 26; i++) {","  await harness.stepFrames(6);","  log.push('f' + ((i + 1) * 6) + ' busy=' + nv('LLM_Busy') + ' req=' + nv('LLM_ReqId') + ' ok=' + nv('LLM_Calls') + ' fail=' + nv('LLM_Fails') + ' err=' + sv('LLM_Err'));","  if (nv('LLM_Calls') > 0) { answered = true; break; }","}","for (const l of log) console.log(l);","console.log('ERR=' + sv('LLM_Err'));","console.log('RAW=' + sv('LLM_Text').slice(0, 350));","console.log('PLAN mode=' + sv('LLM_Mode') + ' strategy=' + sv('LLM_Strategy') + ' aggro=' + nv('LLM_Aggro') + ' mul=' + nv('LLM_SpeedMul') + ' slot=' + nv('LLM_AmbushIdx') + ' reason=' + sv('LLM_Reason'));","harness.assert(answered, 'Groq answered (calls=' + nv('LLM_Calls') + ', err=\"' + sv('LLM_Err') + '\")');","if (answered) {","  const modes = ['hunt', 'stalk', 'ambush', 'patrol', 'intercept', 'feint'];","  harness.assert(modes.indexOf(sv('LLM_Mode')) >= 0, 'mode validated: ' + sv('LLM_Mode'));","  harness.assert(nv('LLM_Valid') === 1, 'plan valid');","  await harness.stepFrames(14);","  const base = nv('LLM_BaseChase'), mul = nv('LLM_SpeedMul');","  harness.assert(Math.abs(nv('Cfg_ChaseSpeed') - base * mul) < 2, 'chase speed = base*plan (' + nv('Cfg_ChaseSpeed') + ' vs ' + (base * mul) + ')');","  const aggroExpect = nv('LLM_BaseSusp') * (0.6 + 0.8 * nv('LLM_Aggro'));","  harness.assert(Math.abs(nv('Cfg_SuspGain') - aggroExpect) < 0.6, 'suspicion gain modulated by aggro (' + nv('Cfg_SuspGain') + ' vs ' + aggroExpect + ')');","  harness.assert(sv('LLM_MemJSON').indexOf('\"plan\"') >= 0, 'plan persisted in memory json');","}","await harness.takeScreenshot('llm-plan');",""]},{"description":"AI answer is parsed into engine structures and executed immediately","lastRunAt":1793228943661.0,"lastRunDurationMs":8868.0,"lastRunFramesExecuted":114,"lastRunStatus":"failed","name":"monster-llm-execute","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(5);","const sv = n => { const v = harness.getSceneVariable(n); return v ? String(v.value) : ''; };","const nv = n => { const v = harness.getSceneVariable(n); return v ? Number(v.value) : NaN; };","harness.setSceneVariable('Mem1X', 1200);","harness.setSceneVariable('Mem1Y', 900);","harness.setSceneVariable('Mem1W', 3);","harness.setSceneVariable('Mem2X', 600);","harness.setSceneVariable('Mem2Y', 400);","harness.setSceneVariable('Mem2W', 2);","let answered = false;","const log = [];","for (let i = 0; i < 18; i++) {","  await harness.stepFrames(6);","  log.push('f' + ((i + 1) * 6) + ' req=' + nv('LLM_ReqId') + ' ok=' + nv('LLM_Calls') + ' fail=' + nv('LLM_Fails') + ' valid=' + nv('LLM_Valid') + ' applied=' + nv('LLM_Applied') + ' err=' + sv('LLM_Err'));","  if (nv('LLM_Calls') > 0) { answered = true; break; }","}","for (const l of log) console.log(l);","console.log('CONTENT=' + sv('LLM_Content').slice(0, 260));","console.log('MODE=' + sv('LLM_Mode') + ' STRATEGY=' + sv('LLM_Strategy') + ' REASON=' + sv('LLM_Reason'));","harness.assert(answered, 'Groq answer received (calls=' + nv('LLM_Calls') + ', err=\"' + sv('LLM_Err') + '\")');","if (answered) {","  harness.assert(sv('LLM_Content').indexOf('{') >= 0, 'answer converted to plan JSON string');","  harness.assert(nv('LLM_Applied') >= 1, 'plan executed by the engine immediately (LLM_Applied=' + nv('LLM_Applied') + ')');","  await harness.stepFrames(10);","  const base = nv('LLM_BaseChase'), mul = nv('LLM_SpeedMul');","  harness.assert(Math.abs(nv('Cfg_ChaseSpeed') - base * mul) < 2, 'engine knob follows the plan (' + nv('Cfg_ChaseSpeed') + ' vs ' + (base * mul) + ')');","}","await harness.takeScreenshot('ai-executed');",""]},{"description":"The terrain stays visible while the lantern is held on the hand layer (no opaque hand layer).","lastRunAt":1794152747303.0,"lastRunDurationMs":1147.0,"lastRunFramesExecuted":62,"lastRunStatus":"passed","name":"World visible with lantern","type":"gameplay","source":["await harness.goToScene('Game Scene');","harness.setMouseButtonPressed(true); await harness.stepFrames(1);","harness.setMouseButtonPressed(false); await harness.stepFrames(60);","await harness.takeScreenshot('world + lantern');","// Pixels in the upper-left area of the screen should not be a flat light grey/white:","const canvas = harness.getRuntimeGame().getRenderer().getCanvas();","const tr = harness.getRuntimeGame().getRenderer().getThreeRenderer();","const gl = tr.getContext();","harness.getCurrentRuntimeScene().render();","const px = new Uint8Array(4);","gl.readPixels(Math.floor(canvas.width * 0.3), Math.floor(canvas.height * 0.3), 1, 1, gl.RGBA, gl.UNSIGNED_BYTE, px);","console.log('pixel at 30%/30%', Array.from(px).join(','));","harness.assert(!(px[0] > 180 && px[1] > 180 && px[2] > 180), 'lower-left world area is not covered by a white/grey sheet');"]},{"description":"Lantern Strength drains away from fires, refills near the Fireplace, and the HUD bar follows it.","lastRunAt":1794154121839.0,"lastRunDurationMs":5348.0,"lastRunFramesExecuted":648,"lastRunStatus":"passed","name":"Lantern drains and recharges at fireplace","type":"gameplay","source":["harness.setMaxScreenshots(4);","await harness.goToScene('Game Scene');","harness.setMouseButtonPressed(true); await harness.stepFrames(1);","harness.setMouseButtonPressed(false); await harness.stepFrames(1);","const flames = () => harness.getObjects('LanternFlame');","const strengthOf = (f) => f.variables.find(v => v.name === 'Strength').value;","const drain = flames()[0].variables.find(v => v.name === 'DrainPerSecond').value;","const s0 = strengthOf(flames()[0]);","const player = harness.getObjects('Player')[0];","const fire = harness.getObjects('Fireplace')[0];","console.log('start strength', s0, 'drain/s', drain, 'player->fire dist', Math.hypot(player.centerX - fire.centerX, player.centerY - fire.centerY).toFixed(0));","await harness.stepFrames(180); // 3 s away from the fire","const s1 = strengthOf(flames()[0]);","const bar1 = harness.getObjects('LanternBar')[0].state.Value;","console.log('after 3s away', s1.toFixed(2), 'bar', bar1);","harness.assert(Math.abs((s0 - s1) - drain * 3) < drain * 0.3, 'drains ~DrainPerSecond away from fire (lost ' + (s0 - s1).toFixed(2) + ')');","harness.assert(Math.abs(bar1 - s1) < 1, 'HUD bar value follows Strength');","// Low-fuel look","harness.getRuntimeObject(flames()[0].id);","for (const f of flames()) harness.setObjectVariable(f.id, 'Strength', 15);","await harness.stepFrames(20);","await harness.takeScreenshot('low strength (15)');","// Walk up to the fire: teleport next to it and hold it there","const p = harness.getObjects('Player')[0];","const target = { x: fire.centerX - 110, y: fire.centerY, z: fire.z + 5 };","harness.setObjectPosition(p.id, target.x - (p.centerX - p.x), target.y - (p.centerY - p.y), target.z);","await harness.stepFrames(10);","const sNear0 = strengthOf(flames()[0]);","await harness.stepFrames(120, { onFrame: () => {} });","const sNear1 = strengthOf(flames()[0]);","const pl = harness.getObjects('Player')[0];","console.log('near fire dist', Math.hypot(pl.centerX - fire.centerX, pl.centerY - fire.centerY).toFixed(0), 'warmth', harness.getSceneVariable('LanternWarmth').value.toFixed(2), 'strength', sNear0.toFixed(2), '->', sNear1.toFixed(2));","harness.assert(sNear1 > sNear0 + 10, 'Strength recharges near the fireplace');","await harness.lookTowardWithMouseDelta('Player', { name: 'Fireplace' }, { yawOnly: true });","await harness.stepFrames(5);","await harness.takeScreenshot('at the fireplace, recharging');","await harness.stepFrames(300);","const sFull = strengthOf(flames()[0]);","console.log('after 5 more s', sFull.toFixed(2), 'bar', harness.getObjects('LanternBar')[0].state.Value);","harness.assert(sFull <= 100 + 1e-6, 'Strength is capped at MaxStrength');"]}],"testsFolderStructure":{"folderName":"__ROOT","children":[{"itemName":"portal-view-smoke"},{"itemName":"portal-cross-view"},{"itemName":"grabpack-init-check"},{"itemName":"horror-physics-check"},{"itemName":"camera-roll-sprint"},{"itemName":"lever-grabpack-pull"},{"itemName":"monster-ai-cunning"},{"itemName":"monster-llm-memory"},{"itemName":"monster-llm-plan-loop"},{"itemName":"monster-llm-execute"},{"itemName":"World visible with lantern"},{"itemName":"Lantern drains and recharges at fireplace"}]},"eventsFunctionsExtensions":[{"author":"","category":"Input","dimension":"","extensionNamespace":"","fullName":"3D character keyboard mapper","gdevelopVersion":">=5.5.222","helpPath":"","iconUrl":"data:image/svg+xml;base64,","name":"PhysicsCharacter3DKeyMapper","previewIconUrl":"https://asset-resources.gdevelop.io/public-resources/Icons/Glyphster Pack/Master/SVG/Computers and Hardware/3e5871434a72821bf3ecb44a6857e62a438cf23dc8f95966f56ae97e95315468_Computers and Hardware_keyboard.svg","shortDescription":"3D platformer and 3D shooter keyboard controls.","version":"1.1.1","description":"3D platformer and 3D shooter keyboard controls.","origin":{"identifier":"PhysicsCharacter3DKeyMapper","name":"gdevelop-extension-store"},"tags":["3d"],"authorIds":["IWykYNRvhCZBN3vEgKEbBPOR3Oc2"],"dependencies":[],"globalVariables":[],"sceneVariables":[],"eventsFunctions":[],"eventsFunctionsFolderStructure":{"folderName":"__ROOT"},"eventsBasedBehaviors":[{"description":"Control a 3D physics character with a keyboard for a platformer or a top-down game.","fullName":"3D platformer keyboard mapper","helpPath":"","iconUrl":"","name":"Platformer3DKeyboardMapper","objectType":"","previewIconUrl":"","eventsFunctions":[{"fullName":"","functionType":"Action","name":"doStepPreEvents","sentence":"","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type"