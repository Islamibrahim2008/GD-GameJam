oothly up to this distance.","name":"Radius","type":"expression"},{"description":"Layer (1 to 4)","name":"Layer","type":"expression"}],"objectGroups":[]},{"description":"Paint a layer on the ground along a line, for example for a path or a road.","fullName":"Paint a layer along a line","functionType":"Action","group":"Paint","name":"PaintLayerAlongLine","sentence":"Paint layer _PARAM6_ on _PARAM0_ from _PARAM1_; _PARAM2_ to _PARAM3_; _PARAM4_ with a radius of _PARAM5_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const x1 = eventsFunctionContext.getArgument(\"X1\");","const y1 = eventsFunctionContext.getArgument(\"Y1\");","const x2 = eventsFunctionContext.getArgument(\"X2\");","const y2 = eventsFunctionContext.getArgument(\"Y2\");","const radius = eventsFunctionContext.getArgument(\"Radius\");","const layer = eventsFunctionContext.getArgument(\"Layer\");","object.__terrain3D.paint(x1, y1, x2, y2, radius, layer, 1);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::Terrain3D","type":"object"},{"description":"X position of the start","name":"X1","type":"expression"},{"description":"Y position of the start","name":"Y1","type":"expression"},{"description":"X position of the end","name":"X2","type":"expression"},{"description":"Y position of the end","name":"Y2","type":"expression"},{"description":"Radius","longDescription":"The effect fades out smoothly up to this distance from the line.","name":"Radius","type":"expression"},{"description":"Layer (1 to 4)","name":"Layer","type":"expression"}],"objectGroups":[]},{"description":"Tint the ground around a position with a color multiplying its layers, like dry grass or darker mud. White removes the tint.","fullName":"Tint the ground","functionType":"Action","group":"Paint","name":"TintGround","sentence":"Tint the ground of _PARAM0_ with _PARAM4_ at _PARAM1_; _PARAM2_ with a radius of _PARAM3_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const x = eventsFunctionContext.getArgument(\"X\");","const y = eventsFunctionContext.getArgument(\"Y\");","const radius = eventsFunctionContext.getArgument(\"Radius\");","const color = gdjs.rgbOrHexToRGBColor(eventsFunctionContext.getArgument(\"Color\"));","object.__terrain3D.tint(x, y, x, y, radius, color, 1);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::Terrain3D","type":"object"},{"description":"X position of the center","name":"X","type":"expression"},{"description":"Y position of the center","name":"Y","type":"expression"},{"description":"Radius","longDescription":"The effect fades out smoothly up to this distance.","name":"Radius","type":"expression"},{"description":"Color","name":"Color","type":"color"}],"objectGroups":[]},{"description":"Make the ground around a position wet (darker and shiny, like after rain or near water) or dry.","fullName":"Change the wetness of the ground","functionType":"Action","group":"Paint","name":"WetGround","sentence":"Change the wetness of the ground of _PARAM0_ to _PARAM4_ at _PARAM1_; _PARAM2_ with a radius of _PARAM3_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const x = eventsFunctionContext.getArgument(\"X\");","const y = eventsFunctionContext.getArgument(\"Y\");","const radius = eventsFunctionContext.getArgument(\"Radius\");","const wetness = eventsFunctionContext.getArgument(\"Wetness\");","object.__terrain3D.wet(x, y, x, y, radius, wetness, 1);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::Terrain3D","type":"object"},{"description":"X position of the center","name":"X","type":"expression"},{"description":"Y position of the center","name":"Y","type":"expression"},{"description":"Radius","longDescription":"The effect fades out smoothly up to this distance.","name":"Radius","type":"expression"},{"description":"Wetness (from 0 for dry to 1)","name":"Wetness","type":"expression"}],"objectGroups":[]},{"description":"the wetness of the ground at a position, from 0 (dry) to 1, painted or near the water (wet shore).","fullName":"Ground wetness","functionType":"ExpressionAndCondition","group":"Paint","name":"GroundWetness","sentence":"the wetness of the ground at _PARAM1_; _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const x = eventsFunctionContext.getArgument(\"X\");","const y = eventsFunctionContext.getArgument(\"Y\");","eventsFunctionContext.returnValue = object.__terrain3D.getWetnessAt(x, y);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::Terrain3D","type":"object"},{"description":"X position","name":"X","type":"expression"},{"description":"Y position","name":"Y","type":"expression"}],"objectGroups":[]},{"description":"The tint painted on the ground at a position, like \"255;255;255\" (white when there is none).","fullName":"Ground tint","functionType":"StringExpression","group":"Paint","name":"GroundTint","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const x = eventsFunctionContext.getArgument(\"X\");","const y = eventsFunctionContext.getArgument(\"Y\");","eventsFunctionContext.returnValue = object.__terrain3D.getTintAt(x, y).join(\";\");"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"string"},"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::Terrain3D","type":"object"},{"description":"X position","name":"X","type":"expression"},{"description":"Y position","name":"Y","type":"expression"}],"objectGroups":[]},{"description":"Remove the ground in a circle, for the entrance of a tunnel, a cave or a well: there is nothing drawn and no collision there. Fill it again with the \"Fill holes\" action. A height field can't go under itself: put a 3D model (with a collision shape) for the tunnel or the cave under the ground. The physics engine removes the triangles touching a hole, so the hole in the collisions can be up to a cell larger than the one drawn: make the model go a bit further than the hole, or put rocks around the entrance.","fullName":"Make a hole","functionType":"Action","group":"Holes","name":"MakeHole","sentence":"Make a hole in _PARAM0_ at _PARAM1_; _PARAM2_ with a radius of _PARAM3_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const x = eventsFunctionContext.getArgument(\"X\");","const y = eventsFunctionContext.getArgument(\"Y\");","const radius = eventsFunctionContext.getArgument(\"Radius\");","object.__terrain3D.makeHole(x, y, x, y, radius);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::Terrain3D","type":"object"},{"description":"X position of the center","name":"X","type":"expression"},{"description":"Y position of the center","name":"Y","type":"expression"},{"description":"Radius","name":"Radius","type":"expression"}],"objectGroups":[]},{"description":"Fill the holes in a circle with the layers of the ground around them: the ground is drawn and has collisions again.","fullName":"Fill holes","functionType":"Action","group":"Holes","name":"FillHoles","sentence":"Fill the holes in _PARAM0_ at _PARAM1_; _PARAM2_ with a radius of _PARAM3_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const x = eventsFunctionContext.getArgument(\"X\");","const y = eventsFunctionContext.getArgument(\"Y\");","const radius = eventsFunctionContext.getArgument(\"Radius\");","object.__terrain3D.fillHoles(x, y, x, y, radius);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::Terrain3D","type":"object"},{"description":"X position of the center","name":"X","type":"expression"},{"description":"Y position of the center","name":"Y","type":"expression"},{"description":"Radius","name":"Radius","type":"expression"}],"objectGroups":[]},{"description":"Make the entrance of a tunnel or a cave on a slope: a hole, with the ground in front of it flattened to the floor of the tunnel.","fullName":"Carve an entrance","functionType":"Action","group":"Holes","name":"CarveEntrance","sentence":"Carve an entrance in _PARAM0_ at _PARAM1_; _PARAM2_ with a radius of _PARAM3_, going in at _PARAM4_° with its floor at Z _PARAM5_ and _PARAM6_ pixels of flat ground in front","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const x = eventsFunctionContext.getArgument(\"X\");","const y = eventsFunctionContext.getArgument(\"Y\");","const radius = eventsFunctionContext.getArgument(\"Radius\");","const angle = eventsFunctionContext.getArgument(\"Angle\");","const floorZ = eventsFunctionContext.getArgument(\"FloorZ\");","const length = eventsFunctionContext.getArgument(\"Length\");","object.__terrain3D.carveEntrance(x, y, radius, angle, floorZ, length);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::Terrain3D","type":"object"},{"description":"X position of the center","name":"X","type":"expression"},{"description":"Y position of the center","name":"Y","type":"expression"},{"description":"Radius","name":"Radius","type":"expression"},{"description":"Direction going into the ground (in degrees)","name":"Angle","type":"expression"},{"description":"Z position of the floor","name":"FloorZ","type":"expression"},{"description":"Length of the flat ground in front of the entrance (in pixels)","name":"Length","type":"expression"}],"objectGroups":[]},{"description":"Check if there is a hole in the ground at a position.","fullName":"Hole","functionType":"Condition","group":"Holes","name":"IsHole","sentence":"There is a hole in _PARAM0_ at _PARAM1_; _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const x = eventsFunctionContext.getArgument(\"X\");","const y = eventsFunctionContext.getArgument(\"Y\");","eventsFunctionContext.returnValue = object.__terrain3D.isHoleAt(x, y);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::Terrain3D","type":"object"},{"description":"X position","name":"X","type":"expression"},{"description":"Y position","name":"Y","type":"expression"}],"objectGroups":[]},{"description":"The Z position of the ground at a position, or the given value where there is a hole.","fullName":"Ground Z position, with holes","functionType":"Expression","group":"Holes","name":"GroundZWithHoles","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const x = eventsFunctionContext.getArgument(\"X\");","const y = eventsFunctionContext.getArgument(\"Y\");","const terrain = object.__terrain3D;","eventsFunctionContext.returnValue = terrain.isHoleAt(x, y) ? eventsFunctionContext.getArgument(\"ZInHoles\") : terrain.getHeightAt(x, y);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::Terrain3D","type":"object"},{"description":"X position","name":"X","type":"expression"},{"description":"Y position","name":"Y","type":"expression"},{"description":"Value in holes","longDescription":"For example, a Z position far under the ground.","name":"ZInHoles","type":"expression"}],"objectGroups":[]},{"description":"Replace the ground with a generated relief. Painted layers are reset.","fullName":"Generate a relief","functionType":"Action","group":"Generation","name":"GenerateRelief","sentence":"Generate a relief of _PARAM1_ on _PARAM0_ with seed _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const relief = eventsFunctionContext.getArgument(\"Relief\");","const seed = eventsFunctionContext.getArgument(\"Seed\");","object.__terrain3D.generate(relief, seed);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::Terrain3D","type":"object"},{"description":"Relief","name":"Relief","supplementaryInformation":"[\"Flat\", \"Hills\", \"Mountains\", \"Island\"]","type":"stringWithSelector"},{"description":"Seed","longDescription":"Each seed gives a different terrain with the same relief.","name":"Seed","type":"expression"}],"objectGroups":[]},{"description":"Replace the ground with the heights of an image. Painted layers are kept.","fullName":"Load a heightmap","functionType":"Action","group":"Generation","name":"LoadHeightmap","sentence":"Load the heights of _PARAM0_ from _PARAM1_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const image = eventsFunctionContext.getArgument(\"Image\");","object.__terrain3D.loadHeightmap(image);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::Terrain3D","type":"object"},{"description":"Heightmap image","longDescription":"Black is the lowest, white the highest. For more precision, store the height on 16 bits in the red (most significant byte) and green channels.","name":"Image","type":"imageResource"}],"objectGroups":[]},{"description":"Move objects up or down so that their bottom is on the ground, under their center. Useful to place trees, rocks or characters on a terrain.","fullName":"Put objects on the ground","functionType":"Action","group":"Position","name":"PutOnGround","sentence":"Put _PARAM1_ on the ground of _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","object.__terrain3D.placeOnGround(eventsFunctionContext.getObjects(\"Objects\"));"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::Terrain3D","type":"object"},{"description":"Objects to put on the ground","name":"Objects","type":"objectList"}],"objectGroups":[]},{"description":"the Z position of the ground at a position of the scene.","fullName":"Ground Z position","functionType":"ExpressionAndCondition","group":"Position","name":"GroundZ","sentence":"the ground Z position at _PARAM1_; _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const x = eventsFunctionContext.getArgument(\"X\");","const y = eventsFunctionContext.getArgument(\"Y\");","eventsFunctionContext.returnValue = object.__terrain3D.getHeightAt(x, y);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::Terrain3D","type":"object"},{"description":"X position","name":"X","type":"expression"},{"description":"Y position","name":"Y","type":"expression"}],"objectGroups":[]},{"description":"the slope of the ground (angle with the horizontal, in degrees) at a position of the scene.","fullName":"Ground slope","functionType":"ExpressionAndCondition","group":"Position","name":"GroundSlope","sentence":"the ground slope at _PARAM1_; _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const x = eventsFunctionContext.getArgument(\"X\");","const y = eventsFunctionContext.getArgument(\"Y\");","eventsFunctionContext.returnValue = object.__terrain3D.getSlopeAt(x, y);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::Terrain3D","type":"object"},{"description":"X position","name":"X","type":"expression"},{"description":"Y position","name":"Y","type":"expression"}],"objectGroups":[]},{"description":"the layer (from 1 to 4) painted the most at a position of the scene. Useful to play footstep sounds or to slow down characters in water or mud.","fullName":"Ground layer","functionType":"ExpressionAndCondition","group":"Paint","name":"GroundLayer","sentence":"the ground layer at _PARAM1_; _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const x = eventsFunctionContext.getArgument(\"X\");","const y = eventsFunctionContext.getArgument(\"Y\");","eventsFunctionContext.returnValue = object.__terrain3D.getLayerAt(x, y);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::Terrain3D","type":"object"},{"description":"X position","name":"X","type":"expression"},{"description":"Y position","name":"Y","type":"expression"}],"objectGroups":[]}],"eventsFunctionsFolderStructure":{"folderName":"__ROOT","children":[{"functionName":"onCreated"},{"functionName":"onDestroy"},{"functionName":"doStepPostEvents"},{"functionName":"onHotReloading"},{"folderName":"Sculpt","children":[{"functionName":"RaiseGround"},{"functionName":"RaiseGroundAlongLine"},{"functionName":"FlattenGround"},{"functionName":"SmoothGround"}]},{"folderName":"Paint","children":[{"functionName":"PaintLayer"},{"functionName":"PaintLayerAlongLine"},{"functionName":"TintGround"},{"functionName":"WetGround"},{"functionName":"GroundWetness"},{"functionName":"GroundTint"},{"functionName":"GroundLayer"}]},{"folderName":"Holes","children":[{"functionName":"MakeHole"},{"functionName":"FillHoles"},{"functionName":"CarveEntrance"},{"functionName":"IsHole"},{"functionName":"GroundZWithHoles"}]},{"folderName":"Generation","children":[{"functionName":"GenerateRelief"},{"functionName":"LoadHeightmap"}]},{"folderName":"Position","children":[{"functionName":"PutOnGround"},{"functionName":"GroundZ"},{"functionName":"GroundSlope"}]}]},"propertyDescriptors":[{"value":"Hills","type":"Choice","label":"Relief","description":"The initial shape, before sculpting.","group":"Shape","choices":[{"label":"Flat","value":"Flat"},{"label":"Hills","value":"Hills"},{"label":"Mountains","value":"Mountains"},{"label":"Island","value":"Island"}],"name":"Relief"},{"value":"1","type":"Number","label":"Seed","description":"Each seed gives a different terrain with the same relief.","group":"Shape","name":"Seed"},{"value":"","type":"Resource","label":"Heightmap image","description":"Optional. Replaces the relief: black is the lowest, white the highest (the object depth).","group":"Shape","extraInformation":["image"],"choices":[],"name":"HeightmapImage"},{"value":"","type":"MultilineString","label":"Edits","description":"Changes of the relief or heightmap, applied in order, as a JSON list, for example [{\"tool\": \"raise\", \"x\": 0.3, \"y\": 0.4, \"radius\": 0.15, \"height\": 0.4}, {\"tool\": \"paint\", \"x\": 0.1, \"y\": 0.9, \"toX\": 0.8, \"toY\": 0.2, \"radius\": 0.02, \"layer\": 2}]. Tools: raise (height added to the ground, negative to lower), flatten (z: the ground is brought to this height, fully at the center, cutting what is above it and filling what is below; with toX and toY, toZ gives the height at the end of the line, for a road going up), smooth (strength), paint (layer, from 1 to 4, and strength), tint (color, like \"120;140;60\", multiplying the layers, white removing the tint, and strength), wetness (amount, from 0 for dry to 1 for wet, and strength), hole (no ground in the radius, for the entrances of tunnels and caves) and fill (the holes in the radius are filled with the layers of the ground around them). x, y and radius are fractions (0 to 1) of the terrain size (x is (scene X - terrain X) / terrain width). height and z are fractions of its depth: the ground at z is at Z = terrain Z + z * terrain depth. Add toX and toY to change the ground along a line (paths, rivers, ridges). Shown in the scene editor.","group":"Shape","advanced":true,"name":"Edits"},{"value":"256","type":"Choice","label":"Resolution","description":"The number of cells on each side of the terrain. Higher is more detailed but slower.","group":"Shape","choices":[{"label":"64 x 64","value":"64"},{"label":"128 x 128","value":"128"},{"label":"256 x 256","value":"256"},{"label":"512 x 512","value":"512"},{"label":"1024 x 1024","value":"1024"}],"name":"Resolution"},{"value":"96;160;64","type":"Color","label":"Layer 1 color (grass)","group":"Layers","name":"Layer1Color"},{"value":"","type":"Resource","label":"Layer 1 texture","description":"Optional. Tinted by the layer color.","group":"Layers","extraInformation":["image"],"choices":[],"name":"Layer1Texture"},{"value":"","type":"Resource","label":"Layer 1 normal map","description":"Optional. The bumps of the texture, lit by the lights (an OpenGL normal map, like the textures of ambientCG).","group":"Layers","extraInformation":["image"],"choices":[],"name":"Layer1NormalMap"},{"value":"150;112;72","type":"Color","label":"Layer 2 color (dirt)","group":"Layers","name":"Layer2Color"},{"value":"","type":"Resource","label":"Layer 2 texture","description":"Optional. Tinted by the layer color.","group":"Layers","extraInformation":["image"],"choices":[],"name":"Layer2Texture"},{"value":"","type":"Resource","label":"Layer 2 normal map","description":"Optional. The bumps of the texture, lit by the lights (an OpenGL normal map, like the textures of ambientCG).","group":"Layers","extraInformation":["image"],"choices":[],"name":"Layer2NormalMap"},{"value":"124;118;112","type":"Color","label":"Layer 3 color (rock)","group":"Layers","name":"Layer3Color"},{"value":"","type":"Resource","label":"Layer 3 texture","description":"Optional. Tinted by the layer color.","group":"Layers","extraInformation":["image"],"choices":[],"name":"Layer3Texture"},{"value":"","type":"Resource","label":"Layer 3 normal map","description":"Optional. The bumps of the texture, lit by the lights (an OpenGL normal map, like the textures of ambientCG).","group":"Layers","extraInformation":["image"],"choices":[],"name":"Layer3NormalMap"},{"value":"224;204;148","type":"Color","label":"Layer 4 color (sand)","group":"Layers","name":"Layer4Color"},{"value":"","type":"Resource","label":"Layer 4 texture","description":"Optional. Tinted by the layer color.","group":"Layers","extraInformation":["image"],"choices":[],"name":"Layer4Texture"},{"value":"","type":"Resource","label":"Layer 4 normal map","description":"Optional. The bumps of the texture, lit by the lights (an OpenGL normal map, like the textures of ambientCG).","group":"Layers","extraInformation":["image"],"choices":[],"name":"Layer4NormalMap"},{"value":"1","type":"Number","label":"Normal map strength","description":"How much the normal maps bump the ground: 0 for none, 1 as they are, more to exaggerate them.","group":"Layers","name":"NormalMapStrength"},{"value":"256","type":"Number","unit":"Pixel","label":"Texture size","description":"The size, in the scene, of one repetition of the layer textures.","group":"Layers","name":"TextureSize"},{"value":"0.5","type":"Number","label":"Height blending","description":"Where layers meet, the bright parts of textures (stones, tufts) cover the dark ones (gaps, sand) instead of fading into each other: 0 for none, 1 for the most.","group":"Layers","name":"HeightBlending"},{"value":"0.5","type":"Number","label":"Texture variation","description":"Makes the repetition of textures less visible, with patches of bigger and rotated textures and colors slowly varying: 0 for none, 1 for the most.","group":"Layers","name":"TextureVariation"},{"value":"false","type":"Boolean","label":"Wet shore","description":"Make the ground wet (darker and shiny) under a Z position, like the sand of a beach near the water.","group":"Wetness","name":"WetShore"},{"value":"0","type":"Number","unit":"Pixel","label":"Wet below Z","description":"The ground is wet under this Z position (for example, the Z of a 3D water object).","group":"Wetness","name":"WetShoreZ"},{"value":"60","type":"Number","unit":"Pixel","label":"Wet shore fade","description":"The ground becomes dry over this height above \"Wet below Z\".","group":"Wetness","name":"WetShoreFade"},{"value":"3","type":"Choice","label":"Layer on steep slopes","description":"This layer is shown where the ground is steep, whatever is painted.","group":"Layers","choices":[{"label":"None","value":"0"},{"label":"Layer 1","value":"1"},{"label":"Layer 2","value":"2"},{"label":"Layer 3","value":"3"},{"label":"Layer 4","value":"4"}],"name":"CliffLayer"},{"value":"45","type":"Number","unit":"DegreeAngle","label":"Steep slope angle","group":"Layers","name":"CliffAngle"},{"value":"true","type":"Boolean","label":"Cast shadows","group":"Rendering","name":"CastShadow"},{"value":"true","type":"Boolean","label":"Receive shadows","group":"Rendering","name":"ReceiveShadow"},{"value":"4","type":"Choice","label":"Anisotropic filtering","description":"Keeps layer textures sharp where the ground is seen at a low angle (like from a car). Lower is faster on slow graphics cards, but blurs the ground in the distance.","group":"Rendering","choices":[{"label":"None (fastest)","value":"1"},{"label":"2x","value":"2"},{"label":"4x","value":"4"},{"label":"8x","value":"8"},{"label":"16x (sharpest)","value":"16"}],"advanced":true,"name":"Anisotropy"},{"value":"","type":"String","label":"Sculpted and painted data","description":"Written by the sculpt and paint tools of the scene editor, in a compact format not meant to be read or written by hand: use Edits instead. Clear it to go back to the relief, heightmap and edits.","advanced":true,"name":"SculptData"}],"propertiesFolderStructure":{"folderName":"__ROOT","children":[{"folderName":"Shape","children":[{"propertyName":"Relief"},{"propertyName":"Seed"},{"propertyName":"HeightmapImage"},{"propertyName":"Edits"},{"propertyName":"Resolution"}]},{"folderName":"Layers","children":[{"propertyName":"Layer1Color"},{"propertyName":"Layer1Texture"},{"propertyName":"Layer1NormalMap"},{"propertyName":"Layer2Color"},{"propertyName":"Layer2Texture"},{"propertyName":"Layer2NormalMap"},{"propertyName":"Layer3Color"},{"propertyName":"Layer3Texture"},{"propertyName":"Layer3NormalMap"},{"propertyName":"Layer4Color"},{"propertyName":"Layer4Texture"},{"propertyName":"Layer4NormalMap"},{"propertyName":"NormalMapStrength"},{"propertyName":"TextureSize"},{"propertyName":"HeightBlending"},{"propertyName":"TextureVariation"},{"propertyName":"CliffLayer"},{"propertyName":"CliffAngle"}]},{"folderName":"Wetness","children":[{"propertyName":"WetShore"},{"propertyName":"WetShoreZ"},{"propertyName":"WetShoreFade"}]},{"folderName":"Rendering","children":[{"propertyName":"CastShadow"},{"propertyName":"ReceiveShadow"},{"propertyName":"Anisotropy"}]},{"propertyName":"SculptData"}]},"variants":[]},{"areaMaxX":1000,"areaMaxY":1000,"areaMaxZ":40,"areaMinX":0,"areaMinY":0,"areaMinZ":0,"defaultName":"Grass","description":"A field of grass blades swaying in the wind and pushed aside by characters. They grow in the area of the object, on the highest 3D terrain at each point (one field can cover several terrains), or at the Z position of the object where there is no terrain.","fullName":"Terrain grass","helpPath":"","iconUrl":"data:image/svg+xml;base64,","is3D":true,"isUsingLegacyInstancesRenderer":true,"name":"TerrainGrass","previewIconUrl":"https://asset-resources.gdevelop.io/public-resources/Icons/732ef90b7fcf5dd9171fe95d0cf262e09159b487304915a4693baa893d9ce16c_grass.svg","objects":[{"assetStoreId":"","name":"AreaPlaceholder","type":"Scene3D::Cube3DObject","variables":[],"effects":[],"behaviors":[],"content":{"width":1000.0,"height":1000.0,"depth":40.0,"enableTextureTransparency":false,"facesOrientation":"Y","backFaceUpThroughWhichAxisRotation":"X","materialType":"Basic","tint":"255;255;255","frontFaceResourceName":"","frontFaceVisible":false,"frontFaceResourceRepeat":false,"backFaceResourceName":"","backFaceVisible":false,"backFaceResourceRepeat":false,"leftFaceResourceName":"","leftFaceVisible":false,"leftFaceResourceRepeat":false,"rightFaceResourceName":"","rightFaceVisible":false,"rightFaceResourceRepeat":false,"topFaceResourceName":"","topFaceVisible":false,"topFaceResourceRepeat":false,"bottomFaceResourceName":"","bottomFaceVisible":false,"bottomFaceResourceRepeat":false}}],"objectsFolderStructure":{"folderName":"__ROOT","children":[{"objectName":"AreaPlaceholder"}]},"objectsGroups":[],"layers":[{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"","renderingType":"","visibility":true,"cameras":[{"defaultSize":true,"defaultViewport":true,"height":0.0,"viewportBottom":1.0,"viewportLeft":0.0,"viewportRight":1.0,"viewportTop":0.0,"width":0.0}],"effects":[]}],"instances":[{"angle":0.0,"customSize":true,"depth":40.0,"height":1000.0,"keepRatio":true,"layer":"","name":"AreaPlaceholder","persistentUuid":"5d7a8b1e-3c2f-4e6a-9b1d-001000001000","width":1000.0,"x":0.0,"y":0.0,"zOrder":1,"numberProperties":[],"stringProperties":[],"initialVariables":[]}],"editionSettings":{},"eventsFunctions":[{"fullName":"","functionType":"Action","name":"onCreated","sentence":"","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"Terrain3D::DefineHelperClasses"},"parameters":["",""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"Terrain3D::DefineGrassHelperClasses"},"parameters":["",""]}]},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","for (const child of object.getChildrenContainer().getAdhocListOfAllInstances()) {","    child.deleteFromScene();","}","if (object.__terrainGrass) object.__terrainGrass.dispose();","object.__terrainGrass = new gdjs.__terrainGrassExtension.Grass(object);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Terrain3D::TerrainGrass","type":"object"}],"objectGroups":[]},{"fullName":"","functionType":"Action","name":"onDestroy","sentence":"","events":[{"type":"BuiltinCommonInstruc