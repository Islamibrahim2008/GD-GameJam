"},"parameters":["AmbushPhase","=","0"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["AmbushX","=","Zombie.CenterX() + RandomInRange(-400, 400)"]},{"type":{"value":"SetNumberVariable"},"parameters":["AmbushY","=","Zombie.CenterY() + RandomInRange(-400, 400)"]}]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["WdIdleT",">","4.5"]},{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["WdStage","=","2"]},{"type":{"inverted":true,"value":"StringVariable"},"parameters":["MonsterState","=","\"Chase\""]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["LastMoveX","=","-99999"]},{"type":{"value":"SetNumberVariable"},"parameters":["LastMoveY","=","-99999"]},{"type":{"value":"SetNumberVariable"},"parameters":["WdStage","=","3"]},{"type":{"value":"SetNumberVariable"},"parameters":["PatrolFail","+","1"]},{"type":{"value":"SetNumberVariable"},"parameters":["PatX","=","Player.CenterX() + RandomInRange(-350, 350)"]},{"type":{"value":"SetNumberVariable"},"parameters":["PatY","=","Player.CenterY() + RandomInRange(-350, 350)"]},{"type":{"value":"SetNumberVariable"},"parameters":["PatReady","=","1"]},{"type":{"value":"ResetTimer"},"parameters":["","\"PatrolTimer\""]},{"type":{"value":"SetNumberVariable"},"parameters":["SearchX","=","PatX"]},{"type":{"value":"SetNumberVariable"},"parameters":["SearchY","=","PatY"]},{"type":{"value":"SetNumberVariable"},"parameters":["SearchArrived","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["LLM_TargetOK","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["LLM_AmbushOK","=","0"]}],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringVariable"},"parameters":["MonsterState","=","\"Ambush\""]},{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["AmbushPhase","=","0"]}],"actions":[{"type":{"value":"SetNumberVariable