},{"propertyName":"OpenDuration"}]},{"folderName":"Pickup","children":[{"propertyName":"Quantity"},{"propertyName":"KeepAfterPickup"}]},{"folderName":"Use","children":[{"propertyName":"Toggled"}]}]}},{"description":"Solid object that blocks the aim (walls, furniture...) so interactables behind it cannot be targeted. Closed interactables already block by themselves.","fullName":"Interaction blocker","helpPath":"","iconUrl":"","name":"InteractionBlocker","objectType":"","previewIconUrl":"","eventsFunctions":[{"fullName":"onCreated","functionType":"Action","group":"Universal interaction","name":"onCreated","sentence":"","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"UniversalInteraction::DeclareLibrary"},"parameters":[""]}]},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const object = objects[0];","const lib = gdjs._universalInteraction; if (!lib) return;","const behavior = object.getBehavior(eventsFunctionContext.getBehaviorName(\"Behavior\"));","lib.registerBlocker(object, behavior, typeof runtimeScene !== 'undefined' ? runtimeScene : null);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":true}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"UniversalInteraction::InteractionBlocker","type":"behavior"}],"objectGroups":[]},{"fullName":"onDestroy","functionType":"Action","group":"Universal interaction","name":"onDestroy","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const object = objects[0];","const behavior = object.getBehavior(eventsFunctionContext.getBehaviorName(\"Behavior\"));","const lib = gdjs._universalInteraction; if (!lib) return;","lib.unregisterBlocker(object, behavior, typeof runtimeScene !== 'undefined' ? runtimeScene : null);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":true}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"UniversalInteraction::InteractionBlocker","type":"behavior"}],"objectGroups":[]}],"eventsFunctionsFolderStructure":{"folderName":"__ROOT","children":[{"folderName":"Universal interaction","children":[{"functionName":"onCreated"},{"functionName":"onDestroy"}]}]},"propertyDescriptors":[],"propertiesFolderStructure":{"folderName":"__ROOT"}}],"eventsBasedObjects":[]},{"author":"Islam Ibrahim / Carrots Team","category":"Advanced","dimension":"","extensionNamespace":"","fullName":"Advanced MathTools","gdevelopVersion":"","helpPath":"","iconUrl":"","name":"AdvancedMathTools","previewIconUrl":"","shortDescription":"Vector2/Vector3, Quaternion, Matrix3/Matrix4 and advanced math (SmoothDamp, InverseLerp, angles, easing) powered by Three.js r185.","version":"1.0.0","description":"Math toolkit built on Three.js (r185). Vectors, quaternions and matrices are stored as named registers (strings) and manipulated with actions; read results with expressions. Rotations use degrees. GDevelop 3D objects use the ZYX Euler order.","tags":["math","vector","quaternion","matrix","three","3d","smoothdamp","lerp","angle","easing"],"authorIds":[],"dependencies":[],"globalVariables":[],"sceneVariables":[],"eventsFunctions":[{"description":"Installs the math library.","fullName":"","functionType":"Action","name":"onFirstSceneLoaded","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["(function(){","const T=(typeof THREE!=='undefined')?THREE:((typeof window!=='undefined'&&window.THREE)||gdjs.THREE||null);","const M=gdjs.advancedMathTools={T:T,DEG:Math.PI/180,store:{v2:new Map(),v3:new Map(),q:new Map(),m4:new Map(),m3:new Map()},sv:new Map(),revision:0};","if(!T){console.error('[Advanced MathTools] THREE was not found. Make sure the project uses 3D (a 3D object) so Three.js is loaded.');return;}","M.revision=parseInt(T.REVISION)||0;","if(M.revision&&M.revision<150)console.warn('[Advanced MathTools] Three.js r'+M.revision+' detected; this extension targets r185.');","const reg=(k,C)=>n=>{n=String(n);const m=M.store[k];let o=m.get(n);if(!o){o=new C();m.set(n,o);}return o;};","M.v2=reg('v2',T.Vector2);M.v3=reg('v3',T.Vector3);M.q=reg('q',T.Quaternion);M.m4=reg('m4',T.Matrix4);M.m3=reg('m3',T.Matrix3);","M.dt=(rs,x)=>x>0?x:(rs.getElapsedTime()/1000);","M.clamp=(v,a,b)=>Math.max(a,Math.min(b,v));","M.repeat=(t,l)=>l===0?0:t-Math.floor(t/l)*l;","M.pingPong=(t,l)=>{if(l===0)return 0;t=M.repeat(t,l*2);return l-Math.abs(t-l);};","M.deltaAngle=(a,b)=>{const d=M.repeat(b-a,360);return d>180?d-360:d;};","M.smoothDamp=(cur,tgt,name,st,ms,dt)=>{st=Math.max(1e-4,st);ms=ms>0?ms:Infinity;let v=M.sv.get(name)||0;const o=2/st,x=o*dt,e=1/(1+x+0.48*x*x+0.235*x*x*x);let ch=cur-tgt;const orig=tgt,mc=ms*st;ch=M.clamp(ch,-mc,mc);tgt=cur-ch;const tmp=(v+o*ch)*dt;v=(v-o*tmp)*e;let out=tgt+(ch+tmp)*e;if((orig-cur>0)===(out>orig)){out=orig;v=dt>0?(out-orig)/dt:0;}M.sv.set(name,v);return out;};","M.smoothDampVec=(cur,tgt,vel,st,ms,dt,out)=>{st=Math.max(1e-4,st);ms=ms>0?ms:Infinity;const o=2/st,x=o*dt,e=1/(1+x+0.48*x*x+0.235*x*x*x);const orig=tgt.clone();const ch=cur.clone().sub(tgt);ch.clampLength(0,ms*st);const t2=cur.clone().sub(ch);const tmp=vel.clone().addScaledVector(ch,o).multiplyScalar(dt);vel.sub(tmp.clone().multiplyScalar(o)).multiplyScalar(e);const res=t2.add(ch.add(tmp).multiplyScalar(e));if(orig.clone().sub(cur).dot(res.clone().sub(orig))>0){res.copy(orig);vel.multiplyScalar(0);}out.copy(res);return out;};","M.moveVec=(a,b,max,out)=>{const d=b.clone().sub(a),l=d.length();if(l<=max||l<1e-12)return out.copy(b);return out.copy(a.clone().addScaledVector(d,max/l));};","M.slerpV3=(a,b,t,out)=>{const la=a.length(),lb=b.length();if(la<1e-9||lb<1e-9)return out.copy(a.clone().lerp(b,t));const na=a.clone().divideScalar(la),nb=b.clone().divideScalar(lb);const th=Math.acos(M.clamp(na.dot(nb),-1,1)),len=la+(lb-la)*t;if(th<1e-6)return out.copy(na).multiplyScalar(len);if(Math.PI-th<1e-6){const ax=Math.abs(na.x)<0.9?new T.Vector3(1,0,0):new T.Vector3(0,1,0);ax.cross(na).normalize();return out.copy(na.applyAxisAngle(ax,Math.PI*t)).multiplyScalar(len);}const s=Math.sin(th),w1=Math.sin((1-t)*th)/s,w2=Math.sin(t*th)/s;return out.set(0,0,0).addScaledVector(na,w1).addScaledVector(nb,w2).multiplyScalar(len);};","M.bez2=(a,b,c,t)=>{const u=1-t;return u*u*a+2*u*t*b+t*t*c;};","M.bez3=(a,b,c,d,t)=>{const u=1-t;return u*u*u*a+3*u*u*t*b+3*u*t*t*c+t*t*t*d;};","M.cr=(p0,p1,p2,p3,t)=>0.5*((2*p1)+(-p0+p2)*t+(2*p0-5*p1+4*p2-p3)*t*t+(-p0+3*p1-3*p2+p3)*t*t*t);","M.map2=(vs,t,f,o)=>o.set(f(...vs.map(v=>v.x),t),f(...vs.map(v=>v.y),t));","M.map3=(vs,t,f,o)=>o.set(f(...vs.map(v=>v.x),t),f(...vs.map(v=>v.y),t),f(...vs.map(v=>v.z),t));","M.axisAngle=q=>{q=q.clone().normalize();const sg=q.w<0?-1:1,w=Math.min(1,Math.abs(q.w)),s=Math.sqrt(1-w*w);if(s<1e-6)return{angle:0,x:1,y:0,z:0};return{angle:2*Math.acos(w)/M.DEG,x:sg*q.x/s,y:sg*q.y/s,z:sg*q.z/s};};","const c1=1.70158,c3=c1+1,c4=2*Math.PI/3;","const bo=x=>{const n=7.5625,d=2.75;if(x<1/d)return n*x*x;if(x<2/d)return n*(x-=1.5/d)*x+0.75;if(x<2.5/d)return n*(x-=2.25/d)*x+0.9375;return n*(x-=2.625/d)*x+0.984375;};","const FAM={sine:{i:x=>1-Math.cos(x*Math.PI/2)},quad:{i:x=>x*x},cubic:{i:x=>x*x*x},quart:{i:x=>x*x*x*x},quint:{i:x=>x*x*x*x*x},","expo:{i:x=>x===0?0:Math.pow(2,10*x-10)},circ:{i:x=>1-Math.sqrt(1-x*x)},back:{i:x=>c3*x*x*x-c1*x*x},","elastic:{i:x=>x===0?0:x===1?1:-Math.pow(2,10*x-10)*Math.sin((x*10-10.75)*c4),o:x=>x===0?0:x===1?1:Math.pow(2,-10*x)*Math.sin((x*10-0.75)*c4)+1},","bounce:{i:x=>1-bo(1-x),o:bo}};","M.ease=(type,t)=>{t=M.clamp(t,0,1);const m=/^(linear|sine|quad|cubic|quart|quint|expo|circ|back|elastic|bounce)(In|Out|InOut)?$/.exec(String(type||'linear'));if(!m||m[1]==='linear')return t;const f=FAM[m[1]],I=f.i,O=f.o||(x=>1-f.i(1-x)),mode=m[2]||'In';if(mode==='In')return I(t);if(mode==='Out')return O(t);return t<0.5?I(t*2)/2:0.5+O(t*2-1)/2;};","})();",""],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[],"objectGroups":[]},{"description":"Set Vector2","fullName":"Set Vector2","functionType":"Action","group":"Vector2","name":"Vec2Set","sentence":"Set Vector2 _PARAM1_ to (_PARAM2_; _PARAM3_)","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["if(!gdjs.advancedMathTools||!gdjs.advancedMathTools.T){console.error('[Advanced MathTools] Library not ready: Three.js (THREE) was not found.');return;}","const M=gdjs.advancedMathTools,T=M.T,D=M.DEG,g=n=>eventsFunctionContext.getArgument(n),N=n=>Number(g(n))||0,V2=n=>M.v2(g(n)),V3=n=>M.v3(g(n)),Q=n=>M.q(g(n)),M4=n=>M.m4(g(n)),M3=n=>M.m3(g(n)),R=v=>{eventsFunctionContext.returnValue=v;},O=()=>eventsFunctionContext.getObjects('Object'),DT=()=>M.dt(runtimeScene,N('DeltaTime'));","V2('Name').set(N('X'),N('Y'))",""],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[{"description":"Vector2 name","name":"Name","type":"string"},{"description":"X","name":"X","type":"expression"},{"description":"Y","name":"Y","type":"expression"}],"objectGroups":[]},{"description":"Copy Vector2","fullName":"Copy Vector2","functionType":"Action","group":"Vector2","name":"Vec2Copy","sentence":"Copy Vector2 _PARAM1_ into _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["if(!gdjs.advancedMathTools||!gdjs.advancedMathTools.T){console.error('[Advanced MathTools] Library not ready: Three.js (THREE) was not found.');return;}","const M=gdjs.advancedMathTools,T=M.T,D=M.DEG,g=n=>eventsFunctionContext.getArgument(n),N=n=>Number(g(n))||0,V2=n=>M.v2(g(n)),V3=n=>M.v3(g(n)),Q=n=>M.q(g(n)),M4=n=>M.m4(g(n)),M3=n=>M.m3(g(n)),R=v=>{eventsFunctionContext.returnValue=v;},O=()=>eventsFunctionContext.getObjects('Object'),DT=()=>M.dt(runtimeScene,N('DeltaTime'));","V2('Target').copy(V2('Source'))",""],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[{"description":"Vector2 name","name":"Source","type":"string"},{