ame":"doStepPostEvents"},{"functionName":"onHotReloading"}]},"propertyDescriptors":[{"value":"60","type":"Number","label":"Density","description":"The number of blades in a square of 100 x 100 pixels.","group":"Blades","name":"Density"},{"value":"36","type":"Number","unit":"Pixel","label":"Blade height","description":"The average height of blades (each blade is between 60% and 140% of it).","group":"Blades","name":"BladeHeight"},{"value":"5","type":"Number","unit":"Pixel","label":"Blade width","group":"Blades","name":"BladeWidth"},{"value":"52;104;36","type":"Color","label":"Base color","group":"Blades","name":"BaseColor"},{"value":"150;196;82","type":"Color","label":"Tip color","group":"Blades","name":"TipColor"},{"value":"1","type":"Number","label":"Seed","description":"Each seed places blades differently.","group":"Blades","name":"Seed"},{"value":"1","type":"Choice","label":"Grows on terrain layer","description":"On a 3D terrain, blades only grow where this layer is painted. A new terrain has layer 1 painted everywhere.","group":"Ground","choices":[{"label":"Any","value":"0"},{"label":"Layer 1","value":"1"},{"label":"Layer 2","value":"2"},{"label":"Layer 3","value":"3"},{"label":"Layer 4","value":"4"}],"name":"GroundLayer"},{"value":"40","type":"Number","unit":"DegreeAngle","label":"Maximum slope","description":"No blades grow on steeper ground.","group":"Ground","name":"MaxSlope"},{"value":"1","type":"Number","label":"Wind strength","description":"0 for no wind.","group":"Wind","name":"WindStrength"},{"value":"2","type":"Number","label":"Wind speed","group":"Wind","name":"WindSpeed"},{"value":"","type":"String","label":"Object bending the grass","description":"The name of an object pushing blades aside when walking through the grass, like the player. The 8 first instances are used.","group":"Wind","name":"BendingObject"},{"value":"2500","type":"Number","unit":"Pixel","label":"Fade distance","description":"Blades are less and less dense up to this distance from the camera, and hidden after.","group":"Rendering","name":"FadeDistance"}],"propertiesFolderStructure":{"folderName":"__ROOT","children":[{"folderName":"Blades","children":[{"propertyName":"Density"},{"propertyName":"BladeHeight"},{"propertyName":"BladeWidth"},{"propertyName":"BaseColor"},{"propertyName":"TipColor"},{"propertyName":"Seed"}]},{"folderName":"Ground","children":[{"propertyName":"GroundLayer"},{"propertyName":"MaxSlope"}]},{"folderName":"Wind","children":[{"propertyName":"WindStrength"},{"propertyName":"WindSpeed"},{"propertyName":"BendingObject"}]},{"folderName":"Rendering","children":[{"propertyName":"FadeDistance"}]}]},"variants":[]},{"areaMaxX":2000,"areaMaxY":2000,"areaMaxZ":200,"areaMinX":0,"areaMinY":0,"areaMinZ":0,"assetStoreTag":"3d scattered models","defaultName":"ScatteredModels","description":"Many copies of a 3D model (trees, rocks, bushes, flowers...) placed in the area of the object and drawn all at once, which is much faster than an object for each one. They stand on the highest 3D terrain at each point, or at the Z position of the object where there is no terrain. Paint where they grow with the brushes of the scene editor.","fullName":"Scattered models (forests, rocks...)","helpPath":"","iconUrl":"data:image/svg+xml;base64,PD94bWwgdmVyc2lvbj0iMS4wIiBlbmNvZGluZz0iVVRGLTgiPz48c3ZnIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyIgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiB2aWV3Qm94PSIwIDAgMjQgMjQiPjxwYXRoIGQ9Ik0xMCAyMXYtM0gzbDUtNUg1bDUtNUg3bDUtNSA1IDVoLTNsNSA1aC0zbDUgNWgtN3YzeiIvPjwvc3ZnPg==","is3D":true,"isUsingLegacyInstancesRenderer":true,"name":"ScatteredModels","previewIconUrl":"","objects":[{"assetStoreId":"","name":"AreaPlaceholder","type":"Scene3D::Cube3DObject","variables":[],"effects":[],"behaviors":[],"content":{"width":2000.0,"height":2000.0,"depth":200.0,"enableTextureTransparency":false,"facesOrientation":"Y","backFaceUpThroughWhichAxisRotation":"X","materialType":"Basic","tint":"255;255;255","frontFaceResourceName":"","frontFaceVisible":fa