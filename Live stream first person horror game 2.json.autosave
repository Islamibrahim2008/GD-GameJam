"parameters":["AnimLock","=","Cfg_AnimMinHold"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"inverted":true,"value":"StringVariable"},"parameters":["DesiredAnim","=","CurAnim"]},{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["OneShotTime",">","0"]}],"actions":[{"type":{"value":"AnimatableCapability::AnimatableBehavior::SetName"},"parameters":["Zombie","Animation","=","DesiredAnim"]},{"type":{"value":"SetStringVariable"},"parameters":["CurAnim","=","DesiredAnim"]},{"type":{"value":"SetNumberVariable"},"parameters":["AnimLock","=","Cfg_AnimMinHold"]}]}],"parameters":[]},{"aiGeneratedEventId":"01M6Y0YPM3MFX89PHM5D42WG7H","colorB":228,"colorG":176,"colorR":74,"creationTime":0,"folded":true,"name":"02 — Patrol Net (JS waypoints)","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"PATROL NET (JS). The monster learns WALKABLE waypoints by itself (player trail + its own trail, saved between runs) and also uses any object named PatrolPoint you place in the scene. When the brain asks for a patrol target, this picks the best waypoint: not visited for long, near player hotspots, near the predicted player area (more with Cunning), no U-turns, never the last 4, with a bit of randomness. Unreachable points get penalised and removed. If fewer than 4 waypoints are known, the old random patrol is used."},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["(function () {","  try {","    const S = runtimeScene;","    const vars = S.getVariables();","    const num = (n) => { try { return vars.get(n).getAsNumber(); } catch (e) { return 0; } };","    const str = (n) => { try { return vars.get(n).getAsString(); } catch (e) { return \"\"; } };","    const put = (n, v) => { try { vars.get(n).setNumber(v); } catch (e) {} };","    const now = S.getTimeManager().getTimeFromStart() / 1000;","    const zs = S.getObjects(\"Zombie\") || [], ps = S.getObjects(\"Player\") || [];","    if (!zs.length || !ps.length) return;","    const z = zs[0], p = ps[0];","    const zx = z.getCenterX(), zy = z.getCenterY(), px = p.getCenterX(), py = p.getCenterY();","","    // ===== PATROL NET: the monster learns WALKABLE ground (player trail + its own trail + optional PatrolPoint objects) =====","    const KEY = \"monster_patrol_net_v1\", SPACING = 220, MAXN = 160;","    let net = S._patrolNet;","    if (!net) {","      net = S._patrolNet = { nodes: [], cur: null, lastCount: -1, lastStage: 0, sampleT: 0, objT: -99, decT: now, saveT: now, recent: [], hx: 1, hy: 0, picks: 0, fails: 0 };","      try {","        const raw = window.localStorage && window.localStorage.getItem(KEY);","        if (raw) JSON.parse(raw).slice(0, MAXN).forEach((n) => { if (isFinite(n.x) && isFinite(n.y)) net.nodes.push({ x: n.x, y: n.y, vis: -999, fail: 0, src: \"trail\", born: 0 }); });","      } catch (e) {}","    }","    const nearest = (x, y, onlySrc) => {","      let b = null, bd = 1e9;","      for (const n of net.nodes) { if (onlySrc && n.src !== onlySrc) continue; const d = Math.hypot(n.x - x, n.y - y); if (d < bd) { bd = d; b = n; } }","      return { n: b, d: bd };","    };","    const addNode = (x, y, src) => {","      if (src === \"obj\") {","        if (nearest(x, y, \"obj\").d < 40) return;","        net.nodes.push({ x, y, vis: now - 60, fail: 0, src: \"obj\", born: now });","        return;","      }","      if (nearest(x, y).d < SPACING) return;","      net.nodes.push({ x, y, vis: now - 30, fail: 0, src: \"trail\", born: now });","      if (net.nodes.length > MAXN) {","        let idx = -1, oldest = 1e12;","        net.nodes.forEach((n, i) => { if (n.src !== \"obj\" && n !== net.cur && n.born < oldest) { oldest = n.born; idx = i; } });","        if (idx >= 0) net.nodes.splice(idx, 1);","      }","    };","    const pick = () => {","      if (net.nodes.length < 4) return null;","      const cun = num(\"Cunning\"), ppx = px + num(\"PlayerVelX\") * 2, ppy = py + num(\"PlayerVelY\") * 2;","      const mem = [];","      for (let i = 1; i <= 6; i++) { const w = num(\"Mem\" + i + \"W\"); if (w > 0.05) mem.push({ x: num(\"Mem\" + i + \"X\"), y: num(\"Mem\" + i + \"Y\"), w }); }","      let best = null, bs = -1e9;","      for (const n of net.nodes) {","        if (n.fail >= 3 || net.recent.indexOf(n) >= 0) continue;","        const dz = Math.hypot(n.x - zx, n.y - zy);","        if (dz < 350) continue;","        let s = Math.min((now - n.vis) / 60, 1.5);                       // not visited for a long time","        let h = 0; for (const m of mem) h += m.w / (1 + Math.hypot(n.x - m.x, n.y - m.y) / 400);","        s += 0.5 * Math.min(h, 3);                                        // where the player hangs out","        s += (0.25 + 0.75 * cun) * (1 - Math.min(Math.hypot(n.x - ppx, n.y - ppy), 3000) / 3000); // predicted player area (grows with cunning)","        if (n.src === \"obj\") s += 0.25;                                   // hand-placed points are trusted","        s -= 0.6 * Math.min(dz, 3000) / 3000;                             // prefer not-too-far","        s += 0.15 * (((n.x - zx) / dz) * net.hx + ((n.y - zy) / dz) * net.hy); // avoid U-turns","        s -= 0.4 * n.fail;                                                // unreliable point","        s += Math.random() * 0.35;                                        // unpredictability","        if (s > bs) { bs = s; best = n; }","      }","      return best;","    };","","    // learn walkable ground","    if (now - net.sampleT > 0.25) { net.sampleT = now; addNode(px, py, \"trail\"); if (num(\"ZSpeed\") > 40) addNode(zx, zy, \"trail\"); }","    if (now - net.objT > 2) {","      net.objT = now;","      try { (S.getObjects(\"PatrolPoint\") || []).forEach((o) => addNode(o.getCenterX(), o.getCenterY(), \"obj\")); } catch (e) {}","    }","    if (now - net.decT > 30) { net.decT = now; net.nodes.forEach((n) => { if (n.fail > 0) n.fail--; }); }","","    const state = str(\"MonsterState\"), stg = num(\"WdStage\");","    // watchdog escalated -> the point we were heading to is unreachable: punish it","    if (stg >= 2 && net.lastStage < 2 && net.cur) {","      net.cur.fail++; net.cur.vis = now; net.fails++;","      if (net.cur.fail >= 3 && net.cur.src !== \"obj\") { const i = net.nodes.indexOf(net.cur); if (i >= 0) net.nodes.splice(i, 1); }","      net.cur = null;","    }","    net.lastStage = stg;","","    if (state === \"Patrol\") {","      const cnt = num(\"PatrolCount\");","      if (cnt !== net.lastCount) {                                        // the brain asked for a new patrol target","        net.lastCount = cnt;","        const n = pick();","        if (n) {","          net.cur = n; net.picks++;","          put(\"PatX\", n.x); put(\"PatY\", n.y); put(\"PatReady\", 1);","          net.recent.push(n); if (net.recent.length > 4) net.recent.shift();","          const L = Math.max(Math.hypot(n.x - zx, n.y - zy), 1); net.hx = (n.x - zx) / L; net.hy = (n.y - zy) / L;","        } else net.cur = null;","      } else if (net.cur) {","        if (Math.abs(num(\"PatX\") - net.cur.x) > 60 || Math.abs(num(\"PatY\") - net.cur.y) > 60) net.cur = null;   // LLM / watchdog took over","        else if (Math.hypot(zx - net.cur.x, zy - net.cur.y) < 170) { net.cur.vis = now; net.cur.fail = 0; net.cur = null; } // arrived","      }","    } else net.cur = null;","","    if (now - net.saveT > 10) {","      net.saveT = now;","      try { window.localStorage && window.localStorage.setItem(KEY, JSON.stringify(net.nodes.filter((n) => n.src === \"trail\").map((n) => ({ x: Math.round(n.x), y: Math.round(n.y) })))); } catch (e) {}","    }","    put(\"PatNodes\", net.nodes.length); put(\"PatPicks\", net.picks); put(\"PatFails\", net.fails);","  } catch (e) { try { console.error(\"PatrolNet:\", e); } catch (_) {} }","})();"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[]},{"aiGeneratedEventId":"01M6Y0YPM3MFX89PHM5D42WG7H","colorB":228,"colorG":176,"colorR":74,"creationTime":0,"folded":true,"name":"03 — Cunning (JS hotspot + hide)","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"SceneJustBegins"},"parameters":[""]}],"actions":[{"type":{"value":"ResetTimer"},"parameters":["","\"MonsterCunning\""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"CompareTimer"},"parameters":["","\"MonsterCunning\"",">","0.5"]}],"actions":[{"type":{"value":"ResetTimer"},"parameters":["","\"MonsterCunning\""]}],"events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["  const vars = runtimeScene.getVariables();","  const G = (n) => vars.get(n).getAsNumber();","  const S = (n, v) => vars.get(n).setNumber(v);","  const zombies = runtimeScene.getObjects(\"Zombie\");","  const players = runtimeScene.getObjects(\"Player\");","  if (!players.length || !zombies.length) return;","  const p = players[0];","  const z = zombies[0];","  const px = p.getCenterX(), py = p.getCenterY();","  const zx = z.getCenterX(), zy = z.getCenterY();","  const pvx = G(\"PlayerVelX\"), pvy = G(\"PlayerVelY\");","  const pred = Math.min(Math.max(G(\"Cfg_PredictTime\"), 0.5), 3);","  const predX = px + pvx * pred, predY = py + pvy * pred;","  const scale = Math.max(G(\"Cfg_MemDistScale\"), 1);","  const slots = [];","  for (let i = 1; i <= 6; i++) {","    const w = G(\"Mem\" + i + \"W\");","    if (w <= 0.01) continue;","    const mx = G(\"Mem\" + i + \"X\"), my = G(\"Mem\" + i + \"Y\");","    const dZ = Math.hypot(mx - zx, my - zy);","    const dP = Math.hypot(mx - predX, my - predY);","    let score = w / (1 + dZ / scale) + (w * 0.8) / (1 + dP / 600);","    slots.push({ i, mx, my, w, score });","  }","  slots.sort((a, b) => b.score - a.score);","  if (slots.length) {","    const best = slots[0];","    S(\"HotX\", best.mx); S(\"HotY\", best.my); S(\"HotScore\", best.score);","    vars.get(\"Mem\" + best.i + \"W\").setNumber(Math.min(best.w + 0.05, G(\"Cfg_MemMaxW\") || 5));","    const dx = best.mx - px, dy = best.my - py;","    const len = Math.max(Math.hypot(dx, dy), 1);","    const hideDist = 280 + G(\"Cunning\") * 220;","    const hx = best.mx + (dx / len) * hideDist;","    const hy = best.my + (dy / len) * hideDist;","    const state = vars.get(\"MonsterState\").getAsString();","    if (state === \"Ambush\" && G(\"AmbushPhase\") === 0) {","      S(\"AmbushX\", hx); S(\"AmbushY\", hy);","    }","    if (state === \"Stalk\" && G(\"GazeOnMonster\") === 1 && G(\"Cunning\") > 0.4) {","      S(\"TargetX\", hx); S(\"TargetY\", hy);","    }","  }"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringVariable"},"parameters":["MonsterState","=","\"Ambush\""]},{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["Cunning",">=","0.3"]},{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["HotScore",">","0.2"]},{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["AmbushPhase","=","0"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["AmbushX","=","HotX"]},{"type":{"value":"SetNumberVariable"},"parameters":["AmbushY","=","HotY"]}]}],"parameters":[]},{"aiGeneratedEventId":"01M6Y1006HGTMABW27TWFF5EBT","colorB":228,"colorG":176,"colorR":74,"creationTime":0,"folded":true,"name":"04 — Watchdog (Never-Idle FIX)","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"NEVER-IDLE WATCHDOG. Root cause of the 'monster stands still': the old stuck-check required 'path NOT finished', but when the NavMesh finds no path to a random target it reports 'destination reached' -> the check never fired and the same bad target was kept forever. Now: if the monster SHOULD be moving but isn't, escalate: (1) re-send MoveTo, (2) pick another target, (3) go near the player (always on the NavMesh), (4) hard reset to Patrol."},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"SceneJustBegins"},"parameters":[""]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["WdIdleT","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["WdStage","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["WdShould","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["WdTDist","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["PatSpeedMul","=","1"]},{"type":{"value":"SetNumberVariable"},"parameters":["PatrolFail","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["Cfg_PatrolSpeed","=","80"]},{"type":{"value":"ResetTimer"},"parameters":["","\"WdMem\""]},{"type":{"value":"ResetTimer"},"parameters":["","\"StuckTimer\""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["WdTDist","=","sqrt(pow(Zombie.CenterX() - TargetX, 2) + pow(Zombie.CenterY() - TargetY, 2))"]},{"type":{"value":"SetNumberVariable"},"parameters":["WdShould","=","1"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["ZSpeed",">=","15"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["WdShould","=","0"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["TargetSpeed","<=","20"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["WdShould","=","0"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["WdTDist","<=","200"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["WdShould","=","0"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["OneShotTime",">","0"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["WdShould","=","0"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["JS_Active","=","1"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["WdShould","=","0"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringVariable"},"parameters":["MonsterState","=","\"Grab\""]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["WdShould","=","0"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringVariable"},"parameters":["MonsterState","=","\"Ambush\""]},{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["AmbushPhase","=","1"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["WdShould","=","0"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringVariable"},"parameters":["MonsterState","=","\"Search\""]},{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["SearchArrived","=","1"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["WdShould","=","0"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["WdShould","=","1"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["WdIdleT","+","TimeDelta()"]}]},{"type":"BuiltinCommonInstructions::Else","conditions":[],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["WdIdleT","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["WdStage","=","0"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":[