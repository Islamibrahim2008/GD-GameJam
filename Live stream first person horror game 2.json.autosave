functionName":"Vec2QuadraticBezier"},{"functionName":"Vec2CubicBezier"},{"functionName":"Vec2CatmullRom"},{"functionName":"Vec2X"},{"functionName":"Vec2Y"},{"functionName":"Vec2Length"},{"functionName":"Vec2LengthSq"},{"functionName":"Vec2Dot"},{"functionName":"Vec2Distance"},{"functionName":"Vec2DistanceSq"},{"functionName":"Vec2ManhattanDistance"},{"functionName":"Vec2AngleBetween"},{"functionName":"Vec2ToString"},{"functionName":"Vec2Equals"},{"functionName":"Vec2IsZero"},{"functionName":"Vec2Rotate"},{"functionName":"Vec2RotateAround"},{"functionName":"Vec2Perpendicular"},{"functionName":"Vec2Project"},{"functionName":"Vec2FromAngle"},{"functionName":"Vec2FromObject"},{"functionName":"Vec2ToObject"},{"functionName":"Vec2Cross"},{"functionName":"Vec2AngleDeg"},{"functionName":"Vec2SignedAngle"}]},{"folderName":"Vector3","children":[{"functionName":"Vec3Set"},{"functionName":"Vec3Copy"},{"functionName":"Vec3Clear"},{"functionName":"Vec3Add"},{"functionName":"Vec3Sub"},{"functionName":"Vec3Mul"},{"functionName":"Vec3Div"},{"functionName":"Vec3Min"},{"functionName":"Vec3Max"},{"functionName":"Vec3Scale"},{"functionName":"Vec3Normalize"},{"functionName":"Vec3Negate"},{"functionName":"Vec3Lerp"},{"functionName":"Vec3MoveTowards"},{"functionName":"Vec3ClampLength"},{"functionName":"Vec3SetLength"},{"functionName":"Vec3Reflect"},{"functionName":"Vec3SmoothDamp"},{"functionName":"Vec3QuadraticBezier"},{"functionName":"Vec3CubicBezier"},{"functionName":"Vec3CatmullRom"},{"functionName":"Vec3X"},{"functionName":"Vec3Y"},{"functionName":"Vec3Z"},{"functionName":"Vec3Length"},{"functionName":"Vec3LengthSq"},{"functionName":"Vec3Dot"},{"functionName":"Vec3Distance"},{"functionName":"Vec3DistanceSq"},{"functionName":"Vec3ManhattanDistance"},{"functionName":"Vec3AngleBetween"},{"functionName":"Vec3ToString"},{"functionName":"Vec3Equals"},{"functionName":"Vec3IsZero"},{"functionName":"Vec3Cross"},{"functionName":"Vec3Slerp"},{"functionName":"Vec3ProjectOnVector"},{"functionName":"Vec3ProjectOnPlane"},{"functionName":"Vec3RotateAxis"},{"functionName":"Vec3ApplyEuler"},{"functionName":"Vec3ApplyQuaternion"},{"functionName":"Vec3ApplyMatrix4"},{"functionName":"Vec3TransformDirection"},{"functionName":"Vec3FromSpherical"},{"functionName":"Vec3FromPolarZUp"},{"functionName":"Vec3FromObject"},{"functionName":"Vec3ToObject"},{"functionName":"Vec3SignedAngle"},{"functionName":"Vec3Azimuth"},{"functionName":"Vec3Elevation"},{"functionName":"Vec3SphericalPhi"},{"functionName":"Vec3SphericalTheta"}]},{"folderName":"Quaternion","children":[{"functionName":"QuatIdentity"},{"functionName":"QuatSet"},{"functionName":"QuatCopy"},{"functionName":"QuatClear"},{"functionName":"QuatFromEuler"},{"functionName":"QuatFromAxisAngle"},{"functionName":"QuatFromMatrix"},{"functionName":"QuatFromUnitVectors"},{"functionName":"QuatLookRotation"},{"functionName":"QuatMultiply"},{"functionName":"QuatInvert"},{"functionName":"QuatConjugate"},{"functionName":"QuatNormalize"},{"functionName":"QuatSlerp"},{"functionName":"QuatRotateTowards"},{"functionName":"QuatToEuler"},{"functionName":"QuatGetAxisVector"},{"functionName":"QuatFromObject"},{"functionName":"QuatToObject"},{"functionName":"QuatX"},{"functionName":"QuatY"},{"functionName":"QuatZ"},{"functionName":"QuatW"},{"functionName":"QuatLength"},{"functionName":"QuatDot"},{"functionName":"QuatAngleBetween"},{"functionName":"QuatAngle"},{"functionName":"QuatAxisX"},{"functionName":"QuatAxisY"},{"functionName":"QuatAxisZ"},{"functionName":"QuatEulerX"},{"functionName":"QuatEulerY"},{"functionName":"QuatEulerZ"},{"functionName":"QuatToString"},{"functionName":"QuatEquals"}]},{"folderName":"Matrix4","children":[{"functionName":"Mat4Identity"},{"functionName":"Mat4Set"},{"functionName":"Mat4Copy"},{"functionName":"Mat4Clear"},{"functionName":"Mat4Multiply"},{"functionName":"Mat4MultiplyScalar"},{"functionName":"Mat4Invert"},{"functionName":"Mat4Transpose"},{"functionName":"Mat4Translation"},{"functionName":"Mat4Scale"},{"functionName":"Mat4RotationAxis"},{"functionName":"Mat4RotationEuler"},{"functionName":"Mat4RotationQuat"},{"functionName":"Mat4Shear"},{"functionName":"Mat4Compose"},{"functionName":"Mat4Decompose"},{"functionName":"Mat4LookAt"},{"functionName":"Mat4Perspective"},{"functionName":"Mat4Orthographic"},{"functionName":"Mat4MakeBasis"},{"functionName":"Mat4SetElement"},{"functionName":"Mat4GetPosition"},{"functionName":"Mat4GetScale"},{"functionName":"Mat4GetRotation"},{"functionName":"Mat4Element"},{"functionName":"Mat4Determinant"},{"functionName":"Mat4MaxScale"},{"functionName":"Mat4IsIdentity"},{"functionName":"Mat4Equals"}]},{"folderName":"Matrix3","children":[{"functionName":"Mat3Identity"},{"functionName":"Mat3Set"},{"functionName":"Mat3Copy"},{"functionName":"Mat3Clear"},{"functionName":"Mat3Multiply"},{"functionName":"Mat3Invert"},{"functionName":"Mat3Transpose"},{"functionName":"Mat3FromMatrix4"},{"functionName":"Mat3NormalMatrix"},{"functionName":"Mat3Translation2D"},{"functionName":"Mat3Rotation2D"},{"functionName":"Mat3Scale2D"},{"functionName":"Mat3UVTransform"},{"functionName":"Mat3TransformVec2"},{"functionName":"Mat3Element"},{"functionName":"Mat3Determinant"},{"functionName":"Mat3IsIdentity"}]},{"folderName":"Advanced Math","children":[{"functionName":"InverseLerp"},{"functionName":"InverseLerpUnclamped"},{"functionName":"LerpUnclamped"},{"functionName":"Remap"},{"functionName":"RemapClamped"},{"functionName":"Saturate"},{"functionName":"Repeat"},{"functionName":"PingPong"},{"functionName":"Wrap"},{"functionName":"MoveTowards"},{"functionName":"RoundToStep"},{"functionName":"Fract"},{"functionName":"SmoothStep"},{"functionName":"SmootherStep"},{"functionName":"SmoothDamp"},{"functionName":"SmoothDampAngle"},{"functionName":"ExpDecay"},{"functionName":"Spring"},{"functionName":"Ease"},{"functionName":"Bezier2"},{"functionName":"Bezier3"},{"functionName":"CatmullRom"},{"functionName":"DeltaAngle"},{"functionName":"LerpAngle"},{"functionName":"MoveTowardsAngle"},{"functionName":"NormalizeAngle"},{"functionName":"NormalizeAngle180"},{"functionName":"AngleDifferenceAbs"},{"functionName":"ResetVelocity"},{"functionName":"Approximately"}]},{"folderName":"Utility","children":[{"functionName":"ClearAllRegisters"},{"functionName":"ThreeRevision"},{"functionName":"ThreeRevisionAtLeast"}]}]},"eventsBasedBehaviors":[],"eventsBasedObjects":[]},{"author":"","category":"Visual effect","dimension":"3D","extensionNamespace":"","fullName":"3D water","gdevelopVersion":">=5.5.222","helpPath":"","iconUrl":"data:image/svg+xml;base64,","name":"Water3D","previewIconUrl":"https://resources.gdevelop-app.com/assets/Icons/waves.svg","shortDescription":"A water surface with waves for seas, lakes and rivers, where objects can float.","version":"0.2.0","description":["A 3D water surface for seas, lakes and rivers, with animated waves, light reflections and foam on wave crests.","","- Resize it to cover a sea or a lake: waves follow its size. Put it at the Z position of the water level.","- **Make objects float** with an action (for objects with the 3D physics behavior), and check if an object is **underwater**.","- Read the height of the waves anywhere with an expression, for example to move a boat.","- Choose another **style** in the properties: realistic, ocean, cartoon, pixel art or cel-shaded water, lava, pixel magma or toxic slime. Every style, the default one included, can draw foam around objects, fade into deep water, tint the view underwater, and have pixel art and bubbles: these effects are off at 0.","- For more realistic ripples, set a seamless **normal map** of water waves in the properties.","- Works well with the 3D terrain extension: place the water between hills or around an island."],"origin":{"identifier":"Water3D","name":"gdevelop-extension-store"},"tags":["3d","water","sea","lake","ocean","waves","buoyancy"],"authorIds":[],"dependencies":[],"globalVariables":[],"sceneVariables":[],"eventsFunctions":[{"description":"Define helper classes JavaScript code.","fullName":"Define helper classes","functionType":"Action","name":"DefineHelperClasses","private":true,"sentence":"Define helper classes JavaScript code","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Kept unless it comes from a version before the styles (still loaded after an update in the editor).","if (gdjs.__water3DExtension && gdjs.__water3DExtension.stylePresets) {","    return;","}","","// Tested by the gameplay tests of the \"3D island terrain\" example (GDevelop-examples repository).","","/**"," * Replace parts of the shader code of a Three.js material, with an error if"," * a part is missing (for example after an update of Three.js)."," * @param {string} shaderCode"," * @param {Array<[string, string]>} replacements The searched code and its replacement."," */","const patchShaderCode = (shaderCode, replacements) => {","    for (const [searchedCode, newCode] of replacements) {","        if (!shaderCode.includes(searchedCode)) {","            console.error(`Water3D: \"${searchedCode}\" was not found in the shader, which won't look as expected.`);","        }","        shaderCode = shaderCode.replace(searchedCode, newCode);","    }","    return shaderCode;","};","","// Size of the object inner area: instances are scaled from it.","const AREA_SIZE = 1000;","// Waves are drawn with vertices up to this distance, in scene units.","const WAVE_VERTEX_SPACING = 25;","const MAX_SEGMENTS = 256;","","// The waves are a sum of sines. The same formula is used by the shader and to","// compute the surface height for events.","const WAVES = [","    // [direction x, direction y, relative length, relative speed, relative height]","    [1, 0.3, 1, 1, 0.5],","    [-0.4, 1, 0.61, 1.27, 0.3],","    [0.7, -0.7, 0.37, 1.61, 0.2],","];","const waveDirections = WAVES.map(([x, y]) => {","    const length = Math.hypot(x, y);","    return [x / length, y / length];","});","","/**"," * @param {number} x Scene X position."," * @param {number} y Scene Y position."," * @param {number} time In seconds."," * @param {{waveHeight: number, waveLength: number, waveSpeed: number}} settings"," * @returns {number} The height of the waves above the water level."," */","/**"," * Waves shorter than a few vertices can't be drawn: they are faded out."," * @param {number} length"," * @param {number} vertexSpacing"," */","const getWaveVisibility = (length, vertexSpacing) => {","    const t = Math.min(Math.max((length / vertexSpacing - 3) / 3, 0), 1);","    return t * t * (3 - 2 * t);","};","","const getWaveHeight = (x, y, time, settings) => {","    let height = 0;","    for (let index = 0; index < WAVES.length; index++) {","        const [, , relativeLength, relativeSpeed, relativeHeight] = WAVES[index];","        const [directionX, directionY] = waveDirections[index];","        const length = settings.waveLength * relativeLength;","        const frequency = (2 * Math.PI) / length;","        const phase = (directionX * x + directionY * y) * frequency + time * settings.waveSpeed * relativeSpeed;","        height += Math.sin(phase) * relativeHeight * getWaveVisibility(length, settings.vertexSpacing);","    }","    return height * settings.waveHeight;","};","","const wavesShaderCode = WAVES.map(([, , relativeLength, relativeSpeed, relativeHeight], index) => {","    const [directionX, directionY] = waveDirections[index];","    return `","  {","    vec2 direction = vec2(${directionX.toFixed(6)}, ${directionY.toFixed(6)});","    float waveLength = waterWaveLength * ${relativeLength.toFixed(6)};","    float frequency = 6.2831853 / waveLength;","    float phase = dot(direction, position) * frequency + waterTime * waterWaveSpeed * ${relativeSpeed.toFixed(6)};","    float amplitude = waterWaveHeight * ${relativeHeight.toFixed(6)} *","      smoothstep(0.0, 1.0, clamp((waveLength / waterVertexSpacing - 3.0) / 3.0, 0.0, 1.0));","    height += sin(phase) * amplitude;","    slope += direction * cos(phase) * amplitude * frequency;","  }`;","}).join('');","","// Waves too short for the vertices are drawn with the light instead: their","// slope is computed for each pixel (and faded out when smaller than pixels).","const shortWavesShaderCode = WAVES.map(([, , relativeLength, relativeSpeed, relativeHeight], index) => {","    const [directionX, directionY] = waveDirections[index];","    return `","  {","    vec2 direction = vec2(${directionX.toFixed(6)}, ${directionY.toFixed(6)});","    float waveLength = waterWaveLength * ${relativeLength.toFixed(6)};","    float frequency = 6.2831853 / waveLength;","    float phase = dot(direction, position) * frequency + waterTime * waterWaveSpeed * ${relativeSpeed.toFixed(6)};","    float amplitude = waterWaveHeight * ${relativeHeight.toFixed(6)} *","      (1.0 - smoothstep(0.0, 1.0, clamp((waveLength / waterVertexSpacing - 3.0) / 3.0, 0.0, 1.0))) *","      clamp(2.0 - fwidth(phase), 0.0, 1.0);","    slope += direction * cos(phase) * amplitude * frequency;","  }`;","}).join('');","","const vertexShaderDeclarations = `","uniform float waterWorldScale;","uniform float waterTime;","uniform float waterWaveHeight;","uniform float waterWaveLength;","uniform float waterWaveSpeed;","uniform float waterVertexSpacing;","varying vec2 vWaterWorldXY;","varying float vWaterCrest;","","// Returns the height of the waves, and their slope in slopeOut.","float getWaterWaves(vec2 position, out vec2 slopeOut) {","  float height = 0.0;","  vec2 slope = vec2(0.0);","  ${wavesShaderCode}","  slopeOut = slope;","  return height;","}","`;","const vertexShaderWaves = `","// Waves are computed in scene coordinates (the 3D scene is flipped on Y).","vec2 waterScenePosition = (modelMatrix * vec4(position, 1.0)).xy * vec2(waterWorldScale, -waterWorldScale);","vec2 waterSlope;","float waterHeight = getWaterWaves(waterScenePosition, waterSlope);","vWaterCrest = waterWaveHeight > 0.0 ? waterHeight / waterWaveHeight : 0.0;","vWaterWorldXY = waterScenePosition;","`;","const vertexShaderNormal = `","transformedNormal = normalize((viewMatrix * vec4(-waterSlope.x, waterSlope.y, 1.0, 0.0)).xyz);","`;","const vertexShaderPosition = `","vec3 transformed = vec3(position.xy, position.z + waterHeight / max(length(modelMatrix[2].xyz) * waterWorldScale, 0.0001));","`;","const fragmentShaderDeclarations = `","uniform float waterTime;","uniform float waterWaveHeight;","uniform float waterWaveLength;","uniform float waterWaveSpeed;","uniform float waterVertexSpacing;","uniform float waterRippleTime;","uniform vec3 waterCrestColor;","uniform float waterFoam;","uniform sampler2D waterNormalMap;","uniform float waterNormalMapSize;","uniform float waterHasNormalMap;","uniform float waterPatternScale;","varying vec2 vWaterWorldXY;","varying float vWaterCrest;","","vec2 getWaterShortWavesSlope(vec2 position) {","  vec2 slope = vec2(0.0);","  ${shortWavesShaderCode}","  // Steeper would only give noise.","  float slopeLength = length(slope);","  return slopeLength > 1.0 ? slope / slopeLength : slope;","}","","float waterHash(vec2 p) {","  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);","}","float waterNoise(vec2 p) {","  vec2 i = floor(p);","  vec2 f = fract(p);","  vec2 u = f * f * (3.0 - 2.0 * f);","  return mix(","    mix(waterHash(i), waterHash(i + vec2(1.0, 0.0)), u.x),","    mix(waterHash(i + vec2(0.0, 1.0)), waterHash(i + vec2(1.0, 1.0)), u.x),","    u.y","  );","}","`;","const fragmentShaderColor = `","// Ripples bend the light: they are a slope in scene coordinates, used for the","// normal (and the foam).","// The pattern scale only changes the ripples, not the waves.","vec2 waterPatternXY = vWaterWorldXY / waterPatternScale;","vec2 rippleSlope;","if (waterHasNormalMap > 0.5) {","  // Two layers of the normal map moving in different directions never repeat","  // the same pattern.","  vec2 rippleUv = waterPatternXY / waterNormalMapSize;","  vec2 slope1 = texture2D(waterNormalMap, rippleUv + vec2(0.013, 0.007) * waterRippleTime).xy * 2.0 - 1.0;","  vec2 slope2 = texture2D(waterNormalMap, rippleUv * 0.71 + vec2(-0.009, 0.011) * waterRippleTime).xy * 2.0 - 1.0;","  rippleSlope = (slope1 + slope2) * 0.5;","} else {","  vec2 rippleNormalPosition = waterPatternXY / 18.0 + vec2(waterRippleTime * 0.4, -waterRippleTime * 0.3);","  rippleSlope = 0.04 * vec2(","    waterNoise(rippleNormalPosition) - 0.5,","    waterNoise(rippleNormalPosition + 7.3) - 0.5","  );","}","rippleSlope -= getWaterShortWavesSlope(vWaterWorldXY);","// Small ripples moving on top of the waves.","vec2 ripplePosition = waterPatternXY / 30.0;","float largeRipples = waterNoise(ripplePosition + vec2(waterRippleTime * 0.6, waterRippleTime * 0.2));","float smallRipples = waterNoise(ripplePosition * 1.7 - vec2(waterRippleTime * 0.3, waterRippleTime * 0.5));","float ripples = largeRipples + smallRipples;","float crest = smoothstep(0.35, 1.0, vWaterCrest + (ripples - 1.0) * 0.35);","// Crest foam: the waves are the swell, broken up by the ripples so it doesn't repeat, and the ridges of","// the ripples are the crest lines, torn by finer ripples (real foam is never a clean line).","water3DStyleSwell = max(vWaterCrest * 0.5 + 0.5 + (largeRipples - smallRipples) * 0.5, 0.0);","float tearingRipples = waterNoise(ripplePosition * 6.3 + vec2(waterRippleTime, -waterRippleTime * 0.8));","water3DStylePattern = 1.0 - abs(ripples - 1.0) + (0.3 - abs(tearingRipples * 2.0 - 1.0)) * 0.18;","diffuseColor.rgb = mix(diffuseColor.rgb, waterCrestColor, crest * 0.6);","`;","const fragmentShaderNormal = `","#include <normal_fragment_maps>","// The 3D scene is flipped on Y.","normal = normalize(normal + faceDirection * (viewMatrix * vec4(rippleSlope.x, -rippleSlope.y, 0.0, 0.0)).xyz);","`;","const fragmentShaderOpacity = `","// Water reflects more light when seen from the side (Fresnel effect).","vec3 waterViewDirection = isOrthographic ? vec3(0.0, 0.0, 1.0) : normalize(vViewPosition);","float waterFresnel = pow(1.0 - clamp(abs(dot(normal, waterViewDirection)), 0.0, 1.0), 4.0);","// It reflects the sky, lit like the wave crests.","outgoingLight = mix(outgoingLight, waterCrestColor, waterFresnel * 0.5);","diffuseColor.a = mix(diffuseColor.a, 1.0, waterFresnel * 0.7);","#include <opaque_fragment>","`;","","/**"," * Moves the vertices of the material of a style with the waves, like the default water, so that the"," * surface is where the events see it (surface Z, buoyancy)."," * @param {THREE.Material} material"," * @param {Object} waveUniforms"," */","const addWaves = (material, waveUniforms) => {","    const patchVertexShader = (vertexShader) => {","        // A lit material gets the normal of the waves, the others compute their own light.","        const isLit = vertexShader.includes('#include <defaultnormal_vertex>');","        return patchShaderCode(vertexShader, [","            ['#include <common>', '#include <common>\\n' + vertexShaderDeclarations],","            ...(isLit","                ? [","                      ['#include <beginnormal_vertex>', '#include <beginnormal_vertex>\\n' + vertexShaderWaves],","                      ['#include <defaultnormal_vertex>', '#include <defaultnormal_vertex>\\n' + vertexShaderNormal],","                  ]","                : [['#include <begin_vertex>', vertexShaderWaves + '\\n#include <begin_vertex>']]),","            ['#include <begin_vertex>', vertexShaderPosition],","        ]);","    };","    if (material.isShaderMaterial) {","        Object.assign(material.uniforms, waveUniforms);","        material.vertexShader = patchVertexShader(material.vertexShader);","        return;","    }","    const styleOnBeforeCompile = material.onBeforeCompile;","    material.onBeforeCompile = (shader, renderer) => {","        styleOnBeforeCompile.call(material, shader, renderer);","        Object.assign(shader.uniforms, waveUniforms);","        shader.vertexShader = patchVertexShader(shader.vertexShader);","    };","    const styleProgramCacheKey = material.customProgramCacheKey.bind(material);","    material.customProgramCacheKey = () => styleProgramCacheKey() + '-water3D-waves';","};","","const normalMapTextures = new WeakMap();","/**"," * @param {gdjs.RuntimeGame} game"," * @param {string} resourceName"," * @returns {THREE.Texture} A repeated texture read as directions, not colors."," */","const getNormalMapTexture = (game, resourceName) => {","    const imageTexture = game.getImageManager().getThreeTexture(resourceName);","    let texture = normalMapTextures.get(imageTexture);","    if (!texture) {","        texture = imageTexture.clone();","        texture.colorSpace = THREE.NoColorSpace;","        texture.wrapS = THREE.RepeatWrapping;","        texture.wrapT = THREE.RepeatWrapping;","        texture.minFilter = THREE.LinearMipmapLinearFilter;","        texture.generateMipmaps = true;","        texture.anisotropy = 4;","        texture.needsUpdate = true;","        normalMapTextures.set(imageTexture, texture);","    }","    return texture;","};","","/**"," * The material of the default style: lit by the scene, with the waves, the ripples and the crests."," * @param {Object} uniforms The uniforms of the water."," */","const createDefaultMaterial = (uniforms) => {","    const material = new THREE.MeshStandardMaterial({","        transparent: true,","        roughness: 0.35,","        metalness: 0,","        side: THREE.DoubleSide,","        // Drawn once: the underside is lit with the flipped normal.","        forceSinglePass: true,","        depthWrite: false,","    });","    material.onBeforeCompile = (shader) => {","        Object.assign(shader.uniforms, uniforms);","        shader.vertexShader = patchShaderCode(shader.vertexShader, [","            ['#include <common>', '#include <common>\\n' + vertexShaderDeclarations],","            ['#include <beginnormal_vertex>', '#include <beginnormal_vertex>\\n' + vertexShaderWaves],","            ['#include <defaultnormal_vertex>', '#include <defaultnormal_vertex>\\n' + vertexShaderNormal],","            ['#include <begin_vertex>', vertexShaderPosition],","        ]);","        shader.fragmentShader = patchShaderCode(shader.fragmentShader, [","            ['#include <common>', '#include <common>\\n' + fragmentShaderDeclarations],","            ['#include <color_fragment>', '#include <color_fragment>\\n' + fragmentShaderColor],","            ['#include <normal_fragment_maps>', fragmentShaderNormal],","            ['#include <opaque_fragment>', fragmentShaderOpacity],","        ]);","    };","    material.customProgramCacheKey = () => 'Water3D';","    return material;","};","","/**"," * The water of a Water3D object: a surface with waves, drawn transparent."," */","class Water {","    /**","     * @param {gdjs.CustomRuntimeObject3D} object","     */","    constructor(object) {","        this.object = object;","        this.time = 0;","        this.uniforms = {","            // Scene units by 3D world unit.","            waterWorldScale: { value: 1 },","            waterTime: { value: 0 },","            // Ripples are noise: a small time keeps them precise.","            waterRippleTime: { value: 0 },","            waterWaveHeight: { value: 0 },","            waterWaveLength: { value: 1 },","            waterWaveSpeed: { value: 1 },","            waterVertexSpacing: { value: 1 },","            waterCrestColor: { value: new THREE.Color() },","            waterFoam: { value: 0 },","            waterNormalMap: { value: null },","            waterNormalMapSize: { value: 1 },","            waterHasNormalMap: { value: 0 },","            waterPatternScale: { value: 1 },","        };","        // The material is given by the style chosen in the properties.","        this.mesh = new THREE.Mesh(new THREE.BufferGeometry());","        this.mesh.userData.isWater3D = true;","        this.mesh.receiveShadow = true;","        // Rays hit the plane of the water, which is all its geometry is (the","        // shader moves the waves): two triangles instead of those of the waves.","        const raycastGeometry = new THREE.PlaneGeometry(AREA_SIZE, AREA_SIZE);","        raycastGeometry.translate(AREA_SIZE / 2, AREA_SIZE / 2, 0);","        this.raycastGeometry = raycastGeometry;","        this.mesh.raycast = function (raycaster, intersects) {","            const drawnGeometry = this.geometry;","            this.geometry = raycastGeometry;","            THREE.Mesh.prototype.raycast.call(this, raycaster, intersects);","            this.geometry = drawnGeometry;","        };","        object.get3DRendererObject().add(this.mesh);","        this.segmentsX = 0;","        this.segmentsY = 0;","        this.settings = { waveHeight: 0, waveLength: 1, waveSpeed: 1, vertexSpacing: 1 };","        /** @type {string | null} */","        this.styleName = null;","        this.style = null;","        this.updateFromProperties();","    }","","    /** The style property picks a preset: its material is rebuilt when it changes (in the editor). */","    _updateStyleIfNeeded() {","        const styleName = this.object._getStyle();","        if (styleName === this.styleName) return;","        this.styleName = styleName;","        const { styleEngine, stylePresets } = gdjs.__water3DExtension;","        const stylePreset = stylePresets[styleName];","        if (!stylePreset) {","            console.error(`Water3D: there is no \"${styleName}\" style, the default water is drawn instead.`);","        }","        if (this.style) this.style.dispose();","        this.style = new styleEngine.WaterStyle(this, stylePreset || stylePresets.Default);","    }","","    updateFromProperties() {","        const { object } = this;","        this.uniforms.waterCrestColor.value.set(gdjs.rgbOrHexStringToNumber(object._getCrestColor()));","        this.uniforms.waterFoam.value = gdjs.evtTools.common.clamp(object._getFoam(), 0, 1);","        const normalMapName = object._getNormalMap();","        this.uniforms.waterHasNormalMap.value = normalMapName ? 1 : 0;","        this.uniforms.waterNormalMap.value = normalMapName","            ? getNormalMapTexture(object.getRuntimeScene().getGame(), normalMapName)","            : null;","        this.uniforms.waterNormalMapSize.value = Math.max(object._getNormalMapSize(), 1);","        this.uniforms.waterPatternScale.value = Math.max(object._getPatternScale(), 0.01);","        this.settings.waveHeight = Math.max(object._getWaveHeight(), 0);","        this.settings.waveLength = Math.max(object._getWaveLength(), 1);","        this.settings.waveSpeed = object._getWaveSpeed();","        this.uniforms.waterWaveHeight.value = this.settings.waveHeight;","        this.uniforms.waterWaveLength.value = this.settings.waveLength;","        this.uniforms.waterWaveSpeed.value = this.settings.waveSpeed;","        this._updateGeometryIfNeeded();","        this._updateStyleIfNeeded();","        this.style.updateFromProperties();","    }","","    /** Waves need vertices: their count follows the size of the water. */","    _updateGeometryIfNeeded() {","        const { object } = this;","        const hasWaves = this.settings.waveHeight > 0;","        const segmentsX = hasWaves","            ? gdjs.evtTools.common.clamp(Math.ceil(object.getWidth() / WAVE_VERTEX_SPACING), 1, MAX_SEGMENTS)","            : 1;","        const segmentsY = hasWaves","            ? gdjs.evtTools.common.clamp(Math.ceil(object.getHeight() / WAVE_VERTEX_SPACING), 1, MAX_SEGMENTS)","            : 1;","        this.settings.vertexSpacing = Math.max(object.getWidth() / segmentsX, object.getHeight() / segmentsY);","        this.uniforms.waterVertexSpacing.value = this.settings.vertexSpacing;","        const waveHeight = this.settings.waveHeight / Math.max(object.getScaleZ(), 0.0001);","        if (segmentsX !== this.segmentsX || segmentsY !== this.segmentsY) {","            this.segmentsX = segmentsX;","            this.segmentsY = segmentsY;","            const geometry = new THREE.PlaneGeometry(AREA_SIZE, AREA_SIZE, segmentsX, segmentsY);","            geometry.translate(AREA_SIZE / 2, AREA_SIZE / 2, 0);","            geometry.boundingBox = new THREE.Box3();","            geometry.boundingSphere = new THREE.Sphere();","            this.mesh.geometry.dispose();","            this.mesh.geometry = geometry;","        }","        // Waves go above and under the plane.","        const { boundingBox, boundingSphere } = this.mesh.geometry;","        if (boundingBox.max.z !== waveHeight) {","            boundingBox.min.set(0, 0, -waveHeight);","            boundingBox.max.set(AREA_SIZE, AREA_SIZE, waveHeight);","            boundingBox.getBoundingSphere(boundingSphere);","        }","    }","","    /** @returns {number} The Z position of the water surface, with the waves. */","    getSurfaceZ(x, y) {","        return this.object.getZ() + getWaveHeight(x, y, this.time, this.settings);","    }","","    /** @returns {boolean} true if an object center is under the surface. */","    isUnderwater(object) {","        if (!gdjs.Base3DHandler.is3D(object)) return false;","        const x = object.getCenterXInScene();","        const y = object.getCenterYInScene();","        return this.isOver(x, y) && object.getCenterZInScene() < this.getSurfaceZ(x, y);","    }","","    /** @returns {boolean} true if the position is above the water, inside its area. */","    isOver(x, y) {","        const { object } = this;","        return (","            x >= object.getX() &&","            x <= object.getX() + object.getWidth() &&","            y >= object.getY() &&","            y <= object.getY() + object.getHeight()","        );","    }","","    /**","     * Push objects up where they are under the surface, and slow them down.","     * @param {gdjs.RuntimeObject[]} objects","     * @param {string} physicsBehaviorName","     * @param {number} buoyancy 1 to float half submerged, higher to float higher.","     */","    applyBuoyancy(objects, physicsBehaviorName, buoyancy) {","        for (const object of objects) {","            /** @type {gdjs.Physics3DRuntimeBehavior | null} */","            const physics = object.getBehavior(physicsBehaviorName);","            if (!physics || !physics.isDynamic()) continue;","            const centerX = object.getCenterXInScene();","            const centerY = object.getCenterYInScene();","            if (!this.isOver(centerX, centerY)) continue;","            const depth = Math.max(object.getDepth(), 1);","            const surfaceZ = this.getSurfaceZ(centerX, centerY);","            const submergedRatio = gdjs.evtTools.common.clamp((surfaceZ - physics.owner3D.getUnrotatedAABBMinZ()) / depth, 0, 1);","            if (submergedRatio <= 0) continue;","            // Forces are in newtons, velocities are converted from pixels to meters.","            const gravityZ = physics.getGravityZ();","            const worldScale = physics.getWorldScale();","            const mass = physics.getMass();","            // Archimedes: floats with half of its depth submerged when buoyancy is 1.","            const buoyancyForce = -2 * buoyancy * submergedRatio * mass * gravityZ;","            // Water drag, to stop bouncing forever.","            const drag = (4 * submergedRatio * mass) / worldScale;","            physics.applyForceAtCenter(","                -physics.getLinearVelocityX() * drag,","                -physics.getLinearVelocityY() * drag,","                buoyancyForce - physics.getLinearVelocityZ() * drag","            );","        }","    }","","    /** @param {number} time In seconds, the same for all water objects. */","    update(time) {","        this.time = time;","        const scene = this.object.getRuntimeScene();","        // 1 in GDevelop versions before the world scale.","        this.uniforms.waterWorldScale.value =","            typeof scene.getRenderer3DWorldScale === 'function' ? scene.getRenderer3DWorldScale() : 1;","        this.uniforms.waterTime.value = time;","        this.uniforms.waterRippleTime.value = time % 1000;","        this._updateGeometryIfNeeded();","        this.style.update(time);","    }","","    dispose() {","        this.style.dispose();","        this.mesh.removeFromParent();","        this.mesh.geometry.dispose();","        this.raycastGeometry.dispose();","    }","}","","gdjs.__water3DExtension = {","    Water,","    getWaveHeight,","    addWaves,","    createDefaultMaterial,","    // Filled by the next events: the engine and the presets of the styles.","    styleEngine: null,","    stylePresets: {},","};"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"colorB":228,"colorG":176,"colorR":74,"creationTime":0,"name":"Styles","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const water3D = gdjs.__water3DExtension;","if (water3D.styleEngine) {","    return;","}","","// Styles: the object draws its surface with one of the presets defined next, chosen with its \"Style\"","// property (the name of the preset). The colors and settings come from the object properties, and the waves","// stay the ones of the default water, so the surface Z and the buoyancy are the same for every style.","// Every style can have every effect: foam around objects, deep water, underwater tint, pixel art, bubbles","// and foam on the wave crests. Each one is off when its property is 0.","// The edge foam and the underwater tint come from the \"Water shader\" extension (by the GDevelop team).","","/**"," * @typedef {Object} WaterStyleSettings"," * @property {number} patternScale"," * @property {string} waterColor"," * @property {string} deepColor"," * @property {string} foamColor"," * @property {number} foamWidth"," * @property {number} foamIntensity"," * @property {number} waterDensity"," * @property {number} surfaceOpacity"," * @property {number} pixelSize 0 or 1 for no pixel art."," * @property {number} animationFps 0 for a smooth animation."," * @property {number} bubbleIntensity From 0 to 1."," * @property {Object} presetSettings"," */","/**"," * @typedef {Object} WaterStylePreset"," * @property {boolean} [isDefault] The default water: it has its own waves, crests and opacity."," * @property {boolean} [hasOwnPixelArt] The preset reads the pixel size and the frame rate itself"," * (its position varying is still snapped, for the effects drawn over it)."," * @property {boolean} [hasOwnBubbles] The preset reads the bubble amount itself."," * The fragment shader of a style sets, for the crest foam, water3DStyleSwell (from 0, about 1 on the"," * highest tops of its biggest waves: the foam gathers there first; not clamped at 1, so that the lowest"," * intensities still pick the highest tops) and water3DStylePattern (from 0 to 1, 1 on the crest"," * lines of its turbulence: the foam draws its veins there). Without swell, the foam is spread evenly."," * @property {string} [positionVarying] The varying holding the world position of the pixel, read by the"," * pattern and snapped by the pixel art (\"vWorldPosition\" when not given)."," * @property {(object: gdjs.CustomRuntimeObject3D) => Object} [readSettings] Settings of this preset only."," * @property {(settings: WaterStyleSettings) => THREE.Color} [getBodyColor] Close to what the surface looks"," * like, for the underwater tint."," * @property {(settings: WaterStyleSettings, edgeUniforms: Object, water: Object) => {material: THREE.Material, setTime: (time: number) => void}} create"," * @property {(water: Object) => {update: () => void, dispose: () => void}} [addExtras] What the preset adds to the scene."," */","","/**"," * Converts a GDevelop \"R;G;B\" color property (sRGB, as shown in the color picker) to a THREE.Color."," * @param {string} rgbString"," */","const toThreeColor = (rgbString) => {","    const [red, green, blue] = String(rgbString).split(';').map(Number);","    return new THREE.Color().setRGB(red / 255, green / 255, blue / 255, THREE.SRGBColorSpace);","};","","// The \"Water density\" property is given per 100 pixels of water, the shader works per pixel.","const WATER_DENSITY_UNIT = 0.01;","// Darkening of the water body color seen from below the surface.","const UNDERWATER_DARKENING = 0.6;","const UNDERWATER_OVERLAY_NAME = 'water3D-underwater-overlay';","","// Edge foam: foam where the water is close to the scene behind it, computed per pixel in screen space.","// Right before a scene containing water is rendered, a depth-only pass of that scene (without the water) is","// rendered with the same camera. The water shader compares its own depth with the scene depth behind each","// pixel. The same thickness of water makes what is below the surface fade out with depth (water density).","const edgeFoamShaderCode = `","    uniform sampler2D uSceneDepth;","    uniform vec2 uSceneDepthResolution;","    uniform float uCameraNear;","    uniform float uCameraFar;","    uniform float uIsOrthographicCamera;","    uniform float uHasEdgeDistance;","    uniform float uFoamWidth;","    uniform float uFoamIntensity;","    uniform vec3 uFoamColor;","    uniform float uFoamTime;","    uniform float uWaterDensity;","    float edgeFoamHash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123); }","    float edgeFoamNoise(vec2 p) {","        vec2 i = floor(p); vec2 f = fract(p);","        vec2 u = f * f * (3.0 - 2.0 * f);","        return mix(mix(edgeFoamHash(i), edgeFoamHash(i + vec2(1.0, 0.0)), u.x), mix(edgeFoamHash(i + vec2(0.0, 1.0)), edgeFoamHash(i + vec2(1.0, 1.0)), u.x), u.y);","    }","    // Depth buffer value to view space Z (negative in front of the camera)","    float edgeFoamViewZ(float depth) {","        if (uIsOrthographicCamera > 0.5) return depth * (uCameraNear - uCameraFar) - uCameraNear;","        return (uCameraNear * uCameraFar) / ((uCameraFar - uCameraNear) * depth - uCameraFar);","    }","    // Thickness of water between this pixel of the surface and the scene behind it, in world pixels","    float edgeDistance() {","        if (uHasEdgeDistance < 0.5) return 1e9;","        float sceneDepth = texture2D(uSceneDepth, gl_FragCoord.xy / uSceneDepthResolution).r;","        if (sceneDepth >= 1.0) return 1e9;","        return max(0.0, edgeFoamViewZ(gl_FragCoord.z) - edgeFoamViewZ(sceneDepth));","    }","    // Share of what is behind the surface that is still seen through the water: 1 right below the surface,","    // 0 deep down. Nothing fades when the density is 0.","    float waterVisibility() {","        if (uWaterDensity <= 0.0) return 1.0;","        return exp(-edgeDistance() * uWaterDensity);","    }","    // p: world position of the pixel on the surface (Z-up), for the foam noise","    float edgeFoam(vec2 p) {","        if (uHasEdgeDistance < 0.5 || uFoamWidth <= 0.0 || uFoamIntensity <= 0.0) return 0.0;","        float distanceToEdge = edgeDistance();","        float width = uFoamWidth;","        // 1 at the object, 0 at the foam width","        float edge = 1.0 - smoothstep(0.0, width, distanceToEdge);","        float wobble = edgeFoamNoise(p * (4.0 / width) + uFoamTime * 0.3) - 0.5;","        // Solid contact line hugging the object: only its outer border wobbles, so it has no holes","        float contact = 1.0 - smoothstep(width * 0.3, width * 0.5, distanceToEdge + wobble * width * 0.15);","        // Bands coming from the open water towards the object, like waves on a shore","        float bands = smoothstep(0.45, 0.7, fract(distanceToEdge / width * 2.5 + uFoamTime * 0.6 + wobble * 0.6)) * edge;","        // Broken up by noise, but never erased","        float breakup = mix(0.7, 1.0, smoothstep(0.25, 0.65, edgeFoamNoise(p * (6.0 / width) - uFoamTime * 0.2)));","        float foam = max(contact, bands * breakup);","        // Soft haze around the object","        foam = max(foam, edge * 0.35);","        return clamp(foam * uFoamIntensity, 0.0, 1.0);","    }","`;","const edgeFoam = { glsl: edgeFoamShaderCode };","","const createEdgeUniforms = () => ({","    uSceneDepth: { value: null },","    uSceneDepthResolution: { value: new THREE.Vector2(1, 1) },","    uCameraNear: { value: 1 },","    uCameraFar: { value: 1000 },","    uIsOrthographicCamera: { value: 0 },","    uHasEdgeDistance: { value: 0 },","    uFoamWidth: { value: 80 },","    uFoamIntensity: { value: 0.9 },","    uFoamColor: { value: new THREE.Color() },","    uFoamTime: { value: 0 },","    uWaterDensity: { value: 0 },","    uSurfaceOpacity: { value: 1 },","});","","// Depth only: nothing is written to the color, only the depth texture is kept.","const depthOnlyMaterial = new THREE.MeshBasicMaterial({ colorWrite: false, side: THREE.DoubleSide });","","/**"," * Everything that must not be part of the depth pass: the water itself, the underwater tints, and every"," * non-surface drawing (lines, points, sprites: editor grid, gizmos, selection boxes)."," * @param {THREE.Object3D} object3D"," */","const isExcludedFromDepthPass = (object3D) =>","    !!object3D.userData.isWater3D ||","    object3D.name === UNDERWATER_OVERLAY_NAME ||","    object3D.isLine ||","    object3D.isLineSegments ||","    object3D.isPoints ||","    object3D.isSprite;","","const ensureDepthTarget = (scene, width, height) => {","    let target = scene.userData.water3DDepthTarget;","    if (target && target.width === width && target.height === height) return target;","    if (target) target.dispose();","    target = new THREE.WebGLRenderTarget(width, height, {","        depthTexture: new THREE.DepthTexture(width, height, THREE.FloatType),","        depthBuffer: true,","    });","    target.depthTexture.minFilter = THREE.NearestFilter;","    target.depthTexture.magFilter = THREE.NearestFilter;","    scene.userData.water3DDepthTarget = target;","    return target;","};","","/** Depth pass of the scene without the water, then hands the depth to every water of the scene. */","const renderDepthPass = (renderer, originalRender, scene, camera) => {","    /** @type {Set<WaterStyle>} */","    const waterStyles = scene.userData.water3DStyles;","    // Forget the water removed from the scene, and the styles replaced by another one.","    for (const waterStyle of waterStyles) {","        if (waterStyle.isDisposed || !waterStyle.root.parent) waterStyles.delete(waterStyle);","    }","    const activeStyles = [...waterStyles].filter((waterStyle) => waterStyle.needsDepthPass);","    if (activeStyles.length === 0) return;","","    // Same size as what is being rendered: the canvas, or the render target GDevelop draws into.","    const currentTarget = renderer.getRenderTarget();","    const size = currentTarget","        ? new THREE.Vector2(currentTarget.width, currentTarget.height)","        : renderer.getDrawingBufferSize(new THREE.Vector2());","    const depthTarget = ensureDepthTarget(scene, Math.max(1, size.x), Math.max(1, size.y));","","    const hiddenObjects = [];","    scene.traverse((object3D) => {","        if (object3D.visible && isExcludedFromDepthPass(object3D)) {","            hiddenObjects.push(object3D);","            object3D.visible = false;","        }","    });","    const previousOverrideMaterial = scene.overrideMaterial;","    const previousBackground = scene.background;","    const previousAutoClear = renderer.autoClear;","    const previousShadowAutoUpdate = renderer.shadowMap.autoUpdate;","    renderer.__isWater3DDepthPassRunning = true;","    try {","        scene.overrideMaterial = depthOnlyMaterial;","        scene.background = null;","        renderer.shadowMap.autoUpdate = false;","        renderer.autoClear = true;","        renderer.setRenderTarget(depthTarget);","        renderer.clear();","        originalRender(scene, camera);","    } finally {","        renderer.setRenderTarget(currentTarget);","        renderer.autoClear = previousAutoClear;","        renderer.shadowMap.autoUpdate = previousShadowAutoUpdate;","        scene.overrideMaterial = previousOverrideMaterial;","        scene.background = previousBackground;","        renderer.__isWater3DDepthPassRunning = false;","        for (const object3D of hiddenObjects) object3D.visible = true;","    }","","    for (const waterStyle of activeStyles) {","        const uniforms = waterStyle.edgeUniforms;","        // The camera planes are in three.js world units: in world pixels, the view depths and so the water","        // thickness are in world pixels too, like the foam width and the water density.","        const worldScale = waterStyle.water.uniforms.waterWorldScale.value;","        uniforms.uSceneDepth.value = depthTarget.depthTexture;","        uniforms.uSceneDepthResolution.value.set(depthTarget.width, depthTarget.height);","        uniforms.uCameraNear.value = camera.near * worldScale;","        uniforms.uCameraFar.value = camera.far * worldScale;","        uniforms.uIsOrthographicCamera.value = camera.isOrthographicCamera ? 1 : 0;","        uniforms.uHasEdgeDistance.value = 1;","    }","};","","/**"," * Wraps the renderer once: every render of a scene containing water, with a view camera, is preceded by"," * the depth pass. Nothing changes for scenes without water."," * @param {THREE.WebGLRenderer} renderer"," */","const installRenderHook = (renderer) => {","    if (renderer.__water3DDepthHookInstalled) return;","    renderer.__water3DDepthHookInstalled = true;","    const originalRender = renderer.render.bind(renderer);","    renderer.render = (scene, camera) => {","        const waterStyles = scene && scene.userData && scene.userData.water3DStyles;","        if (","            !renderer.__isWater3DDepthPassRunning &&","            waterStyles &&","            waterStyles.size > 0 &&","            camera &&","            (camera.isPerspectiveCamera || camera.isOrthographicCamera)","        ) {","            try {","                renderDepthPass(renderer, originalRender, scene, camera);","            } catch (error) {","                console.error('Water3D: the depth pass of the edge foam failed.', error);","            }","        }","        return originalRender(scene, camera);","    };","};","","// Added at the end of every preset fragment shader, right before the color space conversion: the surface","// is at most as opaque as the \"Opacity\" property (foam stays solid), and becomes opaque where the scene","// behind it is deep below the surface.","const depthFadeShaderCode = `","    gl_FragColor.a = mix(1.0, min(gl_FragColor.a, uSurfaceOpacity), waterVisibility());","`;","const depthFadeKeepingOpacityShaderCode = `","    gl_FragColor.a = mix(1.0, gl_FragColor.a, waterVisibility());","`;","","/**"," * Adds the surface opacity and the fading with depth to the preset shader. Works for a ShaderMaterial"," * and for a built-in material patched with onBeforeCompile."," * @param {THREE.Material} material"," * @param {boolean} keepsOpacity The opacity of the material is not limited to the \"Opacity\" property."," */","const addDepthFade = (material, keepsOpacity) => {","    const inject = (fragmentShader) =>","        fragmentShader.includes('float waterVisibility(')","            ? fragmentShader","                  .replace('float waterVisibility(', 'uniform float uSurfaceOpacity;\\nfloat waterVisibility(')","                  .replace(","                      '#include <colorspace_fragment>',","                      (keepsOpacity ? depthFadeKeepingOpacityShaderCode : depthFadeShaderCode) +","                          '\\n#include <colorspace_fragment>'","                  )","            : fragmentShader;","    // Blending is needed for the surface to be see-through.","    material.transparent = true;","    if (material.isShaderMaterial) {","        material.fragmentShader = inject(material.fragmentShader);","        return;","    }","    const presetOnBeforeCompile = material.onBeforeCompile;","    material.onBeforeCompile = (shader, renderer) => {","        presetOnBeforeCompile.call(material, shader, renderer);","        shader.fragmentShader = inject(shader.fragmentShader);","    };","    const presetProgramCacheKey = material.customProgramCacheKey.bind(material);","    material.customProgramCacheKey = () => presetProgramCacheKey() + '-depth-fade';","};","","// Every preset is written in world pixels, like the object properties (pattern scale, foam width...).","// The world position it computes and the camera position are in three.js world units: both are scaled","// back to pixels by uWorldScale.","const worldPositionShaderCode = '(modelMatrix * vec4(transformed, 1.0)).xyz';","/**"," * @param {THREE.Material} material"," * @param {{value: number}} worldScaleUniform"," */","const addWorldScale = (material, worldScaleUniform) => {","    const injectVertex = (vertexShader) =>","        'uniform float uWorldScale;\\n' +","        vertexShader.split(worldPositionShaderCode).join('(' + worldPositionShaderCode + ' * uWorldScale)');","    // Only the preset code is affected: the includes of three.js are resolved after this.","    const injectFragment = (fragmentShader) =>","        'uniform float uWorldScale;\\n' + fragmentShader.replace(/\\bcameraPosition\\b/g, '(cameraPosition * uWorldScale)');","    if (material.isShaderMaterial) {","        material.uniforms.uWorldScale = worldScaleUniform;","        material.vertexShader = injectVertex(material.vertexShader);","        material.fragmentShader = injectFragment(material.fragmentShader);","        return;","    }","    const presetOnBeforeCompile = material.onBeforeCompile;","    material.onBeforeCompile = (shader, renderer) => {","        presetOnBeforeCompile.call(material, shader, renderer);","        shader.uniforms.uWorldScale = worldScaleUniform;","        shader.vertexShader = injectVertex(shader.vertexShader);","        shader.fragmentShader = injectFragment(shader.fragmentShader);","    };","    const presetProgramCacheKey = material.customProgramCacheKey.bind(material);","    material.customProgramCacheKey = () => presetProgramCacheKey() + '-world-scale';","};","","// Effects every style can have, each one off at 0. They are computed from the world position of the pixel","// given by the waves (vWaterWorldXY, in scene pixels).","// The snapped position jumps at the border of each square pixel: derivatives (fwidth, the mipmap level of","// textures) would draw lines there. Inside a square pixel, the snapped position doesn't change.","const pixelArtShaderCode = `","    #undef texture2D","    #define texture2D(textureSampler, uv) textureLod(textureSampler, uv, 0.0)","    #define fwidth(value) ((value) * 0.0)","    uniform float uWater3DPixelSize;","    vec2 water3DPixelate(vec2 position) {","        return (floor(position / uWater3DPixelSize) + 0.5) * uWater3DPixelSize;","    }","    vec3 water3DPixelate(vec3 position) {","        return vec3(water3DPixelate(position.xy), position.z);","    }","`;","const bubblesShaderCode = `","    uniform float uWater3DBubbleIntensity;","    uniform float uWater3DBubbleTime;","    uniform float uWater3DPatternScale;","    vec2 water3DBubbleHash(vec2 p) {","        return fract(sin(vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)))) * 43758.5453);","    }","    // Round bubbles swelling then popping: 1 on their rim and their shine, 0 elsewhere.","    float water3DBubbles(vec2 position) {","        float bubble = 0.0;","        for (int layer = 0; layer < 2; layer++) {","            float cellSize = (layer == 0 ? 48.0 : 31.0) * uWater3DPatternScale;","            vec2 gridPosition = position / cellSize + float(layer) * 17.3;","            vec2 cell = floor(gridPosition);","            vec2 cellRandom = water3DBubbleHash(cell + float(layer) * 41.7);","            if (cellRandom.x >= uWater3DBubbleIntensity * 0.5) continue;","            float phase = fract(uWater3DBubbleTime / (2.5 + 2.0 * cellRandom.y) + cellRandom.y * 7.3);","            float growth = smoothstep(0.0, 0.85, phase);","            float pop = 1.0 - smoothstep(0.85, 0.92, phase);","            vec2 center = 0.3 + 0.4 * water3DBubbleHash(cell + 3.1);","            float radius = mix(0.06, 0.28, growth);","            vec2 cellPosition = fract(gridPosition);","            float rim = 1.0 - smoothstep(0.0, 0.05, abs(length(cellPosition - center) - radius));","            float shine = 1.0 - smoothstep(0.0, 0.04, length(cellPosition - center + radius * 0.45));","            bubble = max(bubble, max(rim * 0.85, shine) * pop);","        }","        return bubble;","    }","`;","const bubblesFragmentCode = `","    float water3DBubble = water3DBubbles(vWaterWorldXY);","    gl_FragColor.rgb = mix(gl_FragColor.rgb, uWater3DFoamColor, water3DBubble);","    gl_FragColor.a = max(gl_FragColor.a, water3DBubble);","`;","// Foam on the crests, like on a real sea: born on the tops of the biggest waves, it stays there as a web","// of veins on the crests of the turbulence. Both come from the style: water3DStyleSwell is the height of","// its biggest waves and water3DStylePattern its crest lines (from 0 to 1, 1 on the crests).","const crestsUniformNames = ['waterFoam'];","const crestsShaderCode = `","    float water3DGetCrestFoam(float stylePattern, float styleSwell) {","        // 0: no foam, 1: foam on every crest. In between, the foam comes down from the very tops of the","        // swell to its bottom, its amount about proportional to the intensity (a few flakes at 0.01, a few","        // patches at 0.1).","        float intensity = clamp(waterFoam, 0.0, 1.0);","        float foamStart = mix(1.1, -0.3, (pow(intensity, 0.3) + pow(intensity, 4.0)) * 0.5);","        float swellTop = smoothstep(foamStart, foamStart + 0.3, styleSwell);","        // The higher on the swell, the lower the crests that keep foam: a few thin veins on its slopes,","        // a dense web with dark holes on its tops.","        float threshold = mix(0.985, 0.82, swellTop);","        float softness = 0.012 + fwidth(stylePattern);","        float veins = smoothstep(threshold - softness, threshold + softness, stylePattern);","        // Foam sunk under the surface lightens the water around the veins.","        float haze = swellTop * swellTop * 0.3 * smoothstep(threshold - 0.25, threshold, stylePattern);","        return max(veins * smoothstep(0.0, 0.2, swellTop) * mix(0.55, 1.0, swellTop), haze);","    }","`;","const crestsFragmentCode = `","    float water3DCrestFoam = waterFoam > 0.0 ? water3DGetCrestFoam(water3DStylePattern, water3DStyleSwell) * 0.9 : 0.0;","    gl_FragColor.rgb = mix(gl_FragColor.rgb, uWater3DFoamColor, water3DCrestFoam);","    gl_FragColor.a = max(gl_FragColor.a, water3DCrestFoam);","`;","","/**"," * Snaps a varying to the pixel grid: the fragment shader reads the snapped copy under the same name."," * @param {string} vertexShader"," * @param {string} fragmentShader"," * @param {string} name"," */","const pixelateVarying = (vertexShader, fragmentShader, name) => {","    const declaration = new RegExp('varying\\\\s+(vec2|vec3)\\\\s+' + name + '\\\\s*;');","    const match = fragmentShader.match(declaration);","    if (!match) return { vertexShader, fragmentShader };","    const rawName = name + 'Raw';","    return {","        vertexShader: vertexShader.replace(new RegExp('\\\\b' + name + '\\\\b', 'g'), rawName),","        fragmentShader: fragmentShader","            .replace(declaration, `varying ${match[1]} ${rawName};\\n${match[1]} ${name};`)","            .replace(/void main\\(\\)\\s*\\{/, `void main() {\\n    ${name} = water3DPixelate(${rawName});`),","    };","};","","/**"," * Adds the effects of every style that the preset doesn't draw itself."," * @param {THREE.Material} material"," * @param {WaterStyleSettings} settings"," * @param {WaterStylePreset} preset"," * @param {Object} uniforms"," */","const addEffects = (material, settings, preset, uniforms) => {","    const hasPixelArt = settings.pixelSize > 1;","    const hasBubbles = !preset.hasOwnBubbles && settings.bubbleIntensity > 0;","    const patch = (vertexShader, fragmentShader) => {","        let declarations = '';","        if (!/varying\\s+vec2\\s+vWaterWorldXY\\s*;/.test(fragmentShader)) declarations += 'varying vec2 vWaterWorldXY;\\n';","        if (hasPixelArt) declarations += pixelArtShaderCode;","        if (hasBubbles) declarations += bubblesShaderCode;","        declarations += 'uniform vec3 uWater3DFoamColor;\\n// Set by the style: the height of its biggest waves (without waves, three quarters up so the foam\\n// intensity still adds veins), and 1 on its crest lines.\\nfloat water3DStyleSwell = 0.75;\\nfloat water3DStylePattern = 0.5;\\n';","        // The default water already has the uniform of the crest foam.","        for (const name of crestsUniformNames) {","            if (!new RegExp('uniform\\\\s+float\\\\s+' + name + '\\\\s*;').test(fragmentShader)) {","                declarations += `uniform float ${name};\\n`;","            }","        }","        let shaders = { vertexShader, fragmentShader: declarations + fragmentShader };","        // After the declarations of the shader, that can come late (#include <common>).","        shaders.fragmentShader = shaders.fragmentShader.replace(/void main\\(\\)\\s*\\{/, (main) => crestsShaderCode + main);","        if (hasPixelArt) {","            for (const name of new Set([preset.positionVarying || 'vWorldPosition', 'vWaterWorldXY'])) {","                shaders = pixelateVarying(shaders.vertexShader, shaders.fragmentShader, name);","            }","        }","        const effectsCode = crestsFragmentCode + (hasBubbles ? bubblesFragmentCode : '');","        shaders.fragmentShader = shaders.fragmentShader.replace(","            '#include <colorspace_fragment>',","            effectsCode + '\\n#include <colorspace_fragment>'","        );","        return shaders;","    };","    if (material.isShaderMaterial) {","        Object.assign(material.uniforms, uniforms);","        const shaders = patch(material.vertexShader, material.fragmentShader);","        material.vertexShader = shaders.vertexShader;","        material.fragmentShader = shaders.fragmentShader;","        return;","    }","    const presetOnBeforeCompile = material.onBeforeCompile;","    material.onBeforeCompile = (shader, renderer) => {","        presetOnBeforeCompile.call(material, shader, renderer);","        Object.assign(shader.uniforms, uniforms);","        const shaders = patch(shader.vertexShader, shader.fragmentShader);","        shader.vertexShader = shaders.vertexShader;","        shader.fragmentShader = shaders.fragmentShader;","    };","    const presetProgramCacheKey = material.customProgramCacheKey.bind(material);","    material.customProgramCacheKey = () =>","        presetProgramCacheKey() + `-effects-${hasPixelArt}-${hasBubbles}`;","};","","/**"," * Full-screen quad shown when the camera is under the surface: its vertices are already in clip space,"," * so it ignores the camera and is never culled. Double sided: GDevelop mirrors its camera (Y axis), which"," * flips the winding of clip space triangles."," */","const createUnderwaterOverlay = () => {","    const overlay = new THREE.Mesh(","        new THREE.PlaneGeometry(2, 2),","        new THREE.ShaderMaterial({","            transparent: true,","            depthTest: false,","            depthWrite: false,","            side: THREE.DoubleSide,","            uniforms: {","                uColor: { value: new THREE.Color() },","                uDensity: { value: 0.6 },","                uTime: { value: 0 },","                // Height of the water surface on screen, 0 = bottom, 1 = top (above 1 when fully underwater).","                uSurfaceScreenY: { value: 2 },","            },","            vertexShader: `","                varying vec2 vScreenUV;","                void main() {","                    vScreenUV = position.xy * 0.5 + 0.5;","                    gl_Position = vec4(position.xy, 0.0, 1.0);","                }","            `,","            fragmentShader: `","                varying vec2 vScreenUV;","                uniform vec3 uColor;","                uniform float uDensity;","                uniform float uTime;","                uniform float uSurfaceScreenY;","                void main() {","                    // Slow wavy light from the surface, darker towards the bottom of the screen","                    float waves = sin(vScreenUV.x * 18.0 + uTime * 1.3) * sin(vScreenUV.y * 11.0 - uTime * 0.9);","                    float depthShade = mix(0.75, 1.1, vScreenUV.y) + waves * 0.04;","                    float alpha = uDensity * (1.0 - smoothstep(uSurfaceScreenY - 0.01, uSurfaceScreenY + 0.01, vScreenUV.y));","                    gl_FragColor = vec4(uColor * depthShade, alpha);","                    #include <colorspace_fragment>","                }","            `,","        })","    );","    overlay.frustumCulled = false;","    overlay.renderOrder = 10000;","    overlay.visible = false;","    overlay.name = UNDERWATER_OVERLAY_NAME;","    return overlay;","};","","const cameraPosition = new THREE.Vector3();","const cameraDirection = new THREE.Vector3();","const surfacePoint = new THREE.Vector3();","","/**"," * The surface of a water drawn with the preset of its style."," */","class WaterStyle {","    /**","     * @param {Object} water The Water of the object.","     * @param {WaterStylePreset} preset","     */","    constructor(water, preset) {","        this.water = water;","        this.preset = preset;","        // Read by the depth pass: the water is drawn by this mesh.","        this.root = water.mesh;","        water.mesh.onBeforeRender = (renderer, scene, camera, geometry, material) =>","            this._onBeforeRender(renderer, scene, camera, material);","        /** @type {THREE.Material | null} */","        this.material = null;","        this.setTime = (time) => {};","        this.signature = '';","        this.bodyColor = new THREE.Color();","        this.edgeUniforms = createEdgeUniforms();","        // Shared with the waves: the world scale is updated by the water each frame.","        this.edgeUniforms.uWorldScale = water.uniforms.waterWorldScale;","        this.needsDepthPass = false;","        this.isDisposed = false;","        this.patternSpeed = 1;","        this.foamSpeed = 1;","        this.patternTime = 0;","        this.foamTime = 0;","        this.lastTime = -1;","        this.animationFps = 0;","        this.underwaterDensity = 0;","        this.effectUniforms = {","            uWater3DPixelSize: { value: 1 },","            uWater3DBubbleIntensity: { value: 0 },","            uWater3DBubbleTime: { value: 0 },","            uWater3DPatternScale: { value: 1 },","            uWater3DFoamColor: { value: new THREE.Color() },","        };","        /** @type {THREE.Mesh | null} */","        this.underwaterOverlay = null;","        this.extras = preset.addExtras ? preset.addExtras(water) : null;","    }","","    /** @returns {WaterStyleSettings} */","    _readSettings() {","        const { object } = this.water;","        const { clamp } = gdjs.evtTools.common;","        return {","            patternScale: Math.max(0.01, object._getPatternScale() || 1),","            waterColor: object._getColor(),","            deepColor: object._getDeepColor(),","            foamColor: object._getFoamColor(),","            foamWidth: Math.max(0, object._getFoamWidth()),","            foamIntensity: clamp(object._getFoamIntensity(), 0, 1),","            waterDensity: Math.max(0, object._getWaterDensity()),","            surfaceOpacity: clamp(object._getOpacity() / 255, 0, 1),","            pixelSize: Math.max(0, object._getPixelSize()),","            animationFps: Math.max(0, object._getAnimationFps()),","            bubbleIntensity: clamp(object._getBubbleIntensity(), 0, 1),","            presetSettings: this.preset.readSettings ? this.preset.readSettings(object) : {},","        };","    }","","    updateFromProperties() {","        const { object } = this.water;","        const settings = this._readSettings();","        this.patternSpeed = Math.max(0, object._getPatternSpeed());","        this.foamSpeed = Math.max(0, object._getFoamSpeed());","        this.animationFps = this.preset.hasOwnPixelArt ? 0 : settings.animationFps;","        this.underwaterDensity = gdjs.evtTools.common.clamp(object._getUnderwaterDensity(), 0, 1);","        // Never culled with the underwater tint, so that it still follows the camera when the surface is out","        // of view.","        this.water.mesh.frustumCulled = this.underwaterDensity <= 0;","        if (this.underwaterDensity <= 0 && this.underwaterOverlay) this.underwaterOverlay.visible = false;","        // The settings are compiled in the material: it's rebuilt when they change.","        const signature = JSON.stringify(settings);","        if (signature !== this.signature) {","            this.signature = signature;","            this._createMaterial(settings);","        }","        const hasEdgeFoam = settings.foamIntensity > 0 && settings.foamWidth > 0;","        const uniforms = this.edgeUniforms;","        uniforms.uFoamWidth.value = settings.foamWidth;","        uniforms.uFoamIntensity.value = hasEdgeFoam ? settings.foamIntensity : 0;","        uniforms.uFoamColor.value.copy(toThreeColor(settings.foamColor));","        uniforms.uWaterDensity.value = settings.waterDensity * WATER_DENSITY_UNIT;","        uniforms.uSurfaceOpacity.value = settings.surfaceOpacity;","        const { effectUniforms } = this;","        effectUniforms.uWater3DPixelSize.value = Math.max(1, settings.pixelSize);","        effectUniforms.uWater3DBubbleIntensity.value = settings.bubbleIntensity;","        effectUniforms.uWater3DPatternScale.value = settings.patternScale;","        effectUniforms.uWater3DFoamColor.value.copy(toThreeColor(settings.foamColor));","        // The depth pass gives both the foam around objects and the fading with depth.","        this.needsDepthPass = hasEdgeFoam || settings.waterDensity > 0;","        if (!this.needsDepthPass) uniforms.uHasEdgeDistance.value = 0;","    }","","    /** @param {WaterStyleSettings} settings */","    _createMaterial(settings) {","        if (this.material) this.material.dispose();","        const { preset } = this;","        const created = preset.create(settings, this.edgeUniforms, this.water);","        const { material } = created;","        addDepthFade(material, !!preset.isDefault);","        if (!preset.isDefault) {","            addWorldScale(material, this.edgeUniforms.uWorldScale);","            water3D.addWaves(material, this.water.uniforms);","            // The surface hides what is under it.","            material.depthWrite = true;","        }","        addEffects(material, settings, preset, this.effectUniforms);","        this.material = material;","        this.setTime = created.setTime;","        this.water.mesh.material = material;","        this.bodyColor = this.preset.getBodyColor","            ? this.preset.getBodyColor(settings)","            : toThreeColor(settings.waterColor);","    }","","    /** @param {number} time In seconds, the same for all water objects. */","    update(time) {","        // The pattern and the foam move with their own speed, so changing a speed never makes them jump.","        const deltaTime = this.lastTime < 0 ? 0 : gdjs.evtTools.common.clamp(time - this.lastTime, 0, 0.1);","        this.lastTime = time;","        this.patternTime += deltaTime * this.patternSpeed;","        this.foamTime += deltaTime * this.foamSpeed;","        // Pixel art moves by steps.","        const { animationFps } = this;","        const toShownTime = (time) => (animationFps > 0 ? Math.floor(time * animationFps) / animationFps : time);","        const shownPatternTime = toShownTime(this.patternTime);","        this.setTime(shownPatternTime);","        this.effectUniforms.uWater3DBubbleTime.value = shownPatternTime;","        this.edgeUniforms.uFoamTime.value = toShownTime(this.foamTime);","        if (this.extras) this.extras.update();","    }","","    _onBeforeRender(renderer, scene, camera, material) {","        if (this.needsDepthPass) {","            installRenderHook(renderer);","            if (!scene.userData.water3DStyles) scene.userData.water3DStyles = new Set();","            scene.userData.water3DStyles.add(this);","        }","        // Shadow map passes also render the water, with a depth material and the light camera: only the","        // view camera decides the underwater state.","        const isShadowPass = material && (material.isMeshDepthMaterial || material.isMeshDistanceMaterial);","        if (!isShadowPass && (camera.isPerspectiveCamera || camera.isOrthographicCamera)) {","            this._updateUnderwater(scene, camera);","        }","    }","","    _updateUnderwater(scene, camera) {","        if (this.underwaterDensity <= 0) return;","        if (!this.underwaterOverlay) this.underwaterOverlay = createUnderwaterOverlay();","        const overlay = this.underwaterOverlay;","        if (overlay.parent !== scene) scene.add(overlay);","","        const { water } = this;","        const worldScale = water.uniforms.waterWorldScale.value;","        camera.getWorldPosition(cameraPosition);","        // The 3D scene is flipped on Y.","        const cameraX = cameraPosition.x * worldScale;","        const cameraY = -cameraPosition.y * worldScale;","        const surfaceZ = water.isOver(cameraX, cameraY)","            ? water.getSurfaceZ(cameraX, cameraY) / worldScale","            : -Infinity;","        const isUnderwater = cameraPosition.z < surfaceZ;","        overlay.visible = isUnderwater;","        if (!isUnderwater) return;","","        const uniforms = overlay.material.uniforms;","        uniforms.uColor.value.copy(this.bodyColor).multiplyScalar(UNDERWATER_DARKENING);","        uniforms.uDensity.value = this.underwaterDensity;","        uniforms.uTime.value = this.patternTime;","        // Where the surface crosses the screen, right in front of the camera, to cut the tint at the waterline.","        camera.getWorldDirection(cameraDirection);","        surfacePoint.copy(cameraPosition).addScaledVector(cameraDirection, camera.near * 4);","        surfacePoint.z = surfaceZ;","        const projected = surfacePoint.project(camera);","        uniforms.uSurfaceScreenY.value =","            cameraPosition.z < surfaceZ - camera.near * 2 ? 2 : projected.y * 0.5 + 0.5;","    }","","    dispose() {","        this.isDisposed = true;","        if (this.material) this.material.dispose();","        if (this.underwaterOverlay) {","            this.underwaterOverlay.removeFromParent();","            this.underwaterOverlay.geometry.dispose();","            this.underwaterOverlay.material.dispose();","        }","        if (this.extras) this.extras.dispose();","    }","}","","water3D.styleEngine = { WaterStyle, toThreeColor, getEdgeFoam: () => edgeFoam };","","// The default style: the lit water of Water3D. Like the other styles, it can have foam around objects, the","// deep water color, the underwater tint, pixel art and bubbles. They are all off with the default properties.","const SHARP_REFLECTIONS_ROUGHNESS = 0.08;","water3D.stylePresets.Default = {","    name: 'Default',","    isDefault: true,","    positionVarying: 'vWaterWorldXY',","    readSettings: (object) => ({ hasSharpReflections: !!object._getSharpReflections() }),","    create: (settings, edgeUniforms, water) => {","        const material = water3D.createDefaultMaterial(water.uniforms);","        material.color.set(gdjs.rgbOrHexStringToNumber(settings.waterColor));","        material.opacity = settings.surfaceOpacity;","        if (settings.presetSettings.hasSharpReflections) material.roughness = SHARP_REFLECTIONS_ROUGHNESS;","        const deepColorUniform = { value: toThreeColor(settings.deepColor) };","        const defaultOnBeforeCompile = material.onBeforeCompile;","        material.onBeforeCompile = (shader, renderer) => {","            defaultOnBeforeCompile.call(material, shader, renderer);","            Object.assign(shader.uniforms, edgeUniforms, { uDeepColor: deepColorUniform });","            shader.fragmentShader = shader.fragmentShader","                .replace('#include <common>', '#include <common>\\nuniform vec3 uDeepColor;\\n' + edgeFoamShaderCode)","                // The deep water takes the deep color, lit like the rest of the surface.","                .replace(","                    '#include <color_fragment>',","                    '#include <color_fragment>\\ndiffuseColor.rgb = mix(diffuseColor.rgb, uDeepColor, 1.0 - waterVisibility());'","                )","                .replace(","                    '#include <opaque_fragment>',","                    `float waterEdgeFoam = edgeFoam(vWaterWorldXY);","outgoingLight = mix(outgoingLight, uFoamColor, waterEdgeFoam);","diffuseColor.a = max(diffuseColor.a, waterEdgeFoam);","#include <opaque_fragment>`","                );","        };","        const defaultProgramCacheKey = material.customProgramCacheKey.bind(material);","        material.customProgramCacheKey = () => defaultProgramCacheKey() + '-style';","        return {","            material,","            setTime: (time) => {","                water.uniforms.waterRippleTime.value = time % 1000;","            },","        };","    },","};"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const water3D = gdjs.__water3DExtension;","if (water3D.stylePresets.RealisticWater) {","    return;","}","","// Preset \"Realistic\": lit lagoon water ported from the \"terrain-water\" material of Little Habitats.","// A MeshStandardMaterial patched with onBeforeCompile, so scene lights, shadows and fog still apply.","// Sharp reflections (object property): only changes the highlights (glossier surface, pinpoint sun glints","// instead of a soft sheen), the waves stay the same.","const { toThreeColor, getEdgeFoam } = water3D.styleEngine;","","// World pixels to shader units: one wave cell is about 200 pixels","const REALISTIC_WORLD_SCALE = 0.005;","","// Average color of the surface: the depth tint between the mid and deep colors, at the fake depth used below","function getRealisticBodyColor(settings) {","    return toThreeColor(settings.waterColor).lerp(toThreeColor(settings.deepColor), 0.58);","}","","// Short hash of a text, to tell three.js when the injected shader code changed","function hashText(text) {","    let hash = 0;","    for (let index = 0; index < text.length; index++) hash = (hash * 31 + text.charCodeAt(index)) | 0;","    return (hash >>> 0).toString(36);","}","","function createRealisticMaterial(settings, edgeUniforms) {","    const hasSharpReflections = settings.presetSettings.hasSharpReflections;","    const edgeFoamGlsl = getEdgeFoam().glsl;","    const shallowColor = toThreeColor(settings.waterColor);","    const deepColor = toThreeColor(settings.deepColor);","    const waterUniforms = {","        uTime: { value: 0 },","        uScale: { value: REALISTIC_WORLD_SCALE * settings.patternScale },","        // Fake water depth, since there is no shore distance texture in GDevelop","        uDepth: { value: 2.5 },","        uSunDir: { value: new THREE.Vector3(0.3, 0.4, 0.85).normalize() },","        uDaylight: { value: 1 },","        uShallow: { value: shallowColor },","        uMid: { value: shallowColor.clone().lerp(deepColor, 0.4) },","        uDeep: { value: deepColor },","        uDeepFar: { value: deepColor.clone().multiplyScalar(0.92) },","        uFoam: { value: toThreeColor(settings.foamColor) },","        uSky: { value: new THREE.Color(\"#cfe8ef\") }","    };","    const material = new THREE.MeshStandardMaterial({","        color: 0xffffff,","        // Low roughness gives small, crisp light highlights instead of wide soft ones","        roughness: hasSharpReflections ? 0.03 : 0.18,","        metalness: 0,","        transparent: true,","        depthWrite: false,","        side: THREE.DoubleSide","    });","    material.name = \"terrain-water\";","    material.onBeforeCompile = shader => {","        Object.assign(shader.uniforms, waterUniforms, edgeUniforms);","        shader.vertexShader = shader.vertexShader","            .replace(\"#include <common>\", \"#include <common>\\nvarying vec3 vWPos;\")","            .replace(\"#include <project_vertex>\", \"#include <project_vertex>\\nvWPos = (modelMatrix * vec4(transformed, 1.0)).xyz;\");","        shader.fragmentShader = shader.fragmentShader","            .replace(\"#include <common>\", `#include <common>","            ${hasSharpReflections ? \"#define SHARP_REFLECTIONS\" : \"\"}","            ${edgeFoamGlsl}","            varying vec3 vWPos;","            uniform float uTime; uniform float uScale; uniform float uDepth;","            uniform vec3 uSunDir; uniform float uDaylight;","            uniform vec3 uShallow; uniform vec3 uMid; uniform vec3 uDeep; uniform vec3 uDeepFar; uniform vec3 uFoam; uniform vec3 uSky;","            float w_hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123); }","            float w_noise(vec2 p) {","                vec2 i = floor(p); vec2 f = fract(p);","                vec2 u = f * f * (3.0 - 2.0 * f);","                return mix(mix(w_hash(i), w_hash(i + vec2(1.0, 0.0)), u.x), mix(w_hash(i + vec2(0.0, 1.0)), w_hash(i + vec2(1.0, 1.0)), u.x), u.y);","            }","            // The two biggest octaves of the waves, from 0 to 1","            float waveSwell(vec2 p, float t) {","                return (w_noise(p * 0.9 + vec2(t * 0.21, t * 0.13)) * 0.5","                     + w_noise(p * 1.9 + vec2(-t * 0.17, t * 0.27)) * 0.3) / 0.8;","            }","            // Noise averaged over two grids rotated from each other: alone, its ridges follow its square grid","            float w_roundNoise(vec2 p) {","                return 0.5 * (w_noise(p) + w_noise(mat2(0.7986, 0.6018, -0.6018, 0.7986) * p * 1.13 + vec2(5.2, 1.3)));","            }","            float w_ridge(float value) { return 1.0 - abs(value * 2.0 - 1.0); }","            // Crest lines of the ripples, at the scale and speed of the next two octaves of the waves: 1 on them.","            // Real foam is never a clean line: finer ridges tear them, and one octave makes them thicker or thinner.","            float waveCrests(vec2 p, float t) {","                float mediumRipples = w_roundNoise(p * 9.7 + vec2(-t * 0.52, t * 0.41));","                float crests = max(w_ridge(w_roundNoise(p * 4.3 + vec2(t * 0.36, -t * 0.29))), w_ridge(mediumRipples) - 0.03);","                float tear = w_ridge(w_roundNoise(p * 19.3 + vec2(t * 0.73, t * 0.6)));","                return crests + (tear - 0.8) * 0.18 + (mediumRipples - 0.5) * 0.08;","            }","            // Same waves with or without sharp reflections: swell plus fine ripples","            float waveH(vec2 p, float t) {","                return waveSwell(p, t) * 0.8","                     + w_noise(p * 4.3 + vec2(t * 0.36, -t * 0.29)) * 0.2","                     + w_noise(p * 9.7 + vec2(-t * 0.52, t * 0.41)) * 0.12","                     + w_noise(p * 19.3 + vec2(t * 0.73, t * 0.6)) * 0.06;","            }","            vec3 wN; vec3 wCol; float wFoam; float wFar;","            `)","            .replace(\"#include <color_fragment>\", `#include <color_fragment>","            {","                vec2 p = vWPos.xy * uScale;","                float t = uTime;","                // Depth varies slowly so the tint is not flat","                float d = max(0.0, uDepth + (w_noise(p * 0.15) - 0.5) * 1.5);","                wFar = smoothstep(22.0, 70.0, distance(cameraPosition, vWPos) * 0.01);","                // Wave normal from finite differences of layered noise, fading with distance","                float e = 0.02;","                float h0 = waveH(p, t);","                water3DStyleSwell = max(0.5 + (waveSwell(p, t) - 0.5) * 2.0, 0.0);","                water3DStylePattern = waveCrests(p, t);","                float hx = waveH(p + vec2(e, 0.0), t);","                float hy = waveH(p + vec2(0.0, e), t);","                float amp = 0.55 * (1.0 - 0.7 * wFar);","                wN = normalize(vec3(-(hx - h0) / e * amp * 0.12, -(hy - h0) / e * amp * 0.12, 1.0));","                // Depth tint","                vec3 c = mix(uShallow, uMid, smoothstep(0.05, 1.2, d));","                c = mix(c, uDeep, smoothstep(1.0, 5.0, d));","                wCol = c;","                c = mix(c, uDeepFar, wFar);","                c *= 0.95 + 0.1 * w_noise(p * 0.12 + t * 0.015);","                float wLum = dot(c, vec3(0.299, 0.587, 0.114));","                c = mix(c, mix(vec3(wLum), c, 0.5) * vec3(0.72, 0.86, 0.9), (1.0 - uDaylight) * 0.75);","                // Drifting foam rings where the fake depth is shallow","                float wob = w_noise(p * 2.7 + t * 0.35) - 0.5;","                float ph = d * 3.4 - t * 0.32 + wob * 0.5;","                float band = fract(ph);","                float ring = smoothstep(0.0, 0.08, band) * (1.0 - smoothstep(0.1, 0.24, band));","                ring *= 1.0 - smoothstep(0.1, 0.62, d);","                ring *= smoothstep(0.35, 0.6, w_noise(p * 1.6 + vec2(t * 0.05, 0.0)) + 0.25);","                wFoam = max(ring * 0.75, edgeFoam(vWPos.xy));","                float alpha = mix(0.6, 0.94, smoothstep(0.0, 2.2, d));","                alpha = mix(alpha, 1.0, smoothstep(0.35, 1.0, wFar));","                diffuseColor.rgb = mix(c, uFoam, wFoam);","                diffuseColor.a = max(alpha, wFoam * 0.95);","            }","            `)","            .replace(\"#include <normal_fragment_maps>\", `#include <normal_fragment_maps>","            normal = normalize((viewMatrix * vec4(mix(wN, vec3(0.0, 0.0, 1.0), wFoam), 0.0)).xyz);","            `)","            .replace(\"#include <emissivemap_fragment>\", `#include <emissivemap_fragment>","            totalEmissiveRadiance += uFoam * wFoam * mix(0.18, 0.06, uDaylight);","            // A little inner glow so the lagoon stays luminous in shade","            totalEmissiveRadiance += wCol * (1.0 - wFoam) * (1.0 - wFar) * 0.12 * (0.4 + 0.6 * uDaylight);","            `)","            .replace(\"#include <opaque_fragment>\", `","            {","                vec3 V = normalize(cameraPosition - vWPos);","                float nv = clamp(dot(wN, V), 0.0, 1.0);","                float fres = pow(1.0 - nv, 4.0);","                outgoingLight = mix(outgoingLight, uSky * mix(0.55, 0.9, uDaylight), fres * 0.55 * (1.0 - wFoam));","                // Sun reflection on the same waves: pinpoint glints when sharp, a soft sheen otherwise","                vec3 Rf = reflect(-V, wN);","                float sd = max(dot(Rf, normalize(uSunDir)), 0.0);","            #ifdef SHARP_REFLECTIONS","                float sparkle = step(0.8, w_noise(vWPos.xy * uScale * 18.0 + vec2(uTime * 1.3, -uTime * 0.9)));","                float glint = pow(sd, 3000.0) * sparkle * 40.0 + pow(sd, 600.0) * 0.5;","            #else","                float glint = pow(sd, 250.0) * 0.6 + pow(sd, 40.0) * 0.08;","            #endif","                glint *= (1.0 - wFoam) * smoothstep(0.0, 0.25, uSunDir.z);","                outgoingLight += vec3(1.0, 0.95, 0.85) * glint * mix(0.25, 1.0, uDaylight);","            }","            #include <opaque_fragment>`);","    };","    // The program cache key must change with the injected code, or three.js reuses a stale compiled program","    const programKey = \"gdevelop-terrain-water-v2-\" + (hasSharpReflections ? \"sharp-\" : \"\") + hashText(edgeFoamGlsl);","    material.customProgramCacheKey = () => programKey;","    return { material, setTime: time => { waterUniforms.uTime.value = time; } };","}","","water3D.stylePresets.RealisticWater = {","    name: \"Realistic\",","    readSettings: waterObject => ({ hasSharpReflections: !!waterObject._getSharpReflections() }),","    positionVarying: \"vWPos\",","    getBodyColor: getRealisticBodyColor,","    create: createRealisticMaterial","};"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const water3D = gdjs.__water3DExtension;","if (water3D.stylePresets.OceanWater) {","    return;","}","","// Preset \"Ocean\": lighting model of tuxalin/water-shader (MIT, https://github.com/tuxalin/water-shader):","// Fresnel sky reflection, specular and depth color extinction, with procedural waves instead of a normal map.","// The waves are noise octaves each rotated and scaled by an irrational factor, so no grid or repetition shows.","// An octave only fades out once it gets smaller than a pixel, so the distance keeps its detail without grain.","//","const { toThreeColor, getEdgeFoam } = water3D.styleEngine;","","// World pixels to wave coordinates","const OCEAN_WORLD_SCALE = 0.0066;","","// Average color of the surface: the depth extinction makes it mostly the deep water color","function getOceanBodyColor(settings) {","    return toThreeColor(settings.deepColor).lerp(toThreeColor(settings.waterColor), 0.25);","}","","function createOceanMaterial(settings, edgeUniforms) {","    const windDirection = new THREE.Vector2(3, 5);","    const material = new THREE.ShaderMaterial({","        side: THREE.DoubleSide,","        transparent: true,","        fog: true,","        uniforms: THREE.UniformsUtils.merge([","            THREE.UniformsLib.fog,","            {","                time: { value: 0 },","                uTiling: { value: OCEAN_WORLD_SCALE * settings.patternScale },","                uWindDirection: { value: windDirection.clone().normalize() },","                uSurfaceColor: { value: toThreeColor(settings.waterColor) },","                uDepthColor: { value: toThreeColor(settings.deepColor) },","                // Sky gradient reflected by the waves: horizon then zenith","                uSkyHorizonColor: { value: new THREE.Color(\"#e4f1f4\") },","                uSkyZenithColor: { value: new THREE.Color(\"#6fa8c8\") },","                uLightDirection: { value: new THREE.Vector3(0.3, 0.4, 0.6).normalize() },","                uLightColor: { value: new THREE.Color(1, 0.97, 0.9) }","            }","        ]),","        vertexShader: `","            #include <common>","            #include <fog_pars_vertex>","            varying vec3 vWorldPosition;","            void main() {","                #include <begin_vertex>","                vWorldPosition = (modelMatrix * vec4(transformed, 1.0)).xyz;","                #include <project_vertex>","                #include <fog_vertex>","            }","        `,","        fragmentShader: `","            #include <common>","            #include <fog_pars_fragment>","            ${getEdgeFoam().glsl}","            varying vec3 vWorldPosition;","            uniform float time;","            uniform float uTiling;","            uniform vec2 uWindDirection;","            uniform vec3 uSurfaceColor;","            uniform vec3 uDepthColor;","            uniform vec3 uSkyHorizonColor;","            uniform vec3 uSkyZenithColor;","            uniform vec3 uLightDirection;","            uniform vec3 uLightColor;","","            // Values of the original Unity material","            const vec2 REFRACTION_VALUES = vec2(0.3, 0.01);","            const float WATER_CLARITY = 0.75;","            const float WATER_TRANSPARENCY = 10.0;","            const vec3 HORIZONTAL_EXTINCTION = vec3(3.0, 10.0, 12.0);","            // Fake water depth, since GDevelop does not expose the scene depth texture","            const float WATER_DEPTH = 6.0;","            // Number of wave octaves, and the slope of the waves (higher tilts the surface and the reflections more)","            const int WAVE_OCTAVES = 6;","            const float WAVE_SLOPE = 0.6;","            // Animation speed of the waves, in wave units per second","            const float WAVE_SPEED = 0.35;","            // An octave is faded out when one of its cells spans fewer screen pixels than this","            const float MIN_PIXELS_PER_CELL = 1.5;","            // Strength of the sky reflection","            const float REFLECTION_STRENGTH = 0.85;","            // Sun highlight: exponent on the reflection angle, and its strength","            const float SPECULAR_EXPONENT = 900.0;","            const float SPECULAR_STRENGTH = 1.6;","","            float oceanHash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123); }","            float oceanNoise(vec2 p) {","                vec2 i = floor(p); vec2 f = fract(p);","                vec2 u = f * f * (3.0 - 2.0 * f);","                return mix(mix(oceanHash(i), oceanHash(i + vec2(1.0, 0.0)), u.x), mix(oceanHash(i + vec2(0.0, 1.0)), oceanHash(i + vec2(1.0, 1.0)), u.x), u.y);","            }","            // Height of the waves, 0 to 1: octaves rotated by 37 degrees each and scaled by 1.87, so their grids","            // never line up. Each octave is the mix of two noises drifting in crossed directions, so the waves","            // change shape instead of only sliding. pixelFootprint is the size of a pixel in wave units: an","            // octave whose cells get smaller than a pixel fades out, and the flat water left keeps its average.","            // For the crest foam, swell is the height of the two smooth octaves and crests the ridges of the next","            // three (1 on their crest lines). Real foam is never a clean line: the ridges of the finest octave","            // tear the crests, and one smooth octave makes them thicker or thinner along their length.","            float oceanHeight(vec2 uv, float seconds, float pixelFootprint, out float swell, out float crests) {","                const mat2 OCTAVE_ROTATION = mat2(0.7986, 0.6018, -0.6018, 0.7986);","                vec2 crossWind = vec2(-uWindDirection.y, uWindDirection.x);","                float height = 0.0;","                swell = 0.0;","                crests = 0.0;","                float crestsWidth = 0.0;","                float crestsTear = 0.0;","                float amplitude = 0.5;","                float totalAmplitude = 0.0;","                float frequency = 1.0;","                vec2 position = uv;","                for (int octave = 0; octave < WAVE_OCTAVES; octave++) {","                    float pixelsPerCell = 1.0 / max(pixelFootprint * frequency, 1e-5);","                    float detail = smoothstep(MIN_PIXELS_PER_CELL, MIN_PIXELS_PER_CELL * 2.0, pixelsPerCell);","                    float drift = seconds * WAVE_SPEED * (1.0 + 0.35 * float(octave));","                    float noiseValue = 0.5 * (oceanNoise(position + uWindDirection * drift)","                        + oceanNoise(position * 1.13 - crossWind * drift * 0.7 + vec2(5.2, 1.3)));","                    if (octave == 3) crestsWidth = (noiseValue - 0.5) * detail;","                    // Ridged octaves on top of smooth swell: sharper crests like real wind waves","                    if (octave >= 2) noiseValue = 1.0 - abs(noiseValue * 2.0 - 1.0);","                    float visibleValue = mix(0.5, noiseValue, detail);","                    height += visibleValue * amplitude;","                    if (octave < 2) swell += visibleValue * amplitude / 0.75;","                    else if (octave < 5) crests = max(crests, visibleValue - 0.03 * float(octave - 2));","                    else crestsTear = (noiseValue - 0.8) * detail;","                    totalAmplitude += amplitude;","                    position = OCTAVE_ROTATION * position * 1.87 + vec2(13.7, 7.3);","                    frequency *= 1.87;","                    amplitude *= 0.5;","                }","                crests += crestsTear * 0.18 + crestsWidth * 0.08;","                return height / totalAmplitude;","            }","","            float fresnelValue(vec3 normal, vec3 eyeDirection) {","                float angle = 1.0 - saturate(dot(normal, eyeDirection));","                float fresnel = angle * angle;","                fresnel *= fresnel;","                fresnel *= angle;","                return saturate(fresnel * (1.0 - saturate(REFRACTION_VALUES.x)) + REFRACTION_VALUES.x - REFRACTION_VALUES.y);","            }","","            // Sky seen in a direction: bright at the horizon, deeper blue towards the zenith (GDevelop is Z-up)","            vec3 skyColor(vec3 direction) {","                return mix(uSkyHorizonColor, uSkyZenithColor, smoothstep(0.0, 0.7, direction.z));","            }","","            // Water color from depth and color extinction (Wojciech Toman)","            vec3 depthRefraction(float waterDepth, float viewWaterDepth, vec3 refractionColor) {","                float accumulatedDepth = viewWaterDepth * WATER_CLARITY;","                float accumulatedDepthExp = saturate(accumulatedDepth / (2.5 * WATER_TRANSPARENCY));","                accumulatedDepthExp *= (1.0 - accumulatedDepthExp) * accumulatedDepthExp * accumulatedDepthExp + 1.0;","                vec3 waterColor = mix(uSurfaceColor, uDepthColor, saturate(vec3(waterDepth) / HORIZONTAL_EXTINCTION));","                refractionColor = mix(refractionColor, uSurfaceColor * waterColor, saturate(accumulatedDepth / WATER_TRANSPARENCY));","                refractionColor = mix(refractionColor, uDepthColor, accumulatedDepthExp);","                return mix(refractionColor, uDepthColor * waterColor, saturate(vec3(waterDepth) / HORIZONTAL_EXTINCTION));","            }","","            void main() {","                vec2 uv = vWorldPosition.xy * uTiling;","                // Size of a screen pixel in wave coordinates","                float pixelFootprint = length(fwidth(uv));","","                // Wave normal from finite differences of the height field (GDevelop is Z-up), with a step of about","                // half a pixel so the normal keeps the visible detail without sampling below the pixel","                float step = max(0.01, pixelFootprint * 0.5);","                float swell, crests, neighborSwell, neighborCrests;","                float h0 = oceanHeight(uv, time, pixelFootprint, swell, crests);","                water3DStyleSwell = max(0.5 + (swell - 0.5) * 2.0, 0.0);","                water3DStylePattern = crests;","                float hx = oceanHeight(uv + vec2(step, 0.0), time, pixelFootprint, neighborSwell, neighborCrests);","                float hy = oceanHeight(uv + vec2(0.0, step), time, pixelFootprint, neighborSwell, neighborCrests);","                vec3 normal = normalize(vec3(-(hx - h0) / step * WAVE_SLOPE, -(hy - h0) / step * WAVE_SLOPE, 1.0));","","                vec3 eyeDirection = normalize(cameraPosition - vWorldPosition);","                vec3 lightDirection = normalize(uLightDirection);","","                // Longer path through the water at grazing angles","                float viewWaterDepth = WATER_DEPTH / max(eyeDirection.z, 0.1);","                vec3 refractionColor = depthRefraction(WATER_DEPTH, viewWaterDepth, uSurfaceColor * 0.5);","                // Crests catch a little more light than troughs","                refractionColor *= mix(0.9, 1.1, h0);","","                // Each wave reflects the part of the sky its surface faces","                vec3 reflectedRay = reflect(-eyeDirection, normal);","                reflectedRay.z = abs(reflectedRay.z);","                float fresnel = fresnelValue(normal, eyeDirection);","                vec3 reflectColor = skyColor(reflectedRay) * REFLECTION_STRENGTH;","","                // Sun glints, fading only very far away where they would flicker pixel by pixel","                float glintDetail = 1.0 - smoothstep(0.1, 0.4, pixelFootprint);","                float sunAlignment = saturate(dot(reflectedRay, lightDirection));","                vec3 specularColor = uLightColor * pow(sunAlignment, SPECULAR_EXPONENT) * SPECULAR_STRENGTH * glintDetail;","","                vec3 color = saturate(mix(refractionColor, reflectColor, fresnel) + specularColor);","                float edgeFoamAmount = edgeFoam(vWorldPosition.xy);","                gl_FragColor = vec4(mix(color, uFoamColor, edgeFoamAmount), max(0.92, edgeFoamAmount));","                #include <tonemapping_fragment>","                #include <colorspace_fragment>","                #include <fog_fragment>","            }","        `","    });","    // After the merge, which clones: the edge foam uniforms must stay shared with the driver","    Object.assign(material.uniforms, edgeUniforms);","    return { material, setTime: time => { material.uniforms.time.value = time; } };","}","","water3D.stylePresets.OceanWater = { name: \"Ocean\", getBodyColor: getOceanBodyColor, create: createOceanMaterial };"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const water3D = gdjs.__water3DExtension;","if (water3D.stylePresets.FastOceanWater) {","    return;","}","","// Preset \"FastOcean\": \"Very fast procedural ocean\" by afl_ext (https://www.shadertoy.com/view/MdXyzX), MIT License.","// Ported to a surface shader: the exponential sine waves, each one dragging the next, give the height and","// normal of each pixel of the water (no full screen raymarching), with the original sky, sun and scattering.","// GDevelop is Z-up. Waves smaller than a few screen pixels fade out, so the finest ones never turn into grain.","//","const { toThreeColor, getEdgeFoam } = water3D.styleEngine;","","// World pixels to wave units","const FAST_OCEAN_WORLD_SCALE = 0.02;","","// Average color of the surface: mostly the scattering of the deep water color, with a little sky reflection","function getFastOceanBodyColor(settings) {","    return toThreeColor(settings.deepColor).multiplyScalar(0.6).lerp(toThreeColor(settings.waterColor), 0.1);","}","","function createFastOceanMaterial(settings, edgeUniforms) {","    const material = new THREE.ShaderMaterial({","        side: THREE.DoubleSide,","        transparent: true,","        fog: true,","        uniforms: THREE.UniformsUtils.merge([","            THREE.UniformsLib.fog,","            {","                time: { value: 0 },","                uScale: { value: FAST_OCEAN_WORLD_SCALE * settings.patternScale },","                uScatteringColor: { value: toThreeColor(settings.deepColor) },","                uWaterTint: { value: toThreeColor(settings.waterColor) },","                uSunDirection: { value: new THREE.Vector3(0.3, 0.4, 0.35).normalize() }","            }","        ]),","        vertexShader: `","            #include <common>","            #include <fog_pars_vertex>","            varying vec3 vWorldPosition;","            void main() {","                #include <begin_vertex>","                vWorldPosition = (modelMatrix * vec4(transformed, 1.0)).xyz;","                #include <project_vertex>","                #include <fog_vertex>","            }","        `,","        fragmentShader: `","            #include <common>","            #include <fog_pars_fragment>","            ${getEdgeFoam().glsl}","            varying vec3 vWorldPosition;","            uniform float time;","            uniform float uScale;","            uniform vec3 uScatteringColor;","            uniform vec3 uWaterTint;","            uniform vec3 uSunDirection;","","            // Values of the original shader","            const float DRAG_MULT = 0.38;","            const float WATER_DEPTH = 1.0;","            const int ITERATIONS_NORMAL = 36;","            // Size of a pixel, in wave units, that keeps only the biggest waves: the swell of the crest foam","            const float SWELL_PIXEL_FOOTPRINT = 0.17;","","            // One wave: value and derivative along its direction","            vec2 waveDx(vec2 position, vec2 direction, float frequency, float timeShift) {","                float x = dot(direction, position) * frequency + timeShift;","                float wave = exp(sin(x) - 1.0);","                float dx = wave * cos(x);","                return vec2(wave, -dx);","            }","","            // Sum of waves, each one moving the sample point of the next (the drag). pixelFootprint is the size","            // of a screen pixel in wave units: a wave whose wavelength spans too few pixels fades out.","            float getWaves(vec2 position, float pixelFootprint) {","                float wavePhaseShift = length(position) * 0.1;","                float iteration = 0.0;","                float frequency = 1.0;","                float timeMultiplier = 2.0;","                float weight = 1.0;","                float sumOfValues = 0.0;","                float sumOfWeights = 0.0;","                for (int i = 0; i < ITERATIONS_NORMAL; i++) {","                    float pixelsPerWave = (2.0 * PI / frequency) / max(pixelFootprint, 1e-5);","                    float detail = smoothstep(6.0, 16.0, pixelsPerWave);","                    if (detail <= 0.0) break;","                    vec2 direction = vec2(sin(iteration), cos(iteration));","                    vec2 result = waveDx(position, direction, frequency, time * timeMultiplier + wavePhaseShift);","                    position += direction * result.y * weight * DRAG_MULT * detail;","                    sumOfValues += result.x * weight * detail;","                    sumOfWeights += weight;","                    weight = mix(weight, 0.0, 0.2);","                    frequency *= 1.18;","                    timeMultiplier *= 1.07;","                    iteration += 1232.399963;","                }","                return sumOfWeights > 0.0 ? sumOfValues / sumOfWeights : 0.0;","            }","","            // Cheap sky of the original, Z-up","            vec3 extraCheapAtmosphere(vec3 rayDirection, vec3 sunDirection) {","                float specialTrick = 1.0 / (rayDirection.z * 1.0 + 0.1);","                float specialTrick2 = 1.0 / (sunDirection.z * 11.0 + 1.0);","                float raySunDot = pow(abs(dot(sunDirection, rayDirection)), 2.0);","                float sunDot = pow(max(0.0, dot(sunDirection, rayDirection)), 8.0);","                float mie = sunDot * specialTrick * 0.2;","                vec3 sunColor = mix(vec3(1.0), max(vec3(0.0), vec3(1.0) - vec3(5.5, 13.0, 22.4) / 22.4), specialTrick2);","                vec3 blueSky = vec3(5.5, 13.0, 22.4) / 22.4 * sunColor;","                vec3 blueSky2 = max(vec3(0.0), blueSky - vec3(5.5, 13.0, 22.4) * 0.002 * (specialTrick + -6.0 * sunDirection.z * sunDirection.z));","                blueSky2 *= specialTrick * (0.24 + raySunDot * 0.24);","                return blueSky2 * (1.0 + 1.0 * pow(1.0 - rayDirection.z, 3.0)) + mie * sunColor;","            }","            float getSun(vec3 direction, vec3 sunDirection) {","                return pow(max(0.0, dot(direction, sunDirection)), 720.0) * 210.0;","            }","            vec3 acesTonemap(vec3 color) {","                mat3 m1 = mat3(0.59719, 0.07600, 0.02840, 0.35458, 0.90834, 0.13383, 0.04823, 0.01566, 0.83777);","                mat3 m2 = mat3(1.60475, -0.10208, -0.00327, -0.53108, 1.10813, -0.07276, -0.07367, -0.00605, 1.07602);","                vec3 v = m1 * color;","                vec3 a = v * (v + 0.0245786) - 0.000090537;","                vec3 b = v * (0.983729 * v + 0.4329510) + 0.238081;","                return pow(clamp(m2 * (a / b), 0.0, 1.0), vec3(1.0 / 2.2));","            }","","            void main() {","                vec2 position = vWorldPosition.xy * uScale;","                float pixelFootprint = length(fwidth(position));","","                // Normal from the cross product of two small offsets on the height field","                float epsilon = max(0.01, pixelFootprint);","                float height = getWaves(position, pixelFootprint) * WATER_DEPTH;","                // Crest foam: the crest lines are where the smaller waves rise above the biggest ones","                float swell = getWaves(position, SWELL_PIXEL_FOOTPRINT);","                water3DStyleSwell = max(0.5 + (swell - 0.43) * 2.0, 0.0);","                water3DStylePattern = clamp(0.5 + (height / WATER_DEPTH - swell - 0.02) * 12.0, 0.0, 1.0);","                vec3 center = vec3(position, height);","                vec3 towardsX = vec3(position.x - epsilon, position.y, getWaves(position - vec2(epsilon, 0.0), pixelFootprint) * WATER_DEPTH);","                vec3 towardsY = vec3(position.x, position.y + epsilon, getWaves(position + vec2(0.0, epsilon), pixelFootprint) * WATER_DEPTH);","                vec3 normal = normalize(cross(center - towardsX, center - towardsY));","                if (normal.z < 0.0) normal = -normal;","                // Smooth the normal out near the horizon, like the original","                vec3 ray = normalize(vWorldPosition - cameraPosition);","                float distanceFactor = clamp(length(vWorldPosition - cameraPosition) * uScale * 0.01, 0.0, 1.0);","                normal = normalize(mix(normal, vec3(0.0, 0.0, 1.0), 0.8 * distanceFactor));","","                vec3 sunDirection = normalize(uSunDirection);","                float fresnel = 0.04 + 0.96 * pow(1.0 - max(0.0, dot(-normal, ray)), 5.0);","                vec3 reflectedRay = normalize(reflect(ray, normal));","                reflectedRay.z = abs(reflectedRay.z);","                vec3 reflection = extraCheapAtmosphere(reflectedRay, sunDirection) + getSun(reflectedRay, sunDirection);","                // Scattering from the deep water color, brighter on the wave crests","                vec3 scattering = uScatteringColor * 0.25 * (0.2 + (height + WATER_DEPTH) / WATER_DEPTH);","                vec3 color = fresnel * reflection + scattering + uWaterTint * 0.05;","                color = acesTonemap(color * 2.0);","                // The original tone maps to display colors: back to linear for the three.js output conversion","                color = pow(color, vec3(2.2));","","                float edgeFoamAmount = edgeFoam(vWorldPosition.xy);","                gl_FragColor = vec4(mix(color, uFoamColor, edgeFoamAmount), max(0.95, edgeFoamAmount));","                #include <colorspace_fragment>","                #include <fog_fragment>","            }","        `","    });","    // After the merge, which clones: the edge foam uniforms must stay shared with the driver","    Object.assign(material.uniforms, edgeUniforms);","    return { material, setTime: time => { material.uniforms.time.value = time; } };","}","","water3D.stylePresets.FastOceanWater = { name: \"FastOcean\", getBodyColor: getFastOceanBodyColor, create: createFastOceanMaterial };"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const water3D = gdjs.__water3DExtension;","if (water3D.stylePresets.CartoonWater) {","    return;","}","","// Preset \"Cartoon\": water with animated foam spots.","const { toThreeColor, getEdgeFoam } = water3D.styleEngine;","","// World pixels to pattern tiles, whatever the size of the object","const CARTOON_WORLD_TILING = 0.0015;","","// Average color of the surface: the water color with a little of the secondary color of the spots","function getCartoonBodyColor(settings) {","    return toThreeColor(settings.waterColor).lerp(toThreeColor(settings.deepColor), 0.15);","}","","function createCartoonMaterial(settings, edgeUniforms) {","    const waterColor = toThreeColor(settings.waterColor);","    const material = new THREE.ShaderMaterial({","        side: THREE.DoubleSide,","        transparent: true,","        fog: true,","        uniforms: Object.assign(THREE.UniformsUtils.clone(THREE.UniformsLib.fog), {","            time: { value: 0 },","            foamColor: { value: toThreeColor(settings.foamColor) },","            waterColorSurface: { value: waterColor },","            waterColorSecondary: { value: waterColor.clone().lerp(toThreeColor(settings.deepColor), 0.35) },","            displacementMultiplier: { value: 0.01 },","            tiling: { value: CARTOON_WORLD_TILING * settings.patternScale }","        }),","        vertexShader: `","            #include <common>","            #include <fog_pars_vertex>","            varying vec3 vWorldPosition;","            void main() {","                #include <begin_vertex>","                vWorldPosition = (modelMatrix * vec4(transformed, 1.0)).xyz;","                #include <project_vertex>","                #include <fog_vertex>","            }","        `,","        fragmentShader: `","            #include <common>","            #include <fog_pars_fragment>","            ${getEdgeFoam().glsl}","            varying vec3 vWorldPosition;","            uniform vec3 foamColor;","            uniform vec3 waterColorSurface;","            uniform vec3 waterColorSecondary;","            uniform float displacementMultiplier;","            uniform float tiling;","            uniform float time;","            #define M_2PI 6.283185307","            #define M_6PI 18.84955592","","            float random(vec2 uv) {","                return fract(sin(dot(uv.xy, vec2(12.9898,78.233))) * 43758.5453123);","            }","            float noise(vec2 uv) {","                vec2 i = floor(uv);","                vec2 f = fract(uv);","                float a = random(i);","                float b = random(i + vec2(1.0, 0.0));","                float c = random(i + vec2(0.0, 1.0));","                float d = random(i + vec2(1.0, 1.0));","                vec2 u = f*f*(3.0-2.0*f);","                return mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;","            }","            // Fractal Brownian Motion","            float fbm(vec2 uv) {","                float amplitude = 0.5;","                float frequency = 3.0;","                float value = 0.0;","                for (int i = 0; i < 6; i++) {","                    value += amplitude * noise(frequency * uv);","                    amplitude *= 0.5;","                    frequency *= 2.0;","                }","                return value;","            }","            // Procedural distortion map","            vec2 proceduralDuDv(vec2 uv, float time) {","                float n1 = fbm(uv + time * 0.1);","                float n2 = fbm(uv * 2.0 - time * 0.2);","                return (vec2(n1, n2) * 2.0 - 1.0) * 0.5;","            }","            // Circle mask","            float circ(vec2 pos, vec2 c, float s) {","                c = abs(pos - c);","                c = min(c, 1.0 - c);","                return dot(c,c) < s ? -1.0 : 0.0;","            }","            // Foam spots layer","            float waterlayer(vec2 uv) {","                uv = mod(uv, 1.0);","                float ret = 1.0;","                ret += circ(uv, vec2(0.37378, 0.277169), 0.0268181);","                ret += circ(uv, vec2(0.0317477, 0.540372), 0.0193742);","                ret += circ(uv, vec2(0.430044, 0.882218), 0.0232337);","                ret += circ(uv, vec2(0.641033, 0.695106), 0.0117864);","                ret += circ(uv, vec2(0.0146398, 0.0791346), 0.0299458);","                ret += circ(uv, vec2(0.43871, 0.394445), 0.0289087);","                ret += circ(uv, vec2(0.909446, 0.878141), 0.028466);","                ret += circ(uv, vec2(0.310149, 0.686637), 0.0128496);","                ret += circ(uv, vec2(0.928617, 0.195986), 0.0152041);","                ret += circ(uv, vec2(0.0438506, 0.868153), 0.0268601);","                ret += circ(uv, vec2(0.308619, 0.194937), 0.00806102);","                ret += circ(uv, vec2(0.349922, 0.449714), 0.00928667);","                ret += circ(uv, vec2(0.0449556, 0.953415), 0.023126);","                ret += circ(uv, vec2(0.117761, 0.503309), 0.0151272);","                ret += circ(uv, vec2(0.563517, 0.244991), 0.0292322);","                ret += circ(uv, vec2(0.566936, 0.954457), 0.00981141);","                ret += circ(uv, vec2(0.0489944, 0.200931), 0.0178746);","                ret += circ(uv, vec2(0.569297, 0.624893), 0.0132408);","                ret += circ(uv, vec2(0.298347, 0.710972), 0.0114426);","                ret += circ(uv, vec2(0.878141, 0.771279), 0.00322719);","                ret += circ(uv, vec2(0.150995, 0.376221), 0.00216157);","                ret += circ(uv, vec2(0.119673, 0.541984), 0.0124621);","                ret += circ(uv, vec2(0.629598, 0.295629), 0.0198736);","                ret += circ(uv, vec2(0.334357, 0.266278), 0.0187145);","                ret += circ(uv, vec2(0.918044, 0.968163), 0.0182928);","                ret += circ(uv, vec2(0.965445, 0.505026), 0.006348);","                ret += circ(uv, vec2(0.514847, 0.865444), 0.00623523);","                ret += circ(uv, vec2(0.710575, 0.0415131), 0.00322689);","                ret += circ(uv, vec2(0.71403, 0.576945), 0.0215641);","                ret += circ(uv, vec2(0.748873, 0.413325), 0.0110795);","                ret += circ(uv, vec2(0.0623365, 0.896713), 0.0236203);","                ret += circ(uv, vec2(0.980482, 0.473849), 0.00573439);","                ret += circ(uv, vec2(0.647463, 0.654349), 0.0188713);","                ret += circ(uv, vec2(0.651406, 0.981297), 0.00710875);","                ret += circ(uv, vec2(0.428928, 0.382426), 0.0298806);","                ret += circ(uv, vec2(0.811545, 0.62568), 0.00265539);","                ret += circ(uv, vec2(0.400787, 0.74162), 0.00486609);","                ret += circ(uv, vec2(0.331283, 0.418536), 0.00598028);","                ret += circ(uv, vec2(0.894762, 0.0657997), 0.00760375);","                ret += circ(uv, vec2(0.525104, 0.572233), 0.0141796);","                ret += circ(uv, vec2(0.431526, 0.911372), 0.0213234);","                ret += circ(uv, vec2(0.658212, 0.910553), 0.000741023);","                ret += circ(uv, vec2(0.514523, 0.243263), 0.0270685);","                ret += circ(uv, vec2(0.0249494, 0.252872), 0.00876653);","                ret += circ(uv, vec2(0.502214, 0.47269), 0.0234534);","                ret += circ(uv, vec2(0.693271, 0.431469), 0.0246533);","                ret += circ(uv, vec2(0.415, 0.884418), 0.0271696);","                ret += circ(uv, vec2(0.149073, 0.41204), 0.00497198);","                ret += circ(uv, vec2(0.533816, 0.897634), 0.00650833);","                ret += circ(uv, vec2(0.0409132, 0.83406), 0.0191398);","                ret += circ(uv, vec2(0.638585, 0.646019), 0.0206129);","                ret += circ(uv, vec2(0.660342, 0.966541), 0.0053511);","                ret += circ(uv, vec2(0.513783, 0.142233), 0.00471653);","                ret += circ(uv, vec2(0.124305, 0.644263), 0.00116724);","                ret += circ(uv, vec2(0.99871, 0.583864), 0.0107329);","                ret += circ(uv, vec2(0.894879, 0.233289), 0.00667092);","                ret += circ(uv, vec2(0.246286, 0.682766), 0.00411623);","                ret += circ(uv, vec2(0.0761895, 0.16327), 0.0145935);","                ret += circ(uv, vec2(0.949386, 0.802936), 0.0100873);","                ret += circ(uv, vec2(0.480122, 0.196554), 0.0110185);","                ret += circ(uv, vec2(0.896854, 0.803707), 0.013969);","                ret += circ(uv, vec2(0.292865, 0.762973), 0.00566413);","                ret += circ(uv, vec2(0.0995585, 0.117457), 0.00869407);","                ret += circ(uv, vec2(0.377713, 0.00335442), 0.0063147);","                ret += circ(uv, vec2(0.506365, 0.531118), 0.0144016);","                ret += circ(uv, vec2(0.408806, 0.894771), 0.0243923);","                ret += circ(uv, vec2(0.143579, 0.85138), 0.00418529);","                ret += circ(uv, vec2(0.0902811, 0.181775), 0.0108896);","                ret += circ(uv, vec2(0.780695, 0.394644), 0.00475475);","                ret += circ(uv, vec2(0.298036, 0.625531), 0.00325285);","                ret += circ(uv, vec2(0.218423, 0.714537), 0.00157212);","                ret += circ(uv, vec2(0.658836, 0.159556), 0.00225897);","                ret += circ(uv, vec2(0.987324, 0.146545), 0.0288391);","                ret += circ(uv, vec2(0.222646, 0.251694), 0.00092276);","                ret += circ(uv, vec2(0.159826, 0.528063), 0.00605293);","                return max(ret, 0.0);","            }","            // Water texture with distortion and animation","            vec3 waterTex(vec2 uv, float iTime) {","                uv *= 4.0;","                vec2 a = vec2(0.02, 0.02);","                float h = sin(uv.x + iTime);","                uv += a * h;","                h = sin(0.841471 * uv.x - 0.540302 * uv.y + iTime);","                uv += a * h;","                float d1 = iTime * 0.07 + mod(uv.x + uv.y, M_2PI);","                float d2 = iTime * 0.5 + mod((uv.x + uv.y + 0.25) * 1.3, M_6PI);","                vec2 dist = vec2(sin(d1) * 0.15 + sin(d2) * 0.05, cos(d1) * 0.15 + cos(d2) * 0.05);","                vec3 base = mix(waterColorSurface, waterColorSecondary, waterlayer(uv + dist));","                float foamSpots = waterlayer(vec2(1.0) - uv - dist.yx);","                water3DStylePattern = foamSpots;","                return mix(base, foamColor, foamSpots);","            }","            void main() {","                // World coordinates: the pattern keeps the same size whatever the size of the object","                vec2 worldUV = vWorldPosition.xy * tiling;","                vec2 flow = proceduralDuDv(worldUV, time);","                // Crest foam: the slow flow that bends the water is its swell","                water3DStyleSwell = max(0.5 + flow.x * 2.5, 0.0);","                worldUV += flow * displacementMultiplier;","                vec3 color = waterTex(worldUV, time);","                float edgeFoamAmount = edgeFoam(vWorldPosition.xy);","                // Flat cartoon colors: no tone mapping, so the foam stays as white as picked","                gl_FragColor = vec4(mix(color, uFoamColor, edgeFoamAmount), max(0.75, edgeFoamAmount));","                #include <colorspace_fragment>","                #include <fog_fragment>","            }","        `","    });","    Object.assign(material.uniforms, edgeUniforms);","    return { material, setTime: time => { material.uniforms.time.value = time; } };","}","","water3D.stylePresets.CartoonWater = { name: \"Cartoon\", getBodyColor: getCartoonBodyColor, create: createCartoonMaterial };"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const water3D = gdjs.__water3DExtension;","if (water3D.stylePresets.PixelWater) {","    return;","}","","// Preset \"Pixel\": retro pixel art water. The surface is cut into big square pixels in world space; on a flat","// water color, a network of lighter lines draws slowly drifting cells like the caustics of old games, with","// a few white pixels twinkling here and there. The animation moves by steps. Unlit, like old hardware.","//","const { toThreeColor, getEdgeFoam } = water3D.styleEngine;","","// World pixels to cell units: one cell is about 60 pixels","const PIXEL_CELL_SCALE = 0.016;","","// Settings specific to this preset: size of one water pixel in world pixels, and frames per second of the","// stepped animation (0 for a smooth one)","function readPixelSettings(waterObject) {","    return {","        pixelSize: Math.max(1, Number(waterObject._getPixelSize()) || 1),","        animationFps: Math.max(0, Number(waterObject._getAnimationFps()) || 0)","    };","}","","// Average color of the surface: the flat water color with a little of the lines","function getPixelBodyColor(settings) {","    return toThreeColor(settings.waterColor).lerp(toThreeColor(settings.deepColor), 0.2);","}","","function createPixelMaterial(settings, edgeUniforms) {","    const material = new THREE.ShaderMaterial({","        side: THREE.DoubleSide,","        transparent: true,","        fog: true,","        uniforms: Object.assign(THREE.UniformsUtils.clone(THREE.UniformsLib.fog), {","            time: { value: 0 },","            uPixelSize: { value: settings.presetSettings.pixelSize },","            uCellScale: { value: PIXEL_CELL_SCALE * settings.patternScale },","            uAnimationFps: { value: settings.presetSettings.animationFps },","            uWaterColor: { value: toThreeColor(settings.waterColor) },","            uShadeColor: { value: toThreeColor(settings.deepColor) },","            uSparkleColor: { value: toThreeColor(settings.foamColor) }","        }),","        vertexShader: `","            #include <common>","            #include <fog_pars_vertex>","            varying vec3 vWorldPosition;","            void main() {","                #include <begin_vertex>","                vWorldPosition = (modelMatrix * vec4(transformed, 1.0)).xyz;","                #include <project_vertex>","                #include <fog_vertex>","            }","        `,","        fragmentShader: `","            #include <common>","            #include <fog_pars_fragment>","            ${getEdgeFoam().glsl}","            varying vec3 vWorldPosition;","            uniform float time;","            uniform float uPixelSize;","            uniform float uCellScale;","            uniform float uAnimationFps;","            uniform vec3 uWaterColor;","            uniform vec3 uShadeColor;","            uniform vec3 uSparkleColor;","","            // Width of the cell lines, in cell units, and how light they are (0 = water color, 1 = sparkle color)","            const float LINE_WIDTH = 0.06;","            const float LINE_LIGHTNESS = 0.35;","            // Share of the water pixels that twinkle white at a given moment, and twinkle steps per second","            const float SPARKLE_SHARE = 0.004;","            const float SPARKLE_STEPS_PER_SECOND = 3.0;","","            vec2 pixelHash2(vec2 p) {","                p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));","                return fract(sin(p) * 43758.5453);","            }","            float pixelNoise(vec2 p) {","                vec2 i = floor(p); vec2 f = fract(p);","                vec2 u = f * f * (3.0 - 2.0 * f);","                float a = pixelHash2(i).x, b = pixelHash2(i + vec2(1.0, 0.0)).x;","                float c = pixelHash2(i + vec2(0.0, 1.0)).x, d = pixelHash2(i + vec2(1.0, 1.0)).x;","                return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);","            }","            // Distance to the nearest border between two slowly drifting cells (0 on the border)","            float cellBorder(vec2 p, float t) {","                vec2 cellIndex = floor(p);","                vec2 cellPosition = fract(p);","                float nearest = 8.0;","                float secondNearest = 8.0;","                for (int y = -1; y <= 1; y++) {","                    for (int x = -1; x <= 1; x++) {","                        vec2 neighbor = vec2(float(x), float(y));","                        vec2 seed = pixelHash2(cellIndex + neighbor);","                        seed = 0.5 + 0.4 * sin(t * 0.6 + 6.2831 * seed);","                        float distanceToSeed = length(neighbor + seed - cellPosition);","                        if (distanceToSeed < nearest) { secondNearest = nearest; nearest = distanceToSeed; }","                        else if (distanceToSeed < secondNearest) { secondNearest = distanceToSeed; }","                    }","                }","                return secondNearest - nearest;","            }","","            void main() {","                // Snap to the water pixel grid, so every water pixel is one flat square","                vec2 pixel = floor(vWorldPosition.xy / uPixelSize);","                vec2 snappedPosition = (pixel + 0.5) * uPixelSize;","                float steppedTime = uAnimationFps > 0.0 ? floor(time * uAnimationFps) / uAnimationFps : time;","                vec2 p = snappedPosition * uCellScale;","","                // Flat water with a few slightly darker areas drifting slowly, in two shades only","                float largeWaves = pixelNoise(p * 0.35 + steppedTime * 0.05);","                float shadedArea = step(0.62, largeWaves);","                // Crest foam: the light areas are the tops of the swell","                water3DStyleSwell = max(0.5 + (0.5 - largeWaves) * 2.0, 0.0);","                vec3 color = mix(uWaterColor, mix(uWaterColor, uShadeColor, 0.35), shadedArea);","","                // Network of lighter lines: two layers of cells, the second one fainter","                float mainLines = step(cellBorder(p, steppedTime), LINE_WIDTH);","                float fineLines = step(cellBorder(p * 1.9 + vec2(3.7, 1.9), steppedTime * 1.3), LINE_WIDTH * 0.8);","                water3DStylePattern = max(mainLines, fineLines * 0.7);","                color = mix(color, mix(uWaterColor, uSparkleColor, LINE_LIGHTNESS), mainLines);","                color = mix(color, mix(uWaterColor, uSparkleColor, LINE_LIGHTNESS * 0.5), fineLines * (1.0 - mainLines));","","                // A few white pixels twinkling on the lines, each for a short step","                float sparkleStep = floor(time * SPARKLE_STEPS_PER_SECOND);","                float sparkle = step(1.0 - SPARKLE_SHARE * 6.0, pixelHash2(pixel + sparkleStep * 17.13).x) * mainLines;","                sparkle = max(sparkle, step(1.0 - SPARKLE_SHARE, pixelHash2(pixel * 1.37 + sparkleStep * 5.71).y));","                color = mix(color, uSparkleColor, sparkle);","","                // Foam around objects, in whole water pixels","                float edgeFoamAmount = edgeFoam(snappedPosition);","                float foamPixel = step(0.5, edgeFoamAmount + (pixelHash2(pixel + 2.0).x - 0.5) * 0.4);","                gl_FragColor = vec4(mix(color, uFoamColor, foamPixel), 1.0);","                #include <colorspace_fragment>","                #include <fog_fragment>","            }","        `","    });","    Object.assign(material.uniforms, edgeUniforms);","    return { material, setTime: time => { material.uniforms.time.value = time; } };","}","","water3D.stylePresets.PixelWater = { name: \"Pixel\", readSettings: readPixelSettings, getBodyColor: getPixelBodyColor, create: createPixelMaterial, hasOwnPixelArt: true };"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const water3D = gdjs.__water3DExtension;","if (water3D.stylePresets.CelShadedWater) {","    return;","}","","// Preset \"CelShaded\": toon water, after the Toon Water technique by Erik Roystan Ross (roystan.net).","// The color goes from a shallow tone near objects to a deep tone further away, using the real distance to","// the scene below the surface (edge foam depth pass). Waves are a fine scrolling noise, bent by a second noise","// used as a distortion, cut at a threshold into many small crisp white shapes. The threshold drops near","// objects, so the waves turn into shoreline foam by themselves. Unlit, with edges one pixel wide at any","// distance.","const { toThreeColor, getEdgeFoam } = water3D.styleEngine;","","// World pixels to noise units: one noise cell is about 80 pixels","const CEL_NOISE_SCALE = 0.012;","","// Average color of the surface: between the shallow and the deep tone","function getCelBodyColor(settings) {","    return toThreeColor(settings.waterColor).lerp(toThreeColor(settings.deepColor), 0.6);","}","","function createCelMaterial(settings, edgeUniforms) {","    const material = new THREE.ShaderMaterial({","        side: THREE.DoubleSide,","        transparent: true,","        fog: true,","        uniforms: Object.assign(THREE.UniformsUtils.clone(THREE.UniformsLib.fog), {","            time: { value: 0 },","            uNoiseScale: { value: CEL_NOISE_SCALE * settings.patternScale },","            uShallowColor: { value: toThreeColor(settings.waterColor) },","            uDeepColor: { value: toThreeColor(settings.deepColor) }","        }),","        vertexShader: `","            #include <common>","            #include <fog_pars_vertex>","            varying vec3 vWorldPosition;","            void main() {","                #include <begin_vertex>","                vWorldPosition = (modelMatrix * vec4(transformed, 1.0)).xyz;","                #include <project_vertex>","                #include <fog_vertex>","            }","        `,","        fragmentShader: `","            #include <common>","            #include <fog_pars_fragment>","            ${getEdgeFoam().glsl}","            varying vec3 vWorldPosition;","            uniform float time;","            uniform float uNoiseScale;","            uniform vec3 uShallowColor;","            uniform vec3 uDeepColor;","","            // Cutoff of the white shapes: lower values give more of them","            const float SURFACE_NOISE_CUTOFF = 0.72;","            // Values of the original technique","            const float SURFACE_DISTORTION_AMOUNT = 0.27;","            const vec2 SURFACE_NOISE_SCROLL = vec2(0.03, 0.03);","            // Distance in world pixels over which the color goes from shallow to deep","            const float DEPTH_MAX_DISTANCE = 300.0;","            // Slow large variation of the base tone, so open water is not one flat color","            const float TONE_VARIATION = 0.25;","","            float celHash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123); }","            float celValueNoise(vec2 p) {","                vec2 i = floor(p); vec2 f = fract(p);","                vec2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);","                return mix(mix(celHash(i), celHash(i + vec2(1.0, 0.0)), u.x), mix(celHash(i + vec2(0.0, 1.0)), celHash(i + vec2(1.0, 1.0)), u.x), u.y);","            }","            // Three octaves, 0 to 1: fine detail makes many small wavy shapes instead of a few big blobs","            float celNoise(vec2 p) {","                return celValueNoise(p) * 0.5","                     + celValueNoise(p * 2.3 + vec2(17.1, 3.7)) * 0.3","                     + celValueNoise(p * 5.1 + vec2(4.3, 11.9)) * 0.2;","            }","","            void main() {","                vec2 p = vWorldPosition.xy * uNoiseScale;","","                // Water depth: thickness of water between the surface and the scene below, in world pixels","                float depthDifference = edgeDistance();","                float waterDepth01 = clamp(depthDifference / DEPTH_MAX_DISTANCE, 0.0, 1.0);","                float toneVariation = (celValueNoise(p * 0.08 + time * 0.01) - 0.5) * TONE_VARIATION;","                vec3 waterColor = mix(uShallowColor, uDeepColor, clamp(waterDepth01 + toneVariation, 0.0, 1.0));","                float waterAlpha = mix(0.75, 0.92, waterDepth01);","","                // Distortion: a second noise, from 0..1 to -1..1, bends the waves so they do not only scroll","                vec2 largeWaves = vec2(celValueNoise(p * 0.5 + vec2(time * 0.02, 0.0)),","                                       celValueNoise(p * 0.5 + vec2(5.2, 1.3) - vec2(0.0, time * 0.02)));","                vec2 distortion = (largeWaves * 2.0 - 1.0) * SURFACE_DISTORTION_AMOUNT;","                vec2 noiseCoordinates = p + time * SURFACE_NOISE_SCROLL + distortion;","                float surfaceNoiseSample = celNoise(noiseCoordinates);","                // Crest foam: the noise that bends the waves is the swell, the shapes drawn above the cutoff are","                // the crests, widened by the foam on the swell tops.","                water3DStyleSwell = max(0.5 + (largeWaves.x - 0.5) * 2.0, 0.0);","                water3DStylePattern = clamp(1.0 - (SURFACE_NOISE_CUTOFF - surfaceNoiseSample) * 1.5, 0.0, 1.0);","","                // The cutoff drops near objects: within the foam width the waves become shoreline foam","                float foamDepth01 = uFoamWidth > 0.0 ? clamp(depthDifference / uFoamWidth, 0.0, 1.0) : 1.0;","                float surfaceNoiseCutoff = foamDepth01 * SURFACE_NOISE_CUTOFF;","                // Edge about one screen pixel wide, so the shapes stay crisp near and far","                float antialias = max(fwidth(surfaceNoiseSample), 0.001);","                float surfaceNoise = smoothstep(surfaceNoiseCutoff - antialias, surfaceNoiseCutoff + antialias, surfaceNoiseSample);","                // Foam intensity only dims the shoreline part, the open water waves stay white","                surfaceNoise *= mix(uFoamIntensity, 1.0, foamDepth01);","","                // Normal blending of the foam over the water","                vec3 color = mix(waterColor, uFoamColor, surfaceNoise);","                float alpha = mix(waterAlpha, 1.0, surfaceNoise);","                gl_FragColor = vec4(color, alpha);","                #include <colorspace_fragment>","                #include <fog_fragment>","            }","        `","    });","    Object.assign(material.uniforms, edgeUniforms);","    return { material, setTime: time => { material.uniforms.time.value = time; } };","}","","water3D.stylePresets.CelShadedWater = { name: \"CelShaded\", getBodyColor: getCelBodyColor, create: createCelMaterial };"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const water3D = gdjs.__water3DExtension;","if (water3D.stylePresets.LavaFlow) {","    return;","}","","// Preset \"Lava\": molten lava. A near black crust of plates floats on the lava and breaks along glowing cracks;","// the whole surface is bent by a slow flowing distortion, the heat pulses, and molten lava wells up around","// objects. Tiny bubbles swell and burst here and there (\"Bubbles\" and \"Bubble amount\" properties). Self lit","// and over-bright in the cracks, and it lights the scene around with a point light above its center.","//","const { toThreeColor, getEdgeFoam } = water3D.styleEngine;","","// World pixels to crust plate units: one plate is about 140 pixels","const LAVA_PLATE_SCALE = 0.007;","// Share of the bubble grid cells that get a bubble when \"Bubble amount\" is 1 (0.5, the default, gives half)","const LAVA_MAX_BUBBLE_SHARE = 0.2;","// Light cast on the scene by the lava: intensity, reach relative to the lava size, and height above the","// surface relative to the lava size. Lights are physically based: the intensity is multiplied by PI, and","// without decay only the reach makes the light fade, whatever the 3D renderer world scale is.","const LAVA_LIGHT_INTENSITY = 3.0 * Math.PI;","const LAVA_LIGHT_DECAY = 0;","const LAVA_LIGHT_REACH_RATIO = 1.5;","const LAVA_LIGHT_HEIGHT_RATIO = 0.25;","","// Color seen on the sides and from inside: the glowing molten lava, a little darkened by the crust","function getLavaBodyColor(settings) {","    return toThreeColor(settings.waterColor).lerp(toThreeColor(settings.deepColor), 0.3);","}","","// Settings of this preset only: rebuild the material when they change","function readLavaSettings(lavaObject) {","    const bubbleIntensity = Math.min(1, Math.max(0, Number(lavaObject._getBubbleIntensity()) || 0));","    return {","        bubbleShare: bubbleIntensity * LAVA_MAX_BUBBLE_SHARE","    };","}","","function createLavaMaterial(settings, edgeUniforms) {","    const presetSettings = settings.presetSettings;","    const material = new THREE.ShaderMaterial({","        side: THREE.DoubleSide,","        transparent: true,","        fog: true,","        defines: presetSettings.bubbleShare > 0 ? { LAVA_BUBBLES: \"\" } : {},","        uniforms: Object.assign(THREE.UniformsUtils.clone(THREE.UniformsLib.fog), {","            time: { value: 0 },","            uPlateScale: { value: LAVA_PLATE_SCALE * settings.patternScale },","            uMoltenColor: { value: toThreeColor(settings.waterColor) },","            uCrustColor: { value: toThreeColor(settings.deepColor) },","            uHotColor: { value: toThreeColor(settings.foamColor) },","            uBubbleShare: { value: presetSettings.bubbleShare }","        }),","        vertexShader: `","            #include <common>","            #include <fog_pars_vertex>","            varying vec3 vWorldPosition;","            void main() {","                #include <begin_vertex>","                vWorldPosition = (modelMatrix * vec4(transformed, 1.0)).xyz;","                #include <project_vertex>","                #include <fog_vertex>","            }","        `,","        fragmentShader: `","            #include <common>","            #include <fog_pars_fragment>","            ${getEdgeFoam().glsl}","            varying vec3 vWorldPosition;","            uniform float time;","            uniform float uPlateScale;","            uniform vec3 uMoltenColor;","            uniform vec3 uCrustColor;","            uniform vec3 uHotColor;","            // Share of the bubble grid cells that get a bubble, 0 to 1","            uniform float uBubbleShare;","","            // Width of the glowing cracks between plates, in plate units, and the speed of the flow","            const float CRACK_WIDTH = 0.08;","            const float FLOW_SPEED = 0.08;","            // Brightness of the molten lava (above 1: over-bright, it reads as emitting light)","            const float EMISSIVE_STRENGTH = 2.2;","            // Soft glow spreading from the cracks over the crust, and its reach in plate units","            const float GLOW_STRENGTH = 0.9;","            const float GLOW_REACH = 0.18;","            // Bubbles: grid cells per plate unit (higher = smaller bubbles, a cell is about 40 pixels), and","            // bubble cycle in seconds","            const float BUBBLE_CELLS = 3.5;","            const float BUBBLE_PERIOD_MIN = 2.0;","            const float BUBBLE_PERIOD_RANGE = 4.0;","            // Part of the cycle spent swelling, the rest is the burst","            const float BUBBLE_SWELL_PART = 0.85;","","            vec2 lavaHash2(vec2 p) {","                p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));","                return fract(sin(p) * 43758.5453);","            }","            float lavaNoise(vec2 p) {","                vec2 i = floor(p); vec2 f = fract(p);","                vec2 u = f * f * (3.0 - 2.0 * f);","                float a = lavaHash2(i).x, b = lavaHash2(i + vec2(1.0, 0.0)).x;","                float c = lavaHash2(i + vec2(0.0, 1.0)).x, d = lavaHash2(i + vec2(1.0, 1.0)).x;","                return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);","            }","            float lavaFbm(vec2 p) {","                const mat2 OCTAVE_ROTATION = mat2(0.7986, 0.6018, -0.6018, 0.7986);","                float value = 0.0;","                float amplitude = 0.5;","                for (int octave = 0; octave < 5; octave++) {","                    value += lavaNoise(p) * amplitude;","                    p = OCTAVE_ROTATION * p * 2.03 + vec2(3.1, 1.7);","                    amplitude *= 0.5;","                }","                return value;","            }","            // Distance to the nearest border between two slowly drifting plates (0 on the border)","            float plateBorder(vec2 p, float t) {","                vec2 cellIndex = floor(p);","                vec2 cellPosition = fract(p);","                float nearest = 8.0;","                float secondNearest = 8.0;","                for (int y = -1; y <= 1; y++) {","                    for (int x = -1; x <= 1; x++) {","                        vec2 neighbor = vec2(float(x), float(y));","                        vec2 seed = lavaHash2(cellIndex + neighbor);","                        seed = 0.5 + 0.35 * sin(t * 0.4 + 6.2831 * seed);","                        float distanceToSeed = length(neighbor + seed - cellPosition);","                        if (distanceToSeed < nearest) { secondNearest = nearest; nearest = distanceToSeed; }","                        else if (distanceToSeed < secondNearest) { secondNearest = distanceToSeed; }","                    }","                }","                return secondNearest - nearest;","            }","","            // One bubble per chosen grid cell, each on its own cycle: it swells as a glowing dome, then bursts","            // into a ring of bright lava that spreads and fades. x = dome amount, y = rim, z = burst ring.","            vec3 lavaBubble(vec2 p, float t) {","                vec2 cellCoordinates = p * BUBBLE_CELLS;","                vec2 cellIndex = floor(cellCoordinates);","                vec2 cellPosition = fract(cellCoordinates);","                vec2 cellRandom = lavaHash2(cellIndex + vec2(17.0, 5.0));","                if (cellRandom.x >= uBubbleShare) return vec3(0.0);","                float period = BUBBLE_PERIOD_MIN + BUBBLE_PERIOD_RANGE * cellRandom.y;","                float phase = fract(t / period + cellRandom.x * 7.13);","                vec2 center = 0.35 + 0.3 * lavaHash2(cellIndex + vec2(3.1, 9.7));","                float distanceToCenter = length(cellPosition - center);","                float antialias = fwidth(distanceToCenter);","                if (phase < BUBBLE_SWELL_PART) {","                    float radius = 0.22 * smoothstep(0.0, BUBBLE_SWELL_PART, phase);","                    float dome = 1.0 - smoothstep(radius - antialias, radius + antialias, distanceToCenter);","                    float rim = smoothstep(radius * 0.6, radius, distanceToCenter) * dome;","                    return vec3(dome, rim, 0.0);","                }","                float burst = (phase - BUBBLE_SWELL_PART) / (1.0 - BUBBLE_SWELL_PART);","                float ringRadius = 0.22 + 0.2 * burst;","                float ring = (1.0 - smoothstep(0.0, 0.025 + antialias, abs(distanceToCenter - ringRadius))) * (1.0 - burst);","                // Splash of molten lava left in the center right after the burst","                float splash = (1.0 - smoothstep(0.0, 0.22, distanceToCenter)) * (1.0 - burst) * 0.8;","                return vec3(0.0, 0.0, max(ring, splash));","            }","","            void main() {","                vec2 p = vWorldPosition.xy * uPlateScale;","                float t = time;","                // Flowing distortion: the lava drifts along one direction and churns on itself","                vec2 flow = vec2(t * FLOW_SPEED, t * FLOW_SPEED * 0.4);","                vec2 distortion = vec2(lavaFbm(p * 0.7 + flow), lavaFbm(p * 0.7 - flow + vec2(5.2, 1.3))) - 0.5;","                vec2 q = p + distortion * 0.8 + flow;","","                // Plates and cracks: the cracks widen and narrow where the heat is higher","                float heat = lavaFbm(q * 1.5 - flow * 2.0);","                // Crest foam: the churning of the lava is its swell, the hottest spots its crests","                water3DStyleSwell = max(0.5 + distortion.x * 2.5, 0.0);","                water3DStylePattern = clamp(0.5 + (heat - 0.48) * 3.0, 0.0, 1.0);","                float border = plateBorder(q, t);","                float crackWidth = CRACK_WIDTH * mix(0.4, 1.8, heat);","                float crack = 1.0 - smoothstep(0.0, crackWidth + fwidth(border), border);","","                // Crust: near black in the middle of the plates, with some rough texture","                float plateCenter = smoothstep(crackWidth, 0.45, border);","                float roughness = lavaFbm(q * 5.0);","                vec3 crust = uCrustColor * mix(1.0, 0.15, plateCenter) * (0.6 + 0.8 * roughness);","                // Glow of the molten lava bleeding on the crust near the cracks","                float glow = exp(-max(border - crackWidth, 0.0) / GLOW_REACH) * GLOW_STRENGTH * heat;","                crust += uMoltenColor * glow;","","                // Molten lava: over-bright, hotter where the heat is high, with a slow pulse","                float pulse = 0.8 + 0.2 * sin(t * 1.3 + heat * 6.0);","                vec3 molten = mix(uMoltenColor, uHotColor, smoothstep(0.5, 0.85, heat)) * EMISSIVE_STRENGTH * pulse;","                vec3 color = mix(crust, molten, crack);","","            #ifdef LAVA_BUBBLES","                // Bubbles drift with the lava, all in the molten color: a dome, a brighter rim, then a burst ring","                vec3 bubble = lavaBubble(q, t);","                color = mix(color, uMoltenColor * EMISSIVE_STRENGTH * 0.9, bubble.x);","                color = mix(color, uMoltenColor * EMISSIVE_STRENGTH * 1.2, bubble.y * 0.8);","                color = mix(color, uMoltenColor * EMISSIVE_STRENGTH * 1.3, bubble.z);","            #endif","","                // Molten lava wells up around objects, in the molten color and pulsing like the cracks","                float edgeFoamAmount = edgeFoam(vWorldPosition.xy);","                color = mix(color, uMoltenColor * EMISSIVE_STRENGTH * pulse, edgeFoamAmount);","                gl_FragColor = vec4(color, 1.0);","                #include <tonemapping_fragment>","                #include <colorspace_fragment>","                #include <fog_fragment>","            }","        `","    });","    Object.assign(material.uniforms, edgeUniforms);","    return { material, setTime: time => { material.uniforms.time.value = time; } };","}","","// Point light above the center of the lava, in its molten color, so the lava lights the objects around it.","// Placed from the box of the water at each step, since the object size and position can change during the","// game.","const lavaLightBox = new THREE.Box3();","const lavaLightSize = new THREE.Vector3();","const lavaLightPosition = new THREE.Vector3();","function placeLavaLight(water, light, root) {","    root.updateWorldMatrix(true, true);","    lavaLightBox.makeEmpty();","    lavaLightBox.expandByObject(water.mesh);","    if (lavaLightBox.isEmpty()) return;","    lavaLightBox.getSize(lavaLightSize);","    const reach = Math.max(lavaLightSize.x, lavaLightSize.y);","    light.distance = reach * LAVA_LIGHT_REACH_RATIO;","    light.color.copy(toThreeColor(water.object._getColor()));","    lavaLightPosition.set(","        (lavaLightBox.min.x + lavaLightBox.max.x) / 2,","        (lavaLightBox.min.y + lavaLightBox.max.y) / 2,","        lavaLightBox.max.z + reach * LAVA_LIGHT_HEIGHT_RATIO","    );","    root.worldToLocal(lavaLightPosition);","    light.position.copy(lavaLightPosition);","}","function addLavaLight(water) {","    const root = water.object.get3DRendererObject();","    const light = new THREE.PointLight(0xffffff, LAVA_LIGHT_INTENSITY, 0, LAVA_LIGHT_DECAY);","    light.name = \"lava-light\";","    root.add(light);","    return {","        update: () => placeLavaLight(water, light, root),","        dispose: () => {","            light.removeFromParent();","            light.dispose();","        }","    };","}","","water3D.stylePresets.LavaFlow = {","    name: \"Lava\",","    readSettings: readLavaSettings,","    getBodyColor: getLavaBodyColor,","    create: createLavaMaterial,","    addExtras: addLavaLight,","    hasOwnBubbles: true","};"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const water3D = gdjs.__water3DExtension;","if (water3D.stylePresets.PixelMagma) {","    return;","}","","// Preset \"PixelMagma\": pixel art magma. The surface is cut into big square pixels in world space and filled","// with slowly drifting cells: near black speckled cores, dark red rings, bright red borders and hot orange","// junctions where three cells meet. Few flat colors and a stepped animation, like old games. Self lit.","//","const { toThreeColor, getEdgeFoam } = water3D.styleEngine;","","// World pixels to cell units: one cell is about 120 pixels","const MAGMA_CELL_SCALE = 0.0085;","","// Settings specific to this preset: size of one pixel in world pixels, and frames per second of the stepped","// animation (0 for a smooth one)","function readMagmaSettings(waterObject) {","    return {","        pixelSize: Math.max(1, Number(waterObject._getPixelSize()) || 1),","        animationFps: Math.max(0, Number(waterObject._getAnimationFps()) || 0)","    };","}","","// Color seen on the sides and from inside: the dark red of the cells","function getMagmaBodyColor(settings) {","    return toThreeColor(settings.deepColor).lerp(toThreeColor(settings.waterColor), 0.35);","}","","function createMagmaMaterial(settings, edgeUniforms) {","    const material = new THREE.ShaderMaterial({","        side: THREE.DoubleSide,","        transparent: true,","        fog: true,","        uniforms: Object.assign(THREE.UniformsUtils.clone(THREE.UniformsLib.fog), {","            time: { value: 0 },","            uPixelSize: { value: settings.presetSettings.pixelSize },","            uCellScale: { value: MAGMA_CELL_SCALE * settings.patternScale },","            uAnimationFps: { value: settings.presetSettings.animationFps },","            uBorderColor: { value: toThreeColor(settings.waterColor) },","            uCoreColor: { value: toThreeColor(settings.deepColor) },","            uJunctionColor: { value: toThreeColor(settings.foamColor) }","        }),","        vertexShader: `","            #include <common>","            #include <fog_pars_vertex>","            varying vec3 vWorldPosition;","            void main() {","                #include <begin_vertex>","                vWorldPosition = (modelMatrix * vec4(transformed, 1.0)).xyz;","                #include <project_vertex>","                #include <fog_vertex>","            }","        `,","        fragmentShader: `","            #include <common>","            #include <fog_pars_fragment>","            ${getEdgeFoam().glsl}","            varying vec3 vWorldPosition;","            uniform float time;","            uniform float uPixelSize;","            uniform float uCellScale;","            uniform float uAnimationFps;","            uniform vec3 uBorderColor;","            uniform vec3 uCoreColor;","            uniform vec3 uJunctionColor;","","            // Width of the bright borders and of the hot junctions, in cell units","            const float BORDER_WIDTH = 0.08;","            const float JUNCTION_WIDTH = 0.2;","            // Width of the dark red ring inside each cell, and size of the near black core","            const float RING_WIDTH = 0.22;","            const float CORE_RADIUS = 0.3;","            // Share of the pixels that take the shade of their neighbor band, for the speckled look","            const float SPECKLE_SHARE = 0.3;","","            vec2 magmaHash2(vec2 p) {","                p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));","                return fract(sin(p) * 43758.5453);","            }","            // Distances to the three nearest drifting cell seeds, in increasing order","            vec3 cellDistances(vec2 p, float t) {","                vec2 cellIndex = floor(p);","                vec2 cellPosition = fract(p);","                vec3 nearest = vec3(8.0);","                for (int y = -1; y <= 1; y++) {","                    for (int x = -1; x <= 1; x++) {","                        vec2 neighbor = vec2(float(x), float(y));","                        vec2 seed = magmaHash2(cellIndex + neighbor);","                        seed = 0.5 + 0.35 * sin(t * 0.5 + 6.2831 * seed);","                        float distanceToSeed = length(neighbor + seed - cellPosition);","                        if (distanceToSeed < nearest.x) { nearest = vec3(distanceToSeed, nearest.xy); }","                        else if (distanceToSeed < nearest.y) { nearest = vec3(nearest.x, distanceToSeed, nearest.y); }","                        else if (distanceToSeed < nearest.z) { nearest.z = distanceToSeed; }","                    }","                }","                return nearest;","            }","","            void main() {","                // Snap to the pixel grid, so every pixel is one flat square","                vec2 pixel = floor(vWorldPosition.xy / uPixelSize);","                vec2 snappedPosition = (pixel + 0.5) * uPixelSize;","                float steppedTime = uAnimationFps > 0.0 ? floor(time * uAnimationFps) / uAnimationFps : time;","                vec2 p = snappedPosition * uCellScale;","","                vec3 distances = cellDistances(p, steppedTime);","                float borderDistance = distances.y - distances.x;","                float junctionDistance = distances.z - distances.x;","                water3DStylePattern = 1.0 - smoothstep(0.0, 0.3, borderDistance);","","                // Bands from the center of the cell to its border: core, dark red, ring, border","                float band = distances.x < CORE_RADIUS ? 0.0 : (borderDistance < RING_WIDTH ? 2.0 : 1.0);","                // Speckles: some pixels take the shade of the next band, which breaks the bands into pixels","                vec2 speckleRandom = magmaHash2(pixel + floor(steppedTime * 0.5) * 3.1);","                if (speckleRandom.x < SPECKLE_SHARE) band = clamp(band + (speckleRandom.y < 0.5 ? -1.0 : 1.0), 0.0, 2.0);","                vec3 color = band < 0.5 ? uCoreColor","                           : band < 1.5 ? mix(uCoreColor, uBorderColor, 0.3)","                           : mix(uCoreColor, uBorderColor, 0.55);","","                // Bright borders, and hot junctions where three cells meet","                if (borderDistance < BORDER_WIDTH) color = uBorderColor;","                if (junctionDistance < JUNCTION_WIDTH && borderDistance < BORDER_WIDTH * 1.5) color = uJunctionColor;","","                // Hot glow around objects, in whole pixels","                float edgeFoamAmount = edgeFoam(snappedPosition);","                float glowPixel = step(0.5, edgeFoamAmount + (magmaHash2(pixel + 7.0).x - 0.5) * 0.4);","                gl_FragColor = vec4(mix(color, uFoamColor, glowPixel), 1.0);","                #include <colorspace_fragment>","                #include <fog_fragment>","            }","        `","    });","    Object.assign(material.uniforms, edgeUniforms);","    return { material, setTime: time => { material.uniforms.time.value = time; } };","}","","water3D.stylePresets.PixelMagma = { name: \"PixelMagma\", readSettings: readMagmaSettings, getBodyColor: getMagmaBodyColor, create: createMagmaMaterial, hasOwnPixelArt: true };"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const water3D = gdjs.__water3DExtension;","if (water3D.stylePresets.ToxicSlime) {","    return;","}","","// Preset \"Slime\": glossy toxic goo, like jelly in a cartoon. A slow, smooth swirl is used as a height field:","// it is shaded softly from dark to light green and lit by a fixed fake light, so the slime looks thick and","// rounded, with a crisp glossy highlight on each bulge. A few round bubbles swell and pop. Bubbly froth","// around objects. Unlit by the scene, so it keeps its colors everywhere.","//","const { toThreeColor, getEdgeFoam } = water3D.styleEngine;","","// World pixels to swirl units: one bulge is about 55 pixels","const SLIME_SWIRL_SCALE = 0.018;","// Share of the bubble cells with a bubble, for a bubble amount of 1","const SLIME_MAX_BUBBLE_SHARE = 0.24;","","// Color seen on the sides and from inside: the middle shade of the goo","function getSlimeBodyColor(settings) {","    return toThreeColor(settings.deepColor).lerp(toThreeColor(settings.waterColor), 0.5);","}","","function createSlimeMaterial(settings, edgeUniforms) {","    const material = new THREE.ShaderMaterial({","        side: THREE.DoubleSide,","        transparent: true,","        fog: true,","        uniforms: Object.assign(THREE.UniformsUtils.clone(THREE.UniformsLib.fog), {","            time: { value: 0 },","            uSwirlScale: { value: SLIME_SWIRL_SCALE * settings.patternScale },","            uLightColor: { value: toThreeColor(settings.waterColor) },","            uDarkColor: { value: toThreeColor(settings.deepColor) },","            uBubbleShare: { value: settings.bubbleIntensity * SLIME_MAX_BUBBLE_SHARE }","        }),","        vertexShader: `","            #include <common>","            #include <fog_pars_vertex>","            varying vec3 vWorldPosition;","            void main() {","                #include <begin_vertex>","                vWorldPosition = (modelMatrix * vec4(transformed, 1.0)).xyz;","                #include <project_vertex>","                #include <fog_vertex>","            }","        `,","        fragmentShader: `","            #include <common>","            #include <fog_pars_fragment>","            ${getEdgeFoam().glsl}","            varying vec3 vWorldPosition;","            uniform float time;","            uniform float uSwirlScale;","            uniform vec3 uLightColor;","            uniform vec3 uDarkColor;","","            // How steep the bulges look under the fake light","            const float BULGE_HEIGHT = 2.2;","            // Glossy highlight: how tight it is, and where its crisp edge sits","            const float GLOSS_SHININESS = 24.0;","            const float GLOSS_EDGE = 0.55;","            // Bubbles: grid cells per swirl unit, share of the cells with a bubble, cycle in seconds","            const float BUBBLE_CELLS = 1.6;","            uniform float uBubbleShare;","            const float BUBBLE_PERIOD = 4.0;","","            vec2 slimeHash2(vec2 p) {","                p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));","                return fract(sin(p) * 43758.5453);","            }","            float slimeNoise(vec2 p) {","                vec2 i = floor(p); vec2 f = fract(p);","                vec2 u = f * f * (3.0 - 2.0 * f);","                float a = slimeHash2(i).x, b = slimeHash2(i + vec2(1.0, 0.0)).x;","                float c = slimeHash2(i + vec2(0.0, 1.0)).x, d = slimeHash2(i + vec2(1.0, 1.0)).x;","                return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);","            }","            // Smooth slow swirl, folded once so the bulges stretch and curl like goo. Few details on purpose.","            float slimeHeight(vec2 p, float t) {","                vec2 fold = vec2(slimeNoise(p * 0.6 + vec2(t * 0.05, 0.0)), slimeNoise(p * 0.6 + vec2(5.2, 1.3) - vec2(0.0, t * 0.04)));","                vec2 q = p + (fold - 0.5) * 1.4;","                return slimeNoise(q) * 0.8 + slimeNoise(q * 1.8 + vec2(t * 0.06)) * 0.2;","            }","            // One bubble per chosen cell: x = inside, y = rim, z = shine spot","            vec3 slimeBubble(vec2 p, float t) {","                vec2 gridPosition = p * BUBBLE_CELLS;","                vec2 cellIndex = floor(gridPosition);","                vec2 cellPosition = fract(gridPosition);","                vec2 cellRandom = slimeHash2(cellIndex + vec2(4.0, 13.0));","                if (cellRandom.x >= uBubbleShare) return vec3(0.0);","                float phase = fract(t / (BUBBLE_PERIOD * (0.7 + 0.6 * cellRandom.y)) + cellRandom.x * 9.1);","                // Swells slowly, then pops: gone for the last part of the cycle","                float radius = 0.22 * smoothstep(0.0, 0.8, phase) * step(phase, 0.85);","                vec2 center = 0.35 + 0.3 * slimeHash2(cellIndex + vec2(7.7, 2.2));","                vec2 offset = cellPosition - center;","                float distanceToCenter = length(offset);","                float antialias = fwidth(distanceToCenter);","                float inside = 1.0 - smoothstep(radius - antialias, radius + antialias, distanceToCenter);","                float rim = inside * smoothstep(radius * 0.6, radius, distanceToCenter);","                float shine = 1.0 - smoothstep(radius * 0.2 - antialias, radius * 0.2 + antialias, length(offset - vec2(-0.35, 0.35) * radius));","                return vec3(inside, rim, shine * inside);","            }","","            void main() {","                vec2 p = vWorldPosition.xy * uSwirlScale;","                float t = time;","                float height = slimeHeight(p, t);","                // Crest foam: the slow swirl is the swell, the tops of the bulges the crests","                water3DStyleSwell = max(0.5 + (slimeNoise(p * 0.6 + vec2(t * 0.05, 0.0)) - 0.5) * 2.0, 0.0);","                water3DStylePattern = clamp(0.5 + (height - 0.5) * 2.0, 0.0, 1.0);","","                // Normal of the height field, for the fake light","                const float SAMPLE_OFFSET = 0.02;","                float heightX = slimeHeight(p + vec2(SAMPLE_OFFSET, 0.0), t);","                float heightY = slimeHeight(p + vec2(0.0, SAMPLE_OFFSET), t);","                vec3 normal = normalize(vec3((height - heightX) / SAMPLE_OFFSET * BULGE_HEIGHT * 0.1,","                                             (height - heightY) / SAMPLE_OFFSET * BULGE_HEIGHT * 0.1, 1.0));","                vec3 lightDirection = normalize(vec3(-0.5, 0.6, 1.0));","","                // Soft shading: dark in the hollows, light on the bulges, a little darker away from the light","                vec3 color = mix(uDarkColor, uLightColor, smoothstep(0.2, 0.85, height));","                color *= 0.75 + 0.35 * max(dot(normal, lightDirection), 0.0);","","                // Crisp glossy highlight on the bulges, like wet jelly","                vec3 halfway = normalize(lightDirection + vec3(0.0, 0.0, 1.0));","                float gloss = pow(max(dot(normal, halfway), 0.0), GLOSS_SHININESS) * smoothstep(0.45, 0.7, height);","                color = mix(color, vec3(1.0), smoothstep(GLOSS_EDGE - 0.08, GLOSS_EDGE, gloss) * 0.8);","","                // A few round bubbles: lighter rim, white shine","                vec3 bubble = slimeBubble(p, t);","                color = mix(color, mix(color, uLightColor * 1.2, 0.5), bubble.x);","                color = mix(color, uLightColor * 1.3, bubble.y * 0.6);","                color = mix(color, vec3(1.0), bubble.z);","","                // Bubbly froth around objects","                float frothAmount = edgeFoam(vWorldPosition.xy);","                float frothBubbles = smoothstep(0.4, 0.5, slimeNoise(vWorldPosition.xy * 0.06 + t * 0.4));","                float froth = smoothstep(0.5, 0.6, frothAmount) + smoothstep(0.2, 0.3, frothAmount) * frothBubbles;","                color = mix(color, uFoamColor, clamp(froth, 0.0, 1.0));","","                gl_FragColor = vec4(color, 1.0);","                #include <colorspace_fragment>","                #include <fog_fragment>","            }","        `","    });","    Object.assign(material.uniforms, edgeUniforms);","    return { material, setTime: time => { material.uniforms.time.value = time; } };","}","","water3D.stylePresets.ToxicSlime = { name: \"Slime\", getBodyColor: getSlimeBodyColor, create: createSlimeMaterial, hasOwnBubbles: true };"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[]}],"parameters":[],"objectGroups":[]}],"eventsFunctionsFolderStructure":{"folderName":"__ROOT","children":[{"functionName":"DefineHelperClasses"}]},"eventsBasedBehaviors":[],"eventsBasedObjects":[{"areaMaxX":1000,"areaMaxY":1000,"areaMaxZ":1,"areaMinX":0,"areaMinY":0,"areaMinZ":0,"assetStoreTag":"3d water","defaultName":"Water","description":"A water surface with waves, for seas, lakes and rivers. Objects can float on it.","fullName":"3D water","helpPath":"","iconUrl":"data:image/svg+xml;base64,","is3D":true,"isUsingLegacyInstancesRenderer":true,"name":"Water3D","previewIconUrl":"https://resources.gdevelop-app.com/assets/Icons/waves.svg","objects":[{"assetStoreId":"","name":"AreaPlaceholder","type":"Scene3D::Cube3DObject","variables":[],"effects":[],"behaviors":[],"content":{"width":1000.0,"height":1000.0,"depth":1.0,"enableTextureTransparency":false,"facesOrientation":"Y","backFaceUpThroughWhichAxisRotation":"X","materialType":"Basic","tint":"255;255;255","frontFaceResourceName":"","frontFaceVisible":false,"frontFaceResourceRepeat":false,"backFaceResourceName":"","backFaceVisible":false,"backFaceResourceRepeat":false,"leftFaceResourceName":"","leftFaceVisible":false,"leftFaceResourceRepeat":false,"rightFaceResourceName":"","rightFaceVisible":false,"rightFaceResourceRepeat":false,"topFaceResourceName":"","topFaceVisible":false,"topFaceResourceRepeat":false,"bottomFaceResourceName":"","bottomFaceVisible":false,"bottomFaceResourceRepeat":false}}],"objectsFolderStructure":{"folderName":"__ROOT","children":[{"objectName":"AreaPlaceholder"}]},"objectsGroups":[],"layers":[{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"","renderingType":"","visibility":true,"cameras":[{"defaultSize":true,"defaultViewport":true,"height":0.0,"viewportBottom":1.0,"viewportLeft":0.0,"viewportRight":1.0,"viewportTop":0.0,"width":0.0}],"effects":[]}],"instances":[{"angle":0.0,"customSize":true,"depth":1.0,"height":1000.0,"keepRatio":true,"layer":"","name":"AreaPlaceholder","persistentUuid":"5d7a8b1e-3c2f-4e6a-9b1d-001000001000","width":1000.0,"x":0.0,"y":0.0,"zOrder":1,"numberProperties":[],"stringProperties":[],"initialVariables":[]}],"editionSettings":{},"eventsFunctions":[{"fullName":"","functionType":"Action","name":"onCreated","sentence":"","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"Water3D::DefineHelperClasses"},"parameters":["",""]}]},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","for (const child of object.getChildrenContainer().getAdhocListOfAllInstances()) {","    child.deleteFromScene();","}","if (object.__water3D) object.__water3D.dispose();","object.__water3D = new gdjs.__water3DExtension.Water(object);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Water3D::Water3D","type":"object"}],"objectGroups":[]},{"fullName":"","functionType":"Action","name":"onDestroy","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","object.__water3D.dispose();"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Water3D::Water3D","type":"object"}],"objectGroups":[]},{"fullName":"","functionType":"Action","name":"doStepPostEvents","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const game = runtimeScene.getGame();","// Time doesn't pass in the scene editor: real time is used to show the waves.","const time = game.isInGameEdition && game.isInGameEdition()","    ? performance.now() / 1000","    : object.getRuntimeScene().getTimeManager().getTimeFromStart() / 1000;","object.__water3D.update(time);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Water3D::Water3D","type":"object"}],"objectGroups":[]},{"fullName":"","functionType":"Action","name":"onHotReloading","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","object.__water3D.updateFromProperties();"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Water3D::Water3D","type":"object"}],"objectGroups":[]},{"description":"the Z position of the water surface, with the waves, at a position of the scene.","fullName":"Water surface Z position","functionType":"ExpressionAndCondition","name":"SurfaceZ","sentence":"the water surface Z position at _PARAM1_; _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const x = eventsFunctionContext.getArgument(\"X\");","const y = eventsFunctionContext.getArgument(\"Y\");","eventsFunctionContext.returnValue = object.__water3D.getSurfaceZ(x, y);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Water3D::Water3D","type":"object"},{"description":"X position","name":"X","type":"expression"},{"description":"Y position","name":"Y","type":"expression"}],"objectGroups":[]},{"description":"Check if the center of an object is under the water surface.","fullName":"Object is underwater","functionType":"Condition","name":"IsUnderwater","sentence":"_PARAM1_ is under the water of _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const water = object.__water3D;","eventsFunctionContext.returnValue = gdjs.evtTools.object.pickObjectsIf(","    (objectToCheck) => water.isUnderwater(objectToCheck),","    eventsFunctionContext.getObjectsLists(\"Objects\"),","    false,","    null",");"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Water3D::Water3D","type":"object"},{"description":"Objects","name":"Objects","type":"objectList"}],"objectGroups":[]},{"description":"Push objects with the 3D physics behavior up when they are in the water, and slow them down. Run this action every frame.","fullName":"Make objects float","functionType":"Action","name":"ApplyBuoyancy","sentence":"Make _PARAM1_ float on _PARAM0_ with a buoyancy of _PARAM3_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["/** @type {gdjs.CustomRuntimeObject3D} */","const object = objects[0];","const objectsToFloat = eventsFunctionContext.getObjects(\"Objects\");","const behaviorName = eventsFunctionContext.getBehaviorName(\"Physics3D\");","const buoyancy = eventsFunctionContext.getArgument(\"Buoyancy\");","object.__water3D.applyBuoyancy(objectsToFloat, behaviorName, buoyancy);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Water3D::Water3D","type":"object"},{"description":"Objects to make float","name":"Objects","type":"objectList"},{"description":"3D physics behavior","name":"Physics3D","supplementaryInformation":"Physics3D::Physics3DBehavior","type":"behavior"},{"defaultValue":"1","description":"Buoyancy","longDescription":"1 makes objects float half submerged. Lower values make them sink, higher values float higher.","name":"Buoyancy","type":"expression"}],"objectGroups":[]}],"eventsFunctionsFolderStructure":{"folderName":"__ROOT","children":[{"functionName":"onCreated"},{"functionName":"onDestroy"},{"functionName":"doStepPostEvents"},{"functionName":"onHotReloading"},{"functionName":"SurfaceZ"},{"functionName":"IsUnderwater"},{"functionName":"ApplyBuoyancy"}]},"propertyDescriptors":[{"value":"Default","type":"Choice","label":"Style","description":"The look of the surface. The colors, foam and effects of the other properties apply to every style.","choices":[{"label":"Default","value":"Default"},{"label":"Realistic water","value":"RealisticWater"},{"label":"Ocean water","value":"OceanWater"},{"label":"Fast ocean water","value":"FastOceanWater"},{"label":"Cartoon water","value":"CartoonWater"},{"label":"Pixel water","value":"PixelWater"},{"label":"Cel shaded water","value":"CelShadedWater"},{"label":"Lava flow","value":"LavaFlow"},{"label":"Pixel magma","value":"PixelMagma"},{"label":"Toxic slime","value":"ToxicSlime"}],"name":"Style"},{"value":"40;120;170","type":"Color","label":"Color","group":"Color","name":"Color"},{"value":"200","type":"Number","label":"Opacity","description":"From 0 (invisible) to 255 (opaque).","group":"Color","name":"Opacity"},{"value":"140;210;220","type":"Color","label":"Color of wave crests","description":"Also the color of the sky reflected on the water, seen from the side.","group":"Color","name":"CrestColor"},{"value":"6","type":"Number","unit":"Pixel","label":"Wave height","description":"0 for flat water. Waves shorter than a few times the size of the water divided by 256 don't move the surface: they are only drawn with the light.","group":"Waves","name":"WaveHeight"},{"value":"300","type":"Number","unit":"Pixel","label":"Wave length","group":"Waves","name":"WaveLength"},{"value":"1.5","type":"Number","label":"Wave speed","group":"Waves","name":"WaveSpeed"},{"value":"","type":"Resource","label":"Ripples normal map","description":"Optional. A seamless normal map of small waves, moving on the surface to reflect the light like real water.","group":"Ripples","extraInformation":["image"],"choices":[],"name":"NormalMap"},{"value":"600","type":"Number","unit":"Pixel","label":"Ripples size","description":"The size of the normal map on the surface.","group":"Ripples","name":"NormalMapSize"},{"value":"18;62;110","type":"Color","label":"Deep water color","description":"Color of the deep water, and of the dark parts of the pattern of the other styles.","group":"Color","name":"DeepColor"},{"value":"241;250;245","type":"Color","label":"Foam color","description":"Color of the foam around objects, of the bubbles, and of the light parts of the pattern of the other styles.","group":"Color","name":"FoamColor"},{"value":"1","type":"Number","label":"Pattern scale","description":"Size of the pattern drawn on the surface (the ripples of the default style).","group":"Pattern","name":"PatternScale"},{"value":"1","type":"Number","label":"Pattern speed","description":"Speed of the pattern drawn on the surface (the ripples of the default style).","group":"Pattern","name":"PatternSpeed"},{"value":"0.3","type":"Number","label":"Crest foam","description":"Foam on the crests of the waves, from 0 (no foam) to 1 (a lot).","group":"Foam","name":"Foam"},{"value":"80","type":"Number","unit":"Pixel","label":"Foam width","description":"Width of the foam around objects.","group":"Foam","name":"FoamWidth"},{"value":"0","type":"Number","label":"Foam intensity","description":"Foam where objects cross the surface or the shore is close below it, from 0 (no foam) to 1 (solid foam).","group":"Foam","name":"FoamIntensity"},{"value":"1","type":"Number","label":"Foam speed","description":"Speed of the foam around objects.","group":"Foam","name":"FoamSpeed"},{"value":"0","type":"Number","label":"Underwater tint","description":"Tint of the view when the camera is under the surface, from 0 (none) to 1 (opaque).","group":"Underwater","name":"UnderwaterDensity"},{"value":"0","type":"Number","label":"Water density","description":"How fast what is under the surface fades out into the deep water color, per 100 pixels of water. 0 to see the bottom at any depth.","group":"Underwater","name":"WaterDensity"},{"value":"0","type":"Number","unit":"Pixel","label":"Pixel size","description":"Size of the square pixels of the surface. 0 for no pixel art.","group":"Pixel art","name":"PixelSize"},{"value":"0","type":"Number","label":"Animation frames per second","description":"The animation of the surface moves by steps. 0 for a smooth animation.","group":"Pixel art","name":"AnimationFps"},{"value":"0","type":"Number","label":"Bubble intensity","description":"Bubbles swelling and popping on the surface, from 0 (no bubbles) to 1.","group":"Pattern","name":"BubbleIntensity"},{"value":"false","type":"Boolean","label":"Sharp reflections","description":"Glossier surface with pinpoint sun glints. For the default and the \"Realistic water\" styles.","group":"Ripples","name":"SharpReflections"}],"propertiesFolderStructure":{"folderName":"__ROOT","children":[{"propertyName":"Style"},{"folderName":"Color","children":[{"propertyName":"Color"},{"propertyName":"Opacity"},{"propertyName":"CrestColor"},{"propertyName":"DeepColor"},{"propertyName":"FoamColor"}]},{"folderName":"Waves","children":[{"propertyName":"WaveHeight"},{"propertyName":"WaveLength"},{"propertyName":"WaveSpeed"}]},{"folderName":"Ripples","children":[{"propertyName":"NormalMap"},{"propertyName":"NormalMapSize"},{"propertyName":"SharpReflections"}]},{"folderName":"Pattern","children":[{"propertyName":"PatternScale"},{"propertyName":"PatternSpeed"},{"propertyName":"BubbleIntensity"}]},{"folderName":"Foam","children":[{"propertyName":"Foam"},{"propertyName":"FoamWidth"},{"propertyName":"FoamIntensity"},{"propertyName":"FoamSpeed"}]},{"folderName":"Underwater","children":[{"propertyName":"UnderwaterDensity"},{"propertyName":"WaterDensity"}]},{"folderName":"Pixel art","children":[{"propertyName":"PixelSize"},{"propertyName":"AnimationFps"}]}]},"variants":[]}]},{"author":"","category":"Network","dimension":"","extensionNamespace":"","fullName":"Advanced HTTP","gdevelopVersion":">=5.5.222","helpPath":"","iconUrl":"data:image/svg+xml;base64,","name":"AdvancedHTTP","previewIconUrl":"https://asset-resources.gdevelop.io/public-resources/Icons/Line Hero Pack/Master/SVG/Email/04e28ac117741933d15ac1cadb34e0d799c7a561352b1525a1b75c5bd1dbeabc_Email_email_envelope_letter_message_fast.svg","shortDescription":"HTTP requests with custom headers, methods, caching, CORS bypass, and JSON/FormData body.","version":"1.1.0","description":"An extension to create HTTP requests with more advanced settings than the built-in \"Network request\" action, like specifying headers or bypassing CORS.","origin":{"identifier":"AdvancedHTTP","name":"gdevelop-extension-store"},"tags":["header","beacon","http","request","get","post","delete","patch","head","method","body","html","request","web","curl","url"],"authorIds":["ZgrsWuRTAkXgeuPV9bo0zuEcA2w1"],"dependencies":[],"globalVariables":[],"sceneVariables":[],"eventsFunctions":[{"description":"Creates a template for your request. All requests must be made from a request template.","fullName":"Create a new request template","functionType":"Action","group":"Request creation","name":"CreateRequest","sentence":"Create request template _PARAM1_ with URL _PARAM2_","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],